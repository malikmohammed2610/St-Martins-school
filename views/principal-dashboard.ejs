<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>
        Principal Dashboard | St. Martin's High School
    </title>

    <link rel="icon"
          type="image/png"
          href="/images/logo.png">

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f3f0e8;
            color: #172635;
            font-family: Arial, sans-serif;
        }


        /* ==================================================
           HEADER
        ================================================== */

        .topbar {

            background: #071827;
            color: white;

            min-height: 76px;

            padding: 12px 30px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 20px;

        }


        .brand {

            display: flex;
            align-items: center;

            gap: 14px;

        }


        .brand img {

            width: 50px;
            height: 50px;

            object-fit: contain;

        }


        .brand-title {

            font-family: Georgia, serif;

            font-size: 19px;

        }


        .brand-subtitle {

            color: #9eacb8;

            font-size: 12px;

            margin-top: 3px;

        }


        .logout {

            text-decoration: none;

            color: white;

            padding: 11px 17px;

            border-radius: 8px;

            border: 1px solid rgba(255,255,255,.2);

            font-size: 14px;

            transition: .2s;

        }


        .logout:hover {

            background: #c5a45a;

            color: #071827;

        }


        /* ==================================================
           MAIN
        ================================================== */

        .container {

            max-width: 1400px;

            margin: auto;

            padding: 40px 25px 70px;

        }


        /* ==================================================
           HERO
        ================================================== */

        .hero {

            background:
                linear-gradient(
                    135deg,
                    #102f49,
                    #081b2b
                );

            color: white;

            border-radius: 24px;

            padding: 45px;

            margin-bottom: 25px;

            box-shadow:
                0 15px 40px
                rgba(7,24,39,.12);

        }


        .eyebrow {

            color: #c5a45a;

            text-transform: uppercase;

            letter-spacing: 3px;

            font-size: 11px;

            font-weight: bold;

        }


        .hero h1 {

            font-family: Georgia, serif;

            font-size: 42px;

            margin: 12px 0;

        }


        .hero p {

            color: #c5d0d9;

            line-height: 1.7;

            max-width: 800px;

        }


        /* ==================================================
           STATS
        ================================================== */

        .stats {

            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 18px;

            margin-bottom: 30px;

        }


        .stat {

            background: white;

            border-radius: 17px;

            padding: 25px;

            box-shadow:
                0 8px 25px
                rgba(0,0,0,.05);

        }


        .stat-label {

            color: #78838d;

            font-size: 13px;

            margin-bottom: 8px;

        }


        .stat-number {

            font-family: Georgia, serif;

            font-size: 34px;

            font-weight: bold;

        }


        /* ==================================================
           GENERAL SECTION
        ================================================== */

        .section {

            background: white;

            border-radius: 20px;

            padding: 32px;

            margin-bottom: 25px;

            box-shadow:
                0 8px 25px
                rgba(0,0,0,.05);

        }


        .section-header {

            margin-bottom: 25px;

        }


        .section-header h2 {

            font-family: Georgia, serif;

            font-size: 28px;

            margin: 0 0 8px;

        }


        .section-header p {

            color: #71808c;

            margin: 0;

            line-height: 1.6;

        }


        /* ==================================================
           INSTRUCTIONS / NOTIFICATIONS
        ================================================== */

        .instruction-section {

            position: relative;

            overflow: hidden;

        }


        .instruction-section::before {

            content: "";

            position: absolute;

            top: 0;
            left: 0;

            width: 100%;

            height: 4px;

            background:
                linear-gradient(
                    90deg,
                    #c5a45a,
                    #e2c77e,
                    #c5a45a
                );

        }


        .instruction-layout {

            display: grid;

            grid-template-columns:
                minmax(0, 1fr)
                1fr;

            gap: 30px;

        }


        .instruction-form {

            background: #faf9f5;

            border: 1px solid #e7e3da;

            border-radius: 16px;

            padding: 25px;

        }


        .instruction-form h3 {

            margin: 0 0 8px;

            font-family: Georgia, serif;

            font-size: 21px;

        }


        .instruction-form .description {

            color: #7a858e;

            font-size: 13px;

            line-height: 1.6;

            margin-bottom: 22px;

        }


        .form-group {

            margin-bottom: 17px;

        }


        .form-group label {

            display: block;

            font-size: 13px;

            font-weight: bold;

            margin-bottom: 8px;

        }


        .form-group input,
        .form-group textarea {

            width: 100%;

            padding: 14px;

            border: 1px solid #d5d1c8;

            border-radius: 10px;

            font-size: 14px;

            outline: none;

            font-family: Arial, sans-serif;

            background: white;

            transition: .2s;

        }


        .form-group textarea {

            min-height: 150px;

            resize: vertical;

            line-height: 1.6;

        }


        .form-group input:focus,
        .form-group textarea:focus {

            border-color: #c5a45a;

            box-shadow:
                0 0 0 3px
                rgba(197,164,90,.12);

        }


        .primary-button {

            border: 0;

            background: #102e47;

            color: white;

            padding: 14px 22px;

            border-radius: 10px;

            cursor: pointer;

            font-weight: bold;

            font-size: 14px;

            transition: .2s;

        }


        .primary-button:hover {

            background: #c5a45a;

            color: #102e47;

        }


        .primary-button:disabled {

            opacity: .6;

            cursor: not-allowed;

        }


        .form-message {

            display: none;

            margin-bottom: 20px;

            padding: 14px;

            border-radius: 10px;

            font-size: 14px;

        }


        .form-message.success {

            display: block;

            background: #e5f5e9;

            color: #27683d;

        }


        .form-message.error {

            display: block;

            background: #fae7e7;

            color: #9b2d2d;

        }


        /* ==================================================
           SENT INSTRUCTIONS
        ================================================== */

        .sent-instructions {

            min-width: 0;

        }


        .sent-header {

            display: flex;

            justify-content: space-between;

            align-items: center;

            gap: 15px;

            margin-bottom: 15px;

        }


        .sent-header h3 {

            margin: 0;

            font-family: Georgia, serif;

            font-size: 21px;

        }


        .notification-count {

            background: #f0e7cf;

            color: #765b1d;

            padding: 6px 10px;

            border-radius: 50px;

            font-size: 11px;

            font-weight: bold;

        }


        .notifications-list {

            max-height: 430px;

            overflow-y: auto;

            padding-right: 5px;

        }


        .notification-item {

            border: 1px solid #e7e3da;

            border-radius: 14px;

            padding: 18px;

            margin-bottom: 12px;

            background: #fff;

            transition: .2s;

        }


        .notification-item:hover {

            border-color: #c5a45a;

            transform: translateY(-1px);

        }


        .notification-item:last-child {

            margin-bottom: 0;

        }


        .notification-top {

            display: flex;

            justify-content: space-between;

            align-items: flex-start;

            gap: 15px;

        }


        .notification-title {

            font-family: Georgia, serif;

            font-size: 17px;

            font-weight: bold;

            color: #172635;

            margin-bottom: 7px;

        }


        .notification-date {

            color: #8b949c;

            font-size: 11px;

            white-space: nowrap;

        }


        .notification-message {

            color: #596771;

            font-size: 13px;

            line-height: 1.7;

            white-space: pre-wrap;

            margin-top: 8px;

        }


        .notification-badge {

            display: inline-block;

            margin-top: 12px;

            padding: 5px 9px;

            border-radius: 50px;

            background: #eef2f5;

            color: #56616b;

            font-size: 10px;

            font-weight: bold;

            text-transform: uppercase;

            letter-spacing: .5px;

        }


        .delete-notification {

            border: 0;

            background: #f9e4e4;

            color: #9a2c2c;

            padding: 7px 10px;

            border-radius: 7px;

            cursor: pointer;

            font-size: 10px;

            font-weight: bold;

            margin-top: 12px;

        }


        .delete-notification:hover {

            background: #eecaca;

        }


        .no-notifications {

            border: 1px dashed #d8d3c8;

            border-radius: 14px;

            padding: 35px 20px;

            text-align: center;

            color: #8a939a;

            font-size: 13px;

            line-height: 1.6;

        }


        /* ==================================================
           CREATE TEACHER
        ================================================== */

        .form-grid {

            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 18px;

        }


        .full {

            grid-column: 1 / -1;

        }


        /* ==================================================
           TEACHER TABLE
        ================================================== */

        .table-wrapper {

            overflow-x: auto;

        }


        table {

            width: 100%;

            border-collapse: collapse;

            min-width: 850px;

        }


        th {

            background: #f0ede5;

            text-align: left;

            padding: 15px;

            font-size: 12px;

            text-transform: uppercase;

            letter-spacing: 1px;

        }


        td {

            padding: 15px;

            border-bottom: 1px solid #ece9e2;

            font-size: 14px;

        }


        tr:hover td {

            background: #fcfbf8;

        }


        .status {

            display: inline-block;

            padding: 6px 10px;

            border-radius: 50px;

            font-size: 11px;

            font-weight: bold;

            text-transform: uppercase;

        }


        .status.pending {

            background: #fff2cf;

            color: #8b681c;

        }


        .status.approved {

            background: #e2f4e8;

            color: #27683c;

        }


        .status.rejected {

            background: #f9e4e4;

            color: #9a2c2c;

        }


        .status.disabled {

            background: #e4e7ea;

            color: #56616b;

        }


        .actions {

            display: flex;

            flex-wrap: wrap;

            gap: 7px;

        }


        .action {

            border: 0;

            padding: 8px 11px;

            border-radius: 7px;

            cursor: pointer;

            font-size: 11px;

            font-weight: bold;

        }


        .approve {

            background: #dff3e5;

            color: #24683a;

        }


        .reject {

            background: #fae4e4;

            color: #9b2b2b;

        }


        .disable {

            background: #e7e9eb;

            color: #4e5962;

        }


        .reactivate {

            background: #e4eff8;

            color: #285d80;

        }


        .empty {

            text-align: center;

            padding: 35px;

            color: #7d8790;

        }


        /* ==================================================
           MOBILE
        ================================================== */

        @media(max-width:1000px) {

            .instruction-layout {

                grid-template-columns: 1fr;

            }

        }


        @media(max-width:900px) {

            .stats {

                grid-template-columns:
                    repeat(2, 1fr);

            }

        }


        @media(max-width:700px) {

            .topbar {

                padding: 12px 16px;

            }


            .brand-title {

                font-size: 15px;

            }


            .container {

                padding:
                    25px 15px 50px;

            }


            .hero {

                padding: 30px;

            }


            .hero h1 {

                font-size: 32px;

            }


            .stats {

                grid-template-columns: 1fr;

            }


            .section {

                padding: 22px;

            }


            .form-grid {

                grid-template-columns: 1fr;

            }


            .full {

                grid-column: auto;

            }


            .notification-top {

                flex-direction: column;

                gap: 5px;

            }


            .notification-date {

                white-space: normal;

            }

        }

    </style>

</head>


<body>


<!-- ======================================================
     HEADER
====================================================== -->

<header class="topbar">

    <div class="brand">

        <img
            src="/images/logo.png"
            alt="School Logo"
        >

        <div>

            <div class="brand-title">
                St. Martin's High School
            </div>

            <div class="brand-subtitle">
                Principal Administration Portal
            </div>

        </div>

    </div>


    <a
        href="/principal-logout"
        class="logout"
    >
        Logout
    </a>

</header>



<main class="container">


    <!-- ==================================================
         HERO
    ================================================== -->

    <section class="hero">

        <div class="eyebrow">
            Principal Dashboard
        </div>

        <h1>
            Welcome, Principal
        </h1>

        <p>
            Manage teacher registrations,
            approve faculty accounts, create
            teacher profiles and communicate
            important instructions directly
            to the teaching staff.
        </p>

    </section>



    <!-- ==================================================
         STATS
    ================================================== -->

    <section class="stats">

        <div class="stat">

            <div class="stat-label">
                Total Teachers
            </div>

            <div
                class="stat-number"
                id="totalTeachers"
            >
                0
            </div>

        </div>


        <div class="stat">

            <div class="stat-label">
                Pending Approval
            </div>

            <div
                class="stat-number"
                id="pendingTeachers"
            >
                0
            </div>

        </div>


        <div class="stat">

            <div class="stat-label">
                Approved
            </div>

            <div
                class="stat-number"
                id="approvedTeachers"
            >
                0
            </div>

        </div>


        <div class="stat">

            <div class="stat-label">
                Disabled
            </div>

            <div
                class="stat-number"
                id="disabledTeachers"
            >
                0
            </div>

        </div>

    </section>



    <!-- ==================================================
         TEACHER INSTRUCTIONS
    ================================================== -->

    <section class="section instruction-section">

        <div class="section-header">

            <h2>
                Teacher Instructions & Notifications
            </h2>

            <p>
                Send private instructions,
                announcements and important
                messages directly to the teacher
                dashboard.
            </p>

        </div>


        <div class="instruction-layout">


            <!-- ==========================================
                 CREATE NOTIFICATION
            =========================================== -->

            <div class="instruction-form">

                <h3>
                    📢 Send New Instruction
                </h3>

                <p class="description">
                    This message will be delivered
                    to the authenticated teacher
                    dashboard. It will not appear
                    on the public school website.
                </p>


                <div
                    id="notificationMessage"
                    class="form-message"
                ></div>


                <form
                    id="notificationForm"
                >


                    <div class="form-group">

                        <label for="notification_title">
                            Instruction Title
                        </label>

                        <input
                            type="text"
                            id="notification_title"
                            maxlength="120"
                            required
                            placeholder="Example: Staff Meeting — Monday"
                        >

                    </div>



                    <div class="form-group">

                        <label for="notification_body">
                            Instruction / Message
                        </label>

                        <textarea
                            id="notification_body"
                            maxlength="3000"
                            required
                            placeholder="Write the instruction or announcement for teachers..."
                        ></textarea>

                    </div>



                    <button
                        type="submit"
                        class="primary-button"
                        id="sendNotificationButton"
                    >
                        📢 Send to Teachers
                    </button>


                </form>

            </div>



            <!-- ==========================================
                 PREVIOUS NOTIFICATIONS
            =========================================== -->

            <div class="sent-instructions">

                <div class="sent-header">

                    <h3>
                        Sent Instructions
                    </h3>

                    <span
                        class="notification-count"
                        id="notificationCount"
                    >
                        0 Sent
                    </span>

                </div>


                <div
                    class="notifications-list"
                    id="notificationsList"
                >

                    <div class="no-notifications">

                        Loading instructions...

                    </div>

                </div>

            </div>


        </div>

    </section>



    <!-- ==================================================
         CREATE TEACHER
    ================================================== -->

    <section class="section">

        <div class="section-header">

            <h2>
                Create Teacher Profile
            </h2>

            <p>
                Create an approved teacher
                account directly. Teachers
                created here do not need
                additional approval.
            </p>

        </div>


        <div
            id="createMessage"
            class="form-message"
        ></div>


        <form id="createTeacherForm">

            <div class="form-grid">


                <div class="form-group">

                    <label>
                        Full Name
                    </label>

                    <input
                        type="text"
                        id="create_full_name"
                        required
                        placeholder="Teacher's full name"
                    >

                </div>



                <div class="form-group">

                    <label>
                        Employee ID
                    </label>

                    <input
                        type="text"
                        id="create_employee_id"
                        required
                        placeholder="Example: SMHS-T001"
                    >

                </div>



                <div class="form-group">

                    <label>
                        Username
                    </label>

                    <input
                        type="text"
                        id="create_username"
                        minlength="4"
                        required
                        placeholder="Teacher login username"
                    >

                </div>



                <div class="form-group">

                    <label>
                        Email Address
                    </label>

                    <input
                        type="email"
                        id="create_email"
                        required
                        placeholder="teacher@example.com"
                    >

                </div>



                <div class="form-group">

                    <label>
                        Password
                    </label>

                    <input
                        type="password"
                        id="create_password"
                        minlength="8"
                        required
                        placeholder="Minimum 8 characters"
                    >

                </div>



                <div class="form-group">

                    <label>
                        Confirm Password
                    </label>

                    <input
                        type="password"
                        id="create_confirm_password"
                        minlength="8"
                        required
                        placeholder="Confirm password"
                    >

                </div>



                <div class="full">

                    <button
                        type="submit"
                        class="primary-button"
                    >
                        + Create Teacher Profile
                    </button>

                </div>


            </div>

        </form>

    </section>



    <!-- ==================================================
         TEACHER MANAGEMENT
    ================================================== -->

    <section class="section">

        <div class="section-header">

            <h2>
                Teacher Accounts
            </h2>

            <p>
                Review registrations and
                manage faculty access.
            </p>

        </div>


        <div class="table-wrapper">

            <table>

                <thead>

                    <tr>

                        <th>
                            Teacher
                        </th>

                        <th>
                            Employee ID
                        </th>

                        <th>
                            Username
                        </th>

                        <th>
                            Email
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody id="teacherTableBody">

                    <tr>

                        <td
                            colspan="6"
                            class="empty"
                        >
                            Loading teacher accounts...
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </section>


</main>



<script>


let teachers = [];


// ==========================================================
// LOAD TEACHERS
// ==========================================================

async function loadTeachers() {

    const tbody =
        document.getElementById(
            "teacherTableBody"
        );

    try {

        const response =
            await fetch(
                "/api/principal/teachers"
            );


        if (response.redirected) {

            window.location.href =
                "/principal-login";

            return;

        }


        const data =
            await response.json();


        if (!data.success) {

            throw new Error(
                data.error ||
                "Unable to load teachers."
            );

        }


        teachers =
            data.teachers || [];


        renderTeachers();

        updateStats();


    } catch (error) {

        console.error(error);


        tbody.innerHTML = `

            <tr>

                <td
                    colspan="6"
                    class="empty"
                >
                    Unable to load teacher accounts.
                </td>

            </tr>

        `;

    }

}



// ==========================================================
// RENDER TEACHERS
// ==========================================================

function renderTeachers() {

    const tbody =
        document.getElementById(
            "teacherTableBody"
        );


    if (!teachers.length) {

        tbody.innerHTML = `

            <tr>

                <td
                    colspan="6"
                    class="empty"
                >
                    No teacher accounts found.
                </td>

            </tr>

        `;

        return;

    }


    tbody.innerHTML =
        teachers.map(
            teacher => {

                let actions = "";


                if (
                    teacher.status ===
                    "pending"
                ) {

                    actions = `

                        <button
                            class="action approve"
                            onclick="updateTeacher(
                                ${teacher.id},
                                'approve'
                            )"
                        >
                            Approve
                        </button>


                        <button
                            class="action reject"
                            onclick="updateTeacher(
                                ${teacher.id},
                                'reject'
                            )"
                        >
                            Reject
                        </button>

                    `;

                }


                if (
                    teacher.status ===
                    "approved"
                ) {

                    actions = `

                        <button
                            class="action disable"
                            onclick="updateTeacher(
                                ${teacher.id},
                                'disable'
                            )"
                        >
                            Disable
                        </button>

                    `;

                }


                if (
                    teacher.status ===
                    "rejected"
                ) {

                    actions = `

                        <button
                            class="action approve"
                            onclick="updateTeacher(
                                ${teacher.id},
                                'approve'
                            )"
                        >
                            Approve
                        </button>

                    `;

                }


                if (
                    teacher.status ===
                    "disabled"
                ) {

                    actions = `

                        <button
                            class="action reactivate"
                            onclick="updateTeacher(
                                ${teacher.id},
                                'reactivate'
                            )"
                        >
                            Reactivate
                        </button>

                    `;

                }


                return `

                    <tr>

                        <td>

                            <strong>
                                ${escapeHtml(
                                    teacher.full_name
                                )}
                            </strong>

                        </td>


                        <td>
                            ${escapeHtml(
                                teacher.employee_id
                            )}
                        </td>


                        <td>
                            ${escapeHtml(
                                teacher.username
                            )}
                        </td>


                        <td>
                            ${escapeHtml(
                                teacher.email
                            )}
                        </td>


                        <td>

                            <span
                                class="status ${escapeHtml(
                                    teacher.status
                                )}"
                            >
                                ${escapeHtml(
                                    teacher.status
                                )}
                            </span>

                        </td>


                        <td>

                            <div class="actions">

                                ${actions}

                            </div>

                        </td>

                    </tr>

                `;

            }

        ).join("");

}



// ==========================================================
// UPDATE STATS
// ==========================================================

function updateStats() {

    document.getElementById(
        "totalTeachers"
    ).textContent =
        teachers.length;


    document.getElementById(
        "pendingTeachers"
    ).textContent =
        teachers.filter(
            t => t.status === "pending"
        ).length;


    document.getElementById(
        "approvedTeachers"
    ).textContent =
        teachers.filter(
            t => t.status === "approved"
        ).length;


    document.getElementById(
        "disabledTeachers"
    ).textContent =
        teachers.filter(
            t => t.status === "disabled"
        ).length;

}



// ==========================================================
// UPDATE TEACHER
// ==========================================================

async function updateTeacher(
    id,
    action
) {

    let confirmation =
        true;


    if (action === "approve") {

        confirmation =
            confirm(
                "Approve this teacher account?"
            );

    }


    if (action === "reject") {

        confirmation =
            confirm(
                "Reject this teacher account?"
            );

    }


    if (action === "disable") {

        confirmation =
            confirm(
                "Disable this teacher account?"
            );

    }


    if (action === "reactivate") {

        confirmation =
            confirm(
                "Reactivate this teacher account?"
            );

    }


    if (!confirmation) {

        return;

    }


    try {

        const response =
            await fetch(
                `/api/principal/teachers/${id}/${action}`,
                {
                    method: "POST"
                }
            );


        if (response.redirected) {

            window.location.href =
                "/principal-login";

            return;

        }


        const data =
            await response.json();


        if (!data.success) {

            alert(
                data.error ||
                "Unable to update teacher."
            );

            return;

        }


        await loadTeachers();


    } catch (error) {

        console.error(error);


        alert(
            "Unable to connect to the server."
        );

    }

}



// ==========================================================
// CREATE TEACHER
// ==========================================================

const createForm =
    document.getElementById(
        "createTeacherForm"
    );


createForm.addEventListener(
    "submit",
    async function(event) {

        event.preventDefault();


        const message =
            document.getElementById(
                "createMessage"
            );


        message.className =
            "form-message";

        message.textContent = "";


        const full_name =
            document.getElementById(
                "create_full_name"
            ).value.trim();


        const employee_id =
            document.getElementById(
                "create_employee_id"
            ).value.trim();


        const username =
            document.getElementById(
                "create_username"
            ).value.trim();


        const email =
            document.getElementById(
                "create_email"
            ).value.trim();


        const password =
            document.getElementById(
                "create_password"
            ).value;


        const confirm_password =
            document.getElementById(
                "create_confirm_password"
            ).value;


        if (
            password !==
            confirm_password
        ) {

            message.className =
                "form-message error";

            message.textContent =
                "Passwords do not match.";

            return;

        }


        try {

            const response =
                await fetch(
                    "/api/principal/teachers/create",
                    {

                        method: "POST",

                        headers: {

                            "Content-Type":
                                "application/json"

                        },

                        body: JSON.stringify({

                            full_name,
                            employee_id,
                            username,
                            email,
                            password,
                            confirm_password

                        })

                    }

                );


            if (response.redirected) {

                window.location.href =
                    "/principal-login";

                return;

            }


            const data =
                await response.json();


            if (!data.success) {

                message.className =
                    "form-message error";

                message.textContent =
                    data.error ||
                    "Unable to create teacher.";

                return;

            }


            message.className =
                "form-message success";

            message.textContent =
                data.message;


            createForm.reset();


            await loadTeachers();


        } catch (error) {

            console.error(error);


            message.className =
                "form-message error";

            message.textContent =
                "Unable to connect to the server.";

        }

    }

);



// ==========================================================
// SEND TEACHER INSTRUCTION
// ==========================================================

const notificationForm =
    document.getElementById(
        "notificationForm"
    );


notificationForm.addEventListener(
    "submit",
    async function(event) {

        event.preventDefault();


        const title =
            document.getElementById(
                "notification_title"
            ).value.trim();


        const messageText =
            document.getElementById(
                "notification_body"
            ).value.trim();


        const messageBox =
            document.getElementById(
                "notificationMessage"
            );


        const button =
            document.getElementById(
                "sendNotificationButton"
            );


        messageBox.className =
            "form-message";

        messageBox.textContent = "";


        if (!title || !messageText) {

            messageBox.className =
                "form-message error";

            messageBox.textContent =
                "Please enter both a title and an instruction.";

            return;

        }


        button.disabled = true;

        button.textContent =
            "Sending...";


        try {

            const response =
                await fetch(
                    "/api/principal/notifications",
                    {

                        method: "POST",

                        headers: {

                            "Content-Type":
                                "application/json"

                        },

                        body: JSON.stringify({

                            title,
                            message:
                                messageText

                        })

                    }

                );


            if (response.redirected) {

                window.location.href =
                    "/principal-login";

                return;

            }


            const data =
                await response.json();


            if (!data.success) {

                throw new Error(
                    data.error ||
                    "Unable to send instruction."
                );

            }


            messageBox.className =
                "form-message success";

            messageBox.textContent =
                "Instruction sent successfully to the teacher dashboard.";


            notificationForm.reset();


            await loadNotifications();


        } catch (error) {

            console.error(error);


            messageBox.className =
                "form-message error";

            messageBox.textContent =
                error.message ||
                "Unable to connect to the server.";

        } finally {

            button.disabled = false;

            button.textContent =
                "📢 Send to Teachers";

        }

    }

);



// ==========================================================
// LOAD PREVIOUS NOTIFICATIONS
// ==========================================================

async function loadNotifications() {

    const list =
        document.getElementById(
            "notificationsList"
        );


    const count =
        document.getElementById(
            "notificationCount"
        );


    try {

        const response =
            await fetch(
                "/api/principal/notifications"
            );


        if (response.redirected) {

            window.location.href =
                "/principal-login";

            return;

        }


        const data =
            await response.json();


        if (!data.success) {

            throw new Error(
                data.error ||
                "Unable to load notifications."
            );

        }


        const notifications =
            data.notifications || [];


        count.textContent =
            `${notifications.length} Sent`;


        if (!notifications.length) {

            list.innerHTML = `

                <div class="no-notifications">

                    No instructions have been
                    sent to teachers yet.

                </div>

            `;

            return;

        }


        list.innerHTML =
            notifications.map(
                notification => `

                    <div
                        class="notification-item"
                    >

                        <div
                            class="notification-top"
                        >

                            <div
                                class="notification-title"
                            >
                                ${escapeHtml(
                                    notification.title
                                )}
                            </div>


                            <div
                                class="notification-date"
                            >
                                ${formatDate(
                                    notification.created_at
                                )}
                            </div>

                        </div>


                        <div
                            class="notification-message"
                        >
                            ${escapeHtml(
                                notification.message
                            )}
                        </div>


                        <span
                            class="notification-badge"
                        >
                            Sent to Teachers
                        </span>


                        <br>


                        <button
                            class="delete-notification"
                            onclick="deleteNotification(
                                ${Number(
                                    notification.id
                                )}
                            )"
                        >
                            Delete

                        </button>

                    </div>

                `
            ).join("");


    } catch (error) {

        console.error(error);


        list.innerHTML = `

            <div class="no-notifications">

                Unable to load sent instructions.

            </div>

        `;

    }

}



// ==========================================================
// DELETE NOTIFICATION
// ==========================================================

async function deleteNotification(id) {

    const confirmation =
        confirm(
            "Delete this instruction? It will no longer be available to teachers."
        );


    if (!confirmation) {

        return;

    }


    try {

        const response =
            await fetch(
                `/api/principal/notifications/${id}`,
                {
                    method: "DELETE"
                }
            );


        if (response.redirected) {

            window.location.href =
                "/principal-login";

            return;

        }


        const data =
            await response.json();


        if (!data.success) {

            alert(
                data.error ||
                "Unable to delete instruction."
            );

            return;

        }


        await loadNotifications();


    } catch (error) {

        console.error(error);


        alert(
            "Unable to connect to the server."
        );

    }

}



// ==========================================================
// FORMAT DATE
// ==========================================================

function formatDate(value) {

    if (!value) {

        return "";

    }


    const date =
        new Date(value);


    if (
        Number.isNaN(
            date.getTime()
        )
    ) {

        return String(value);

    }


    return date.toLocaleString(
        "en-IN",
        {
            day: "2-digit",
            month: "short",
            year: "numeric",
            hour: "2-digit",
            minute: "2-digit"
        }
    );

}



// ==========================================================
// ESCAPE HTML
// ==========================================================

function escapeHtml(value) {

    return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

}



// ==========================================================
// INITIAL LOAD
// ==========================================================

loadTeachers();

loadNotifications();


</script>

