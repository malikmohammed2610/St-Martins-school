<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gallery | St. Martin's High School</title>

    <!-- FAVICON -->
    <link rel="icon" type="image/png" href="/images/logo.png">

    <!-- GOOGLE FONTS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- BOOTSTRAP -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- FONT AWESOME -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- MAIN WEBSITE CSS -->
    <link rel="stylesheet" href="/css/style.css">

    <style>

        :root {
            --navy-midnight: #071A2B;
            --navy-light: #10283d;
            --gold: #C5A45A;
            --gold-light: #dfc982;
            --ivory: #F6F1E7;
            --cream: #faf7f0;
            --charcoal: #20252A;
            --muted: #6c757d;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: var(--ivory);
            color: var(--charcoal);
            font-family: 'Inter', sans-serif;
        }

        /* =====================================================
           HEADER
        ===================================================== */

        .global-header {
            background: #ffffff;
            border-bottom: 1px solid rgba(7, 26, 43, 0.08);
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .brand-container {
            max-width: 1140px;
            margin: auto;
            padding: 14px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand-link {
            display: flex;
            align-items: center;
            text-decoration: none;
            color: var(--navy-midnight);
        }

        .brand-logo {
            width: 60px;
            height: 60px;
            object-fit: contain;
            margin-right: 15px;
        }

        .brand-title {
            margin: 0;
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.3rem;
            font-weight: 700;
            letter-spacing: 0.02em;
            color: var(--navy-midnight);
        }

        .brand-location {
            display: block;
            margin-top: 2px;
            font-size: 0.68rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: #6c757d;
        }

        .header-contact {
            display: flex;
            align-items: center;
            gap: 22px;
        }

        .phone-number {
            color: #6c757d;
            font-size: 0.85rem;
        }

        .phone-number i {
            color: var(--gold);
            margin-right: 6px;
        }

        .teacher-login {
            text-decoration: none;
            background: var(--navy-midnight);
            color: #ffffff;
            padding: 11px 18px;
            font-size: 0.72rem;
            letter-spacing: 0.09em;
            text-transform: uppercase;
            transition: all 0.3s ease;
        }

        .teacher-login:hover {
            background: var(--gold);
            color: var(--navy-midnight);
        }

        /* =====================================================
           NAVIGATION
        ===================================================== */

        .main-navigation {
            background: var(--navy-midnight);
            border-bottom: 1px solid rgba(197, 164, 90, 0.25);
        }

        .navigation-container {
            max-width: 1140px;
            margin: auto;
        }

        .navbar {
            padding: 0;
        }

        .navbar-nav {
            width: 100%;
            display: flex;
            justify-content: space-between;
        }

        .navbar .nav-link {
            color: #ffffff !important;
            font-size: 0.78rem;
            font-weight: 500;
            letter-spacing: 0.04em;
            padding: 16px 10px !important;
            transition: color 0.3s ease;
        }

        .navbar .nav-link:hover {
            color: var(--gold-light) !important;
        }

        .dropdown-menu {
            border: none;
            border-radius: 0;
            padding: 8px 0;
            box-shadow: 0 15px 35px rgba(7, 26, 43, 0.18);
        }

        .dropdown-item {
            font-size: 0.82rem;
            padding: 10px 20px;
            color: var(--charcoal);
        }

        .dropdown-item:hover {
            background: var(--ivory);
            color: var(--navy-midnight);
        }

        .navbar-toggler {
            border-color: rgba(255,255,255,0.25);
            border-radius: 0;
            margin: 10px 15px;
        }

        /* =====================================================
           PAGE HERO
        ===================================================== */

        .gallery-hero {
            position: relative;
            padding: 105px 20px 90px;
            background:
                linear-gradient(
                    rgba(7, 26, 43, 0.94),
                    rgba(7, 26, 43, 0.97)
                ),
                url('/images/gallery/campus.jpg') center/cover;
            color: #ffffff;
            text-align: center;
            overflow: hidden;
        }

        .gallery-hero::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border: 1px solid rgba(197,164,90,0.35);
            right: 8%;
            top: 25%;
            transform: rotate(45deg);
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 800px;
            margin: auto;
        }

        .eyebrow {
            display: inline-block;
            color: var(--gold-light);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.22em;
            margin-bottom: 15px;
        }

        .gallery-hero h1 {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(3rem, 7vw, 5.5rem);
            line-height: 0.95;
            font-weight: 500;
            margin-bottom: 25px;
        }

        .hero-line {
            width: 70px;
            height: 1px;
            background: var(--gold);
            margin: 0 auto 25px;
        }

        .gallery-hero p {
            max-width: 650px;
            margin: auto;
            color: rgba(255,255,255,0.78);
            font-size: 1rem;
            line-height: 1.9;
        }

        /* =====================================================
           INTRODUCTION
        ===================================================== */

        .gallery-introduction {
            max-width: 1050px;
            margin: auto;
            padding: 90px 20px 50px;
            text-align: center;
        }

        .section-eyebrow {
            color: var(--gold);
            text-transform: uppercase;
            letter-spacing: 0.18em;
            font-size: 0.72rem;
            font-weight: 600;
        }

        .gallery-introduction h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 3rem;
            color: var(--navy-midnight);
            font-weight: 600;
            margin: 12px 0 20px;
        }

        .gold-rule {
            width: 60px;
            height: 2px;
            background: var(--gold);
            margin: 0 auto 25px;
        }

        .gallery-introduction p {
            max-width: 760px;
            margin: auto;
            color: #5d6873;
            line-height: 1.9;
            font-size: 0.96rem;
        }

        /* =====================================================
           GALLERY FILTERS
        ===================================================== */

        .gallery-filters {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
            margin: 30px auto 55px;
            padding: 0 20px;
        }

        .filter-btn {
            border: 1px solid rgba(7, 26, 43, 0.2);
            background: transparent;
            color: var(--navy-midnight);
            padding: 10px 20px;
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .filter-btn:hover,
        .filter-btn.active {
            background: var(--navy-midnight);
            color: #ffffff;
            border-color: var(--navy-midnight);
        }

        /* =====================================================
           GALLERY
        ===================================================== */

        .gallery-section {
            max-width: 1150px;
            margin: auto;
            padding: 0 20px 100px;
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .gallery-card {
            position: relative;
            overflow: hidden;
            background: var(--navy-midnight);
            min-height: 310px;
            border: 1px solid rgba(197,164,90,0.25);
        }

        .gallery-card.large {
            grid-column: span 2;
        }

        .gallery-image {
            width: 100%;
            height: 100%;
            min-height: 310px;
            object-fit: cover;
            display: block;
            transition: transform 0.6s ease;
        }

        .gallery-card:hover .gallery-image {
            transform: scale(1.05);
        }

        .gallery-placeholder {
            min-height: 310px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--gold);
            text-align: center;
            padding: 30px;
            background:
                linear-gradient(
                    135deg,
                    var(--navy-midnight),
                    var(--navy-light)
                );
        }

        .gallery-placeholder i {
            font-size: 2rem;
            margin-bottom: 12px;
            display: block;
        }

        .gallery-overlay {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            padding: 28px 24px 22px;
            background: linear-gradient(
                transparent,
                rgba(7,26,43,0.96)
            );
            color: #ffffff;
        }

        .gallery-category {
            color: var(--gold-light);
            text-transform: uppercase;
            font-size: 0.65rem;
            letter-spacing: 0.15em;
        }

        .gallery-overlay h3 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.65rem;
            margin: 4px 0 0;
            font-weight: 500;
        }

        .gallery-overlay p {
            margin: 5px 0 0;
            font-size: 0.75rem;
            color: rgba(255,255,255,0.72);
        }

        /* =====================================================
           DETAILS SECTION
        ===================================================== */

        .gallery-details {
            background: #ffffff;
            padding: 90px 20px;
        }

        .details-container {
            max-width: 1050px;
            margin: auto;
        }

        .details-heading {
            text-align: center;
            margin-bottom: 50px;
        }

        .details-heading h2 {
            font-family: 'Cormorant Garamond', serif;
            color: var(--navy-midnight);
            font-size: 3rem;
            margin-top: 10px;
        }

        .detail-box {
            height: 100%;
            padding: 35px;
            border: 1px solid rgba(7,26,43,0.1);
            background: var(--cream);
            transition: all 0.3s ease;
        }

        .detail-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(7,26,43,0.08);
        }

        .detail-icon {
            width: 50px;
            height: 50px;
            border: 1px solid var(--gold);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--gold);
            margin-bottom: 20px;
        }

        .detail-box h3 {
            font-family: 'Cormorant Garamond', serif;
            color: var(--navy-midnight);
            font-size: 1.7rem;
        }

        .detail-box p {
            color: #68727c;
            line-height: 1.8;
            font-size: 0.9rem;
            margin-bottom: 0;
        }

        /* =====================================================
           CALL TO ACTION
        ===================================================== */

        .gallery-cta {
            padding: 90px 20px;
            background: var(--navy-midnight);
            text-align: center;
            color: #ffffff;
        }

        .gallery-cta h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 3.2rem;
            font-weight: 500;
            margin-bottom: 15px;
        }

        .gallery-cta p {
            color: rgba(255,255,255,0.7);
            max-width: 600px;
            margin: 0 auto 30px;
            line-height: 1.8;
        }

        .cta-button {
            display: inline-block;
            background: var(--gold);
            color: var(--navy-midnight);
            text-decoration: none;
            padding: 13px 27px;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .cta-button:hover {
            background: #ffffff;
            color: var(--navy-midnight);
        }

        /* =====================================================
           FOOTER
        ===================================================== */

        .site-footer {
            background: #04111d;
            color: #ffffff;
            padding: 70px 20px 25px;
            border-top: 1px solid rgba(197,164,90,0.25);
        }

        .footer-container {
            max-width: 1140px;
            margin: auto;
        }

        .footer-logo {
            width: 70px;
            height: 70px;
            object-fit: contain;
            margin-bottom: 18px;
        }

        .footer-school-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.6rem;
            margin-bottom: 10px;
        }

        .footer-description {
            color: rgba(255,255,255,0.58);
            line-height: 1.8;
            font-size: 0.85rem;
            max-width: 330px;
        }

        .footer-title {
            color: var(--gold-light);
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-size: 0.7rem;
            margin-bottom: 22px;
        }

        .footer-links {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .footer-links li {
            margin-bottom: 11px;
        }

        .footer-links a {
            color: rgba(255,255,255,0.65);
            text-decoration: none;
            font-size: 0.82rem;
            transition: color 0.3s ease;
        }

        .footer-links a:hover {
            color: var(--gold-light);
        }

        .footer-contact {
            color: rgba(255,255,255,0.65);
            font-size: 0.82rem;
            line-height: 1.9;
        }

        .footer-contact i {
            width: 20px;
            color: var(--gold);
        }

        .footer-bottom {
            margin-top: 50px;
            padding-top: 20px;
            border-top: 1px solid rgba(255,255,255,0.08);
            display: flex;
            justify-content: space-between;
            gap: 20px;
            color: rgba(255,255,255,0.42);
            font-size: 0.7rem;
        }

        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @media (max-width: 991px) {

            .header-contact {
                display: none;
            }

            .navbar-nav {
                display: block;
            }

            .navbar .nav-link {
                padding: 12px 15px !important;
            }

            .gallery-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .gallery-card.large {
                grid-column: span 2;
            }
        }

        @media (max-width: 767px) {

            .brand-title {
                font-size: 1rem;
            }

            .brand-location {
                font-size: 0.58rem;
            }

            .brand-logo {
                width: 48px;
                height: 48px;
                margin-right: 10px;
            }

            .gallery-hero {
                padding: 80px 20px 70px;
            }

            .gallery-introduction {
                padding-top: 65px;
            }

            .gallery-introduction h2,
            .details-heading h2 {
                font-size: 2.4rem;
            }

            .gallery-grid {
                grid-template-columns: 1fr;
            }

            .gallery-card.large {
                grid-column: span 1;
            }

            .gallery-cta h2 {
                font-size: 2.5rem;
            }

            .footer-bottom {
                flex-direction: column;
                text-align: center;
            }
        }

    </style>

</head>

