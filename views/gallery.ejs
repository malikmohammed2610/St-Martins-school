<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gallery | St. Martin's High School</title>

    <meta name="description"
        content="Explore the campus, academic activities, sports, events and student life at St. Martin's High School, Balanagar, Hyderabad.">

    <meta name="theme-color" content="#071A2B">

    <!-- FAVICON -->
    <link rel="icon" type="image/png" href="/images/Logo.png">

    <!-- GOOGLE FONTS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- BOOTSTRAP -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- FONT AWESOME -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- GLOBAL WEBSITE CSS -->
    <link rel="stylesheet" href="/css/style.css">

    <style>
        :root {
            --navy-midnight: #071A2B;
            --navy-light: #10283d;
            --gold: #C5A45A;
            --gold-light: #dfc982;
            --ivory: #F6F1E7;
            --cream: #faf7f0;
            --charcoal: #20252A;
            --muted: #6c757d;
        }

        .gallery-page {
            overflow: hidden;
            background: var(--ivory);
            color: var(--charcoal);
            font-family: 'Inter', sans-serif;
        }

        .gallery-page *,
        .gallery-page *::before,
        .gallery-page *::after {
            box-sizing: border-box;
        }

        .gallery-page img {
            max-width: 100%;
        }

        .gallery-page a {
            transition: color 0.3s ease, background 0.3s ease;
        }

        /* =========================================
           HERO
        ========================================= */

        .gallery-hero {
            position: relative;
            isolation: isolate;
            padding: 105px 20px 90px;
            background:
                linear-gradient(
                    rgba(7, 26, 43, 0.94),
                    rgba(7, 26, 43, 0.97)
                ),
                url('/images/story-image.png') center / cover no-repeat;
            color: #ffffff;
            text-align: center;
            overflow: hidden;
        }

        .gallery-hero::before {
            content: "";
            position: absolute;
            z-index: -1;
            width: 340px;
            height: 340px;
            left: -210px;
            bottom: -220px;
            border: 1px solid rgba(197, 164, 90, 0.35);
            transform: rotate(45deg);
        }

        .gallery-hero::after {
            content: "";
            position: absolute;
            z-index: -1;
            width: 180px;
            height: 180px;
            border: 1px solid rgba(197, 164, 90, 0.35);
            right: 8%;
            top: 25%;
            transform: rotate(45deg);
        }

        .gallery-hero-content {
            position: relative;
            z-index: 1;
            max-width: 800px;
            margin: auto;
        }

        .gallery-eyebrow {
            display: inline-block;
            color: var(--gold-light);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.22em;
            margin-bottom: 15px;
        }

        .gallery-hero h1 {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(3rem, 7vw, 5.5rem);
            line-height: 0.98;
            font-weight: 500;
            margin-bottom: 25px;
            color: #ffffff;
        }

        .gallery-hero-line {
            width: 70px;
            height: 1px;
            background: var(--gold);
            margin: 0 auto 25px;
        }

        .gallery-hero p {
            max-width: 650px;
            margin: auto;
            color: rgba(255, 255, 255, 0.78);
            font-size: 1rem;
            line-height: 1.9;
        }

        /* =========================================
           INTRODUCTION
        ========================================= */

        .gallery-introduction {
            max-width: 1050px;
            margin: auto;
            padding: 90px 20px 50px;
            text-align: center;
        }

        .gallery-section-eyebrow {
            color: var(--gold);
            text-transform: uppercase;
            letter-spacing: 0.18em;
            font-size: 0.72rem;
            font-weight: 600;
        }

        .gallery-introduction h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(2.3rem, 5vw, 3rem);
            color: var(--navy-midnight);
            font-weight: 600;
            margin: 12px 0 20px;
        }

        .gallery-gold-rule {
            width: 60px;
            height: 2px;
            background: var(--gold);
            margin: 0 auto 25px;
        }

        .gallery-introduction p {
            max-width: 760px;
            margin: auto;
            color: #5d6873;
            line-height: 1.9;
            font-size: 0.96rem;
        }

        /* =========================================
           FILTER BUTTONS
        ========================================= */

        .gallery-filters {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            margin: 30px auto 55px;
            padding: 0 20px;
        }

        .gallery-filter-btn {
            border: 1px solid rgba(7, 26, 43, 0.2);
            background: transparent;
            color: var(--navy-midnight);
            padding: 10px 20px;
            font-family: 'Inter', sans-serif;
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .gallery-filter-btn:hover,
        .gallery-filter-btn.active {
            background: var(--navy-midnight);
            color: #ffffff;
            border-color: var(--navy-midnight);
        }

        .gallery-filter-btn:focus-visible,
        .gallery-card:focus-visible {
            outline: 2px solid var(--gold);
            outline-offset: 4px;
        }

        /* =========================================
           GALLERY GRID
        ========================================= */

        .gallery-section {
            max-width: 1150px;
            margin: auto;
            padding: 0 20px 100px;
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 25px;
        }

        .gallery-card {
            position: relative;
            min-width: 0;
            min-height: 310px;
            overflow: hidden;
            background: var(--navy-midnight);
            border: 1px solid rgba(197, 164, 90, 0.25);
            isolation: isolate;
            animation: galleryFadeIn 0.5s ease both;
        }

        .gallery-card.large {
            grid-column: span 2;
        }

        .gallery-card[hidden] {
            display: none !important;
        }

        .gallery-image {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            min-height: 310px;
            object-fit: cover;
            display: block;
            transition: transform 0.7s ease;
        }

        .gallery-card:hover .gallery-image {
            transform: scale(1.055);
        }

        .gallery-placeholder {
            min-height: 310px;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--gold-light);
            text-align: center;
            padding: 30px;
            background:
                radial-gradient(
                    circle at 50% 35%,
                    rgba(197, 164, 90, 0.10),
                    transparent 50%
                ),
                linear-gradient(
                    135deg,
                    var(--navy-midnight),
                    var(--navy-light)
                );
        }

        .gallery-placeholder i {
            font-size: 2rem;
            margin-bottom: 15px;
            display: block;
            color: var(--gold);
        }

        .gallery-placeholder strong {
            display: block;
            font-size: 0.78rem;
            letter-spacing: 0.08em;
        }

        .gallery-placeholder small {
            display: block;
            margin-top: 8px;
            color: rgba(255, 255, 255, 0.55);
            font-size: 0.7rem;
        }

        .gallery-overlay {
            position: absolute;
            inset: auto 0 0;
            padding: 65px 24px 22px;
            background: linear-gradient(
                to bottom,
                transparent,
                rgba(7, 26, 43, 0.96)
            );
            color: #ffffff;
            pointer-events: none;
        }

        .gallery-category {
            color: var(--gold-light);
            text-transform: uppercase;
            font-size: 0.65rem;
            letter-spacing: 0.15em;
        }

        .gallery-overlay h3 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.65rem;
            margin: 4px 0 0;
            font-weight: 500;
            color: #ffffff;
        }

        .gallery-overlay p {
            margin: 5px 0 0;
            font-size: 0.75rem;
            line-height: 1.7;
            color: rgba(255, 255, 255, 0.72);
        }

        @keyframes galleryFadeIn {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* =========================================
           DETAILS SECTION
        ========================================= */

        .gallery-details {
            background: #ffffff;
            padding: 90px 20px;
        }

        .gallery-details-container {
            max-width: 1050px;
            margin: auto;
        }

        .gallery-details-heading {
            text-align: center;
            margin-bottom: 50px;
        }

        .gallery-details-heading h2 {
            font-family: 'Cormorant Garamond', serif;
            color: var(--navy-midnight);
            font-size: clamp(2.3rem, 5vw, 3rem);
            margin-top: 10px;
            font-weight: 600;
        }

        .gallery-detail-box {
            height: 100%;
            padding: 35px;
            border: 1px solid rgba(7, 26, 43, 0.1);
            background: var(--cream);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .gallery-detail-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(7, 26, 43, 0.08);
        }

        .gallery-detail-icon {
            width: 50px;
            height: 50px;
            border: 1px solid var(--gold);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--gold);
            margin-bottom: 20px;
        }

        .gallery-detail-box h3 {
            font-family: 'Cormorant Garamond', serif;
            color: var(--navy-midnight);
            font-size: 1.7rem;
            font-weight: 600;
        }

        .gallery-detail-box p {
            color: #68727c;
            line-height: 1.8;
            font-size: 0.9rem;
            margin-bottom: 0;
        }

        /* =========================================
           CALL TO ACTION
        ========================================= */

        .gallery-cta {
            padding: 90px 20px;
            background: var(--navy-midnight);
            text-align: center;
            color: #ffffff;
        }

        .gallery-cta h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(2.5rem, 5vw, 3.2rem);
            font-weight: 500;
            margin-bottom: 15px;
            color: #ffffff;
        }

        .gallery-cta p {
            color: rgba(255, 255, 255, 0.7);
            max-width: 600px;
            margin: 0 auto 30px;
            line-height: 1.8;
        }

        .gallery-cta-button {
            display: inline-block;
            background: var(--gold);
            color: var(--navy-midnight);
            text-decoration: none;
            padding: 13px 27px;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .gallery-cta-button:hover {
            background: #ffffff;
            color: var(--navy-midnight);
        }

        /* =========================================
           GALLERY FOOTER
           Retained from the original page.
        ========================================= */

        .gallery-page-footer {
            background: #04111d;
            color: #ffffff;
            padding: 70px 20px 25px;
            border-top: 1px solid rgba(197, 164, 90, 0.25);
        }

        .gallery-footer-container {
            max-width: 1140px;
            margin: auto;
        }

        .gallery-footer-logo {
            width: 70px;
            height: 70px;
            object-fit: contain;
            margin-bottom: 18px;
        }

        .gallery-footer-school-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.6rem;
            margin-bottom: 10px;
            color: #ffffff;
        }

        .gallery-footer-description {
            color: rgba(255, 255, 255, 0.58);
            line-height: 1.8;
            font-size: 0.85rem;
            max-width: 330px;
        }

        .gallery-footer-title {
            color: var(--gold-light);
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-size: 0.7rem;
            margin-bottom: 22px;
        }

        .gallery-footer-links {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .gallery-footer-links li {
            margin-bottom: 11px;
        }

        .gallery-footer-links a {
            color: rgba(255, 255, 255, 0.65);
            text-decoration: none;
            font-size: 0.82rem;
        }

        .gallery-footer-links a:hover {
            color: var(--gold-light);
        }

        .gallery-footer-contact {
            color: rgba(255, 255, 255, 0.65);
            font-size: 0.82rem;
            line-height: 1.9;
        }

        .gallery-footer-contact i {
            width: 20px;
            color: var(--gold);
        }

        .gallery-footer-bottom {
            margin-top: 50px;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            justify-content: space-between;
            gap: 20px;
            color: rgba(255, 255, 255, 0.42);
            font-size: 0.7rem;
        }

        /* =========================================
           RESPONSIVE
        ========================================= */

        @media (max-width: 991px) {
            .gallery-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .gallery-card.large {
                grid-column: span 2;
            }
        }

        @media (max-width: 767px) {
            .gallery-hero {
                padding: 80px 20px 70px;
            }

            .gallery-hero::after {
                width: 110px;
                height: 110px;
                right: -30px;
            }

            .gallery-introduction {
                padding-top: 65px;
            }

            .gallery-grid {
                grid-template-columns: minmax(0, 1fr);
                gap: 18px;
            }

            .gallery-card,
            .gallery-card.large {
                grid-column: span 1;
                min-height: 310px;
            }

            .gallery-placeholder {
                min-height: 310px;
            }

            .gallery-filters {
                gap: 8px;
                margin-bottom: 40px;
            }

            .gallery-filter-btn {
                padding: 9px 13px;
                font-size: 0.67rem;
            }

            .gallery-details {
                padding: 65px 20px;
            }

            .gallery-detail-box {
                padding: 28px;
            }

            .gallery-footer-bottom {
                flex-direction: column;
                text-align: center;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .gallery-page *,
            .gallery-page *::before,
            .gallery-page *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                scroll-behavior: auto !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>

<body>

    <div class="gallery-page">

        <!-- =========================================
             SHARED GLOBAL HEADER
             Uses views/partials/header.ejs
        ========================================= -->

        <%- include('partials/header') %>


        <!-- =========================================
             GALLERY HERO
        ========================================= -->

        <section class="gallery-hero">

            <div class="gallery-hero-content">

                <span class="gallery-eyebrow">
                    Visual Archive
                </span>

                <h1>Campus &amp; Student Life</h1>

                <div class="gallery-hero-line"></div>

                <p>
                    Explore the people, places, experiences and moments
                    that form the vibrant educational community of
                    St. Martin's High School, Balanagar.
                </p>

            </div>

        </section>


        <!-- =========================================
             INTRODUCTION
        ========================================= -->

        <section class="gallery-introduction">

            <span class="gallery-section-eyebrow">
                The St. Martin's Experience
            </span>

            <h2>Moments That Define Our School</h2>

            <div class="gallery-gold-rule"></div>

            <p>
                From the classrooms where curiosity begins to the
                playgrounds where teamwork develops, every part of
                St. Martin's High School contributes to the growth
                of our students. Our gallery offers a glimpse into
                academic life, sporting activities, celebrations,
                facilities and the everyday moments that make our
                school community special.
            </p>

        </section>


        <!-- =========================================
             FILTER BUTTONS
        ========================================= -->

        <div class="gallery-filters" role="group" aria-label="Filter gallery">

            <button type="button"
                class="gallery-filter-btn active"
                data-filter="all"
                aria-pressed="true">
                All
            </button>

            <button type="button"
                class="gallery-filter-btn"
                data-filter="campus"
                aria-pressed="false">
                Campus
            </button>

            <button type="button"
                class="gallery-filter-btn"
                data-filter="academics"
                aria-pressed="false">
                Academics
            </button>

            <button type="button"
                class="gallery-filter-btn"
                data-filter="sports"
                aria-pressed="false">
                Sports
            </button>

            <button type="button"
                class="gallery-filter-btn"
                data-filter="events"
                aria-pressed="false">
                Events
            </button>

            <button type="button"
                class="gallery-filter-btn"
                data-filter="student-life"
                aria-pressed="false">
                Student Life
            </button>

        </div>


        <!-- =========================================
             GALLERY GRID

             Replace each placeholder with your real photo.

             Example:
             <img src="/images/gallery/campus.jpg"
                  alt="St. Martin's school campus"
                  class="gallery-image">
        ========================================= -->

        <section class="gallery-section" aria-label="School photo gallery">

            <div class="gallery-grid">

                <!-- CAMPUS -->

                <article class="gallery-card large" data-category="campus">

                    <div class="gallery-placeholder">
                        <div>
                            <i class="fas fa-school" aria-hidden="true"></i>
                            <strong>ADD CAMPUS PHOTO</strong>
                            <small>/images/story-image.png</small>
                        </div>
                    </div>

                    <!-- To display a photo, replace the placeholder above with:
                    <img src="/images/story-image.png"
                         alt="St. Martin's High School campus"
                         class="gallery-image">
                    -->

                    <div class="gallery-overlay">
                        <span class="gallery-category">Campus</span>
                        <h3>Our School Campus</h3>
                        <p>
                            A welcoming environment designed for learning,
                            growth and discovery.
                        </p>
                    </div>

                </article>


                <!-- SPORTS -->

                <article class="gallery-card" data-category="sports">

                    <div class="gallery-placeholder">
                        <div>
                            <i class="fas fa-futbol" aria-hidden="true"></i>
                            <strong>ADD SPORTS PHOTO</strong>
                            <small>/images/gallery/sports.jpg</small>
                        </div>
                    </div>

                    <!-- Replace the placeholder with your sports image. -->

                    <div class="gallery-overlay">
                        <span class="gallery-category">Sports</span>
                        <h3>Sports &amp; Athletics</h3>
                        <p>
                            Building teamwork, discipline and confidence.
                        </p>
                    </div>

                </article>


                <!-- ACADEMICS -->

                <article class="gallery-card" data-category="academics">

                    <div class="gallery-placeholder">
                        <div>
                            <i class="fas fa-book-open" aria-hidden="true"></i>
                            <strong>ADD CLASSROOM PHOTO</strong>
                            <small>/images/gallery/classroom.jpg</small>
                        </div>
                    </div>

                    <div class="gallery-overlay">
                        <span class="gallery-category">Academics</span>
                        <h3>Learning Spaces</h3>
                        <p>
                            Classrooms that encourage curiosity and participation.
                        </p>
                    </div>

                </article>


                <!-- EVENTS -->

                <article class="gallery-card" data-category="events">

                    <div class="gallery-placeholder">
                        <div>
                            <i class="fas fa-calendar-days" aria-hidden="true"></i>
                            <strong>ADD EVENT PHOTO</strong>
                            <small>/images/gallery/events.jpg</small>
                        </div>
                    </div>

                    <div class="gallery-overlay">
                        <span class="gallery-category">Events</span>
                        <h3>School Celebrations</h3>
                        <p>
                            Important occasions and memorable celebrations.
                        </p>
                    </div>

                </article>


                <!-- STUDENT LIFE -->

                <article class="gallery-card large" data-category="student-life">

                    <div class="gallery-placeholder">
                        <div>
                            <i class="fas fa-users" aria-hidden="true"></i>
                            <strong>ADD STUDENT LIFE PHOTO</strong>
                            <small>/images/gallery/student-life.jpg</small>
                        </div>
                    </div>

                    <div class="gallery-overlay">
                        <span class="gallery-category">Student Life</span>
                        <h3>Life Beyond the Classroom</h3>
                        <p>
                            Experiences that help students discover their
                            interests, talents and potential.
                        </p>
                    </div>

                </article>


                <!-- FACILITIES -->

                <article class="gallery-card" data-category="campus">

                    <div class="gallery-placeholder">
                        <div>
                            <i class="fas fa-building" aria-hidden="true"></i>
                            <strong>ADD FACILITY PHOTO</strong>
                            <small>/images/gallery/facilities.jpg</small>
                        </div>
                    </div>

                    <div class="gallery-overlay">
                        <span class="gallery-category">Campus</span>
                        <h3>School Facilities</h3>
                        <p>
                            Purpose-built spaces supporting modern education.
                        </p>
                    </div>

                </article>


                <!-- CULTURAL ACTIVITIES -->

                <article class="gallery-card" data-category="events">

                    <div class="gallery-placeholder">
                        <div>
                            <i class="fas fa-masks-theater" aria-hidden="true"></i>
                            <strong>ADD CULTURAL PHOTO</strong>
                            <small>/images/gallery/cultural.jpg</small>
                        </div>
                    </div>

                    <div class="gallery-overlay">
                        <span class="gallery-category">Events</span>
                        <h3>Cultural Activities</h3>
                        <p>
                            Celebrating creativity, expression and talent.
                        </p>
                    </div>

                </article>


                <!-- STUDENT ACTIVITIES -->

                <article class="gallery-card" data-category="student-life">

                    <div class="gallery-placeholder">
                        <div>
                            <i class="fas fa-lightbulb" aria-hidden="true"></i>
                            <strong>ADD ACTIVITY PHOTO</strong>
                            <small>/images/gallery/activities.jpg</small>
                        </div>
                    </div>

                    <div class="gallery-overlay">
                        <span class="gallery-category">Student Life</span>
                        <h3>Student Activities</h3>
                        <p>
                            Opportunities to explore interests beyond academics.
                        </p>
                    </div>

                </article>

            </div>

        </section>


        <!-- =========================================
             GALLERY DETAILS
        ========================================= -->

        <section class="gallery-details">

            <div class="gallery-details-container">

                <div class="gallery-details-heading">

                    <span class="gallery-section-eyebrow">
                        More Than a Photograph
                    </span>

                    <h2>A School Full of Experiences</h2>

                    <div class="gallery-gold-rule"></div>

                </div>

                <div class="row g-4">

                    <!-- ACADEMIC LIFE -->

                    <div class="col-lg-4 col-md-6">

                        <div class="gallery-detail-box">

                            <div class="gallery-detail-icon">
                                <i class="fas fa-graduation-cap"
                                    aria-hidden="true"></i>
                            </div>

                            <h3>Academic Life</h3>

                            <p>
                                Our classrooms and learning spaces encourage
                                students to ask questions, develop knowledge
                                and build the confidence required for lifelong
                                learning.
                            </p>

                        </div>

                    </div>


                    <!-- SPORTS -->

                    <div class="col-lg-4 col-md-6">

