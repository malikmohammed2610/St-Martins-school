    <!-- =====================================================
         GALLERY
         
         TO ADD YOUR OWN PHOTO:
         
         Put the image inside:
         public/images/gallery/
         
         Example:
         public/images/gallery/campus.jpg
         
         Then replace the placeholder with:
         
         <img src="/images/gallery/campus.jpg"
              alt="School Campus"
              class="gallery-image">
    ===================================================== -->

    <section class="gallery-section">

        <div class="gallery-grid">


            <!-- CAMPUS -->

            <div class="gallery-card large" data-category="campus">

                <div class="gallery-placeholder">

                    <div>
                        <i class="fas fa-school"></i>

                        <strong>
                            ADD CAMPUS PHOTO
                        </strong>

                        <small style="display:block;margin-top:8px;">
                            /images/gallery/campus.jpg
                        </small>

                    </div>

                </div>

                <div class="gallery-overlay">

                    <span class="gallery-category">
                        Campus
                    </span>

                    <h3>
                        Our School Campus
                    </h3>

                    <p>
                        A welcoming environment designed for learning,
                        growth and discovery.
                    </p>

                </div>

            </div>


            <!-- SPORTS -->

            <div class="gallery-card" data-category="sports">

                <div class="gallery-placeholder">

                    <div>

                        <i class="fas fa-futbol"></i>

                        <strong>
                            ADD SPORTS PHOTO
                        </strong>

                        <small style="display:block;margin-top:8px;">
                            /images/gallery/sports.jpg
                        </small>

                    </div>

                </div>

                <div class="gallery-overlay">

                    <span class="gallery-category">
                        Sports
                    </span>

                    <h3>
                        Sports &amp; Athletics
                    </h3>

                    <p>
                        Building teamwork, discipline and confidence.
                    </p>

                </div>

            </div>


            <!-- ACADEMICS -->

