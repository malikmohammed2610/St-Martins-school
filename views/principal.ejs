<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Principal & Management | St. Martin's High School, Balanagar</title>

    <meta name="description"
        content="Meet the Principal and Management of St. Martin's High School, Balanagar, Hyderabad.">

    <link rel="icon" type="image/png" href="/images/logo.png">

    <!-- =========================================================
         GOOGLE FONTS
    ========================================================== -->

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">


    <!-- =========================================================
         FONT AWESOME
    ========================================================== -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">


    <!-- =========================================================
         BOOTSTRAP
    ========================================================== -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">


    <!-- =========================================================
         PAGE STYLES
    ========================================================== -->

    <style>

        :root {

            --navy: #071A2B;
            --navy-light: #10283D;

            --gold: #C5A45A;
            --gold-light: #DFC982;

            --ivory: #F7F3EB;
            --white: #FFFFFF;

            --text: #303944;
            --muted: #727C86;

            --border: rgba(7, 26, 43, 0.10);

        }


        * {
            box-sizing: border-box;
        }


        html {
            scroll-behavior: smooth;
        }


        body {

            margin: 0;

            padding: 0;

            font-family: 'Inter', sans-serif;

            color: var(--text);

            background: var(--ivory);

            overflow-x: hidden;

        }


        a {
            transition: all 0.3s ease;
        }


        .font-serif {
            font-family: 'Cormorant Garamond', serif;
        }


        /* =====================================================
           HEADER
        ===================================================== */

        .school-header {

            background: rgba(255,255,255,0.98);

            border-bottom: 1px solid var(--border);

            position: sticky;

            top: 0;

            z-index: 1050;

            backdrop-filter: blur(12px);

        }


        .header-container {

            max-width: 1200px;

            margin: auto;

            padding: 15px 22px;

        }


        .school-brand {

            text-decoration: none;

            display: flex;

            align-items: center;

        }


        .school-logo {

            width: 62px;

            height: 62px;

            object-fit: contain;

            margin-right: 15px;

        }


        .school-name {

            margin: 0;

            color: var(--navy);

            font-family: 'Cormorant Garamond', serif;

            font-size: 1.35rem;

            font-weight: 700;

            letter-spacing: 0.02em;

        }


        .school-location {

            color: #737B84;

            font-size: 0.68rem;

            letter-spacing: 0.17em;

            margin-top: 2px;

        }


        .header-phone {

            color: #68737D;

            font-size: 0.84rem;

        }


        .header-phone i {

            color: var(--gold);

        }


        .teacher-login {

            border: 1px solid var(--navy);

            color: var(--navy);

            text-decoration: none;

            padding: 9px 17px;

            font-size: 0.72rem;

            letter-spacing: 0.10em;

            text-transform: uppercase;

            transition: all 0.3s ease;

        }


        .teacher-login:hover {

            background: var(--navy);

            color: white;

        }


        /* =====================================================
           NAVIGATION
        ===================================================== */

        .main-nav {

            background: var(--navy);

            padding: 0;

            position: relative;

            z-index: 1040;

        }


        .main-nav .container {

            max-width: 1200px;

        }


        .main-nav .navbar-nav {

            width: 100%;

            justify-content: center;

        }


        .main-nav .nav-link {

            color: rgba(255,255,255,0.86) !important;

            font-size: 0.72rem;

            text-transform: uppercase;

            letter-spacing: 0.08em;

            padding: 15px 11px !important;

        }


        .main-nav .nav-link:hover,

        .main-nav .nav-link.active {

            color: var(--gold-light) !important;

        }


        .navbar-toggler {

            border: 1px solid rgba(255,255,255,0.3);

            border-radius: 0;

        }


        .navbar-toggler:focus {

            box-shadow: none;

        }


        /* =====================================================
           PAGE HERO
        ===================================================== */

        .page-hero {

            position: relative;

            min-height: 430px;

            display: flex;

            align-items: center;

            justify-content: center;

            text-align: center;

            overflow: hidden;

            background:

                linear-gradient(
                    rgba(7,26,43,0.90),
                    rgba(7,26,43,0.94)
                ),

                url('/images/school-campus.jpg');

            background-size: cover;

            background-position: center;

        }


        .page-hero::after {

            content: "";

            position: absolute;

            left: 50%;

            bottom: 0;

            transform: translateX(-50%);

            width: 120px;

            height: 3px;

            background: var(--gold);

        }


        .hero-content {

            position: relative;

            z-index: 2;

            max-width: 900px;

            padding: 70px 20px;

        }


        .hero-eyebrow {

            color: var(--gold-light);

            font-size: 0.75rem;

            letter-spacing: 0.25em;

            text-transform: uppercase;

            font-weight: 600;

            margin-bottom: 18px;

        }


        .hero-title {

            color: white;

            font-family: 'Cormorant Garamond', serif;

            font-size: clamp(3.4rem, 7vw, 6rem);

            line-height: 0.95;

            font-weight: 500;

            margin-bottom: 25px;

        }


        .hero-description {

            color: rgba(255,255,255,0.75);

            max-width: 720px;

            margin: auto;

            font-size: 0.95rem;

            line-height: 1.9;

            font-weight: 300;

        }


        /* =====================================================
           SECTION
        ===================================================== */

        .section {

            padding: 100px 0;

        }


        .section-heading {

            text-align: center;

            max-width: 780px;

            margin: 0 auto 60px;

        }


        .section-label {

            color: var(--gold);

            font-size: 0.70rem;

            letter-spacing: 0.25em;

            text-transform: uppercase;

            font-weight: 700;

            margin-bottom: 12px;

        }


        .section-title {

            color: var(--navy);

            font-family: 'Cormorant Garamond', serif;

            font-size: 3.5rem;

            line-height: 1;

            font-weight: 600;

            margin-bottom: 20px;

        }


        .section-description {

            color: var(--muted);

            line-height: 1.9;

            font-size: 0.92rem;

        }


        /* =====================================================
           PRINCIPAL
        ===================================================== */

        .principal-section {

            background: var(--white);

        }


        .principal-wrapper {

            max-width: 1100px;

            margin: auto;

        }


        .principal-image-wrapper {

            position: relative;

            padding: 14px;

            background: var(--ivory);

        }


        .principal-image-wrapper::before {

            content: "";

            position: absolute;

            top: -10px;

            left: -10px;

            width: 75px;

            height: 75px;

            border-top: 2px solid var(--gold);

            border-left: 2px solid var(--gold);

        }


        .principal-image-wrapper::after {

            content: "";

            position: absolute;

            right: -10px;

            bottom: -10px;

            width: 75px;

            height: 75px;

            border-right: 2px solid var(--gold);

            border-bottom: 2px solid var(--gold);

        }


        .principal-image {

            width: 100%;

            height: 570px;

            object-fit: cover;

            display: block;

            background: #e9e4d9;

        }


        .principal-content {

            padding: 25px 10px 25px 35px;

        }


        .principal-role {

            color: var(--gold);

            font-size: 0.72rem;

            text-transform: uppercase;

            letter-spacing: 0.22em;

            font-weight: 700;

            margin-bottom: 12px;

        }


        .principal-name {

            color: var(--navy);

            font-family: 'Cormorant Garamond', serif;

            font-size: 3.4rem;

            line-height: 1;

            margin-bottom: 25px;

            font-weight: 600;

        }


        .gold-line {

            width: 60px;

            height: 2px;

            background: var(--gold);

            margin-bottom: 25px;

        }


        .principal-message {

            color: #59636D;

            font-size: 0.95rem;

            line-height: 2;

            margin-bottom: 25px;

        }


        .principal-note {

            padding: 22px 25px;

            background: var(--ivory);

            border-left: 3px solid var(--gold);

            color: var(--navy);

            font-family: 'Cormorant Garamond', serif;

            font-size: 1.25rem;

            font-style: italic;

            line-height: 1.6;

        }


        /* =====================================================
           MANAGEMENT SECTION
        ===================================================== */

        .management-section {

            background: var(--ivory);

        }


        .management-grid {

            max-width: 1150px;

            margin: auto;

        }


        .management-card {

            height: 100%;

            background: white;

            border: 1px solid rgba(7,26,43,0.07);

            transition: all 0.4s ease;

            overflow: hidden;

            position: relative;

        }


        .management-card:hover {

            transform: translateY(-8px);

            box-shadow: 0 20px 50px rgba(7,26,43,0.12);

        }


        .management-photo-wrapper {

            position: relative;

            background: #eee9df;

            overflow: hidden;

        }


        .management-photo {

            width: 100%;

            height: 390px;

            object-fit: cover;

            object-position: center top;

            display: block;

            transition: transform 0.6s ease;

        }


        .management-card:hover .management-photo {

            transform: scale(1.035);

        }


        .management-photo-wrapper::after {

            content: "";

            position: absolute;

            left: 0;

            right: 0;

            bottom: 0;

            height: 35%;

            background: linear-gradient(
                transparent,
                rgba(7,26,43,0.20)
            );

            pointer-events: none;

        }


        .management-body {

            padding: 30px 30px 35px;

        }


        .management-role {

            color: var(--gold);

            font-size: 0.66rem;

            font-weight: 700;

            text-transform: uppercase;

            letter-spacing: 0.18em;

            margin-bottom: 10px;

        }


        .management-name {

            color: var(--navy);

            font-family: 'Cormorant Garamond', serif;

            font-size: 2rem;

            line-height: 1.05;

            font-weight: 600;

            margin-bottom: 18px;

        }


        .management-divider {

            width: 42px;

            height: 2px;

            background: var(--gold);

            margin-bottom: 20px;

        }


        .management-bio {

            color: #68727C;

            font-size: 0.83rem;

            line-height: 1.85;

            margin: 0;

        }


        /* =====================================================
           LEADERSHIP STATEMENT
        ===================================================== */

        .leadership-statement {

            background: var(--navy);

            color: white;

            text-align: center;

            padding: 90px 20px;

        }


        .statement-inner {

            max-width: 850px;

            margin: auto;

        }


        .statement-mark {

            color: var(--gold);

            font-family: Georgia, serif;

            font-size: 4rem;

            line-height: 0.5;

            margin-bottom: 25px;

        }


        .statement-text {

            color: rgba(255,255,255,0.85);

            font-family: 'Cormorant Garamond', serif;

            font-size: 2rem;

            line-height: 1.45;

            font-weight: 400;

        }


        .statement-caption {

            color: var(--gold-light);

            font-size: 0.67rem;

            text-transform: uppercase;

            letter-spacing: 0.22em;

            margin-top: 25px;

        }


        /* =====================================================
           FOOTER
        ===================================================== */

        .school-footer {

            background: #05131F;

            color: white;

            padding: 75px 0 25px;

        }


        .footer-container {

            max-width: 1150px;

            margin: auto;

        }


        .footer-brand {

            font-family: 'Cormorant Garamond', serif;

            color: white;

            font-size: 1.65rem;

            font-weight: 600;

            margin-bottom: 15px;

        }


        .footer-description {

            color: #8E9BA7;

            font-size: 0.82rem;

            line-height: 1.9;

            max-width: 350px;

        }


        .footer-heading {

            color: white;

            font-family: 'Cormorant Garamond', serif;

            font-size: 1.35rem;

            margin-bottom: 20px;

        }


        .footer-links {

            list-style: none;

            padding: 0;

            margin: 0;

        }


        .footer-links li {

            margin-bottom: 9px;

        }


        .footer-links a {

            color: #8E9BA7;

            text-decoration: none;

            font-size: 0.78rem;

        }


        .footer-links a:hover {

            color: var(--gold-light);

            padding-left: 4px;

        }


        .footer-contact {

            color: #8E9BA7;

            font-size: 0.80rem;

            line-height: 1.8;

        }


        .footer-contact i {

            color: var(--gold);

            width: 22px;

        }


        .footer-divider {

            border: 0;

            border-top: 1px solid rgba(255,255,255,0.09);

            margin: 45px 0 22px;

        }


        .footer-bottom {

            color: #697682;

            font-size: 0.70rem;

        }


        .footer-bottom a {

            color: var(--gold-light);

            text-decoration: none;

        }


        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @media (max-width: 991px) {

            .main-nav .nav-link {

                padding: 12px 15px !important;

            }


            .principal-content {

                padding: 40px 0 0;

            }


            .principal-image {

                height: 500px;

            }

        }


        @media (max-width: 767px) {

            .header-container {

                padding: 12px 15px;

            }


            .school-logo {

                width: 52px;

                height: 52px;

                margin-right: 10px;

            }


            .school-name {

                font-size: 1.05rem;

            }


            .school-location {

                font-size: 0.55rem;

            }


            .page-hero {

                min-height: 390px;

            }


            .hero-title {

                font-size: 3.5rem;

            }


            .section {

                padding: 70px 0;

            }


            .section-title {

                font-size: 2.8rem;

            }


            .principal-image {

                height: 430px;

            }


            .principal-name {

                font-size: 2.8rem;

            }


            .management-photo {

                height: 420px;

            }


            .statement-text {

                font-size: 1.55rem;

            }

        }

    </style>

</head>


