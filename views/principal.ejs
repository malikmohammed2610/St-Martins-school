<!-- =========================================================
     HERO
========================================================== -->

<section class="page-hero">

    <div class="hero-content">

        <div class="hero-eyebrow">

            Leadership • Vision • Excellence

        </div>


        <h1 class="hero-title">

            Principal & Management

        </h1>


        <p class="hero-description">

            The strength of an institution lies in the vision,
            dedication and leadership of those who guide it.
            Meet the individuals who help shape the educational
            journey of St. Martin's High School.

        </p>

    </div>

</section>



<!-- =========================================================
     PRINCIPAL
========================================================== -->

<section class="section principal-section">

    <div class="container">

        <div class="section-heading">

            <div class="section-label">

                The Principal

            </div>


            <h2 class="section-title">

                Leadership Begins<br>
                With Purpose

            </h2>


            <p class="section-description">

                At St. Martin's High School, the Principal plays
                a central role in creating an environment where
                students are encouraged to learn, grow and
                develop into responsible individuals.

            </p>

        </div>


        <div class="principal-wrapper">

            <div class="row align-items-center g-5">


                <!-- PRINCIPAL PHOTO -->

                <div class="col-lg-6">

                    <div class="principal-image-wrapper">

                        <!--
                            IMPORTANT:
                            Put the Principal's photograph here:

                            public/images/principal.jpg

                            If your image has a different name,
                            simply change the src below.
                        -->

                        <img
                            src="/images/principal.jpg"
                            alt="Principal of St. Martin's High School"
                            class="principal-image"
                            onerror="this.src='/images/logo.png';">

                    </div>

                </div>


                <!-- PRINCIPAL INFORMATION -->

                <div class="col-lg-6">

                    <div class="principal-content">

                        <div class="principal-role">

                            Principal

                        </div>


                        <h2 class="principal-name">

                            Our Principal

                        </h2>


                        <div class="gold-line"></div>


                        <p class="principal-message">

                            The Principal provides academic and
                            administrative leadership while
                            working closely with teachers,
                            students and parents to maintain
                            a positive and purposeful school
                            environment.

                        </p>


                        <p class="principal-message">

                            With a commitment to academic
                            excellence, discipline, character
                            development and the overall
                            wellbeing of students, the school
                            leadership strives to prepare every
                            learner for the opportunities and
                            responsibilities of the future.

                        </p>


                        <div class="principal-note">

                            "Education is not only about what
                            students learn, but also about
                            who they become."

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =========================================================
     MANAGEMENT
========================================================== -->

<section class="section management-section">

    <div class="container">


        <div class="section-heading">

            <div class="section-label">

                The Management

            </div>


            <h2 class="section-title">

                The People Behind<br>
                The Vision

            </h2>


            <p class="section-description">

                St. Martin's High School is guided by a
                committed management team whose experience,
                vision and dedication continue to contribute
                to the development of the institution.

            </p>

        </div>



        <div class="row g-4 management-grid">


            <!-- =================================================
                 MALLA REDDY
            ================================================== -->

            <div class="col-lg-6">

                <article class="management-card">

                    <div class="management-photo-wrapper">

                        <img
                            src="https://media.base44.com/images/public/6a464a4d03da5966a79b6c2c/a09ec53a6_Malla-Reddy-Sir.jpg"
                            alt="Sri CH. Malla Reddy"
                            class="management-photo"
                            loading="lazy">

                    </div>


                    <div class="management-body">

                        <div class="management-role">

                            Secretary & Correspondent

                        </div>


                        <h3 class="management-name">

                            Sri CH. Malla Reddy

                        </h3>


                        <div class="management-divider"></div>


                        <p class="management-bio">

                            A visionary leader and Hon'ble MLA of
                            Medchal Constituency, Sri CH. Malla
                            Reddy has been associated with
                            education for over three decades.

                            <br><br>

                            He is a founder member of St. Martin's
                            Educational Society and the Founder
                            Chairman of the Malla Reddy Group of
                            Institutions.

