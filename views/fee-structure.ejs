            </ul>

        </div>

    </div>

</nav>



<!-- =========================================================
     MAIN
========================================================= -->

<main class="fee-page">


    <!-- PAGE INTRO -->

    <span class="eyebrow">
        Financial Transparency
    </span>


    <h1 class="page-title">
        Fee Structure
    </h1>


    <div class="gold-rule"></div>


    <p class="page-intro">

        St. Martin's High School believes in maintaining clarity
        and transparency regarding school fees. The fee structure
        is designed to support the academic programme, learning
        resources, campus facilities, student activities, and
        overall educational experience provided by the school.

    </p>



    <!-- =====================================================
         IMPORTANT NOTICE
    ===================================================== -->

    <div class="fee-notice">

        <div class="fee-notice-icon">

            <i class="fas fa-circle-info"></i>

        </div>


        <div>

            <h3>
                Official Fee Information
            </h3>

            <p>

                The amounts displayed in the tables below are
                placeholders until the school's official fee
                schedule is entered. Please verify the final
                fee amount with the school administration before
                making any payment.

            </p>

        </div>

    </div>



    <!-- =====================================================
         ANNUAL SCHOOL FEES
    ===================================================== -->

    <div class="section-heading">

        <span class="section-number">
            01 · Annual Fees
        </span>

        <h2>
            School Fee Structure
        </h2>

    </div>


    <div class="fee-table-wrapper">

        <table class="fee-table">

            <thead>

                <tr>

                    <th>
                        Class / Grade
                    </th>

                    <th>
                        Annual Tuition Fee
                    </th>

                    <th>
                        Other Charges
                    </th>

                    <th>
                        Total
                    </th>

                </tr>

            </thead>


            <tbody>

                <tr>

                    <td class="fee-class">
                        Nursery
                    </td>

                    <td class="fee-placeholder">
                        To be updated
                    </td>

                    <td class="fee-placeholder">
                        To be updated
                    </td>

                    <td class="fee-placeholder">
                        To be updated
                    </td>

                </tr>


                <tr>

                    <td class="fee-class">
                        LKG
                    </td>

                    <td class="fee-placeholder">
                        To be updated
                    </td>

                    <td class="fee-placeholder">
