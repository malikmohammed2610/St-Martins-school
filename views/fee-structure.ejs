                        </li>

                        <li>
                            <a
                                class="dropdown-item"
                                href="/educational-society">

                                Educational Society

                            </a>
                        </li>

                        <li>
                            <a
                                class="dropdown-item"
                                href="/disclosure">

                                Disclosure

                            </a>
                        </li>

                    </ul>

                </li>



                <!-- FACILITIES -->

                <li class="nav-item">

                    <a
                        class="nav-link"
                        href="/facilities">

                        FACILITIES

                    </a>

                </li>



                <!-- ACADEMICS -->

                <li class="nav-item dropdown">

                    <a
                        class="nav-link dropdown-toggle"
                        href="#"
                        role="button"
                        data-bs-toggle="dropdown">

                        ACADEMICS

                    </a>


                    <ul class="dropdown-menu">

                        <li>

                            <a
                                class="dropdown-item"
                                href="/academics/curriculum">

                                Curriculum

                            </a>

                        </li>

                    </ul>

                </li>



                <!-- STUDENT LIFE -->

                <li class="nav-item">

