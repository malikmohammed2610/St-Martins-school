<section class="hero">
    <div class="container">
        <div class="hero-content">
            <div class="hero-label">
                Life Beyond The Classroom
            </div>

            <h1>
                Student<br>
                <span>Life</span>
            </h1>

            <p>
                At St. Martin's High School, education extends far
                beyond textbooks. Our students discover their talents,
                develop confidence, build friendships and create
                memories that stay with them for life.
            </p>
        </div>
    </div>
</section>


<!-- =========================================================
     INTRODUCTION
========================================================= -->
<section class="intro-section">
    <div class="container">
        <div class="section-label">
            A Complete School Experience
        </div>

        <h2 class="section-title">
            Growing Beyond<br>
            <span>Academics</span>
        </h2>

        <p class="intro-text">
            Student life at St. Martin's High School is built around
            discovery, participation and personal growth. From sports
            and cultural activities to celebrations, competitions and
            collaborative experiences, every opportunity is designed
            to help our students become confident, responsible and
            well-rounded individuals.
            <br><br>
            We believe that some of the most important lessons in a
            student's life happen outside the classroom — on the
            playing field, on the stage, during teamwork and in the
            friendships they build along the way.
        </p>
    </div>
</section>


<!-- =========================================================
     SPORTS FEATURE
========================================================= -->
<section class="feature-section">
    <div class="container">
        <div class="feature-box">
            <div class="row g-0 align-items-stretch">
                <!-- IMAGE -->
                <div class="col-lg-6">
                    <div class="feature-image">
                        <img
                            src="/images/spiritofsport.png"
                            alt="The Spirit Of Sport"
                        >
                    </div>
                </div>

                <!-- CONTENT -->
                <div class="col-lg-6">
                    <div class="feature-content">
                        <div class="section-label">
                            Active & Sportive
                        </div>

                        <h2 class="feature-title">
                            The Spirit<br>
                            Of <span>Sport</span>
                        </h2>

                        <p>
                            Sport is an important part of student life
                            at St. Martin's High School. It teaches
                            discipline, teamwork, perseverance and the
                            importance of giving your best.
                        </p>

                        <p>
                            Our sporting activities encourage students
                            to remain active while developing leadership,
                            confidence and a healthy competitive spirit.
                        </p>

                        <ul class="feature-list">
                            <li>
                                <i class="fa-solid fa-check"></i>
                                <span>Encouraging teamwork and leadership</span>
                            </li>
                            <li>
                                <i class="fa-solid fa-check"></i>
                                <span>Building confidence through participation</span>
                            </li>
                            <li>
                                <i class="fa-solid fa-check"></i>
                                <span>Developing discipline and perseverance</span>
                            </li>
                            <li>
                                <i class="fa-solid fa-check"></i>
                                <span>Promoting an active and healthy lifestyle</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- =========================================================
     STUDENT LIFE CARDS
========================================================= -->
<section class="life-section">
    <div class="container">
        <div class="text-center mb-5">
            <div class="section-label justify-content-center">
                Discover • Participate • Grow
            </div>

            <h2 class="section-title">
                More Than A <span>Classroom</span>
            </h2>
        </div>

        <div class="row g-4">
            <!-- CARD 1 -->
            <div class="col-lg-4 col-md-6">
                <div class="life-card">
                    <div class="life-icon">
                        <i class="fa-solid fa-trophy"></i>
                    </div>
                    <h3>Competitions</h3>
                    <p>
                        Students are encouraged to participate in
                        academic, sporting and creative competitions,
                        giving them opportunities to challenge
                        themselves and showcase their talents.
                    </p>
                </div>
            </div>

            <!-- CARD 2 -->
            <div class="col-lg-4 col-md-6">
                <div class="life-card">
                    <div class="life-icon">
                        <i class="fa-solid fa-masks-theater"></i>
                    </div>
                    <h3>Cultural Activities</h3>
                    <p>
                        Cultural programmes and celebrations provide
                        students with opportunities to express
                        creativity, appreciate traditions and perform
                        with confidence.
                    </p>
                </div>
            </div>

            <!-- CARD 3 -->
            <div class="col-lg-4 col-md-6">
                <div class="life-card">
                    <div class="life-icon">
                        <i class="fa-solid fa-people-group"></i>
                    </div>
                    <h3>Teamwork</h3>
                    <p>
                        Collaborative activities help students
                        understand the value of communication,
                        cooperation, respect and shared responsibility.
                    </p>
                </div>
            </div>

            <!-- CARD 4 -->
            <div class="col-lg-4 col-md-6">
                <div class="life-card">
                    <div class="life-icon">
                        <i class="fa-solid fa-lightbulb"></i>
                    </div>
                    <h3>Creativity</h3>
                    <p>
                        Students are given opportunities to explore
                        their imagination through creative projects,
                        presentations and artistic expression.
                    </p>
                </div>
            </div>

            <!-- CARD 5 -->
            <div class="col-lg-4 col-md-6">
                <div class="life-card">
                    <div class="life-icon">
                        <i class="fa-solid fa-handshake"></i>
                    </div>
                    <h3>Leadership</h3>
                    <p>
                        School activities help students develop
                        responsibility, confidence and the ability
                        to lead and support others.
                    </p>
                </div>
            </div>

            <!-- CARD 6 -->
            <div class="col-lg-4 col-md-6">
                <div class="life-card">
                    <div class="life-icon">
                        <i class="fa-solid fa-heart"></i>
                    </div>
                    <h3>Friendships</h3>
                    <p>
                        Shared experiences create lasting friendships
                        and help students develop a strong sense of
                        belonging within the school community.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- =========================================================
     QUOTE
========================================================= -->
<section class="quote-section">
    <div class="container">
        <div class="quote-content">
            <div class="quote-icon">
                <i class="fa-solid fa-quote-left"></i>
            </div>
            <div class="quote-text">
                "Education is not only about what students learn,
                but also about who they become."
            </div>
            <div class="quote-author">
                St. Martin's High School
            </div>
        </div>
    </div>
</section>


<!-- =========================================================
     CTA
