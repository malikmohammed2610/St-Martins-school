    <script>
        /* =========================================
           SCROLL REVEAL
           Falls back to visible content if the
           IntersectionObserver API is unavailable.
        ========================================= */

        (function () {
            const page = document.querySelector(".student-life-page");

            if (!page) return;

            const revealItems = page.querySelectorAll(".sl-reveal");

            if (!("IntersectionObserver" in window)) {
                revealItems.forEach(function (item) {
                    item.classList.add("sl-visible");
                });
                return;
            }

            page.classList.add("sl-js");

            const observer = new IntersectionObserver(
                function (entries, currentObserver) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("sl-visible");
                            currentObserver.unobserve(entry.target);
                        }
                    });
                },
                {
                    threshold: 0.12,
                    rootMargin: "0px 0px -35px 0px"
                }
            );

            revealItems.forEach(function (item) {
                observer.observe(item);
            });
        })();
    </script>

