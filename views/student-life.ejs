<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Life | St. Martin's High School, Balanagar</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/logo.png">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <style>
        /* =========================================================
           ROOT
        ========================================================= */
        :root {
            --navy: #071A2B;
            --navy-midnight: #05131F;
            --navy-light: #10283D;
            --gold: #C5A45A;
            --gold-light: #DFC982;
            --ivory: #F7F3EB;
            --cream: #F2ECE0;
            --white: #FFFFFF;
            --text: #303944;
            --muted: #727C86;
            --border: rgba(7, 26, 43, 0.10);
        }

        /* =========================================================
           GLOBAL
        ========================================================= */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: "Inter", sans-serif;
            color: var(--text);
            background: var(--ivory);
            line-height: 1.7;
            overflow-x: hidden;
        }

        /* =========================================================
           HERO
        ========================================================= */
        .hero {
            position: relative;
            min-height: 560px;
            display: flex;
            align-items: center;
            background:
                linear-gradient(
                    90deg,
                    rgba(5, 19, 31, 0.94),
                    rgba(5, 19, 31, 0.68),
                    rgba(5, 19, 31, 0.28)
                ),
                url("/images/student-life.jpg");
            background-size: cover;
            background-position: center;
        }

        .hero-content {
            max-width: 760px;
            padding: 90px 0;
        }

        .hero-label {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 22px;
            color: var(--gold-light);
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .hero-label::before {
            content: "";
            width: 38px;
            height: 1px;
            background: var(--gold);
        }

        .hero h1 {
            margin-bottom: 20px;
            font-family: "Cormorant Garamond", serif;
            font-size: clamp(55px, 7vw, 92px);
            font-weight: 500;
            line-height: 0.95;
            color: var(--white);
        }

        .hero h1 span {
            color: var(--gold-light);
        }

        .hero p {
            max-width: 650px;
            color: rgba(255, 255, 255, 0.78);
            font-size: 16px;
            font-weight: 300;
            line-height: 1.9;
        }

        /* =========================================================
           INTRODUCTION
        ========================================================= */
        .intro-section {
            padding: 110px 0;
            background: var(--ivory);
        }

        .section-label {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 18px;
            color: var(--gold);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .section-label::before {
            content: "";
            width: 36px;
            height: 1px;
            background: var(--gold);
        }

        .section-title {
            margin-bottom: 25px;
            font-family: "Cormorant Garamond", serif;
            font-size: clamp(42px, 5vw, 64px);
            font-weight: 500;
            line-height: 1;
            color: var(--navy);
        }

        .section-title span {
            color: var(--gold);
        }

        .intro-text {
            max-width: 850px;
            color: var(--muted);
            font-size: 16px;
            line-height: 1.9;
        }

        /* =========================================================
           SPORTS FEATURE
        ========================================================= */
        .feature-section {
            padding: 110px 0;
            background: var(--cream);
        }

        .feature-box {
            background: var(--white);
            border: 1px solid rgba(7, 26, 43, 0.08);
            box-shadow: 0 25px 70px rgba(7, 26, 43, 0.08);
            overflow: hidden;
        }

        .feature-image {
            position: relative;
            width: 100%;
            height: 520px;
            overflow: hidden;
            background: var(--navy);
        }

        .feature-image img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            object-position: center;
            transition: transform 0.8s ease;
        }

        .feature-image:hover img {
            transform: scale(1.04);
        }

        .feature-image::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(
                135deg,
                rgba(7, 26, 43, 0.05),
                rgba(7, 26, 43, 0.20)
            );
            pointer-events: none;
        }

        .feature-content {
            padding: 65px 65px 65px 45px;
        }

        .feature-title {
            margin-bottom: 25px;
            font-family: "Cormorant Garamond", serif;
            font-size: clamp(45px, 5vw, 68px);
            font-weight: 500;
            line-height: 0.95;
            color: var(--navy);
        }

        .feature-title span {
            color: var(--gold);
        }

        .feature-content p {
            margin-bottom: 20px;
            color: var(--muted);
            font-size: 15px;
            line-height: 1.9;
        }

        .feature-list {
            list-style: none;
            margin: 30px 0 0;
            padding: 0;
        }

        .feature-list li {
            display: flex;
            align-items: flex-start;
            gap: 13px;
            padding: 13px 0;
            border-bottom: 1px solid var(--border);
            color: var(--text);
            font-size: 14px;
        }

        .feature-list li i {
            margin-top: 5px;
            color: var(--gold);
            font-size: 12px;
        }

        /* =========================================================
           LIFE CARDS
        ========================================================= */
        .life-section {
            padding: 110px 0;
            background: var(--ivory);
        }

        .life-card {
            height: 100%;
            padding: 42px 35px;
            background: var(--white);
            border: 1px solid var(--border);
            transition: transform 0.35s ease, box-shadow 0.35s ease;
        }

        .life-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 55px rgba(7, 26, 43, 0.09);
        }

        .life-icon {
            width: 58px;
            height: 58px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 25px;
            border: 1px solid rgba(197, 164, 90, 0.45);
            color: var(--gold);
            font-size: 21px;
        }

        .life-card h3 {
            margin-bottom: 13px;
            font-family: "Cormorant Garamond", serif;
            font-size: 30px;
            font-weight: 600;
            color: var(--navy);
        }

        .life-card p {
            margin: 0;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.8;
        }

        /* =========================================================
           QUOTE
        ========================================================= */
        .quote-section {
            position: relative;
            padding: 120px 0;
            background:
                linear-gradient(
                    rgba(5, 19, 31, 0.94),
                    rgba(5, 19, 31, 0.94)
                ),
                url("/images/student-life.jpg");
            background-size: cover;
            background-position: center;
        }

        .quote-content {
            max-width: 850px;
            margin: auto;
            text-align: center;
        }

        .quote-icon {
            margin-bottom: 25px;
            color: var(--gold);
            font-size: 28px;
        }

        .quote-text {
            margin-bottom: 25px;
            font-family: "Cormorant Garamond", serif;
            color: var(--white);
            font-size: clamp(35px, 5vw, 58px);
            font-weight: 400;
            line-height: 1.15;
        }

        .quote-author {
            color: var(--gold-light);
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        /* =========================================================
           CTA
        ========================================================= */
        .cta-section {
            padding: 100px 0;
            background: var(--gold);
        }

        .cta-section h2 {
            margin-bottom: 12px;
            font-family: "Cormorant Garamond", serif;
            font-size: 48px;
            font-weight: 600;
            color: var(--navy);
        }

        .cta-section p {
            margin: 0;
            color: rgba(7, 26, 43, 0.75);
            font-size: 15px;
        }

        .cta-button {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            padding: 15px 28px;
            background: var(--navy);
            color: var(--white);
            text-decoration: none;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            transition: all 0.3s ease;
        }

        .cta-button:hover {
            background: var(--navy-midnight);
            color: var(--gold-light);
            transform: translateY(-2px);
        }

        /* =========================================================
           FOOTER
        ========================================================= */
        footer {
            background: var(--navy-midnight);
            color: rgba(255, 255, 255, 0.65);
        }

        .footer-main {
            padding: 75px 0 55px;
        }

        .footer-brand {
            margin-bottom: 20px;
            font-family: "Cormorant Garamond", serif;
            color: var(--white);
            font-size: 30px;
        }

        .footer-text {
            max-width: 400px;
            color: rgba(255, 255, 255, 0.55);
            font-size: 13px;
            line-height: 1.8;
        }

        .footer-title {
            margin-bottom: 22px;
            color: var(--gold-light);
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .footer-links {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .footer-links li {
            margin-bottom: 10px;
        }

        .footer-links a {
            color: rgba(255, 255, 255, 0.55);
            text-decoration: none;
            font-size: 13px;
            transition: color 0.3s ease;
        }

        .footer-links a:hover {
            color: var(--gold-light);
        }

        .footer-contact {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 15px;
            font-size: 13px;
        }

        .footer-contact i {
            width: 18px;
            margin-top: 4px;
            color: var(--gold);
        }

        .footer-bottom {
            padding: 22px 0;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 11px;
            color: rgba(255, 255, 255, 0.4);
        }

        /* =========================================================
           RESPONSIVE BREAKPOINTS
        ========================================================= */
        @media (max-width: 991px) {
            .hero {
                min-height: 500px;
            }

            .feature-image {
                height: 430px;
            }

            .feature-content {
                padding: 50px 40px;
            }
        }

        @media (max-width: 767px) {
            .hero-content {
                padding: 75px 0;
            }

            .hero h1 {
                font-size: 58px;
            }

            .intro-section,
            .feature-section,
            .life-section {
                padding: 75px 0;
            }

            .feature-image {
                height: 350px;
            }

            .feature-content {
                padding: 42px 30px;
            }

            .feature-title {
                font-size: 50px;
            }

            .life-card {
                padding: 32px 28px;
            }

            .quote-section {
                padding: 85px 0;
            }

            .cta-section {
                padding: 70px 0;
                text-align: center;
            }

            .cta-button {
                margin-top: 25px;
            }
        }
    </style>
</head>

<body>

