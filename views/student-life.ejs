                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a href="/contact" class="cta-button">
                    Contact The School
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</section>

