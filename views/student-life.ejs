<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Discover student life, campus activities, school celebrations and achievements at St. Martin's High School, Balanagar, Hyderabad.">
    <title>Student Life | St. Martin's High School</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link rel="stylesheet" href="/css/style.css">

    <style>
        .life-page { color:#253247; background:#f8f7f3; min-height:70vh; }
        .life-hero { padding:90px 24px; color:#fff; text-align:center; background:linear-gradient(120deg,#071a2b,#123d55); }
        .life-hero .eyebrow { color:#e0c67b; letter-spacing:4px; text-transform:uppercase; font-size:12px; font-weight:700; }
        .life-hero h1 { margin:16px 0; font-size:clamp(36px,5vw,62px); }
        .life-hero p { max-width:700px; margin:0 auto; color:#e1e8ef; line-height:1.8; }
        .life-container { width:min(1150px,92%); margin:auto; padding:60px 0; }
        .life-section-title { margin-bottom:12px; color:#102b42; font-size:clamp(26px,3vw,38px); }
        .life-intro { max-width:760px; line-height:1.8; color:#637080; margin-bottom:32px; }
        .life-highlights { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:20px; margin:35px 0 65px; }
        .life-highlight { background:#fff; padding:26px; border:1px solid #e9e4d9; border-radius:12px; }
        .life-highlight .symbol { font-size:30px; }
        .life-highlight h3 { color:#102b42; margin:14px 0 9px; }
        .life-highlight p { color:#66717e; line-height:1.7; margin:0; }
        .life-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:22px; }
        .life-card { background:#fff; border:1px solid #e8e5dd; border-radius:12px; overflow:hidden; }
        .life-card img { display:block; width:100%; height:210px; object-fit:cover; }
        .life-card-content { padding:23px; }
        .life-tag { display:inline-block; padding:6px 10px; border-radius:30px; background:#f3ead4; color:#735c24; font-size:12px; font-weight:700; }
        .life-card h3 { margin:14px 0 10px; color:#102b42; font-size:21px; }
        .life-card p { color:#66717e; line-height:1.75; white-space:pre-line; }
        .life-date { color:#8a7440; font-size:13px; }
        .life-empty { padding:25px; background:#fff; border:1px dashed #d7d2c7; border-radius:10px; color:#66717e; }
        .life-button { display:inline-block; padding:13px 23px; background:#c5a45a; color:#071a2b; text-decoration:none; font-weight:700; border-radius:5px; margin-top:18px; }
        @media(max-width:600px) { .life-hero{padding:65px 20px}.life-container{padding:40px 0} }
    </style>
</head>
<body>

<%- include('partials/header') %>

<%
    const pageUpdates = typeof updates !== 'undefined' && Array.isArray(updates) ? updates : [];
    const pageEvents = typeof events !== 'undefined' && Array.isArray(events) ? events : [];
%>

<main class="life-page">
    <section class="life-hero">
        <div class="eyebrow">Beyond the Classroom</div>
        <h1>Discover Student Life</h1>
        <p>
            Every school day is an opportunity to learn, participate,
            build friendships and discover new possibilities at
            St. Martin's High School, Balanagar.
        </p>
    </section>

    <div class="life-container">
        <section>
            <h2 class="life-section-title">A Journey of Learning and Growth</h2>
            <p class="life-intro">
                We believe education extends beyond textbooks. School activities,
                celebrations, collaborative learning and responsible participation
                help students develop confidence, creativity and character.
            </p>

            <div class="life-highlights">
                <article class="life-highlight">
                    <div class="symbol">📚</div>
                    <h3>Learning Together</h3>
                    <p>Classroom activities encourage curiosity, communication and a lifelong love of learning.</p>
                </article>
                <article class="life-highlight">
                    <div class="symbol">🏆</div>
                    <h3>Activities & Achievement</h3>
                    <p>Students are encouraged to explore their interests, practise their skills and celebrate progress.</p>
                </article>
                <article class="life-highlight">
                    <div class="symbol">🎨</div>
                    <h3>Creativity & Expression</h3>
                    <p>Creative activities give students opportunities to express ideas and develop individual talents.</p>
                </article>
                <article class="life-highlight">
                    <div class="symbol">🤝</div>
                    <h3>Values & Community</h3>
                    <p>Respect, teamwork, responsibility and kindness are important parts of school life.</p>
                </article>
            </div>
        </section>

        <section>
            <h2 class="life-section-title">Student Life News & Announcements</h2>
            <p class="life-intro">
                Stay informed about school announcements and activities approved for publication.
            </p>

            <% if (pageUpdates.length > 0) { %>
                <div class="life-grid">
                    <% pageUpdates.forEach(function(item) { %>
                        <article class="life-card">
                            <% if (item.image_url) { %>
                                <img src="<%= item.image_url %>" alt="<%= item.title %>" loading="lazy">
                            <% } %>
                            <div class="life-card-content">
                                <span class="life-tag"><%= item.category || 'Announcement' %></span>
                                <h3><%= item.title %></h3>
                                <p><%= item.description || '' %></p>
                                <% if (item.created_at) { %>
                                    <div class="life-date">
                                        <%= new Date(item.created_at).toLocaleDateString('en-IN', {day:'numeric',month:'long',year:'numeric'}) %>
                                    </div>
                                <% } %>
                            </div>
                        </article>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="life-empty">
                    <strong>New updates coming soon.</strong>
                    <p>School announcements and student activity updates will appear here when published.</p>
                </div>
            <% } %>
        </section>

        <section style="margin-top:60px">
            <h2 class="life-section-title">Upcoming School Events</h2>
            <p class="life-intro">Explore upcoming activities and important dates from the school calendar.</p>

            <% if (pageEvents.length > 0) { %>
                <div class="life-grid">
                    <% pageEvents.forEach(function(event) { %>
                        <article class="life-card">
                            <div class="life-card-content">
                                <span class="life-tag"><%= event.category || 'School Event' %></span>
                                <h3><%= event.title %></h3>
                                <p><%= event.description || 'More details will be shared by the school.' %></p>
                                <div class="life-date">
                                    <strong>Date:</strong>
                                    <%= event.event_date || event.date || 'To be announced' %>
                                </div>
                                <% if (event.start_time) { %>
                                    <p><strong>Time:</strong> <%= event.start_time %><%= event.end_time ? ' – ' + event.end_time : '' %></p>
                                <% } %>
                                <% if (event.location) { %>
                                    <p><strong>Location:</strong> <%= event.location %></p>
                                <% } %>
                            </div>
                        </article>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="life-empty">
                    There are no published upcoming events at the moment.
                    Please check the academic calendar for future updates.
                    <br>
                    <a class="life-button" href="/calendar">View Academic Calendar</a>
                </div>
            <% } %>
        </section>

        <section style="margin-top:60px;text-align:center">
            <h2 class="life-section-title">Every Day Is an Opportunity</h2>
            <p class="life-intro" style="margin-left:auto;margin-right:auto">
                Explore our academic programmes, facilities and school activities.
            </p>
            <a class="life-button" href="/academics">Explore Academics</a>
            <a class="life-button" href="/gallery" style="margin-left:8px">Visit Gallery</a>
        </section>
    </div>
</main>

<%- include('partials/footer') %>

</body>
</html>
