```ejs
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Life | St. Martin's High School, Balanagar</title>

    <meta name="description"
          content="Discover student life at St. Martin's High School, Balanagar, Hyderabad — sports, academics, creativity, leadership, and holistic development.">

    <meta name="theme-color" content="#071a2b">

    <link rel="icon" type="image/png" href="/images/logo.png">

    <link rel="stylesheet" href="/css/style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
        /* =========================================
           STUDENT LIFE PAGE
           Styles are scoped to prevent conflicts
           with the global header and footer.
        ========================================= */

        .student-life-page {
            --sl-navy: #071a2b;
            --sl-navy-light: #102c43;
            --sl-burgundy: #581722;
            --sl-gold: #c5a45a;
            --sl-gold-light: #e0c67b;
            --sl-cream: #f6f1e7;
            --sl-white: #ffffff;
            --sl-text: #253341;
            --sl-muted: #6c7882;

            background: var(--sl-white);
            color: var(--sl-text);
            font-family: "Inter", sans-serif;
            overflow: hidden;
        }

        .student-life-page *,
        .student-life-page *::before,
        .student-life-page *::after {
            box-sizing: border-box;
        }

        .student-life-page img {
            display: block;
            max-width: 100%;
        }

        .student-life-page a {
            text-decoration: none;
        }

        .student-life-page .sl-container {
            width: min(1180px, calc(100% - 44px));
            margin: 0 auto;
        }

        .student-life-page .sl-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--sl-gold);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 17px;
        }

        .student-life-page .sl-eyebrow::before {
            content: "";
            width: 30px;
            height: 1px;
            background: currentColor;
        }

        .student-life-page .sl-section-heading {
            max-width: 760px;
            margin: 0 auto 48px;
            text-align: center;
        }

        .student-life-page .sl-section-heading h2 {
            color: var(--sl-navy);
            font-family: "Cormorant Garamond", serif;
            font-size: clamp(36px, 5vw, 58px);
            font-weight: 600;
            line-height: 1.08;
            margin: 0 0 17px;
        }

        .student-life-page .sl-section-heading p {
            max-width: 680px;
            margin: 0 auto;
            color: var(--sl-muted);
            font-size: 14px;
            line-height: 1.9;
        }

        /* HERO */

        .student-life-page .sl-hero {
            min-height: 580px;
            position: relative;
            display: flex;
            align-items: center;
            background:
                linear-gradient(90deg,
                    rgba(4, 17, 29, .93) 0%,
                    rgba(4, 17, 29, .76) 48%,
                    rgba(4, 17, 29, .24) 100%),
                url("/images/Legacy.png") center 42% / cover no-repeat,
                var(--sl-navy);
        }

        .student-life-page .sl-hero::after {
            content: "";
            position: absolute;
            inset: auto 0 0;
            height: 90px;
            background: linear-gradient(transparent, rgba(7, 26, 43, .35));
            pointer-events: none;
        }

        .student-life-page .sl-hero-content {
            position: relative;
            z-index: 1;
            max-width: 780px;
            padding: 105px 0 115px;
        }

        .student-life-page .sl-hero .sl-eyebrow {
            color: var(--sl-gold-light);
        }

        .student-life-page .sl-hero h1 {
            color: var(--sl-white);
            font-family: "Cormorant Garamond", serif;
            font-size: clamp(50px, 7.2vw, 86px);
            font-weight: 600;
            letter-spacing: -.8px;
            line-height: .98;
            margin: 0 0 25px;
        }

        .student-life-page .sl-hero h1 span {
            color: var(--sl-gold-light);
            font-style: italic;
        }

        .student-life-page .sl-hero p {
            max-width: 610px;
            color: rgba(255, 255, 255, .83);
            font-size: 15px;
            line-height: 2;
            margin: 0 0 32px;
        }

        .student-life-page .sl-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            min-height: 50px;
            padding: 14px 24px;
            border: 1px solid var(--sl-gold);
            background: var(--sl-gold);
            color: var(--sl-navy);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            transition: background .25s ease, color .25s ease,
                        transform .25s ease;
        }

        .student-life-page .sl-button:hover {
            background: transparent;
            color: var(--sl-gold-light);
            transform: translateY(-2px);
        }

        .student-life-page .sl-button-outline {
            background: transparent;
            color: var(--sl-white);
        }

        .student-life-page .sl-button-outline:hover {
            background: var(--sl-gold);
            color: var(--sl-navy);
        }

        /* INTRODUCTION */

        .student-life-page .sl-intro {
            padding: 100px 0;
            background: var(--sl-white);
        }

        .student-life-page .sl-intro-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 75px;
            align-items: center;
        }

        .student-life-page .sl-intro-image {
            position: relative;
            min-height: 440px;
        }

        .student-life-page .sl-intro-image img {
            width: 100%;
            height: 440px;
            object-fit: cover;
            background: var(--sl-cream);
        }

        .student-life-page .sl-image-label {
            position: absolute;
            right: -18px;
            bottom: 24px;
            width: min(230px, 75%);
            padding: 24px;
            background: var(--sl-navy);
            border-bottom: 3px solid var(--sl-gold);
            color: var(--sl-white);
        }

        .student-life-page .sl-image-label strong {
            display: block;
            color: var(--sl-gold-light);
            font-family: "Cormorant Garamond", serif;
            font-size: 26px;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .student-life-page .sl-image-label span {
            display: block;
            font-size: 11px;
            line-height: 1.7;
        }

        .student-life-page .sl-intro-copy h2 {
            color: var(--sl-navy);
            font-family: "Cormorant Garamond", serif;
            font-size: clamp(37px, 4.4vw, 56px);
            font-weight: 600;
            line-height: 1.08;
            margin: 0 0 22px;
        }

        .student-life-page .sl-intro-copy h2 span {
            color: var(--sl-burgundy);
            font-style: italic;
        }

        .student-life-page .sl-intro-copy p {
            color: var(--sl-muted);
            font-size: 14px;
            line-height: 2;
            margin: 0 0 17px;
        }

        .student-life-page .sl-intro-points {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 17px;
            margin-top: 28px;
        }

        .student-life-page .sl-intro-point {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            color: var(--sl-navy);
            font-size: 12px;
            font-weight: 700;
            line-height: 1.6;
        }

        .student-life-page .sl-intro-point i {
            margin-top: 3px;
            color: var(--sl-gold);
        }

        /* CORE VALUES */

        .student-life-page .sl-values {
            padding: 90px 0;
            background: var(--sl-cream);
        }

        .student-life-page .sl-values-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 20px;
        }

        .student-life-page .sl-value-card {
            padding: 32px 24px;
            background: var(--sl-white);
            border-bottom: 3px solid transparent;
            transition: transform .25s ease, border-color .25s ease,
                        box-shadow .25s ease;
        }

        .student-life-page .sl-value-card:hover {
            transform: translateY(-6px);
            border-color: var(--sl-gold);
            box-shadow: 0 18px 35px rgba(7, 26, 43, .08);
        }

        .student-life-page .sl-value-icon {
            width: 53px;
            height: 53px;
            display: grid;
            place-items: center;
            background: var(--sl-navy);
            color: var(--sl-gold-light);
            font-size: 20px;
            margin-bottom: 24px;
        }

        .student-life-page .sl-value-card h3 {
            color: var(--sl-navy);
            font-family: "Cormorant Garamond", serif;
            font-size: 25px;
            font-weight: 600;
            margin: 0 0 12px;
        }

        .student-life-page .sl-value-card p {
            color: var(--sl-muted);
            font-size: 12px;
            line-height: 1.9;
            margin: 0;
        }

        /* SPORTS FEATURE */

        .student-life-page .sl-sports {
            padding: 105px 0;
            background: var(--sl-navy);
            color: var(--sl-white);
        }

        .student-life-page .sl-sports-grid {
            display: grid;
            grid-template-columns: 1.02fr .98fr;
            gap: 70px;
            align-items: center;
        }

        .student-life-page .sl-sports-image {
            position: relative;
            min-height: 450px;
        }

        .student-life-page .sl-sports-image img {
            width: 100%;
            height: 450px;
            object-fit: cover;
            background: #102c43;
        }

        .student-life-page .sl-sports-image::after {
            content: "";
            position: absolute;
            inset: 15px -15px -15px 15px;
            border: 1px solid rgba(197, 164, 90, .7);
            pointer-events: none;
        }

        .student-life-page .sl-sports-copy {
            position: relative;
            z-index: 1;
        }

        .student-life-page .sl-sports-copy h2 {
            color: var(--sl-white);
            font-family: "Cormorant Garamond", serif;
            font-size: clamp(40px, 5vw, 62px);
            font-weight: 600;
            line-height: 1.04;
            margin: 0 0 23px;
        }

        .student-life-page .sl-sports-copy h2 span {
            color: var(--sl-gold-light);
            font-style: italic;
        }

        .student-life-page .sl-sports-copy p {
            color: rgba(255, 255, 255, .74);
            font-size: 13px;
            line-height: 2;
            margin: 0 0 17px;
        }

        .student-life-page .sl-sports-list {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px 20px;
            padding: 0;
            margin: 28px 0 32px;
            list-style: none;
        }

        .student-life-page .sl-sports-list li {
            display: flex;
            gap: 10px;
            align-items: center;
            color: rgba(255, 255, 255, .9);
            font-size: 12px;
        }

        .student-life-page .sl-sports-list i {
            color: var(--sl-gold-light);
            font-size: 12px;
        }

        /* STUDENT EXPERIENCES */

        .student-life-page .sl-experiences {
            padding: 100px 0;
            background: var(--sl-white);
        }

        .student-life-page .sl-experience-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 25px;
        }

        .student-life-page .sl-experience-card {
            background: var(--sl-white);
            border: 1px solid #e9e7e1;
            transition: transform .25s ease, box-shadow .25s ease;
        }

        .student-life-page .sl-experience-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 40px rgba(7, 26, 43, .09);
        }

        .student-life-page .sl-experience-card img {
            width: 100%;
            height: 230px;
            object-fit: cover;
            background: var(--sl-cream);
        }

        .student-life-page .sl-experience-content {
            padding: 25px;
        }

        .student-life-page .sl-experience-content span {
            display: block;
            color: var(--sl-gold);
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 11px;
        }

        .student-life-page .sl-experience-content h3 {
            color: var(--sl-navy);
            font-family: "Cormorant Garamond", serif;
            font-size: 27px;
            font-weight: 600;
            margin: 0 0 10px;
        }

        .student-life-page .sl-experience-content p {
            color: var(--sl-muted);
            font-size: 12px;
            line-height: 1.9;
            margin: 0;
        }

        /* WELLNESS */

        .student-life-page .sl-wellness {
            padding: 85px 0;
            background: #f8f6f0;
        }

        .student-life-page .sl-wellness-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 30px;
        }

        .student-life-page .sl-wellness-item {
            padding: 10px 10px 10px 0;
        }

        .student-life-page .sl-wellness-item i {
            display: inline-grid;
            place-items: center;
            width: 48px;
            height: 48px;
            background: var(--sl-burgundy);
            color: var(--sl-white);
            font-size: 17px;
            margin-bottom: 20px;
        }

        .student-life-page .sl-wellness-item h3 {
            color: var(--sl-navy);
            font-family: "Cormorant Garamond", serif;
            font-size: 27px;
            font-weight: 600;
            margin: 0 0 12px;
        }

        .student-life-page .sl-wellness-item p {
            color: var(--sl-muted);
            font-size: 12px;
            line-height: 1.95;
            margin: 0;
        }

        /* QUOTE */

        .student-life-page .sl-quote {
            position: relative;
            padding: 85px 24px;
            text-align: center;
            background: var(--sl-burgundy);
            color: var(--sl-white);
        }

        .student-life-page .sl-quote-icon {
            color: var(--sl-gold-light);
            font-size: 30px;
            margin-bottom: 18px;
        }

        .student-life-page .sl-quote blockquote {
            max-width: 850px;
            margin: 0 auto 20px;
            color: var(--sl-white);
            font-family: "Cormorant Garamond", serif;
            font-size: clamp(30px, 4.5vw, 46px);
            font-weight: 500;
            line-height: 1.25;
        }

        .student-life-page .sl-quote p {
            color: rgba(255, 255, 255, .7);
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin: 0;
        }

        /* PHOTO GALLERY */

        .student-life-page .sl-gallery {
            padding: 100px 0;
            background: var(--sl-white);
        }

        .student-life-page .sl-gallery-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            grid-auto-rows: 225px;
            gap: 16px;
        }

        .student-life-page .sl-gallery-item {
            position: relative;
            overflow: hidden;
            background: var(--sl-cream);
        }

        .student-life-page .sl-gallery-item:first-child {
            grid-column: span 2;
            grid-row: span 2;
        }

        .student-life-page .sl-gallery-item:nth-child(4) {
            grid-column: span 2;
        }

        .student-life-page .sl-gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .5s ease;
        }

        .student-life-page .sl-gallery-item:hover img {
            transform: scale(1.06);
        }

        .student-life-page .sl-gallery-overlay {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: flex-end;
            padding: 22px;
            background: linear-gradient(transparent 35%, rgba(4, 17, 29, .85));
            pointer-events: none;
        }

        .student-life-page .sl-gallery-overlay span {
            color: var(--sl-white);
            font-family: "Cormorant Garamond", serif;
            font-size: 24px;
            font-weight: 600;
        }

        /* ADMISSIONS CTA */

        .student-life-page .sl-cta {
            position: relative;
            padding: 85px 24px;
            text-align: center;
            background:
                linear-gradient(rgba(7, 26, 43, .94), rgba(7, 26, 43, .94)),
                url("/images/Legacy.png") center / cover no-repeat;
        }

        .student-life-page .sl-cta .sl-eyebrow {
            justify-content: center;
        }

        .student-life-page .sl-cta h2 {
            max-width: 760px;
            margin: 0 auto 20px;
            color: var(--sl-white);
            font-family: "Cormorant Garamond", serif;
            font-size: clamp(38px, 5vw, 58px);
            font-weight: 600;
            line-height: 1.1;
        }

        .student-life-page .sl-cta h2 span {
            color: var(--sl-gold-light);
            font-style: italic;
        }

        .student-life-page .sl-cta p {
            max-width: 650px;
            margin: 0 auto 30px;
            color: rgba(255, 255, 255, .76);
            font-size: 13px;
            line-height: 1.9;
        }

        /* REVEAL EFFECT */

        .student-life-page .sl-reveal {
            opacity: 1;
            transform: none;
        }

        .student-life-page.sl-js .sl-reveal {
            opacity: 0;
            transform: translateY(22px);
            transition: opacity .7s ease, transform .7s ease;
        }

        .student-life-page.sl-js .sl-reveal.sl-visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* RESPONSIVE */

        @media (max-width: 1000px) {
            .student-life-page .sl-values-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .student-life-page .sl-intro-grid,
            .student-life-page .sl-sports-grid {
                gap: 42px;
            }

            .student-life-page .sl-experience-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .student-life-page .sl-gallery-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 700px) {
            .student-life-page .sl-container {
                width: min(100% - 34px, 560px);
            }

            .student-life-page .sl-hero {
                min-height: 500px;
                background-position: center, 58% center, center;
            }

            .student-life-page .sl-hero-content {
                padding: 85px 0;
            }

            .student-life-page .sl-hero h1 {
                font-size: clamp(48px, 13vw, 70px);
            }

            .student-life-page .sl-intro,
            .student-life-page .sl-experiences,
            .student-life-page .sl-gallery {
                padding: 70px 0;
            }

            .student-life-page .sl-intro-grid,
            .student-life-page .sl-sports-grid {
                grid-template-columns: 1fr;
                gap: 42px;
            }

            .student-life-page .sl-intro-image {
                min-height: 320px;
                margin-right: 10px;
            }

            .student-life-page .sl-intro-image img {
                height: 320px;
            }

            .student-life-page .sl-image-label {
                right: -8px;
            }

            .student-life-page .sl-values {
                padding: 70px 0;
            }

            .student-life-page .sl-values-grid {
                gap: 14px;
            }

            .student-life-page .sl-value-card {
                padding: 24px 18px;
            }

            .student-life-page .sl-value-card h3 {
                font-size: 23px;
            }

            .student-life-page .sl-sports {
                padding: 75px 0;
            }

            .student-life-page .sl-sports-image {
                min-height: 300px;
                margin-right: 10px;
            }

            .student-life-page .sl-sports-image img {
                height: 300px;
            }

            .student-life-page .sl-experience-grid,
            .student-life-page .sl-wellness-grid {
                grid-template-columns: 1fr;
            }

            .student-life-page .sl-experience-card img {
                height: 245px;
            }

            .student-life-page .sl-wellness {
                padding: 70px 0;
            }

            .student-life-page .sl-wellness-grid {
                gap: 30px;
            }

            .student-life-page .sl-gallery-grid {
                grid-auto-rows: 170px;
                gap: 10px;
            }

            .student-life-page .sl-gallery-item:first-child {
                grid-column: span 2;
                grid-row: span 1;
            }

            .student-life-page .sl-gallery-item:nth-child(4) {
                grid-column: span 2;
            }

            .student-life-page .sl-gallery-overlay {
                padding: 12px;
            }

            .student-life-page .sl-gallery-overlay span {
                font-size: 19px;
            }

            .student-life-page .sl-quote {
                padding: 65px 22px;
            }

            .student-life-page .sl-cta {
                padding: 70px 20px;
            }
        }

        @media (max-width: 400px) {
            .student-life-page .sl-intro-points,
            .student-life-page .sl-sports-list {
                grid-template-columns: 1fr;
            }

            .student-life-page .sl-gallery-grid {
                grid-auto-rows: 145px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .student-life-page *,
            .student-life-page *::before,
            .student-life-page *::after {
                scroll-behavior: auto !important;
                animation-duration: .01ms !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
</head>

<body>

    <!-- GLOBAL HEADER -->
    <%- include('partials/header') %>

    <main class="student-life-page">

        <!-- HERO -->
        <section class="sl-hero">
            <div class="sl-container">
                <div class="sl-hero-content sl-reveal">
                    <span class="sl-eyebrow">Life Beyond the Classroom</span>

                    <h1>
                        Where Young Minds<br>
                        <span>Find Their Wings.</span>
                    </h1>

                    <p>
                        At St. Martin's High School, student life is a journey of
                        discovery, friendship, creativity and achievement. Every
                        experience helps our students develop confidence, character
                        and a lifelong love of learning.
                    </p>

                    <a href="#student-experiences" class="sl-button">
                        Discover Student Life
                        <i class="fa-solid fa-arrow-down"></i>
                    </a>
                </div>
            </div>
        </section>

        <!-- INTRODUCTION -->
        <section class="sl-intro">
            <div class="sl-container">
                <div class="sl-intro-grid">

                    <div class="sl-intro-image sl-reveal">
                        <img
                            src="/images/Legacy.png"
                            alt="School life and student experiences at St. Martin's High School"
                            loading="lazy"
                            onerror="this.onerror=null;this.src='/images/classroom.png';"
                        >

