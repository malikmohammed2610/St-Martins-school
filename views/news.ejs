<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>News & Events | St. Martin's High School</title>

    <meta name="description"
        content="News, announcements and events from St. Martin's High School, Balanagar, Hyderabad.">

    <link rel="stylesheet" href="/css/style.css">
</head>


<body class="news-page">

    <!-- =====================================================
         GLOBAL HEADER
         Loaded from partials/header.ejs
    ====================================================== -->

    <%- include('partials/header') %>


    <!-- =====================================================
         NEWS HERO
    ====================================================== -->

    <section class="news-hero">

        <div class="news-hero-inner">

            <div class="news-eyebrow">
                Institutional Updates
            </div>

            <h1>
                News <span>&amp;</span> Events
            </h1>

            <p class="news-hero-text">
                Discover the latest announcements, achievements,
                celebrations and important updates from the
                St. Martin's High School community.
            </p>

        </div>

    </section>


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main class="news-content">


        <!-- =================================================
             FEATURED ANNOUNCEMENT
        ================================================== -->

        <article class="featured-news">

            <div class="featured-visual">

                <div class="featured-icon">
                    ✦
                </div>

                <div class="featured-label">
                    Featured Announcement
                </div>

            </div>


            <div class="featured-content">

                <span class="news-date">
                    October 2026 · Admissions
                </span>

                <h2>
                    Admissions Open for
                    the Academic Year
                </h2>

                <p>
                    Applications are now being accepted for
                    selected classes. Families interested in
                    joining the St. Martin's community are invited
                    to explore our admissions process and learn
                    more about the school's academic environment.
                </p>

                <div class="featured-button-wrap">

                    <a href="/admissions" class="news-button">
                        Explore Admissions
                    </a>

                </div>

            </div>

        </article>


        <!-- =================================================
             LATEST NEWS
        ================================================== -->

        <section>

            <div class="news-section-heading">

                <div class="news-eyebrow">
                    From Our Campus
                </div>

                <h2>
                    Latest News
                </h2>

                <p>
                    Stay connected with the academic, cultural
                    and extracurricular life of St. Martin's
                    High School.
                </p>

            </div>


            <div class="news-grid">


                <!-- NEWS CARD 01 -->

                <article class="news-card">

                    <div class="news-card-top">

                        <div class="news-card-number">
                            01
                        </div>

                    </div>

                    <div class="news-card-content">

                        <span class="news-category">
                            Campus Life
                        </span>

                        <h3>
                            A Vibrant Learning Environment
                        </h3>

                        <p>
                            Discover the spaces, activities and
                            experiences that make everyday life
                            at St. Martin's meaningful.
                        </p>

                        <a href="/student-life" class="read-more">
                            Explore Student Life →
                        </a>

                    </div>

                </article>


                <!-- NEWS CARD 02 -->

                <article class="news-card">

                    <div class="news-card-top">

                        <div class="news-card-number">
                            02
                        </div>

                    </div>

                    <div class="news-card-content">

                        <span class="news-category">
                            Achievement
                        </span>

                        <h3>
                            Celebrating Student Excellence
                        </h3>

                        <p>
                            Our students continue to pursue
                            excellence through academics,
                            creativity, leadership and sport.
                        </p>

                        <a href="/gallery" class="read-more">
                            View Highlights →
                        </a>

                    </div>

                </article>


                <!-- NEWS CARD 03 -->

                <article class="news-card">

                    <div class="news-card-top">

                        <div class="news-card-number">
                            03
                        </div>

                    </div>

                    <div class="news-card-content">

                        <span class="news-category">
                            School Events
                        </span>

                        <h3>
                            Moments That Bring Us Together
                        </h3>

                        <p>
                            From celebrations to academic
                            programmes, school events create
                            lasting memories for our community.
                        </p>

                        <a href="/calendar" class="read-more">
                            View Calendar →
                        </a>

                    </div>

                </article>


            </div>

        </section>


        <!-- =================================================
             UPCOMING EVENTS
        ================================================== -->

        <section class="events-section">

            <div class="news-section-heading">

                <div class="news-eyebrow">
                    Mark Your Calendar
                </div>

                <h2>
                    Upcoming Events
                </h2>

                <p>
                    Important dates and upcoming activities
                    from the St. Martin's academic calendar.
                </p>

            </div>


            <div class="events-list">


                <!-- EVENT 01 -->

                <div class="event-row">

                    <div class="event-date">

                        <strong>12</strong>

                        <span>OCT</span>

                    </div>

                    <div class="event-info">

                        <h3>
                            Academic Programme
                        </h3>

                        <p>
                            Balanagar Campus · School Programme
                        </p>

                    </div>

                    <div class="event-arrow">
                        →
                    </div>

                </div>


                <!-- EVENT 02 -->

                <div class="event-row">

                    <div class="event-date">

                        <strong>18</strong>

                        <span>OCT</span>

                    </div>

                    <div class="event-info">

                        <h3>
                            Student Activities
                        </h3>

                        <p>
                            Campus · Student Enrichment Programme
                        </p>

                    </div>

                    <div class="event-arrow">
                        →
                    </div>

                </div>


                <!-- EVENT 03 -->

                <div class="event-row">

                    <div class="event-date">

                        <strong>25</strong>

                        <span>OCT</span>

                    </div>

                    <div class="event-info">

                        <h3>
                            School Community Event
                        </h3>

                        <p>
                            St. Martin's High School · Balanagar
                        </p>

                    </div>

                    <div class="event-arrow">
                        →
                    </div>

                </div>


            </div>

        </section>


        <!-- =================================================
             CONTACT CTA
        ================================================== -->

        <section class="news-cta">

            <h2>
                Stay Connected With
                St. Martin's
            </h2>

            <p>
                Explore our academic programmes, campus life,
                admissions and upcoming activities to discover
                more about the St. Martin's experience.
            </p>

            <a href="/contact" class="news-button">
                Contact The School
            </a>

        </section>


    </main>


    <!-- =====================================================
         GLOBAL FOOTER
    ====================================================== -->

    <%- include('partials/footer') %>


    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

    <script src="/js/script.js"></script>

    <script src="/js/premium-effects.js"></script>


    <!-- =====================================================
         PAGE-ONLY STYLING
    ====================================================== -->

    <style>

        /* =====================================================
           NEWS PAGE
        ===================================================== */

        .news-page {
            background: #f6f1e7;
            min-height: 100vh;
            color: #071a2b;
        }


        /* =====================================================
           HERO
        ===================================================== */

        .news-hero {
            position: relative;
            overflow: hidden;

            /*
             * Extra top spacing is intentional.
             * It prevents the hero from sitting underneath
             * a fixed/sticky global header.
             */

            padding: 110px 5% 85px;

            background:
                linear-gradient(
                    135deg,
                    #071a2b 0%,
                    #0c2235 100%
                );
        }


        .news-hero::before {
            content: "";

            position: absolute;

            width: 430px;
            height: 430px;

            right: -140px;
            top: -210px;

            border: 1px solid rgba(197,164,90,0.18);

            border-radius: 50%;
        }


        .news-hero::after {
            content: "";

            position: absolute;

            width: 260px;
            height: 260px;

            right: 60px;
            bottom: -180px;

            border: 1px solid rgba(197,164,90,0.12);

            border-radius: 50%;
        }


        .news-hero-inner {
            position: relative;
            z-index: 2;

            max-width: 1180px;

            margin: 0 auto;
        }


        .news-eyebrow {
            display: inline-flex;

            align-items: center;

            gap: 12px;

            color: #c5a45a;

            font-size: 12px;

            font-weight: 600;

            letter-spacing: 3px;

            text-transform: uppercase;

            margin-bottom: 18px;
        }


        .news-eyebrow::before {
            content: "";

            width: 35px;
            height: 1px;

            background: #c5a45a;
        }


        .news-hero h1 {
            margin: 0;

            color: #ffffff;

            font-family:
                Georgia,
                "Times New Roman",
                serif;

            font-size:
                clamp(48px, 7vw, 86px);

            line-height: 0.95;

            font-weight: 600;
        }


        .news-hero h1 span {
            color: #c5a45a;
        }


        .news-hero-text {
            max-width: 650px;

            margin-top: 25px;

            color:
                rgba(255,255,255,0.72);

            font-size: 16px;

            line-height: 1.9;

            font-weight: 300;
        }


        /* =====================================================
           CONTENT
        ===================================================== */

        .news-content {
            max-width: 1180px;

            margin: 0 auto;

            padding:
                70px 5%
                90px;
        }


        /* =====================================================
           FEATURED
        ===================================================== */

        .featured-news {
            display: grid;

            grid-template-columns:
                1fr 1fr;

            background: #ffffff;

            box-shadow:
                0 20px 60px
                rgba(7,26,43,0.09);

            margin-bottom: 80px;
        }


        .featured-visual {
            min-height: 420px;

            position: relative;

            overflow: hidden;

            display: flex;

            align-items: flex-end;

            padding: 35px;

            background:
                linear-gradient(
                    135deg,
                    #071a2b,
                    #17374d
                );
        }


        .featured-visual::before {
            content: "";

            position: absolute;

            width: 350px;
            height: 350px;

            border:
                1px solid
                rgba(197,164,90,0.25);

            border-radius: 50%;

            top: -130px;
            right: -100px;
        }


        .featured-visual::after {
            content: "";

            position: absolute;

            width: 220px;
            height: 220px;

            border:
                1px solid
                rgba(197,164,90,0.15);

            border-radius: 50%;

            bottom: -130px;
            left: -80px;
        }


        .featured-icon {
            position: absolute;

            z-index: 2;

            top: 50%;
            left: 50%;

            transform:
                translate(-50%, -50%);

            width: 120px;
            height: 120px;

            border:
                1px solid
                rgba(197,164,90,0.55);

            border-radius: 50%;

            display: flex;

            justify-content: center;
            align-items: center;

            color: #c5a45a;

            font-size: 48px;

            font-family: Georgia, serif;
        }


        .featured-label {
            position: relative;

            z-index: 2;

            color: #c5a45a;

            font-size: 12px;

            letter-spacing: 3px;

            text-transform: uppercase;

            font-weight: 700;
        }


        .featured-content {
            padding: 55px;

            display: flex;

            justify-content: center;

            flex-direction: column;
        }


        .news-date {
            color: #c5a45a;

            font-size: 11px;

            letter-spacing: 2px;

            text-transform: uppercase;

            font-weight: 700;
        }


        .featured-content h2 {
            margin: 15px 0;

            color: #071a2b;

            font-family:
                Georgia,
                "Times New Roman",
                serif;

            font-size: 40px;

            line-height: 1.08;

            font-weight: 600;
        }


        .featured-content p {
            color: #555555;

            line-height: 1.85;

            font-size: 15px;

            font-weight: 300;
        }


        .featured-button-wrap {
            margin-top: 20px;
        }


        /* =====================================================
           BUTTON
        ===================================================== */

        .news-button {
            display: inline-flex;

            align-items: center;
            justify-content: center;

            background: #c5a45a;

            color: #071a2b;

            padding:
                14px 24px;

            text-decoration: none;

            font-size: 11px;

            font-weight: 700;

            letter-spacing: 1.5px;

            text-transform: uppercase;

            transition:
                all 0.3s ease;
        }


        .news-button:hover {
            background: #e0c67b;

            color: #071a2b;

            transform:
                translateY(-2px);
        }


        /* =====================================================
           SECTION HEADING
        ===================================================== */

        .news-section-heading {
            margin-bottom: 30px;
        }


        .news-section-heading h2 {
            margin: 0;

            color: #071a2b;

            font-family:
                Georgia,
                "Times New Roman",
                serif;

            font-size: 46px;

            font-weight: 600;
        }


        .news-section-heading p {
            max-width: 600px;

            margin-top: 12px;

            color: #777777;

            line-height: 1.7;
        }


        /* =====================================================
           NEWS GRID
        ===================================================== */

        .news-grid {
            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 22px;
        }


        .news-card {
            background: #ffffff;

            border:
                1px solid
                rgba(7,26,43,0.06);

            transition:
                all 0.35s ease;
        }


        .news-card:hover {
            transform:
                translateY(-8px);

            box-shadow:
                0 20px 50px
                rgba(7,26,43,0.1);
        }


        .news-card-top {
            height: 175px;

            position: relative;

            overflow: hidden;

            background:
                linear-gradient(
                    135deg,
                    #071a2b,
                    #17374d
                );
        }


        .news-card-top::before {
            content: "";

            position: absolute;

            width: 180px;
            height: 180px;

            border:
                1px solid
                rgba(197,164,90,0.3);

            border-radius: 50%;

            right: -60px;
            top: -70px;
        }


        .news-card-number {
            position: absolute;

            left: 25px;
            bottom: 20px;

            color: #c5a45a;

            font-family: Georgia, serif;

            font-size: 42px;
        }


        .news-card-content {
            padding: 28px;
        }


        .news-category {
            color: #c5a45a;

            font-size: 10px;

            font-weight: 700;

            letter-spacing: 2px;

            text-transform: uppercase;
        }


        .news-card h3 {
            margin:
                10px 0;

            color: #071a2b;

            font-family:
                Georgia,
                "Times New Roman",
                serif;

            font-size: 25px;

            line-height: 1.15;
        }


        .news-card p {
            color: #666666;

            font-size: 14px;

            line-height: 1.75;
        }


        .read-more {
            display: inline-block;

            margin-top: 12px;

            color: #071a2b;

            text-decoration: none;

            font-size: 11px;

            font-weight: 700;

            letter-spacing: 1px;

            text-transform: uppercase;
        }


        .read-more:hover {
            color: #c5a45a;
        }


        /* =====================================================
           EVENTS
        ===================================================== */

        .events-section {
            margin-top: 90px;
        }


        .events-list {
            border-top:
                1px solid
                rgba(7,26,43,0.12);
        }


        .event-row {
            display: grid;

            grid-template-columns:
                90px 1fr 45px;

            align-items: center;

            gap: 25px;

            padding: 25px 0;

            border-bottom:
                1px solid
                rgba(7,26,43,0.1);

            transition:
                all 0.3s ease;
        }


        .event-row:hover {
            padding-left: 12px;
            padding-right: 12px;
        }


        .event-date {
            text-align: center;

            border-right:
                1px solid
                rgba(197,164,90,0.5);

            padding-right: 20px;
        }


        .event-date strong {
            display: block;

            color: #071a2b;

            font-family: Georgia, serif;

            font-size: 38px;

            line-height: 1;
        }


        .event-date span {
            color: #c5a45a;

            font-size: 10px;

            font-weight: 700;

            letter-spacing: 2px;
        }


        .event-info h3 {
            margin:
                0 0 6px;

            color: #071a2b;

            font-family: Georgia, serif;

            font-size: 23px;
        }


        .event-info p {
            margin: 0;

            color: #777777;

            font-size: 13px;
        }


        .event-arrow {
            width: 38px;
            height: 38px;

            border:
                1px solid
                rgba(197,164,90,0.5);

            border-radius: 50%;

            display: flex;

            align-items: center;
            justify-content: center;

            color: #c5a45a;

            transition:
                all 0.3s ease;
        }


        .event-row:hover .event-arrow {
            background: #c5a45a;

            color: #071a2b;
        }


        /* =====================================================
           CTA
        ===================================================== */

        .news-cta {
            margin-top: 90px;

            padding:
                65px 30px;

            background:
                linear-gradient(
                    135deg,
                    #071a2b,
                    #0c2235
                );

            text-align: center;

            position: relative;

            overflow: hidden;
        }


        .news-cta h2 {
            margin: 0;

            color: #ffffff;

            font-family:
                Georgia,
                serif;

            font-size: 42px;
        }


        .news-cta p {
            max-width: 620px;

            margin:
                15px auto 25px;

            color:
                rgba(255,255,255,0.7);

            line-height: 1.8;
        }


        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @media (max-width: 900px) {

            .featured-news {
                grid-template-columns: 1fr;
            }

            .featured-visual {
                min-height: 300px;
            }

            .news-grid {
                grid-template-columns:
                    1fr 1fr;
            }

        }


        @media (max-width: 650px) {

            .news-hero {
                padding:
                    80px 7%
                    65px;
            }

            .news-content {
                padding:
                    55px 7%
                    70px;
            }

            .news-grid {
                grid-template-columns: 1fr;
            }

            .featured-content {
                padding: 35px 25px;
            }

            .featured-content h2 {
                font-size: 32px;
            }

            .news-section-heading h2 {
                font-size: 36px;
            }

            .event-row {
                grid-template-columns:
                    70px 1fr;

                gap: 15px;
            }

            .event-arrow {
                display: none;
            }

            .news-cta {
                padding:
                    50px 20px;
            }

            .news-cta h2 {
                font-size: 34px;
            }

        }

    </style>


</body>
</html>

