```ejs
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Read the latest announcements, school news and upcoming events from St. Martin's High School, Balanagar, Hyderabad.">
    <title>News & Updates | St. Martin's High School</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link rel="stylesheet" href="/css/style.css">

    <style>
        .news-page{background:#f8f7f3;color:#263448;min-height:70vh}
        .news-hero{background:linear-gradient(120deg,#071a2b,#123d55);color:white;text-align:center;padding:85px 22px}
        .news-hero span{color:#e0c67b;font-size:12px;letter-spacing:4px;text-transform:uppercase;font-weight:700}
        .news-hero h1{font-size:clamp(36px,5vw,60px);margin:16px 0}
        .news-hero p{max-width:720px;margin:auto;color:#e0e7ed;line-height:1.8}
        .news-container{width:min(1150px,92%);margin:auto;padding:55px 0}
        .news-heading{font-size:clamp(26px,3vw,36px);color:#102b42;margin-bottom:12px}
        .news-subheading{color:#657181;line-height:1.8;margin-bottom:30px}
        .news-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:22px}
        .news-card{background:#fff;border:1px solid #e8e3d8;border-radius:12px;overflow:hidden}
        .news-card img{width:100%;height:220px;object-fit:cover;display:block}
        .news-content{padding:24px}
        .news-category{display:inline-block;background:#f3ead4;color:#735c24;padding:6px 10px;border-radius:30px;font-size:12px;font-weight:700}
        .news-content h3{font-size:22px;color:#102b42;margin:15px 0 10px;line-height:1.4}
        .news-content p{line-height:1.8;color:#66717e;white-space:pre-line}
        .news-date{font-size:13px;color:#8a7440;margin-top:15px}
        .news-empty{padding:26px;background:white;border:1px dashed #d7d2c7;border-radius:10px;color:#66717e;line-height:1.8}
        .news-link{display:inline-block;margin-top:16px;padding:12px 20px;border-radius:5px;background:#c5a45a;color:#071a2b;text-decoration:none;font-weight:700}
        .news-section{margin-bottom:60px}
        @media(max-width:600px){.news-hero{padding:60px 20px}.news-container{padding:38px 0}}
    </style>
</head>
<body>

<%- include('partials/header') %>

<%
    const pageUpdates = typeof updates !== 'undefined' && Array.isArray(updates) ? updates : [];
    const pageEvents = typeof events !== 'undefined' && Array.isArray(events) ? events : [];
%>

<main class="news-page">
    <section class="news-hero">
        <span>What's Happening at SMHS</span>
        <h1>News & Updates</h1>
        <p>
            Stay connected with school announcements, important notices,
            student activities and upcoming events at St. Martin's High School.
        </p>
    </section>

    <div class="news-container">
        <section class="news-section">
            <h2 class="news-heading">Latest School Announcements</h2>
            <p class="news-subheading">
                Official updates and announcements published by the school.
            </p>

            <% if (pageUpdates.length > 0) { %>
                <div class="news-grid">
                    <% pageUpdates.forEach(function(item) { %>
                        <article class="news-card">
                            <% if (item.image_url) { %>
                                <img src="<%= item.image_url %>" alt="<%= item.title %>" loading="lazy">
                            <% } %>
                            <div class="news-content">
                                <span class="news-category"><%= item.category || 'Announcement' %></span>
                                <h3><%= item.title %></h3>
                                <p><%= item.description || '' %></p>
                                <% if (item.created_at) { %>
                                    <div class="news-date">
                                        Published:
                                        <%= new Date(item.created_at).toLocaleDateString('en-IN', {day:'numeric',month:'long',year:'numeric'}) %>
                                    </div>
                                <% } %>
                            </div>
                        </article>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="news-empty">
                    <strong>No announcements have been published yet.</strong>
                    <br>
                    New school announcements will appear here after approval.
                    Please check again soon.
                </div>
            <% } %>
        </section>

        <section class="news-section">
            <h2 class="news-heading">Upcoming Events</h2>
            <p class="news-subheading">
                Keep track of important school dates, celebrations and activities.
            </p>

            <% if (pageEvents.length > 0) { %>
                <div class="news-grid">
                    <% pageEvents.forEach(function(event) { %>
                        <article class="news-card">
                            <div class="news-content">
                                <span class="news-category"><%= event.category || 'School Event' %></span>
                                <h3><%= event.title %></h3>
                                <p><%= event.description || 'Further details will be announced by the school.' %></p>
                                <div class="news-date">
                                    <strong>Date:</strong>
                                    <%= event.event_date || event.date || 'To be announced' %>
                                </div>
                                <% if (event.start_time) { %>
                                    <p><strong>Time:</strong> <%= event.start_time %><%= event.end_time ? ' – ' + event.end_time : '' %></p>
                                <% } %>
                                <% if (event.location) { %>
                                    <p><strong>Venue:</strong> <%= event.location %></p>
                                <% } %>
                            </div>
                        </article>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="news-empty">
                    There are no upcoming events published at this time.
                    <br>
                    <a href="/calendar" class="news-link">View Academic Calendar</a>
                </div>
            <% } %>
        </section>

        <section class="news-section">
            <h2 class="news-heading">Stay Connected</h2>
            <p class="news-subheading">
                Visit our student life page to learn more about school activities
                and the experiences that make learning meaningful.
            </p>
            <a href="/student-life" class="news-link">Explore Student Life</a>
            <a href="/contact" class="news-link" style="margin-left:8px">Contact the School</a>
        </section>
    </div>
</main>

<%- include('partials/footer') %>

</body>
</html>
```
