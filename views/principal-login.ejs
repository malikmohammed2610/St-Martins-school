<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>
        Principal Login | St. Martin's High School
    </title>

    <link rel="icon"
          type="image/png"
          href="/images/logo.png">

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background:
                radial-gradient(
                    circle at top right,
                    #4a3b19,
                    transparent 35%
                ),
                #07131f;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 25px;
            font-family: Arial, sans-serif;
        }

        .card {
            width: 100%;
            max-width: 470px;
            background: #f7f3ea;
            color: #172635;
            border-radius: 25px;
            padding: 45px;
            box-shadow: 0 30px 80px rgba(0,0,0,.5);
        }

        .brand {
            text-align: center;
            margin-bottom: 30px;
        }

        .brand img {
            width: 100px;
            height: 100px;
            object-fit: contain;
        }

        .eyebrow {
            margin-top: 18px;
            color: #9a7835;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 11px;
            font-weight: bold;
        }

        h1 {
            font-family: Georgia, serif;
            font-size: 34px;
            margin: 10px 0;
        }

        .brand p {
            color: #6b7580;
            line-height: 1.6;
        }

        .group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-weight: bold;
            font-size: 14px;
            margin-bottom: 8px;
        }

        input {
            width: 100%;
            padding: 15px;
            border: 1px solid #d4cfc5;
            border-radius: 11px;
            font-size: 15px;
            outline: none;
        }

        input:focus {
            border-color: #c5a45a;
            box-shadow: 0 0 0 3px rgba(197,164,90,.12);
        }

        button {
            width: 100%;
            padding: 16px;
            border: 0;
            border-radius: 11px;
            background: #132f48;
            color: white;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            background: #c5a45a;
            color: #172635;
        }

        .message {
            display: none;
            padding: 13px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .message.error {
            display: block;
            background: #f8e5e5;
            color: #982c2c;
        }

        .message.success {
            display: block;
            background: #e5f5e9;
            color: #27683c;
        }

        .bottom {
            text-align: center;
            margin-top: 25px;
            font-size: 14px;
        }

        .bottom a {
            color: #95732e;
            text-decoration: none;
            font-weight: bold;
        }

    </style>

</head>

<body>

<div class="card">

    <div class="brand">

        <img
            src="/images/logo.png"
            alt="St. Martin's High School"
        >

        <div class="eyebrow">
            Administration Portal
        </div>

        <h1>
            Principal Login
        </h1>

        <p>
            Secure administrative access to
            teacher account management.
        </p>

    </div>


    <div
        id="message"
        class="message"
    ></div>


    <form id="loginForm">

        <div class="group">

            <label>
                Principal Username
            </label>

            <input
                type="text"
                id="username"
                required
                autocomplete="username"
            >

        </div>


        <div class="group">

            <label>
                Password
            </label>

            <input
                type="password"
                id="password"
                required
                autocomplete="current-password"
            >

        </div>


        <button type="submit">
            Secure Sign In
        </button>

    </form>


    <div class="bottom">

        <a href="/">
            ← Return to School Website
        </a>

        <br><br>

        <a href="/teacher-login">
            Teacher Login
        </a>

    </div>

</div>


<script>

const form =
    document.getElementById("loginForm");

const message =
    document.getElementById("message");


form.addEventListener(
    "submit",
    async function(event) {

        event.preventDefault();

        message.className = "message";
        message.textContent = "";


        const username =
            document.getElementById("username")
                .value
                .trim();

        const password =
            document.getElementById("password")
                .value;


        try {

            const response =
                await fetch(
                    "/api/principal/login",
                    {

                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json"
                        },

                        body: JSON.stringify({
                            username,
                            password
                        })

                    }
                );


            const data =
                await response.json();


            if (!data.success) {

                message.className =
                    "message error";

                message.textContent =
                    data.error ||
                    "Invalid login.";

                return;
            }


            message.className =
                "message success";

            message.textContent =
                "Login successful. Opening dashboard...";


            setTimeout(
                () => {

                    window.location.href =
                        data.redirect ||
                        "/principal-dashboard";

                },
                600
            );


        } catch (error) {

            message.className =
                "message error";

            message.textContent =
                "Unable to connect to the server.";

        }

    }
);

</script>

</body>
</html>