<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Principal Login | St. Martin's High School</title>

    <link rel="icon"
          type="image/png"
          href="/images/Logo.png">

    <style>

        * {
            box-sizing: border-box;
        }

        :root {
            --navy: #07131f;
            --navy2: #0c2235;
            --gold: #c5a45a;
            --gold-light: #e0c67b;
            --ivory: #f7f3ea;
            --text: #172635;
        }

        html,
        body {
            margin: 0;
            width: 100%;
            min-height: 100%;
        }

        body {

            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 30px;

            font-family:
                Inter,
                Arial,
                sans-serif;

            background:

                radial-gradient(
                    circle at 15% 15%,
                    rgba(197,164,90,.20),
                    transparent 25%
                ),

                radial-gradient(
                    circle at 85% 10%,
                    rgba(50,105,145,.22),
                    transparent 28%
                ),

                radial-gradient(
                    circle at 50% 100%,
                    rgba(197,164,90,.10),
                    transparent 35%
                ),

                linear-gradient(
                    135deg,
                    #030b12,
                    #07131f 45%,
                    #0c2235
                );

            overflow: hidden;

            perspective: 1400px;
        }


        /* =========================
           BACKGROUND 3D ORBS
        ========================= */

        .scene {
            position: fixed;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
            z-index: 0;
        }


        .orb {

            position: absolute;

            border-radius: 50%;

            filter: blur(1px);

            transform-style: preserve-3d;

            box-shadow:
                inset -20px -20px 40px rgba(0,0,0,.45),
                inset 15px 15px 30px rgba(255,255,255,.08),
                0 25px 80px rgba(0,0,0,.35);
        }


        .orb.one {

            width: 190px;
            height: 190px;

            top: 8%;
            left: 5%;

            background:
                radial-gradient(
                    circle at 30% 25%,
                    #e0c67b,
                    #80662e 35%,
                    #211a0b 75%
                );

            animation:
                floatOne 8s ease-in-out infinite;
        }


        .orb.two {

            width: 260px;
            height: 260px;

            right: -80px;
            bottom: 5%;

            background:
                radial-gradient(
                    circle at 30% 25%,
                    #365d78,
                    #102c42 45%,
                    #030b12 80%
                );

            animation:
                floatTwo 10s ease-in-out infinite;
        }


        .orb.three {

            width: 85px;
            height: 85px;

            right: 18%;
            top: 13%;

            background:
                radial-gradient(
                    circle at 30% 25%,
                    #f1d992,
                    #80662e 45%,
                    #211a0b
                );

            animation:
                floatThree 6s ease-in-out infinite;
        }


        @keyframes floatOne {

            0%,100% {
                transform:
                    translate3d(0,0,0)
                    rotateX(0deg)
                    rotateY(0deg);
            }

            50% {
                transform:
                    translate3d(35px,45px,100px)
                    rotateX(25deg)
                    rotateY(35deg);
            }
        }


        @keyframes floatTwo {

            0%,100% {
                transform:
                    translate3d(0,0,0)
                    rotateY(0deg);
            }

            50% {
                transform:
                    translate3d(-50px,-40px,80px)
                    rotateY(30deg);
            }
        }


        @keyframes floatThree {

            0%,100% {
                transform:
                    translate3d(0,0,0);
            }

            50% {
                transform:
                    translate3d(-35px,30px,120px)
                    rotateX(180deg);
            }
        }


        /* =========================
           PARTICLES
        ========================= */

        .particle {

            position: absolute;

            width: 4px;
            height: 4px;

            border-radius: 50%;

            background: var(--gold-light);

            box-shadow:
                0 0 12px var(--gold);

            opacity: .45;

            animation:
                particleFloat linear infinite;
        }


        .p1 {
            left: 15%;
            bottom: -10px;
            animation-duration: 11s;
        }

        .p2 {
            left: 30%;
            bottom: -10px;
            animation-duration: 14s;
        }

        .p3 {
            left: 65%;
            bottom: -10px;
            animation-duration: 9s;
        }

        .p4 {
            left: 80%;
            bottom: -10px;
            animation-duration: 13s;
        }

        .p5 {
            left: 45%;
            bottom: -10px;
            animation-duration: 16s;
        }


        @keyframes particleFloat {

            0% {
                transform:
                    translateY(0)
                    scale(.5);

                opacity: 0;
            }

            20% {
                opacity: .6;
            }

            80% {
                opacity: .5;
            }

            100% {
                transform:
                    translateY(-110vh)
                    scale(1.3);

                opacity: 0;
            }
        }


        /* =========================
           CARD
        ========================= */

        .card-wrapper {

            position: relative;

            z-index: 5;

            width: 100%;
            max-width: 470px;

            transform-style: preserve-3d;

            transition:
                transform .15s ease-out;
        }


        .card {

            position: relative;

            width: 100%;

            padding: 45px;

            border-radius: 28px;

            background:

                linear-gradient(
                    145deg,
                    rgba(255,255,255,.96),
                    rgba(247,243,234,.94)
                );

            color: var(--text);

            box-shadow:

                0 50px 120px rgba(0,0,0,.55),

                0 15px 40px rgba(0,0,0,.30),

                inset 0 1px 0 rgba(255,255,255,.9);

            transform-style: preserve-3d;

            border:
                1px solid rgba(255,255,255,.55);

            overflow: hidden;
        }


        /* Gold light reflection */

        .card::before {

            content: "";

            position: absolute;

            width: 300px;
            height: 300px;

            top: -180px;
            right: -130px;

            background:
                radial-gradient(
                    circle,
                    rgba(197,164,90,.28),
                    transparent 65%
                );

            pointer-events: none;
        }


        .card::after {

            content: "";

            position: absolute;

            inset: 10px;

            border-radius: 20px;

            border:
                1px solid rgba(197,164,90,.15);

            pointer-events: none;
        }


        /* =========================
           BRAND
        ========================= */

        .brand {

            position: relative;

            z-index: 2;

            text-align: center;

            margin-bottom: 30px;

            transform:
                translateZ(35px);
        }


        .brand img {

            width: 105px;
            height: 105px;

            object-fit: contain;

            filter:
                drop-shadow(
                    0 12px 15px rgba(0,0,0,.20)
                );

            transition:
                transform .5s ease;
        }


        .brand img:hover {

            transform:
                translateY(-5px)
                rotateY(12deg)
                rotateX(8deg)
                scale(1.04);
        }


        .eyebrow {

            margin-top: 16px;

            color: #9a7835;

            text-transform: uppercase;

            letter-spacing: 3px;

            font-size: 10px;

            font-weight: 800;
        }


        h1 {

            font-family:
                Georgia,
                "Times New Roman",
                serif;

            font-size: 34px;

            margin:
                10px 0;

            letter-spacing: -.5px;

            color: #172635;
        }


        .brand p {

            color: #6b7580;

            line-height: 1.6;

            margin-bottom: 0;
        }


        /* =========================
           FORM
        ========================= */

        .form-area {

            position: relative;

            z-index: 3;

            transform:
                translateZ(25px);
        }


        .group {

            margin-bottom: 20px;
        }


        label {

            display: block;

            font-weight: 700;

            font-size: 13px;

            margin-bottom: 8px;

            color: #263746;
        }


        .input-wrap {

            position: relative;
        }


        .input-wrap::before {

            content: "";

            position: absolute;

            left: 15px;

            top: 50%;

            width: 6px;
            height: 6px;

            border-radius: 50%;

            background:
                var(--gold);

            box-shadow:
                0 0 8px
                rgba(197,164,90,.7);

            transform:
                translateY(-50%);

            z-index: 2;
        }


        input {

            width: 100%;

            padding:
                15px
                15px
                15px
                30px;

            border:
                1px solid #d4cfc5;

            border-radius: 12px;

            font-size: 15px;

            outline: none;

            background:
                rgba(255,255,255,.75);

            color: #172635;

            transition:
                .25s ease;

            box-shadow:
                inset 0 2px 5px
                rgba(0,0,0,.03);
        }


        input:hover {

            border-color:
                #bda15f;

            transform:
                translateY(-1px);
        }


        input:focus {

            border-color:
                var(--gold);

            background:
                #fff;

            box-shadow:

                0 0 0 4px
                rgba(197,164,90,.12),

                0 8px 20px
                rgba(0,0,0,.07);

            transform:
                translateY(-2px);
        }


        /* =========================
           BUTTON
        ========================= */

        button {

            position: relative;

            width: 100%;

            padding: 16px;

            border: 0;

            border-radius: 12px;

            background:

                linear-gradient(
                    135deg,
                    #0c2235,
                    #173b58
                );

            color: white;

            font-weight: 800;

            letter-spacing: .3px;

            cursor: pointer;

            overflow: hidden;

            box-shadow:

                0 10px 25px
                rgba(7,19,31,.28),

                inset 0 1px 0
                rgba(255,255,255,.12);

            transition:
                .3s ease;

            transform:
                translateZ(20px);
        }


        button::before {

            content: "";

            position: absolute;

            top: 0;
            left: -120%;

            width: 80%;
            height: 100%;

            background:
                linear-gradient(
                    90deg,
                    transparent,
                    rgba(255,255,255,.28),
                    transparent
                );

            transform:
                skewX(-20deg);

            transition:
                left .7s ease;
        }


        button:hover {

            background:

                linear-gradient(
                    135deg,
                    #c5a45a,
                    #e0c67b
                );

            color: #172635;

            transform:
                translateY(-3px)
                translateZ(25px);

            box-shadow:

                0 18px 35px
                rgba(117,89,28,.25);
        }


        button:hover::before {

            left: 140%;
        }


        button:active {

            transform:
                translateY(0)
                translateZ(15px)
                scale(.99);
        }


        /* =========================
           MESSAGE
        ========================= */

        .message {

            display: none;

            padding: 13px;

            border-radius: 10px;

            margin-bottom: 20px;

            font-size: 14px;

            font-weight: 600;

            transform:
                translateZ(20px);
        }


        .message.error {

            display: block;

            background: #f8e5e5;

            color: #982c2c;

            border:
                1px solid #edc8c8;
        }


        .message.success {

            display: block;

            background: #e5f5e9;

            color: #27683c;

            border:
                1px solid #c4e5cc;
        }


        /* =========================
           FOOTER
        ========================= */

        .bottom {

            position: relative;

            z-index: 2;

            text-align: center;

            margin-top: 25px;

            font-size: 13px;

            line-height: 1.8;

            transform:
                translateZ(20px);
        }


        .bottom a {

            color: #95732e;

            text-decoration: none;

            font-weight: 700;

            transition:
                .2s ease;
        }


        .bottom a:hover {

            color: #c5a45a;

            text-shadow:
                0 0 10px
                rgba(197,164,90,.3);
        }


        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 600px) {

            body {
                padding: 18px;
            }

            .card {
                padding: 32px 25px;
                border-radius: 22px;
            }

            h1 {
                font-size: 29px;
            }

            .brand img {
                width: 90px;
                height: 90px;
            }

            .orb.one {
                width: 120px;
                height: 120px;
            }

            .orb.two {
                width: 170px;
                height: 170px;
            }
        }

    </style>

</head>


<body>


<!-- =========================
     3D BACKGROUND
========================= -->

<div class="scene">

    <div class="orb one"></div>

    <div class="orb two"></div>

    <div class="orb three"></div>

    <div class="particle p1"></div>
    <div class="particle p2"></div>
    <div class="particle p3"></div>
    <div class="particle p4"></div>
    <div class="particle p5"></div>

</div>


<!-- =========================
     LOGIN CARD
========================= -->

<div class="card-wrapper" id="cardWrapper">

    <div class="card">

        <div class="brand">

            <img
                src="/images/Logo.png"
                alt="St. Martin's High School"
            >

            <div class="eyebrow">
                Administration Portal
            </div>

            <h1>
                Principal Login
            </h1>

            <p>
                Secure administrative access to
                teacher account management.
            </p>

        </div>


        <div
            id="message"
            class="message"
        ></div>


        <div class="form-area">

            <form id="loginForm">

                <div class="group">

                    <label for="username">
                        Principal Username
                    </label>

                    <div class="input-wrap">

                        <input
                            type="text"
                            id="username"
                            required
                            autocomplete="username"
                            placeholder="Enter principal username"
                        >

                    </div>

                </div>


                <div class="group">

                    <label for="password">
                        Password
                    </label>

                    <div class="input-wrap">

                        <input
                            type="password"
                            id="password"
                            required
                            autocomplete="current-password"
                            placeholder="Enter password"
                        >

                    </div>

                </div>


                <button type="submit">
                    Secure Sign In
                </button>

            </form>

        </div>


        <div class="bottom">

            <a href="/">
                ← Return to School Website
            </a>

            <br>

            <a href="/teacher-login">
                Teacher Login
            </a>

        </div>

    </div>

</div>


<script>

/* ==========================================
   3D MOUSE TILT
========================================== */

const cardWrapper =
    document.getElementById("cardWrapper");


document.addEventListener(
    "mousemove",
    (event) => {

        const x =
            (window.innerWidth / 2 - event.clientX)
            / 35;

        const y =
            (window.innerHeight / 2 - event.clientY)
            / 35;


        cardWrapper.style.transform =
            `rotateY(${-x}deg)
             rotateX(${y}deg)
             translateZ(10px)`;
    }
);


document.addEventListener(
    "mouseleave",
    () => {

        cardWrapper.style.transform =
            "rotateY(0deg) rotateX(0deg)";
    }
);


/* ==========================================
   LOGIN
========================================== */

const form =
    document.getElementById("loginForm");

const message =
    document.getElementById("message");


form.addEventListener(
    "submit",
    async function(event) {

        event.preventDefault();

        message.className =
            "message";

        message.textContent =
            "";


        const username =
            document
                .getElementById("username")
                .value
                .trim();


        const password =
            document
                .getElementById("password")
                .value;


        try {

            const response =
                await fetch(
                    "/api/principal/login",
                    {

                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json"
                        },

                        body:
                            JSON.stringify({
                                username,
                                password
                            })

                    }
                );


            const data =
                await response.json();


            if (!data.success) {

                message.className =
                    "message error";

                message.textContent =
                    data.message || data.error ||
                    "Invalid login.";

                return;
            }


            message.className =
                "message success";

            message.textContent =
                "Login successful. Opening dashboard...";


            setTimeout(
                () => {

                    window.location.href =
                        data.redirect ||
                        "/principal-dashboard";

                },
                600
            );


        } catch (error) {

            message.className =
                "message error";

            message.textContent =
                "Unable to connect to the server.";

        }

    }
);

</script>

<script src="data.js"></script>

</body>

</html>