            }


            .md-trust-grid {
                grid-template-columns: 1fr;
            }


            .md-location-grid {
                grid-template-columns: 1fr;
            }

        }


        @media (max-width: 650px) {

            .md-container {
                width: min(
                    100% - 36px,
