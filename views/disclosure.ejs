<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Mandatory Disclosure | St. Martin's High School</title>

    <meta
        name="description"
        content="Mandatory Public Disclosure and institutional information of St. Martin's High School, Balanagar, Hyderabad."
    >

    <!-- Existing Website CSS -->
    <link rel="stylesheet" href="/css/style.css">

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <!-- Premium Typography -->
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <style>

        :root {
            --navy: #071A2B;
            --navy-dark: #04111D;
            --navy-soft: #0D263D;

            --gold: #C5A45A;
            --gold-light: #E0CA8B;

            --ivory: #F6F1E7;
            --cream: #FBF8F1;

            --white: #FFFFFF;

            --text: #20252A;
            --muted: #687078;

            --border: rgba(7, 26, 43, 0.10);
        }


        /* ==========================================
           GLOBAL
        ========================================== */

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: var(--ivory);
            color: var(--text);
            font-family: "Inter", sans-serif;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
        }

        .container {
            max-width: 1180px;
        }


/* ==========================================
   TOP BRAND HEADER
========================================== */

.school-header {
    background: var(--white);
    border-bottom: 1px solid rgba(197,164,90,0.22);

    position: relative !important;
    top: auto !important;

    width: 100%;
    z-index: 1050;
}

.brand-container {
    min-height: 88px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.school-brand {
    display: flex;
    align-items: center;
    color: var(--navy);
}

.school-logo {
    width: 64px;
    height: 64px;
    object-fit: contain;
    margin-right: 16px;
}

.school-name {
    margin: 0;

    font-family: "Cormorant Garamond", serif;

    font-size: 1.45rem;
    line-height: 1;

    font-weight: 700;
    letter-spacing: 0.04em;

    color: var(--navy);
}

.school-location {
    display: block;

    margin-top: 6px;

    font-size: 0.67rem;
    letter-spacing: 0.19em;

    text-transform: uppercase;

    color: #737B82;
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 25px;
}

.header-phone {
    color: var(--muted);
    font-size: 0.82rem;
}

.header-phone i {
    color: var(--gold);
    margin-right: 7px;
}

.teacher-button {
    border: 1px solid var(--navy);

    padding: 10px 18px;

    color: var(--navy);

    font-size: 0.7rem;
    font-weight: 500;

    letter-spacing: 0.13em;
    text-transform: uppercase;

    transition: all 0.3s ease;

    text-decoration: none;
}

.teacher-button:hover {
    background: var(--navy);
    color: var(--white);
}


/* ==========================================
   NAVIGATION
========================================== */

.main-navigation {
    background: var(--navy);

    min-height: 53px;

    position: relative !important;
    top: auto !important;

    z-index: 1040;

    box-shadow:
        0 5px 20px rgba(7,26,43,0.13);
}

.main-navigation .navbar-nav {
    width: 100%;
    justify-content: space-between;
}

.main-navigation .nav-link {
    color: rgba(255,255,255,0.93) !important;

    padding: 17px 7px !important;

    font-size: 0.74rem;
    font-weight: 500;

    letter-spacing: 0.09em;

    transition: color 0.3s ease;
}

.main-navigation .nav-link:hover {
    color: var(--gold-light) !important;
}

.main-navigation .dropdown-menu {
    margin-top: 0;

    border: 0;

    border-top: 2px solid var(--gold);

    border-radius: 0;

    padding: 8px 0;

    min-width: 220px;

    box-shadow:
        0 20px 50px rgba(7,26,43,0.20);

    z-index: 2000;
}

.main-navigation .dropdown-item {
    padding: 11px 22px;

    font-size: 0.8rem;

    color: var(--navy);

    transition: all 0.2s ease;
}

.main-navigation .dropdown-item:hover {
    background: var(--cream);

    color: var(--navy);

    padding-left: 27px;
}

.navbar-toggler {
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 0;
}


/* ==========================================
   DISCLOSURE HERO
========================================== */

.disclosure-hero {
    position: relative;

    z-index: 1;

    width: 100%;

    min-height: 390px;

    /*
       IMPORTANT:
       Force the hero content to begin BELOW
       the navigation instead of being vertically
       pulled underneath it.
    */
    display: block;

    overflow: hidden;

    padding: 80px 0 90px;

    margin: 0 !important;

    background:
        linear-gradient(
            110deg,
            rgba(4,17,29,0.98),
            rgba(7,26,43,0.90),
            rgba(7,26,43,0.70)
        ),
        url("/images/hero-bg.jpg")
        center center / cover no-repeat;
}


/* ==========================================
   HERO DECORATIVE CIRCLES
========================================== */

.disclosure-hero::before {
    content: "";

    position: absolute;

    width: 500px;
    height: 500px;

    right: -180px;
    top: -220px;

    border: 1px solid rgba(197,164,90,0.30);

    border-radius: 50%;

    pointer-events: none;
}

.disclosure-hero::after {
    content: "";

    position: absolute;

    width: 300px;
    height: 300px;

    right: -50px;
    bottom: -190px;

    border: 1px solid rgba(197,164,90,0.18);

    border-radius: 50%;

    pointer-events: none;
}


/* ==========================================
   HERO CONTENT — FIXED POSITION
========================================== */

.hero-content {
    position: relative !important;

    z-index: 10 !important;

    width: 100%;

    max-width: 820px;

    /*
       This prevents global hero styles from
       pulling the content upward.
    */
    transform: none !important;

    margin-top: 0 !important;

    margin-bottom: 0 !important;
}


/* ==========================================
   HERO EYEBROW
========================================== */

.hero-eyebrow {
    color: var(--gold-light);

    font-size: 0.72rem;

    font-weight: 600;

    letter-spacing: 0.28em;

    text-transform: uppercase;

    display: block;

    margin-bottom: 0;
}


/* ==========================================
   HERO TITLE
========================================== */

.hero-title {
    margin: 17px 0 22px !important;

    color: var(--white) !important;

    font-family: "Cormorant Garamond", serif;

    font-size: clamp(3rem, 7vw, 5rem);

    line-height: 0.94;

    font-weight: 600;

    position: relative;

    z-index: 20;

    /*
       Prevent any global transform from moving
       the title behind the navigation.
    */
    transform: none !important;

    visibility: visible !important;

    opacity: 1 !important;
}


/* ==========================================
   HERO DESCRIPTION
========================================== */

.hero-description {
    max-width: 720px;

    color: rgba(255,255,255,0.72);

    font-size: 0.98rem;

    font-weight: 300;

    line-height: 1.9;

    position: relative;

    z-index: 10;

    margin-bottom: 0;
}


/* ==========================================
   HERO GOLD RULE
========================================== */

.hero-rule {
    width: 65px;

    height: 2px;

    margin-top: 28px;

    background: var(--gold);
}


/* ==========================================
   MAIN
========================================== */

.main-section {
    position: relative;

    z-index: 2;

    width: 100%;

    padding: 95px 0;

    margin-top: 0 !important;

    transform: none !important;

    visibility: visible !important;

    opacity: 1 !important;
}

.eyebrow {
    color: #98772D;

    font-size: 0.7rem;

    font-weight: 600;

    letter-spacing: 0.23em;

    text-transform: uppercase;
}

.section-title {
    margin: 13px 0;

    color: var(--navy);

    font-family: "Cormorant Garamond", serif;

    font-size: 2.8rem;

    font-weight: 600;
}

.gold-line {
    width: 62px;

    height: 2px;

    margin-bottom: 27px;

    background: var(--gold);
}

.intro-copy {
    max-width: 890px;

    color: var(--muted);

    font-size: 0.94rem;

    font-weight: 300;

    line-height: 1.95;
}


/* ==========================================
   DISCLOSURE PAGE — HARD POSITION FIX
========================================== */

/*
   These rules have !important deliberately.
   They override any older global header/hero
   positioning in style.css.
*/

.disclosure-page .school-header {
    position: relative !important;
    top: auto !important;
    transform: none !important;
}

.disclosure-page .main-navigation {
    position: relative !important;
    top: auto !important;
    transform: none !important;
}

.disclosure-page .disclosure-hero {
    position: relative !important;

    top: auto !important;
    left: auto !important;

    margin-top: 0 !important;

    transform: none !important;

    padding-top: 80px !important;
}

.disclosure-page .hero-content {
    position: relative !important;

    top: auto !important;
    left: auto !important;

    transform: none !important;

    margin-top: 0 !important;
}

.disclosure-page .hero-title {
    position: relative !important;

    top: auto !important;

    transform: none !important;

    margin-top: 17px !important;
}


/* ==========================================
   MOBILE
========================================== */

@media (max-width: 991px) {

    .brand-container {
        min-height: 78px;
    }

    .school-logo {
        width: 54px;
        height: 54px;

        margin-right: 12px;
    }

    .school-name {
        font-size: 1.15rem;
    }

    .school-location {
        font-size: 0.58rem;

        letter-spacing: 0.13em;
    }

    .header-actions {
        gap: 12px;
    }

    .header-phone {
        display: none;
    }

    .teacher-button {
        padding: 8px 12px;

        font-size: 0.62rem;
    }

    .disclosure-hero {
        min-height: 340px;

        padding: 65px 0 75px;
    }

    .hero-title {
        font-size: clamp(2.6rem, 10vw, 4rem);
    }

    .main-section {
        padding: 70px 0;
    }

    .disclosure-page .disclosure-hero {
        padding-top: 65px !important;
    }
}


/* ==========================================
   SMALL MOBILE
========================================== */

@media (max-width: 575px) {

    .brand-container {
        min-height: 72px;
    }

    .school-logo {
        width: 48px;
        height: 48px;
    }

    .school-name {
        font-size: 1rem;
    }

    .school-location {
        margin-top: 4px;

        font-size: 0.52rem;
    }

    .teacher-button {
        padding: 7px 9px;

        font-size: 0.56rem;

        letter-spacing: 0.08em;
    }

    .disclosure-hero {
        min-height: 310px;

        padding: 55px 0 65px;
    }

    .hero-title {
        font-size: 2.7rem;
    }

    .hero-description {
        font-size: 0.88rem;

        line-height: 1.75;
    }

    .section-title {
        font-size: 2.25rem;
    }

    .disclosure-page .disclosure-hero {
        padding-top: 55px !important;
    }
}

        /* ==========================================
           INFORMATION TABLE
        ========================================== */

        .disclosure-wrapper {
            margin-top: 48px;

            background: var(--white);

            border: 1px solid rgba(197,164,90,0.27);

            box-shadow:
                0 20px 65px rgba(7,26,43,0.07);

            overflow: hidden;
        }

        .disclosure-table {
            margin: 0;
        }

        .disclosure-table thead {
            background: var(--navy);
        }

        .disclosure-table th {
            padding: 21px 25px;

            color: var(--white);

            border: 0;

            font-family: "Cormorant Garamond", serif;

            font-size: 1.18rem;
            font-weight: 600;
        }

        .disclosure-table td {
            padding: 18px 25px;

            color: #596168;

            border-color: rgba(7,26,43,0.07);

            font-size: 0.87rem;

            line-height: 1.65;
        }

        .disclosure-table td:first-child {
            width: 36%;

            color: var(--navy);

            font-weight: 600;
        }

        .disclosure-table tbody tr {
            transition: background 0.2s ease;
        }

        .disclosure-table tbody tr:hover {
            background: #FCFAF5;
        }


        /* ==========================================
           QUICK STATISTICS
        ========================================== */

        .stats-section {
            padding: 0 0 95px;
        }

        .stat-card {
            height: 100%;

            padding: 32px 27px;

            background: var(--white);

            border: 1px solid rgba(197,164,90,0.20);

            transition: all 0.35s ease;
        }

        .stat-card:hover {
            transform: translateY(-7px);

            border-color: rgba(197,164,90,0.50);

            box-shadow:
                0 20px 50px rgba(7,26,43,0.09);
        }

        .stat-icon {
            width: 49px;
            height: 49px;

            display: flex;
            align-items: center;
            justify-content: center;

            margin-bottom: 20px;

            color: var(--gold);

            border: 1px solid rgba(197,164,90,0.45);
        }

        .stat-card h3 {
            margin-bottom: 10px;

            color: var(--navy);

            font-family: "Cormorant Garamond", serif;

            font-size: 1.55rem;
            font-weight: 600;
        }

        .stat-card p {
            margin: 0;

            color: var(--muted);

            font-size: 0.83rem;

            line-height: 1.8;
        }


        /* ==========================================
           DETAILED INFORMATION
        ========================================== */

        .details-section {
            padding: 95px 0;

            background: var(--cream);
        }

        .detail-panel {
            height: 100%;

            padding: 38px;

            background: var(--white);

            border: 1px solid rgba(197,164,90,0.20);

            box-shadow:
                0 10px 35px rgba(7,26,43,0.035);
        }

        .detail-number {
            color: var(--gold);

            font-family: "Cormorant Garamond", serif;

            font-size: 2.3rem;

            line-height: 1;
        }

        .detail-panel h3 {
            margin: 10px 0 14px;

            color: var(--navy);

            font-family: "Cormorant Garamond", serif;

            font-size: 1.65rem;
        }

        .detail-panel p {
            margin: 0;

            color: var(--muted);

            font-size: 0.85rem;

            line-height: 1.9;
        }

        .detail-panel ul {
            margin: 17px 0 0;
            padding-left: 18px;
        }

        .detail-panel li {
            margin-bottom: 9px;

            color: #626A70;

            font-size: 0.82rem;

            line-height: 1.65;
        }


        /* ==========================================
           DOCUMENTS
        ========================================== */

        .documents-section {
            padding: 95px 0;
        }

        .document-row {
            background: var(--white);

            border: 1px solid rgba(197,164,90,0.20);

            margin-bottom: 12px;

            padding: 19px 22px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            transition: all 0.3s ease;
        }

        .document-row:hover {
            border-color: rgba(197,164,90,0.55);

            transform: translateX(4px);
        }

        .document-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .document-icon {
            width: 42px;
            height: 42px;

            display: flex;
            align-items: center;
            justify-content: center;

            color: var(--gold);

            background: var(--cream);

            border: 1px solid rgba(197,164,90,0.22);
        }

        .document-name {
            color: var(--navy);

            font-size: 0.86rem;
            font-weight: 600;
        }

        .document-description {
            margin-top: 3px;

            color: #7A8187;

            font-size: 0.74rem;
        }

        .document-status {
            color: #98772D;

            font-size: 0.67rem;
            font-weight: 600;

            letter-spacing: 0.1em;

            text-transform: uppercase;
        }


        /* ==========================================
           TRANSPARENCY
        ========================================== */

        .transparency-section {
            padding: 90px 0;

            background:
                linear-gradient(
                    120deg,
                    var(--navy-dark),
                    var(--navy-soft)
                );

            color: white;
        }

        .transparency-title {
            margin: 12px 0;

            color: white;

            font-family: "Cormorant Garamond", serif;

            font-size: 2.9rem;
        }

        .transparency-copy {
            max-width: 850px;

            color: rgba(255,255,255,0.67);

            font-size: 0.88rem;

            line-height: 1.95;
        }

        .transparency-list {
            list-style: none;

            padding: 0;

            margin-top: 30px;
        }

        .transparency-list li {
            padding: 12px 0;

            border-bottom: 1px solid rgba(255,255,255,0.09);

            color: rgba(255,255,255,0.70);

            font-size: 0.83rem;
        }

        .transparency-list i {
            color: var(--gold);

            margin-right: 10px;
        }


        /* ==========================================
           LOCATION
        ========================================== */

        .location-section {
            padding: 95px 0;

            background: var(--ivory);
        }

        .location-box {
            margin-top: 42px;

            background: white;

            border: 1px solid rgba(197,164,90,0.22);

            overflow: hidden;

            box-shadow:
                0 20px 60px rgba(7,26,43,0.06);
        }

        .location-content {
            padding: 42px;
        }

        .location-title {
            margin-bottom: 14px;

            color: var(--navy);

            font-family: "Cormorant Garamond", serif;

            font-size: 2.1rem;
        }

        .location-description {
            color: var(--muted);

            font-size: 0.86rem;

            line-height: 1.85;
        }

        .location-item {
            display: flex;

            gap: 13px;

            margin-top: 21px;

            color: #596168;

            font-size: 0.82rem;

            line-height: 1.65;
        }

        .location-item i {
            width: 20px;

            color: var(--gold);

            margin-top: 4px;
        }

        .map-frame {
            width: 100%;
            height: 100%;
            min-height: 410px;

            border: 0;
        }

        .directions-button {
            display: inline-block;

            margin-top: 23px;

            padding: 13px 20px;

            background: var(--navy);

            color: white;

            font-size: 0.69rem;
            font-weight: 500;

            letter-spacing: 0.12em;

            text-transform: uppercase;

            transition: all 0.3s ease;
        }

        .directions-button:hover {
            background: var(--gold);

            color: var(--navy);
        }


        /* ==========================================
           FOOTER
        ========================================== */

        .school-footer {
            padding-top: 75px;

            background: #04131F;

            color: rgba(255,255,255,0.67);
        }

        .footer-school-name {
            margin-bottom: 15px;

            color: white;

            font-family: "Cormorant Garamond", serif;

            font-size: 1.75rem;
            font-weight: 600;
        }

        .footer-description {
            max-width: 380px;

            color: rgba(255,255,255,0.55);

            font-size: 0.8rem;

            line-height: 1.9;
        }

        .footer-heading {
            margin-bottom: 20px;

            color: var(--gold-light);

            font-size: 0.7rem;
            font-weight: 600;

            letter-spacing: 0.17em;

            text-transform: uppercase;
        }

        .footer-links {
            list-style: none;

            margin: 0;
            padding: 0;
        }

        .footer-links li {
            margin-bottom: 10px;
        }

        .footer-links a {
            color: rgba(255,255,255,0.58);

            font-size: 0.79rem;

            transition: all 0.25s ease;
        }

        .footer-links a:hover {
            color: var(--gold-light);

            padding-left: 4px;
        }

        .footer-contact {
            color: rgba(255,255,255,0.58);

            font-size: 0.79rem;

            line-height: 1.85;
        }

        .footer-contact i {
            width: 21px;

            color: var(--gold);

            margin-right: 5px;
        }

        .footer-map {
            width: 100%;
            height: 190px;

            margin-top: 50px;

            border: 0;

            opacity: 0.82;
        }

        .footer-bottom {
            margin-top: 45px;

            padding: 21px 0;

            border-top: 1px solid rgba(255,255,255,0.08);

            color: rgba(255,255,255,0.39);

            font-size: 0.68rem;
        }


        /* ==========================================
           RESPONSIVE
        ========================================== */

        @media (max-width: 991px) {

            .header-actions {
                display: none;
            }

            .main-navigation .navbar-nav {
                padding: 10px 0;
            }

            .main-navigation .nav-link {
                padding: 12px 0 !important;
            }

            .disclosure-hero {
                min-height: 430px;
            }

            .map-frame {
                min-height: 320px;
            }

        }


        @media (max-width: 767px) {

            .school-logo {
                width: 52px;
                height: 52px;

                margin-right: 10px;
            }

            .school-name {
                font-size: 1.05rem;
            }

            .school-location {
                font-size: 0.54rem;

                letter-spacing: 0.13em;
            }

            .hero-title {
                font-size: 3.2rem;
            }

            .main-section,
            .documents-section,
            .location-section {
                padding: 65px 0;
            }

            .details-section {
                padding: 65px 0;
            }

            .transparency-section {
                padding: 65px 0;
            }

            .section-title,
            .transparency-title {
                font-size: 2.3rem;
            }

            .document-row {
                align-items: flex-start;
            }

            .document-status {
                display: none;
            }

            .location-content {
                padding: 30px;
            }

        }

    </style>

</head>


<body>


<!-- =========================================================
     SCHOOL HEADER
========================================================= -->

<header class="school-header">

    <div class="container">

        <div class="brand-container">

            <a href="/" class="school-brand">

                <img
                    src="/images/logo.png"
                    alt="St. Martin's High School Logo"
                    class="school-logo"
                    onerror="this.style.display='none'"
                >

                <div>

                    <h1 class="school-name">
                        ST. MARTIN'S HIGH SCHOOL
                    </h1>

                    <span class="school-location">
