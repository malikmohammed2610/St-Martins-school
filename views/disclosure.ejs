<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Mandatory Public Disclosure and institutional information of St. Martin's High School, Balanagar, Hyderabad."
    >

    <title>Mandatory Disclosure | St. Martin's High School</title>


    <!-- GLOBAL CSS -->
    <link rel="stylesheet" href="/css/style.css">


    <!-- BOOTSTRAP -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <!-- FONT AWESOME -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >


    <!-- FONTS -->
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    >


    <!-- =====================================================
         MANDATORY DISCLOSURE PAGE CSS
    ====================================================== -->

    <style>

        /* =====================================================
           PAGE BASE
        ====================================================== */

        .md-page {
            --md-navy: #071A2B;
            --md-dark: #04111D;
            --md-navy-soft: #0C2235;

            --md-gold: #C5A45A;
            --md-gold-light: #E0C67B;

            --md-ivory: #F6F1E7;
            --md-cream: #FBF8F1;

            --md-text: #20252A;
            --md-muted: #687078;

            width: 100%;
            display: block;
            visibility: visible;
            opacity: 1;
            color: var(--md-text);
            background: var(--md-cream);
            font-family: "Inter", sans-serif;
            overflow: hidden;
        }


        .md-page *,
        .md-page *::before,
        .md-page *::after {
            box-sizing: border-box;
        }


        .md-page main,
        .md-page section,
        .md-page article,
        .md-page div {
            visibility: visible;
        }


        /* =====================================================
           HERO
        ====================================================== */

        .md-hero {

            min-height: 610px;

            position: relative;

            overflow: hidden;

            display: flex;

            align-items: center;

            background:
                radial-gradient(
                    circle at 75% 45%,
                    rgba(197,164,90,0.18),
                    transparent 30%
                ),
                linear-gradient(
                    135deg,
                    #04111D 0%,
                    #071A2B 50%,
                    #0C2235 100%
                );

            color: white;

            padding: 145px 0 90px;
        }


        /* grid */

        .md-hero-grid {

            position: absolute;

            inset: 0;

            opacity: 0.12;

            background-image:
                linear-gradient(
                    rgba(255,255,255,0.08) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    90deg,
                    rgba(255,255,255,0.08) 1px,
                    transparent 1px
                );

            background-size: 55px 55px;

            pointer-events: none;
        }


        /* giant text */

        .md-hero-watermark {

            position: absolute;

            left: -20px;

            bottom: -35px;

            font-family: "Cormorant Garamond", serif;

            font-size: clamp(100px, 16vw, 230px);

            line-height: 0.8;

            font-weight: 700;

            color: rgba(255,255,255,0.025);

            white-space: nowrap;

            pointer-events: none;

            user-select: none;
        }


        .md-container {

            width: min(1240px, calc(100% - 50px));

            margin: 0 auto;

            position: relative;

            z-index: 5;
        }


        .md-hero-layout {

            display: grid;

            grid-template-columns: 1fr 0.8fr;

            gap: 40px;

            align-items: center;
        }


        .md-eyebrow {

            display: flex;

            align-items: center;

            gap: 12px;

            color: var(--md-gold-light);

            text-transform: uppercase;

            letter-spacing: 0.25em;

            font-size: 11px;

            font-weight: 700;

            margin-bottom: 22px;
        }


        .md-eyebrow::before {

            content: "";

            width: 38px;

            height: 1px;

            background: var(--md-gold);
        }


        .md-title {

            font-family: "Cormorant Garamond", serif;

            font-size: clamp(55px, 7vw, 92px);

            line-height: 0.9;

            font-weight: 500;

            margin: 0 0 25px;

            color: #ffffff;
        }


        .md-title span {

            display: block;

            color: var(--md-gold-light);

            font-style: italic;
        }


        .md-description {

            max-width: 650px;

            color: rgba(255,255,255,0.70);

            font-size: 15px;

            line-height: 1.9;

            margin-bottom: 30px;
        }


        .md-button {

            display: inline-flex;

            align-items: center;

            gap: 10px;

            padding: 14px 22px;

            border: 1px solid rgba(224,198,123,0.55);

            border-radius: 50px;

            color: var(--md-gold-light);

            text-decoration: none;

            font-size: 11px;

            font-weight: 700;

            letter-spacing: 0.13em;

            text-transform: uppercase;

            background: rgba(255,255,255,0.04);

            transition: 0.3s ease;
        }


        .md-button:hover {

            color: white;

            background: rgba(197,164,90,0.15);

            transform: translateY(-3px);
        }


        /* =====================================================
           HERO 3D OBJECT
        ====================================================== */

        .md-visual {

            height: 440px;

            position: relative;

            perspective: 1200px;

            display: flex;

            align-items: center;

            justify-content: center;
        }


        .md-ring {

            position: absolute;

            border-radius: 50%;

            border: 1px solid rgba(224,198,123,0.35);

            transform-style: preserve-3d;
        }


        .md-ring-1 {

            width: 370px;

            height: 370px;

            transform:
                rotateX(65deg)
                rotateY(15deg);

            animation: mdRotate1 18s linear infinite;
        }


        .md-ring-2 {

            width: 300px;

            height: 300px;

            transform:
                rotateY(65deg)
                rotateX(15deg);

            border-color: rgba(255,255,255,0.16);

            animation: mdRotate2 14s linear infinite reverse;
        }


        .md-ring-3 {

            width: 230px;

            height: 230px;

            transform:
                rotateX(70deg)
                rotateZ(30deg);

            border-color: rgba(224,198,123,0.55);

            animation: mdRotate3 10s linear infinite;
        }


        @keyframes mdRotate1 {

            from {
                transform:
                    rotateX(65deg)
                    rotateY(15deg)
                    rotateZ(0deg);
            }

            to {
                transform:
                    rotateX(65deg)
                    rotateY(15deg)
                    rotateZ(360deg);
            }
        }


        @keyframes mdRotate2 {

            from {
                transform:
                    rotateY(65deg)
                    rotateX(15deg)
                    rotateZ(0deg);
            }

            to {
                transform:
                    rotateY(65deg)
                    rotateX(15deg)
                    rotateZ(360deg);
            }
        }


        @keyframes mdRotate3 {

            from {
                transform:
                    rotateX(70deg)
                    rotateZ(30deg)
                    rotateY(0deg);
            }

            to {
                transform:
                    rotateX(70deg)
                    rotateZ(30deg)
                    rotateY(360deg);
            }
        }


        /* =====================================================
           3D DOCUMENT
        ====================================================== */

        .md-document {

            width: 205px;

            height: 270px;

            position: relative;

            z-index: 5;

            padding: 25px;

            border-radius: 8px;

            background:
                linear-gradient(
                    145deg,
                    #fffdf7,
                    #e7deca
                );

            box-shadow:
                25px 35px 60px rgba(0,0,0,0.45);

            transform:
                rotateX(8deg)
                rotateY(-18deg)
                translateZ(30px);

            transform-style: preserve-3d;

            animation: mdFloat 5s ease-in-out infinite;
        }


        .md-document::before {

            content: "";

            position: absolute;

            left: 12px;

            top: 12px;

            width: 100%;

            height: 100%;

            background: #b9984e;

            border-radius: 8px;

            transform: translateZ(-15px);

            opacity: 0.35;
        }


        .md-document-icon {

            width: 48px;

            height: 48px;

            border-radius: 50%;

            display: flex;

            align-items: center;

            justify-content: center;

            background: var(--md-navy);

            color: var(--md-gold-light);

            margin-bottom: 25px;

            position: relative;

            z-index: 2;
        }


        .md-line {

            height: 5px;

            border-radius: 10px;

            background: #c4baa3;

            margin-bottom: 12px;

            position: relative;

            z-index: 2;
        }


        .md-line-lg {
            width: 80%;
        }


        .md-line-md {
            width: 60%;
        }


        .md-line-sm {
            width: 38%;
        }


        .md-stamp {

            width: 48px;

            height: 48px;

            position: absolute;

            right: 20px;

            bottom: 20px;

            border: 2px solid var(--md-gold);

            border-radius: 50%;

            display: flex;

            align-items: center;

            justify-content: center;

            color: var(--md-gold);
        }


        @keyframes mdFloat {

            0%,
            100% {
                margin-top: 0;
            }

            50% {
                margin-top: -15px;
            }
        }


        /* =====================================================
           FLOATING DOTS
        ====================================================== */

        .md-dot {

            position: absolute;

            border-radius: 50%;

            background: var(--md-gold);

            box-shadow:
                0 0 25px rgba(197,164,90,0.55);

            animation: mdDotFloat 6s ease-in-out infinite;
        }


        .md-dot-a {

            width: 9px;

            height: 9px;

            right: 17%;

            top: 25%;
        }


        .md-dot-b {

            width: 13px;

            height: 13px;

            right: 9%;

            bottom: 20%;

            animation-delay: -2s;
        }


        .md-dot-c {

            width: 6px;

            height: 6px;

            left: 45%;

            top: 18%;

            animation-delay: -4s;
        }


        @keyframes mdDotFloat {

            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-25px);
            }
        }


        /* =====================================================
           INTRO
        ====================================================== */

        .md-intro {

            padding: 110px 0 70px;

            background: var(--md-cream);
        }


        .md-intro-grid {

            display: grid;

            grid-template-columns: 0.75fr 1.25fr;

            gap: 80px;

            align-items: end;
        }


        .md-label {

            color: var(--md-gold);

            text-transform: uppercase;

            font-size: 11px;

            font-weight: 700;

            letter-spacing: 0.2em;

            margin-bottom: 15px;
        }


        .md-heading {

            font-family: "Cormorant Garamond", serif;

            color: var(--md-navy);

            font-size: clamp(42px, 5vw, 65px);

            line-height: 0.98;

            font-weight: 600;

            margin: 0;
        }


        .md-copy {

            color: var(--md-muted);

            font-size: 15px;

            line-height: 1.9;

            margin: 0 0 18px;
        }


        /* =====================================================
           INFORMATION
        ====================================================== */

        .md-information {

            padding: 40px 0 115px;

            background: var(--md-cream);
        }


        .md-table-box {

            margin-top: 45px;

            background: white;

            border-radius: 18px;

            overflow: hidden;

            border: 1px solid rgba(7,26,43,0.08);

            box-shadow:
                0 25px 70px rgba(7,26,43,0.08);
        }


        .md-table {

            width: 100%;

            border-collapse: collapse;

            margin: 0;
        }


        .md-table tr {

            border-bottom: 1px solid rgba(7,26,43,0.07);

            transition: background 0.25s ease;
        }


        .md-table tr:last-child {
            border-bottom: 0;
        }


        .md-table tr:hover {
            background: #fcfaf5;
        }


        .md-table th {

            width: 32%;

            padding: 21px 27px;

            text-align: left;

            vertical-align: top;

            color: var(--md-navy);

            font-size: 11px;

            font-weight: 700;

            text-transform: uppercase;

            letter-spacing: 0.06em;
        }


        .md-table td {

            padding: 21px 27px;

            color: #5d666d;

            font-size: 14px;

            line-height: 1.7;

            vertical-align: top;
        }


        /* =====================================================
           QUICK INFORMATION
        ====================================================== */

        .md-stats {

            padding: 100px 0 115px;

            position: relative;

            overflow: hidden;

            background: var(--md-navy);

            color: white;
        }


        .md-stats::before {

            content: "";

            position: absolute;

            width: 600px;

            height: 600px;

            border-radius: 50%;

            border: 1px solid rgba(224,198,123,0.10);

            right: -300px;

            top: -300px;
        }


        .md-stats .md-heading {
            color: white;
        }


        .md-stats-grid {

            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 18px;

            margin-top: 50px;

            position: relative;

            z-index: 2;
        }


        .md-stat {

            min-height: 275px;

            padding: 30px;

            border-radius: 18px;

            border: 1px solid rgba(255,255,255,0.09);

            background:
                linear-gradient(
                    145deg,
                    rgba(255,255,255,0.075),
                    rgba(255,255,255,0.025)
                );

            backdrop-filter: blur(12px);

            transform-style: preserve-3d;

            transition:
                transform 0.35s ease,
                border-color 0.35s ease;
        }


        .md-stat:hover {

            transform:
                perspective(900px)
                rotateX(5deg)
                rotateY(-5deg)
                translateY(-7px);

            border-color:
                rgba(224,198,123,0.4);
        }


        .md-stat-number {

            font-family: "Cormorant Garamond", serif;

            font-size: 48px;

            color: var(--md-gold-light);

            line-height: 1;

            margin-bottom: 25px;
        }


        .md-stat-icon {

            width: 48px;

            height: 48px;

            border: 1px solid rgba(224,198,123,0.4);

            border-radius: 50%;

            display: flex;

            align-items: center;

            justify-content: center;

            color: var(--md-gold-light);

            margin-bottom: 20px;
        }


        .md-stat h3 {

            font-family: "Cormorant Garamond", serif;

            color: white;

            font-size: 27px;

            margin-bottom: 12px;
        }


        .md-stat p {

            color: rgba(255,255,255,0.58);

            font-size: 13px;

            line-height: 1.75;

            margin: 0;
        }


        /* =====================================================
           DETAILED DISCLOSURE
        ====================================================== */

        .md-details {

            padding: 115px 0;

            background: var(--md-cream);
        }


        .md-details-grid {

            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 20px;

            margin-top: 55px;
        }


        .md-detail {

            min-height: 320px;

            padding: 36px;

            background: white;

            border-radius: 18px;

            border: 1px solid rgba(7,26,43,0.08);

            position: relative;

            overflow: hidden;

            transform-style: preserve-3d;

            transition:
                transform 0.35s ease,
                box-shadow 0.35s ease;
        }


        .md-detail:hover {

            transform:
                perspective(1100px)
                rotateX(3deg)
                rotateY(-3deg)
                translateY(-6px);

            box-shadow:
                0 25px 60px rgba(7,26,43,0.10);
        }


        .md-detail::after {

            content: "";

            position: absolute;

            width: 160px;

            height: 160px;

            border-radius: 50%;

            right: -90px;

            bottom: -90px;

            border: 1px solid rgba(197,164,90,0.16);
        }


        .md-detail-number {

            position: absolute;

            right: 28px;

            top: 22px;

            font-family: "Cormorant Garamond", serif;

            font-size: 58px;

            color: rgba(197,164,90,0.18);
        }


        .md-detail-icon {

            width: 50px;

            height: 50px;

            border-radius: 50%;

            display: flex;

            align-items: center;

            justify-content: center;

            color: var(--md-gold-light);

            background: var(--md-navy);

            margin-bottom: 23px;
        }


        .md-detail h3 {

            font-family: "Cormorant Garamond", serif;

            color: var(--md-navy);

            font-size: 31px;

            margin-bottom: 14px;
        }


        .md-detail p {

            color: var(--md-muted);

            font-size: 14px;

            line-height: 1.85;

            margin-bottom: 16px;
        }


        .md-detail ul {

            padding-left: 18px;

            margin: 0;
        }


        .md-detail li {

            color: #626a70;

            font-size: 13px;

            line-height: 1.8;
        }


        .md-detail li::marker {
            color: var(--md-gold);
        }


        /* =====================================================
           DOCUMENTS
        ====================================================== */

        .md-documents {

            padding: 105px 0;

            background: #F0EADD;
        }


        .md-documents-grid {

            display: grid;

            grid-template-columns:
                repeat(5, 1fr);

            gap: 15px;

            margin-top: 50px;
        }


        .md-document-card {

            min-height: 225px;

            padding: 25px;

            border-radius: 16px;

            background: rgba(255,255,255,0.78);

            border: 1px solid rgba(7,26,43,0.08);

            position: relative;

            transition:
                transform 0.35s ease,
                box-shadow 0.35s ease;
        }


        .md-document-card:hover {

            transform:
                translateY(-7px)
                rotateX(3deg);

            box-shadow:
                0 20px 45px rgba(7,26,43,0.10);
        }


        .md-document-card i {

            font-size: 24px;

            color: var(--md-gold);

            margin-bottom: 38px;
        }


        .md-document-card h4 {

            font-family: "Cormorant Garamond", serif;

            font-size: 23px;

            line-height: 1.15;

            color: var(--md-navy);

            margin-bottom: 10px;
        }


        .md-document-card p {

            color: var(--md-muted);

            font-size: 12px;

            line-height: 1.7;

            margin: 0;
        }


        .md-document-arrow {

            position: absolute;

            right: 20px;

            bottom: 18px;

            color: var(--md-gold);
        }


        /* =====================================================
           TRUST SECTION
        ====================================================== */

        .md-trust {

            padding: 120px 0;

            background:
                radial-gradient(
                    circle at 80% 50%,
                    rgba(197,164,90,0.12),
                    transparent 30%
                ),
                var(--md-dark);

            color: white;

            overflow: hidden;
        }


        .md-trust-grid {

            display: grid;

            grid-template-columns:
                1fr 0.75fr;

            gap: 70px;

            align-items: center;
        }


        .md-trust .md-heading {
            color: white;
        }


        .md-trust-copy {

            color: rgba(255,255,255,0.62);

            font-size: 14px;

            line-height: 1.9;

            max-width: 680px;

            margin-top: 22px;
        }


        .md-checks {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 14px;

            margin-top: 30px;
        }


        .md-check {

            display: flex;

            align-items: center;

            gap: 10px;

            color: rgba(255,255,255,0.75);

            font-size: 13px;
        }


        .md-check i {
            color: var(--md-gold-light);
        }


        /* =====================================================
           3D TRUST SEAL
        ====================================================== */

        .md-seal-area {

            height: 370px;

            display: flex;

            align-items: center;

            justify-content: center;

            perspective: 1000px;
        }


        .md-seal {

            width: 250px;

            height: 250px;

            border-radius: 50%;

            border: 1px solid rgba(224,198,123,0.6);

            display: flex;

            align-items: center;

            justify-content: center;

            transform:
                rotateX(15deg)
                rotateY(-15deg);

            box-shadow:
                0 30px 70px rgba(0,0,0,0.35),
                inset 0 0 50px rgba(197,164,90,0.08);

            animation:
                mdSealFloat
                5s
                ease-in-out
                infinite;

            position: relative;
        }


        .md-seal::before {

            content: "";

            position: absolute;

            inset: 15px;

            border:
                1px dashed rgba(224,198,123,0.55);

            border-radius: 50%;

            animation:
                mdSealRotate
                18s
                linear
                infinite;
        }


        .md-seal-inner {

            width: 145px;

            height: 145px;

            border-radius: 50%;

            border: 1px solid rgba(255,255,255,0.12);

            display: flex;

            align-items: center;

            justify-content: center;

            flex-direction: column;

            text-align: center;

            position: relative;

            z-index: 2;
        }


        .md-seal-inner i {

            font-size: 28px;

            color: var(--md-gold-light);

            margin-bottom: 9px;
        }


        .md-seal-inner strong {

            font-family: "Cormorant Garamond", serif;

            color: white;

            font-size: 24px;
        }


        .md-seal-inner span {

            font-size: 8px;

            text-transform: uppercase;

            letter-spacing: 0.2em;

            color: rgba(255,255,255,0.5);
        }


        @keyframes mdSealFloat {

            0%,
            100% {
                transform:
                    rotateX(15deg)
                    rotateY(-15deg)
                    translateY(0);
            }

            50% {
                transform:
                    rotateX(20deg)
                    rotateY(-10deg)
                    translateY(-12px);
            }
        }


        @keyframes mdSealRotate {

            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }


        /* =====================================================
           LOCATION
        ====================================================== */

        .md-location {

            padding: 110px 0;

            background: var(--md-cream);
        }


        .md-location-grid {

            display: grid;

            grid-template-columns:
                0.75fr 1.25fr;

            gap: 45px;

            margin-top: 50px;
        }


        .md-location-info {

            padding: 40px;

            border-radius: 18px;

            background: var(--md-navy);

            color: white;

            position: relative;

            overflow: hidden;
        }


        .md-location-info::after {

            content: "";

            position: absolute;

            width: 280px;

            height: 280px;

            border-radius: 50%;

            border: 1px solid rgba(224,198,123,0.15);

            right: -150px;

            bottom: -150px;
        }


        .md-location-info h3 {

            font-family: "Cormorant Garamond", serif;

            font-size: 37px;

            color: white;

            margin-bottom: 30px;

            position: relative;

            z-index: 2;
        }


        .md-location-item {

            display: flex;

            gap: 14px;

            margin-bottom: 24px;

            position: relative;

            z-index: 2;
        }


        .md-location-item > i {

            color: var(--md-gold-light);

            width: 20px;

            margin-top: 4px;
        }


        .md-location-item div {

            color: rgba(255,255,255,0.65);

            font-size: 13px;

            line-height: 1.7;
        }


        .md-location-item strong {

            display: block;

            color: white;

            margin-bottom: 3px;
        }


        .md-map {

            min-height: 420px;

            overflow: hidden;

            border-radius: 18px;

            background: #ddd;

            border: 7px solid white;

            box-shadow:
                0 20px 55px rgba(7,26,43,0.10);
        }


        .md-map iframe {

            display: block;

            width: 100%;

            height: 100%;

            min-height: 406px;

            border: 0;
        }


        /* =====================================================
           RESPONSIVE
        ====================================================== */

        @media (max-width: 1100px) {

            .md-hero-layout {
                grid-template-columns: 1fr 0.7fr;
            }


            .md-visual {
                transform: scale(0.85);
            }


            .md-stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }


            .md-documents-grid {
                grid-template-columns: repeat(3, 1fr);
            }

        }


        @media (max-width: 850px) {

            .md-hero {
                padding-top: 125px;

                min-height: 720px;
            }


            .md-hero-layout {
                grid-template-columns: 1fr;
            }


            .md-visual {

