    <!-- =========================================================
         PAGE REVEAL ANIMATION
    ========================================================= -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const revealElements =
                    document.querySelectorAll(".reveal");


                /*
                 * Make sure content is visible even if the
                 * observer is unavailable.
                 */

                if (!("IntersectionObserver" in window)) {

                    revealElements.forEach(
                        function (element) {

                            element.classList.add("visible");

                        }
                    );

                    return;

                }


                const observer =
                    new IntersectionObserver(
                        function (entries) {

                            entries.forEach(
                                function (entry) {

                                    if (
                                        entry.isIntersecting
                                    ) {

                                        entry.target.classList.add(
                                            "visible"
                                        );

                                        observer.unobserve(
                                            entry.target
                                        );

                                    }

                                }
                            );

                        },
                        {
                            threshold: 0.08
                        }
                    );


                revealElements.forEach(
                    function (element) {

                        observer.observe(element);

                    }
                );


                /*
                 * Safety fallback:
                 * If an element remains hidden for any reason,
                 * reveal everything after a few seconds.
                 */

                setTimeout(
                    function () {

                        revealElements.forEach(
                            function (element) {

                                element.classList.add("visible");

                            }
                        );

                    },
                    2500
                );

            }
        );

    </script>


