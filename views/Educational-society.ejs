<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title || "Educational Society | St. Martin's High School" %></title>

    <meta
        name="description"
        content="Learn about St. Martin's Children's Education Society, its vision, values, leadership and educational legacy."
    >

    <meta
        name="keywords"
        content="St. Martin's High School, Educational Society, Children's Education Society, Balanagar, Hyderabad"
    >

    <!-- =========================================================
         BOOTSTRAP
    ========================================================== -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <!-- =========================================================
         FONT AWESOME
    ========================================================== -->

    <link
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
        rel="stylesheet"
    >


    <!-- =========================================================
         GOOGLE FONTS
    ========================================================== -->

    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >


    <!-- =========================================================
         GLOBAL WEBSITE CSS
    ========================================================== -->

    <link
        rel="stylesheet"
        href="/css/style.css"
    >


    <!-- =========================================================
         PAGE CSS
    ========================================================== -->

    <style>

        /* =====================================================
           PAGE VARIABLES
        ===================================================== */

        :root {

            --society-navy: #071A2B;
            --society-navy-light: #10283D;

            --society-gold: #C5A45A;
            --society-gold-light: #DFC982;

            --society-ivory: #F6F1E7;

            --society-white: #FFFFFF;

            --society-text: #263442;
            --society-muted: #71808F;

        }


        /* =====================================================
           SCROLL SAFETY
           IMPORTANT:
           This page must remain scrollable even if global CSS
           contains restrictive rules.
        ===================================================== */

        html {

            height: auto !important;

            min-height: 100% !important;

            overflow-x: hidden !important;

            overflow-y: auto !important;

            scroll-behavior: smooth;

        }


        body {

            height: auto !important;

            min-height: 100vh !important;

            margin: 0;

            overflow-x: hidden !important;

            overflow-y: auto !important;

            position: relative !important;

        }


        .society-page {

            height: auto !important;

            min-height: 100vh !important;

            overflow-x: hidden !important;

            overflow-y: visible !important;

        }


        /* =====================================================
           PAGE TYPOGRAPHY
        ===================================================== */

        .society-page h1,
        .society-page h2,
        .society-page h3,
        .society-page h4,
        .society-page h5,
        .society-page h6 {

            font-family:
                "Cormorant Garamond",
                serif;

        }


        /* =====================================================
           PAGE HERO
        ===================================================== */

        .page-hero {

            position: relative;

            min-height: 430px;

            display: flex;

            align-items: center;

            background:

                radial-gradient(
                    circle at 82% 18%,
                    rgba(197,164,90,0.16),
                    transparent 28%
                ),

                radial-gradient(
                    circle at 12% 90%,
                    rgba(197,164,90,0.07),
                    transparent 28%
                ),

                linear-gradient(
                    135deg,
                    #071A2B 0%,
                    #0B2034 55%,
                    #10283D 100%
                );

            color: white;

            border-bottom:
                4px solid var(--society-gold);

            overflow: hidden;

        }


        /* Large decorative ring */

        .page-hero::before {

            content: "";

            position: absolute;

            width: 360px;
            height: 360px;

            right: -130px;
            top: -150px;

            border-radius: 50%;

            border:
                1px solid rgba(197,164,90,0.25);

            box-shadow:

                0 0 0 28px rgba(197,164,90,0.035),

                0 0 0 58px rgba(197,164,90,0.022),

                0 0 0 90px rgba(197,164,90,0.012);

            pointer-events: none;

        }


        /* Small decorative ring */

        .page-hero::after {

            content: "";

            position: absolute;

            width: 190px;
            height: 190px;

            left: -95px;
            bottom: -95px;

            border-radius: 50%;

            border:
                1px solid rgba(197,164,90,0.14);

            box-shadow:
                0 0 0 25px rgba(197,164,90,0.02);

            pointer-events: none;

        }


        .page-hero-content {

            position: relative;

            z-index: 2;

            width: 100%;

        }


        .hero-label {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 10px;

            color: var(--society-gold-light);

            font-size: 12px;

            font-weight: 700;

            letter-spacing: 2px;

            text-transform: uppercase;

        }


        .hero-label::before,
        .hero-label::after {

            content: "";

            width: 32px;

            height: 1px;

            background:
                var(--society-gold);

        }


        .page-hero h1 {

            position: relative;

            font-size:
                clamp(44px, 6vw, 76px);

            line-height: 0.98;

            font-weight: 600;

            margin: 22px 0 20px;

            color: white;

        }


        .page-hero h1 span {

            color:
                var(--society-gold-light);

        }


        .page-hero p {

            max-width: 720px;

            margin: auto;

            color: #BAC6D2;

            font-size: 14px;

            line-height: 1.9;

        }


        /* =====================================================
           SECTION LABELS
        ===================================================== */

        .section-label {

            color:
                var(--society-gold);

            font-size: 12px;

            font-weight: 800;

            letter-spacing: 2px;

            text-transform: uppercase;

        }


        .section-title {

            color:
                var(--society-navy);

            font-size:
                clamp(34px, 4vw, 52px);

            line-height: 1.06;

            font-weight: 600;

        }


        .section-description {

            color:
                var(--society-muted);

            font-size: 14px;

            line-height: 1.85;

        }


        /* =====================================================
           FOUNDERS PHOTO SECTION
        ===================================================== */

        .founders-section {

            position: relative;

            background: white;

            overflow: hidden;

        }


        .founders-section::before {

            content: "";

            position: absolute;

            width: 300px;
            height: 300px;

            left: -150px;
            top: 90px;

            border-radius: 50%;

            border:
                1px solid rgba(197,164,90,0.09);

            box-shadow:
                0 0 0 30px rgba(197,164,90,0.018);

            pointer-events: none;

        }


        .management-photo-card {

            position: relative;

            width: 100%;

            border:
                1px solid rgba(197,164,90,0.38);

            border-radius: 24px;

            background:
                var(--society-navy);

            overflow: hidden;

            box-shadow:
                0 30px 75px rgba(7,26,43,0.18);

            transition:
                transform 0.45s ease,
                box-shadow 0.45s ease;

        }


        .management-photo-card:hover {

            transform:
                translateY(-8px);

            box-shadow:
                0 42px 90px rgba(7,26,43,0.24);

        }


        .management-photo-card img {

            display: block;

            width: 100%;

            height: 560px;

            object-fit: contain;

            background:
                var(--society-navy);

            transition:
                transform 0.7s ease;

        }


        .management-photo-card:hover img {

            transform:
                scale(1.025);

        }


        .photo-overlay {

            position: absolute;

            left: 20px;
            right: 20px;
            bottom: 20px;

            padding: 18px 20px;

            border:
                1px solid rgba(197,164,90,0.34);

            border-radius: 14px;

            background:
                rgba(7,26,43,0.91);

            backdrop-filter:
                blur(14px);

            -webkit-backdrop-filter:
                blur(14px);

        }


        .photo-overlay-title {

            color:
                var(--society-gold-light);

            font-family:
                "Cormorant Garamond",
                serif;

            font-size: 25px;

            line-height: 1.1;

        }


        .photo-overlay-text {

            color:
                rgba(255,255,255,0.64);

            margin-top: 4px;

            font-size: 11px;

            letter-spacing: 0.5px;

        }


        /* =====================================================
           OVERVIEW SECTION
        ===================================================== */

        .overview-section {

            position: relative;

            background:
                #F1F4F8;

            overflow: hidden;

        }


        .overview-section::before {

            content: "";

            position: absolute;

            width: 280px;
            height: 280px;

            right: -140px;
            top: 70px;

            border-radius: 50%;

            border:
                1px solid rgba(197,164,90,0.14);

            box-shadow:

                0 0 0 28px rgba(197,164,90,0.025),

                0 0 0 55px rgba(197,164,90,0.015);

            pointer-events: none;

        }


        .overview-text {

            position: relative;

            z-index: 2;

        }


        .overview-text p {

            color:
                var(--society-muted);

            font-size: 14px;

            line-height: 1.9;

        }


        .overview-text strong {

            color:
                var(--society-navy);

        }


        /* =====================================================
           OBJECTIVES CARD
        ===================================================== */

        .objectives-card {

            position: relative;

            padding: 36px;

            border-radius: 22px;

            background:

                radial-gradient(
                    circle at 100% 0%,
                    rgba(197,164,90,0.10),
                    transparent 30%
                ),

                linear-gradient(
                    145deg,
                    #071A2B,
                    #10283D
                );

            border-left:
                4px solid var(--society-gold);

            color: white;

            box-shadow:
                0 25px 60px rgba(7,26,43,0.18);

            overflow: hidden;

        }


        .objectives-card::before {

            content: "";

            position: absolute;

            width: 250px;
            height: 250px;

            right: -120px;
            top: -120px;

            border-radius: 50%;

            border:
                1px solid rgba(197,164,90,0.16);

            box-shadow:
                0 0 0 30px rgba(197,164,90,0.025);

            pointer-events: none;

        }


        .objectives-card::after {

            content: "";

            position: absolute;

            width: 180px;
            height: 180px;

            right: -70px;
            bottom: -80px;

            border-radius: 50%;

            border:
                1px solid rgba(197,164,90,0.20);

            pointer-events: none;

        }


        .objectives-card h3 {

            position: relative;

            z-index: 2;

            color:
                var(--society-gold-light);

            font-size: 31px;

        }


        .objectives-list {

            position: relative;

            z-index: 2;

            list-style: none;

            padding: 0;
            margin: 0;

        }


        .objectives-list li {

            display: flex;

            align-items: flex-start;

            gap: 11px;

            margin-bottom: 18px;

            color: #B9C4D0;

            font-size: 13px;

            line-height: 1.7;

        }


        .objectives-list li:last-child {

            margin-bottom: 0;

        }


        .objectives-list i {

            color:
                var(--society-gold-light);

            margin-top: 4px;

            flex-shrink: 0;

        }


        /* =====================================================
           BUTTONS
        ===================================================== */

        .btn-outline-navy {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 8px;

            padding:
                11px 20px;

            border:
                1px solid var(--society-navy);

            border-radius: 50px;

            color:
                var(--society-navy);

            background:
                transparent;

            font-size: 13px;

            font-weight: 700;

            transition:
                all 0.3s ease;

        }


        .btn-outline-navy:hover {

            background:
                var(--society-navy);

            color: white;

            transform:
                translateY(-3px);

            box-shadow:
                0 12px 25px rgba(7,26,43,0.15);

        }


        .btn-gold {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 8px;

            padding:
                11px 20px;

            border:
                1px solid var(--society-gold);

            border-radius: 50px;

            background:
                var(--society-gold);

            color:
                var(--society-navy);

            font-size: 13px;

            font-weight: 700;

            transition:
                all 0.3s ease;

            box-shadow:
                0 8px 20px rgba(7,26,43,0.10);

        }


        .btn-gold:hover {

            background:
                var(--society-gold-light);

            border-color:
                var(--society-gold-light);

            color:
                var(--society-navy);

            transform:
                translateY(-3px);

            box-shadow:
                0 14px 30px rgba(7,26,43,0.18);

        }


        /* =====================================================
           GOVERNANCE
        ===================================================== */

        .governance-section {

            position: relative;

            background: white;

            overflow: hidden;

        }


        .governance-section::before {

            content: "";

            position: absolute;

            width: 320px;
            height: 320px;

            left: -160px;
            top: 90px;

            border-radius: 50%;

            border:
                1px solid rgba(197,164,90,0.10);

            box-shadow:

                0 0 0 30px rgba(197,164,90,0.02),

                0 0 0 60px rgba(197,164,90,0.014);

            pointer-events: none;

        }


        .society-card {

            position: relative;

            height: 100%;

            padding: 32px;

            border:
                1px solid rgba(197,164,90,0.25);

            border-radius: 20px;

            background: white;

            overflow: hidden;

            transition:
                transform 0.35s ease,
                box-shadow 0.35s ease,
                border-color 0.35s ease;

        }


        .society-card::before {

            content: "";

            position: absolute;

            top: 0;
            left: 0;
            right: 0;

            height: 3px;

            background:
                linear-gradient(
                    90deg,
                    var(--society-navy),
                    var(--society-gold),
                    var(--society-navy)
                );

            transform:
                scaleX(0);

            transition:
                transform 0.35s ease;

        }


        .society-card:hover {

            transform:
                translateY(-8px);

            border-color:
                rgba(197,164,90,0.48);

            box-shadow:
                0 22px 48px rgba(7,26,43,0.12);

        }


        .society-card:hover::before {

            transform:
                scaleX(1);

        }


        .pillar-icon {

            width: 72px;
            height: 72px;

            display: inline-flex;

            align-items: center;
            justify-content: center;

            border-radius: 50%;

            background:
                var(--society-navy);

            color:
                var(--society-gold-light);

            font-size: 22px;

            margin-bottom: 20px;

            box-shadow:
                0 12px 25px rgba(7,26,43,0.15);

            transition:
                transform 0.45s ease;

        }


        .society-card:hover .pillar-icon {

            transform:
                rotateY(180deg);

        }


        .society-card h3 {

            color:
                var(--society-navy);

            font-size: 29px;

            margin-bottom: 12px;

        }


        .society-card p {

            color:
                var(--society-muted);

            font-size: 13px;

            line-height: 1.8;

            margin: 0;

        }


        /* =====================================================
           TIMELINE
        ===================================================== */

        .timeline-section {

            position: relative;

            background:
                var(--society-ivory);

            overflow: hidden;

        }


        .timeline-section::before {

            content: "";

            position: absolute;

            width: 300px;
            height: 300px;

            right: -150px;
            bottom: -150px;

            border-radius: 50%;

            border:
                1px solid rgba(197,164,90,0.14);

            box-shadow:
                0 0 0 30px rgba(197,164,90,0.025);

            pointer-events: none;

        }


        .timeline {

            position: relative;

            max-width: 900px;

            margin: auto;

        }


        .timeline::before {

            content: "";

            position: absolute;

            left: 50%;

            top: 0;
            bottom: 0;

            width: 1px;

            background:
                linear-gradient(
                    to bottom,
                    var(--society-gold),
                    rgba(197,164,90,0.12)
                );

            transform:
                translateX(-50%);

        }


        .timeline-item {

            position: relative;

            width: 50%;

            padding:
                0 40px 55px;

        }


        .timeline-item:nth-child(odd) {

            left: 0;

            text-align: right;

        }


        .timeline-item:nth-child(even) {

            left: 50%;

        }


        .timeline-item:last-child {

            padding-bottom: 0;

        }


        .timeline-dot {

            position: absolute;

            top: 0;

            width: 15px;
            height: 15px;

            border-radius: 50%;

            background:
                var(--society-gold);

            border:
                4px solid var(--society-ivory);

            box-shadow:
                0 0 0 1px var(--society-gold);

            z-index: 2;

        }


        .timeline-item:nth-child(odd) .timeline-dot {

            right: -8px;

        }


        .timeline-item:nth-child(even) .timeline-dot {

            left: -7px;

        }


        .timeline-year {

            color:
                var(--society-gold);

            font-size: 12px;

            font-weight: 800;

            letter-spacing: 2px;

        }


        .timeline-item h3 {

            color:
                var(--society-navy);

            font-size: 30px;

            margin:
                7px 0;

        }


        .timeline-item p {

            color:
                var(--society-muted);

            font-size: 13px;

            line-height: 1.8;

            margin: 0;

        }


        /* =====================================================
           SCROLL REVEAL
        ===================================================== */

        .reveal {

            opacity: 0;

            transform:
                translateY(30px);

            transition:
                opacity 0.7s ease,
                transform 0.7s ease;

        }


        .reveal.visible {

            opacity: 1;

            transform:
                translateY(0);

        }


        /* =====================================================
           TABLET
        ===================================================== */

        @media (max-width: 991px) {

            .page-hero {

                min-height: 400px;

            }


            .management-photo-card img {

                height: 450px;

            }


            .timeline::before {

                left: 15px;

            }


            .timeline-item,
            .timeline-item:nth-child(odd),
            .timeline-item:nth-child(even) {

                width: 100%;

                left: 0;

                text-align: left;

                padding-left: 50px;

                padding-right: 10px;

            }


            .timeline-item:nth-child(odd) .timeline-dot,
            .timeline-item:nth-child(even) .timeline-dot {

                left: 7px;

                right: auto;

            }

        }


        /* =====================================================
           MOBILE
        ===================================================== */

        @media (max-width: 576px) {

            .page-hero {

                min-height: 390px;

            }


            .page-hero h1 {

                font-size: 44px;

            }


            .hero-label {

                font-size: 10px;

                letter-spacing: 1.5px;

            }


            .hero-label::before,
            .hero-label::after {

                width: 20px;

            }


            .page-hero p {

                font-size: 13px;

                line-height: 1.8;

            }


            .management-photo-card {

                border-radius: 18px;

            }


            .management-photo-card img {

                height: 330px;

            }


            .photo-overlay {

                left: 12px;
                right: 12px;
                bottom: 12px;

                padding:
                    14px 16px;

            }


            .photo-overlay-title {

                font-size: 21px;

            }


            .objectives-card {

                padding:
                    27px 22px;

                border-radius: 18px;

            }


            .objectives-card h3 {

                font-size: 27px;

            }


            .society-card {

                padding:
                    27px 22px;

            }


            .society-card h3 {

                font-size: 26px;

            }


            .timeline-item {

                padding-bottom: 40px;

            }

        }


        /* =====================================================
           ACCESSIBILITY / REDUCED MOTION
        ===================================================== */

        @media (prefers-reduced-motion: reduce) {

            html {

                scroll-behavior: auto;

            }


            .reveal {

                opacity: 1;

                transform: none;

                transition: none;

            }


            .management-photo-card,
            .management-photo-card img,
            .society-card,
            .pillar-icon,
            .btn-gold,
            .btn-outline-navy {

                transition: none;

            }

        }

    </style>

</head>


<body class="society-page">


    <!-- =========================================================
         GLOBAL HEADER

         IMPORTANT:
         The header is NOT written here.

         It is loaded from:
         views/partials/header.ejs
    ========================================================= -->

    <%- include('partials/header') %>


    <!-- =========================================================
         HERO
    ========================================================= -->

    <section class="page-hero">

        <div class="container page-hero-content">

            <div class="text-center">

                <div class="hero-label">

                    St. Martin's Children's Education Society

                </div>


                <h1>

                    Founders

                    <span>&amp;</span>

                    Governing Body

                </h1>


                <p>

                    Founded in 1982 — steering St. Martin's High School
                    toward enduring academic distinction, character,
                    responsibility and moral integrity.

                </p>

            </div>

        </div>

    </section>


    <!-- =========================================================
         FOUNDERS
    ========================================================= -->

    <section class="founders-section py-5">

        <div class="container py-4">

            <div class="text-center mb-5 reveal">

                <div class="section-label mb-2">

                    Our Honoured Founders

                </div>


                <h2 class="section-title mb-3">

                    The Executive Leadership Board

                </h2>


                <p
                    class="section-description mx-auto"
                    style="max-width: 700px;"
                >

                    Guiding visionaries behind the establishment,
                    development and continuing educational mission
                    of the institution.

                </p>

            </div>


            <div class="row justify-content-center">

                <div class="col-lg-10 reveal">

                    <div class="management-photo-card">

                        <img
                            src="/images/management-placeholder.png"
                            alt="St. Martin's Children's Education Society Founders"
                            loading="lazy"
                        >


                        <div class="photo-overlay">

                            <div class="photo-overlay-title">

                                Leadership &amp; Vision

                            </div>


                            <div class="photo-overlay-text">

                                St. Martin's Children's Education Society

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         SOCIETY OVERVIEW
    ========================================================= -->

    <section class="overview-section py-5">

        <div class="container py-4">

            <div class="row align-items-center g-5">


                <!-- LEFT -->

                <div class="col-lg-6 reveal">

                    <div class="overview-text">

                        <div class="section-label mb-2">

                            Our Legacy

                        </div>


                        <h2 class="section-title mb-4">

                            Decades of Commitment to Community
                            &amp; Quality Learning

                        </h2>


                        <p class="mb-4">

                            St. Martin's High School operates under the
                            careful stewardship and vision of the
                            <strong>
                                St. Martin's Children's Education Society
                            </strong>,
