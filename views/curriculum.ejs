<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Curriculum | St. Martin's High School | Balanagar</title>

    <meta
        name="description"
        content="Explore the academic curriculum and learning approach of St. Martin's High School, Balanagar."
    >

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/Logo.png">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <style>

        /* ============================================================
           CURRICULUM PAGE
           ST. MARTIN'S HIGH SCHOOL
        ============================================================ */

        .curriculum-page {

            --curr-navy: #071426;
            --curr-navy-2: #0d1d32;
            --curr-navy-3: #142842;

            --curr-ivory: #f7f4ed;
            --curr-white: #ffffff;

            --curr-gold: #c6a45c;
            --curr-gold-light: #dfc98f;

            --curr-text: #273244;
            --curr-muted: #6e7887;

            --curr-border: rgba(20,40,66,0.10);

            --curr-shadow:
                0 18px 50px rgba(7,20,38,0.10);

            --curr-shadow-heavy:
                0 30px 80px rgba(7,20,38,0.18);

            background:
                var(--curr-ivory);

            color:
                var(--curr-text);

            font-family:
                "Inter",
                sans-serif;

            line-height:
                1.7;

            overflow:
                hidden;
        }


        .curriculum-page *,
        .curriculum-page *::before,
        .curriculum-page *::after {

            box-sizing:
                border-box;
        }


        .curriculum-page img {

            max-width:
                100%;

            display:
                block;
        }


        .curriculum-page a {

            text-decoration:
                none;
        }


        /* ============================================================
           HERO
        ============================================================ */

        .curriculum-page .curriculum-hero {

            position:
                relative;

            width:
                100%;

            min-height:
                620px;

            display:
                flex;

            align-items:
                center;

            overflow:
                hidden;

            background:

                linear-gradient(
                    90deg,
                    rgba(7,20,38,.98) 0%,
                    rgba(7,20,38,.94) 40%,
                    rgba(7,20,38,.70) 72%,
                    rgba(7,20,38,.82) 100%
                ),

                url("/images/curriculum.jpg")
                center / cover
                no-repeat;
        }


        /* Decorative golden orbit */

        .curriculum-page .curriculum-hero::before {

            content:
                "";

            position:
                absolute;

            width:
                600px;

            height:
                600px;

            right:
                -260px;

            top:
                -190px;

            border:
                1px solid
                rgba(198,164,92,.24);

            border-radius:
                50%;

            animation:
                currOrbit 18s linear infinite;

            pointer-events:
                none;
        }


        .curriculum-page .curriculum-hero::after {

            content:
                "";

            position:
                absolute;

            width:
                390px;

            height:
                390px;

            right:
                80px;

            bottom:
                -240px;

            border:
                1px solid
                rgba(198,164,92,.15);

            border-radius:
                50%;

            animation:
                currOrbitReverse 14s linear infinite;

            pointer-events:
                none;
        }


        @keyframes currOrbit {

            from {
                transform:
                    rotate(0deg);
            }

            to {
                transform:
                    rotate(360deg);
            }

        }


        @keyframes currOrbitReverse {

            from {
                transform:
                    rotate(360deg);
            }

            to {
                transform:
                    rotate(0deg);
            }

        }


        /* Decorative light */

        .curriculum-page .curriculum-hero .curriculum-light {

            position:
                absolute;

            width:
                480px;

            height:
                480px;

            right:
                8%;

            top:
                50%;

            transform:
                translateY(-50%);

            border-radius:
                50%;

            background:
                radial-gradient(
                    circle,
                    rgba(198,164,92,.15),
                    transparent 68%
                );

            filter:
                blur(3px);

            pointer-events:
                none;
        }


        .curriculum-page .curriculum-container {

            width:
                min(1180px, calc(100% - 40px));

            margin:
                0 auto;
        }


        .curriculum-page .hero-content {

            position:
                relative;

            z-index:
                5;

            max-width:
                820px;

            padding:
                110px 0 95px;

            color:
                white;
        }


        .curriculum-page .hero-kicker {

            display:
                inline-flex;

            align-items:
                center;

            gap:
                12px;

            color:
                var(--curr-gold-light);

            font-size:
                12px;

            font-weight:
                700;

            text-transform:
                uppercase;

            letter-spacing:
                3px;

            margin-bottom:
                20px;
        }


        .curriculum-page .hero-kicker::before {

            content:
                "";

            width:
                44px;

            height:
                1px;

            background:
                var(--curr-gold);
        }


        .curriculum-page .hero-title {

            font-family:
                "Cormorant Garamond",
                serif;

            font-size:
                clamp(56px, 7vw, 92px);

            line-height:
                .92;

            font-weight:
                600;

            letter-spacing:
                -1.5px;

            margin:
                0 0 28px;

            text-shadow:
                0 10px 40px rgba(0,0,0,.25);
        }


        .curriculum-page .hero-title span {

            color:
                var(--curr-gold-light);
        }


        .curriculum-page .hero-description {

            max-width:
                730px;

            color:
                rgba(255,255,255,.82);

            font-size:
                16px;

            font-weight:
                300;

            line-height:
                1.9;

            margin:
                0 0 34px;
        }


        /* ============================================================
           BUTTONS
        ============================================================ */

        .curriculum-page .hero-actions {

            display:
                flex;

            flex-wrap:
                wrap;

            gap:
                12px;
        }


        .curriculum-page .hero-btn {

            display:
                inline-flex;

            align-items:
                center;

            justify-content:
                center;

            gap:
                9px;

            padding:
                14px 23px;

            font-size:
                11px;

            font-weight:
                700;

            letter-spacing:
                .8px;

            text-transform:
                uppercase;

            transition:
                .3s ease;

            position:
                relative;

            overflow:
                hidden;
        }


        .curriculum-page .hero-btn-primary {

            background:
                var(--curr-gold);

            color:
                var(--curr-navy);

            box-shadow:
                0 10px 30px rgba(198,164,92,.20);
        }


        .curriculum-page .hero-btn-primary:hover {

            background:
                #dec27b;

            color:
                var(--curr-navy);

            transform:
                translateY(-3px);

            box-shadow:
                0 15px 35px rgba(198,164,92,.30);
        }


        .curriculum-page .hero-btn-outline {

            color:
                white;

            border:
                1px solid
                rgba(255,255,255,.35);
        }


        .curriculum-page .hero-btn-outline:hover {

            color:
                white;

            border-color:
                var(--curr-gold-light);

            background:
                rgba(255,255,255,.07);

            transform:
                translateY(-3px);
        }


        /* ============================================================
           GENERAL SECTIONS
        ============================================================ */

        .curriculum-page .curr-section {

            position:
                relative;

            padding:
                105px 0;
        }


        .curriculum-page .curr-section-light {

            background:
                var(--curr-ivory);
        }


        .curriculum-page .curr-section-white {

            background:
                #ffffff;
        }


        .curriculum-page .curr-section-dark {

            background:
                var(--curr-navy);

            color:
                white;
        }


        .curriculum-page .section-label {

            display:
                inline-flex;

            align-items:
                center;

            gap:
                10px;

            color:
                #9c7b36;

            font-size:
                11px;

            font-weight:
                700;

            letter-spacing:
                2.5px;

            text-transform:
                uppercase;

            margin-bottom:
                14px;
        }


        .curriculum-page .curr-section-dark .section-label {

            color:
                var(--curr-gold-light);
        }


        .curriculum-page .section-label::before {

            content:
                "";

            width:
                32px;

            height:
                1px;

            background:
                var(--curr-gold);
        }


        .curriculum-page .section-title {

            font-family:
                "Cormorant Garamond",
                serif;

            font-size:
                clamp(40px, 5vw, 62px);

            line-height:
                1.05;

            font-weight:
                600;

            color:
                var(--curr-navy);

            margin:
                0 0 20px;
        }


        .curriculum-page .section-title span {

            color:
                #a3833e;
        }


        .curriculum-page .curr-section-dark .section-title {

            color:
                white;
        }


        .curriculum-page .curr-section-dark .section-title span {

            color:
                var(--curr-gold-light);
        }


        .curriculum-page .section-description {

            color:
                var(--curr-muted);

            font-size:
                15px;

            line-height:
                1.9;

            max-width:
                750px;
        }


        .curriculum-page .curr-section-dark .section-description {

            color:
                rgba(255,255,255,.67);
        }


        /* ============================================================
           INTRO
        ============================================================ */

        .curriculum-page .intro-panel {

            position:
                relative;

            background:
                white;

            padding:
                55px;

            border-top:
                3px solid
                var(--curr-gold);

            box-shadow:
                var(--curr-shadow);

            overflow:
                hidden;

            transform:
                perspective(1000px)
                rotateX(0deg);

            transition:
                .4s ease;
        }


        .curriculum-page .intro-panel:hover {

            transform:
                perspective(1000px)
                rotateX(1deg)
                translateY(-4px);

            box-shadow:
                var(--curr-shadow-heavy);
        }


        .curriculum-page .intro-panel::before {

            content:
                "";

            position:
                absolute;

            width:
                260px;

            height:
                260px;

            right:
                -140px;

            bottom:
                -140px;

            border:
                1px solid
                rgba(198,164,92,.18);

            border-radius:
                50%;
        }


        .curriculum-page .intro-panel p {

            position:
                relative;

            z-index:
                2;

            color:
                #596474;

            font-size:
                15px;

            line-height:
                1.95;

            margin:
                0 0 18px;
        }


        .curriculum-page .intro-highlight {

            display:
                grid;

            grid-template-columns:
                repeat(2,1fr);

            gap:
                14px;

            margin-top:
                28px;
        }


        .curriculum-page .intro-highlight-item {

            padding:
                19px;

            background:
                #fbfaf7;

            border:
                1px solid
                var(--curr-border);

            transition:
                .3s ease;
        }


        .curriculum-page .intro-highlight-item:hover {

            transform:
                translateY(-4px);

            box-shadow:
                0 12px 30px rgba(7,20,38,.08);

            border-color:
                rgba(198,164,92,.35);
        }


        .curriculum-page .intro-highlight-item i {

            color:
                var(--curr-gold);

            font-size:
                17px;

            margin-bottom:
                10px;
        }


        .curriculum-page .intro-highlight-item strong {

            display:
                block;

            color:
                var(--curr-navy);

            font-family:
                "Cormorant Garamond",
                serif;

            font-size:
                20px;

            line-height:
                1.1;
        }


        .curriculum-page .intro-highlight-item span {

            display:
                block;

            margin-top:
                5px;

            color:
                var(--curr-muted);

            font-size:
                11px;

            line-height:
                1.5;
        }


        /* ============================================================
           GLANCE CARDS
        ============================================================ */

        .curriculum-page .glance-card {

            height:
                100%;

            padding:
                34px 30px;

            background:
                #fbfaf7;

            border:
                1px solid
                var(--curr-border);

            position:
                relative;

            overflow:
                hidden;

            transition:
                .35s ease;

            transform-style:
                preserve-3d;
        }


        .curriculum-page .glance-card::after {

            content:
                "";

            position:
                absolute;

            width:
                120px;

            height:
                120px;

            right:
                -55px;

            top:
                -55px;

            border:
                1px solid
                rgba(198,164,92,.20);

            border-radius:
                50%;
        }


        .curriculum-page .glance-card:hover {

            transform:
                perspective(900px)
                rotateX(3deg)
                rotateY(-3deg)
                translateY(-8px);

            box-shadow:
                var(--curr-shadow);
        }


        .curriculum-page .glance-number {

            color:
                var(--curr-gold);

            font-family:
                "Cormorant Garamond",
                serif;

            font-size:
                43px;

            line-height:
                1;

            margin-bottom:
                18px;
        }


        .curriculum-page .glance-card h3 {

            font-family:
                "Cormorant Garamond",
                serif;

            font-size:
                27px;

            color:
                var(--curr-navy);

            margin:
                0 0 10px;
        }


        .curriculum-page .glance-card p {

            color:
                var(--curr-muted);

            font-size:
                13px;

            line-height:
                1.8;

            margin:
                0;
        }


        /* ============================================================
           PRINCIPLES
        ============================================================ */

        .curriculum-page .principle-card {

            height:
                100%;

            padding:
                34px 30px;

            background:
                #fff;

            border:
                1px solid
                var(--curr-border);

            transition:
                .35s ease;

            transform-style:
                preserve-3d;
        }


        .curriculum-page .principle-card:hover {

            transform:
                perspective(900px)
                rotateX(2deg)
                rotateY(2deg)
                translateY(-7px);

            box-shadow:
                var(--curr-shadow);
        }


        .curriculum-page .principle-number {

            color:
                var(--curr-gold);

            font-family:
                "Cormorant Garamond",
                serif;

            font-size:
                46px;

            line-height:
                1;

            margin-bottom:
                18px;
        }


        .curriculum-page .principle-icon {

            width:
                52px;

            height:
                52px;

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

            background:
                var(--curr-navy);

            color:
                var(--curr-gold-light);

            margin-bottom:
                22px;

            box-shadow:
                8px 8px 0
                rgba(198,164,92,.12);
        }


        .curriculum-page .principle-card h3 {

            font-family:
                "Cormorant Garamond",
                serif;

            font-size:
                27px;

            color:
                var(--curr-navy);

            margin:
                0 0 12px;
        }


        .curriculum-page .principle-card p {

            color:
                var(--curr-muted);

            font-size:
                13px;

            line-height:
                1.8;

            margin:
                0;
        }


        /* ============================================================
           STAGES
        ============================================================ */

        .curriculum-page .stage-card {

            height:
                100%;

            position:
                relative;

            background:
                white;

            padding:
                38px;

            border:
                1px solid
                var(--curr-border);

            overflow:
                hidden;

            transition:
                .35s ease;
        }


        .curriculum-page .stage-card:hover {

            transform:
                translateY(-7px);

            box-shadow:
                var(--curr-shadow);
        }


        .curriculum-page .stage-card::after {

            content:
                "";

            position:
                absolute;

            width:
                140px;

            height:
                140px;

            right:
                -70px;

            top:
                -70px;

            border:
                1px solid
                rgba(198,164,92,.18);

            border-radius:
                50%;
        }


        .curriculum-page .stage-index {

            color:
                var(--curr-gold);

            font-size:
                11px;

            font-weight:
                700;

            letter-spacing:
                2px;

            text-transform:
                uppercase;
        }


        .curriculum-page .stage-card h3 {

            font-family:
                "Cormorant Garamond",
                serif;

            color:
                var(--curr-navy);

            font-size:
                34px;

            margin:
                10px 0 7px;
        }


        .curriculum-page .stage-subtitle {

            color:
                #9c7b36;

            font-size:
                11px;

            font-weight:
                700;

            letter-spacing:
                1.5px;

            text-transform:
                uppercase;

            margin-bottom:
                20px;
        }


        .curriculum-page .stage-card p {

            color:
                var(--curr-muted);

            font-size:
                13px;

            line-height:
                1.8;
        }


        .curriculum-page .stage-list {

            list-style:
                none;

            padding:
                0;

            margin:
                22px 0 0;
        }


        .curriculum-page .stage-list li {

            position:
                relative;

            padding-left:
                22px;

            color:
                #4f5968;

            font-size:
                13px;

            margin-bottom:
                9px;
        }


        .curriculum-page .stage-list li::before {

            content:
                "\f00c";

            font-family:
                "Font Awesome 6 Free";

            font-weight:
                900;

            position:
                absolute;

            left:
                0;

            top:
                1px;

            color:
                var(--curr-gold);

            font-size:
                11px;
        }


        /* ============================================================
           SUBJECTS
        ============================================================ */

        .curriculum-page .subject-box {

            height:
                100%;

            padding:
                32px;

            background:
                #fbfaf7;

            border:
                1px solid
                var(--curr-border);

            transition:
                .35s ease;

            transform-style:
                preserve-3d;
        }


        .curriculum-page .subject-box:hover {

            background:
                var(--curr-navy);

            transform:
                perspective(900px)
                rotateX(2deg)
                rotateY(-2deg)
                translateY(-6px);

            box-shadow:
                var(--curr-shadow-heavy);
        }


        .curriculum-page .subject-icon {

            width:
                55px;

            height:
                55px;

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

            background:
                rgba(198,164,92,.14);

            color:
                #a3833e;

            font-size:
                19px;

            margin-bottom:
                22px;
        }


        .curriculum-page .subject-box:hover .subject-icon {

            color:
                var(--curr-gold-light);
        }


        .curriculum-page .subject-box h3 {

            font-family:
                "Cormorant Garamond",
                serif;

            color:
                var(--curr-navy);

            font-size:
                29px;

            margin:
                0 0 12px;

            transition:
                .3s ease;
        }


        .curriculum-page .subject-box p {

            color:
                var(--curr-muted);

            font-size:
                13px;

            line-height:
                1.8;

            margin-bottom:
                16px;

            transition:
                .3s ease;
        }


        .curriculum-page .subject-box ul {

            list-style:
                none;

            padding:
                0;

            margin:
                0;
        }


        .curriculum-page .subject-box li {

            color:
                #5b6573;

            font-size:
                12px;

            margin-bottom:
                7px;

            transition:
                .3s ease;
        }


        .curriculum-page .subject-box li i {

            color:
                var(--curr-gold);

            width:
                17px;
        }


        .curriculum-page .subject-box:hover h3,
        .curriculum-page .subject-box:hover p,
        .curriculum-page .subject-box:hover li {

            color:
                white;
        }


        /* ============================================================
           LEARNING APPROACH
        ============================================================ */

        .curriculum-page .learning-section {

            background:
                var(--curr-navy);

            color:
                white;

            position:
                relative;

            overflow:
                hidden;
        }


        .curriculum-page .learning-section::before {

            content:
                "";

            position:
                absolute;

            width:
                550px;

            height:
                550px;

            left:
                -300px;

            top:
                -200px;

            border:
                1px solid
                rgba(198,164,92,.12);

            border-radius:
                50%;
        }


        .curriculum-page .learning-section::after {

            content:
                "";

            position:
                absolute;

            width:
                300px;

            height:
                300px;

            right:
                -130px;

            bottom:
                -120px;

            border:
                1px solid
                rgba(198,164,92,.10);

            border-radius:
                50%;
        }


        .curriculum-page .learning-item {

            display:
                flex;

            gap:
                22px;

            padding:
                25px 0;

            border-bottom:
                1px solid
                rgba(255,255,255,.10);
        }


        .curriculum-page .learning-item:last-child {

            border-bottom:
                0;
        }


        .curriculum-page .learning-icon {

            flex:
                0 0 52px;

            width:
                52px;

            height:
                52px;

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

            border:
                1px solid
                rgba(198,164,92,.5);

            color:
                var(--curr-gold-light);
        }


        .curriculum-page .learning-item h3 {

            font-family:
                "Cormorant Garamond",
                serif;

            font-size:
                27px;

            margin:
                0 0 6px;
        }


        .curriculum-page .learning-item p {

            margin:
                0;

            color:
                rgba(255,255,255,.62);

            font-size:
                13px;

            line-height:
                1.75;
        }


        .curriculum-page .learning-statement {

            position:
                relative;

            z-index:
                2;

            padding:
                48px;

            border:
                1px solid
                rgba(198,164,92,.25);

            background:
                rgba(255,255,255,.035);

            box-shadow:
                0 25px 70px rgba(0,0,0,.20);

            transform:
                perspective(1000px)
                rotateY(-2deg);

            transition:
                .4s ease;
        }


        .curriculum-page .learning-statement:hover {

            transform:
                perspective(1000px)
                rotateY(0deg)
                translateY(-5px);
        }


        .curriculum-page .learning-statement > i {

            color:
                var(--curr-gold);

            font-size:
                28px;

            margin-bottom:
                20px;
        }


        .curriculum-page .learning-statement h3 {

            font-family:
                "Cormorant Garamond",
                serif;

            font-size:
                37px;

            line-height:
                1.2;

            margin:
                0 0 16px;
        }


        .curriculum-page .learning-statement p {

            color:
                rgba(255,255,255,.65);

            font-size:
                14px;

            line-height:
                1.85;

            margin:
                0;
        }


        /* ============================================================
           ASSESSMENT
        ============================================================ */

        .curriculum-page .assessment-card {

            background:
                white;

            padding:
                35px;

            height:
                100%;

            border:
                1px solid
                var(--curr-border);

            transition:
                .35s ease;
        }


        .curriculum-page .assessment-card:hover {

            transform:
                translateY(-6px);

            box-shadow:
                var(--curr-shadow);
        }


        .curriculum-page .assessment-card h3 {

            display:
                flex;

            align-items:
                center;

            gap:
                12px;

            font-family:
                "Cormorant Garamond",
                serif;

            font-size:
                28px;

            color:
                var(--curr-navy);

            margin:
                0 0 14px;
        }


        .curriculum-page .assessment-card h3 i {

            color:
                var(--curr-gold);

            font-size:
                18px;
        }


        .curriculum-page .assessment-card p {

            color:
                var(--curr-muted);

            font-size:
                13px;

            line-height:
                1.8;

            margin:
                0;
        }


        /* ============================================================
           HOLISTIC DEVELOPMENT
        ============================================================ */

        .curriculum-page .development-panel {

            background:
                var(--curr-navy);

            color:
                white;

            padding:
                55px;

            height:
                100%;

            position:
                relative;

            overflow:
                hidden;
        }


        .curriculum-page .development-panel::after {

            content:
                "";

            position:
                absolute;

            width:
                300px;

            height:
                300px;

            right:
                -150px;

            bottom:
                -130px;

            border:
                1px solid
                rgba(198,164,92,.15);

            border-radius:
                50%;
        }


        .curriculum-page .development-panel h2 {

            font-family:
                "Cormorant Garamond",
                serif;

            font-size:
                46px;

            line-height:
                1.1;

            margin:
                0 0 18px;
        }


        .curriculum-page .development-panel p {

            color:
                rgba(255,255,255,.67);

            font-size:
                14px;

            line-height:
                1.85;
        }


        .curriculum-page .development-list {

            margin:
                30px 0 0;

            padding:
                0;

            list-style:
                none;
        }


        .curriculum-page .development-list li {

            display:
                flex;

            gap:
                13px;

            color:
                rgba(255,255,255,.82);

            font-size:
                13px;

            padding:
                12px 0;

            border-bottom:
                1px solid
                rgba(255,255,255,.09);
        }


        .curriculum-page .development-list i {

            color:
                var(--curr-gold-light);

            margin-top:
                5px;
        }


        .curriculum-page .development-grid {

            display:
                grid;

            grid-template-columns:
                repeat(2,1fr);

            gap:
                15px;

            height:
                100%;
        }


        .curriculum-page .development-tile {

            min-height:
                170px;

            padding:
                28px;

            background:
                #fbfaf7;

            border:
                1px solid
                var(--curr-border);

            display:
                flex;

            flex-direction:
                column;

            justify-content:
                flex-end;

            transition:
                .3s ease;
        }


        .curriculum-page .development-tile:hover {

            background:
                #f3eee3;

            transform:
                translateY(-5px);

            box-shadow:
                var(--curr-shadow);
        }


        .curriculum-page .development-tile i {

            color:
                #a3833e;

            font-size:
                20px;

            margin-bottom:
                auto;
        }


        .curriculum-page .development-tile h4 {

            font-family:
                "Cormorant Garamond",
                serif;

            color:
                var(--curr-navy);

            font-size:
                25px;

            margin:
                25px 0 0;
        }


        /* ============================================================
           JOURNEY
        ============================================================ */

        .curriculum-page .journey {

            position:
                relative;

            max-width:
                900px;

            margin:
                45px auto 0;
        }


        .curriculum-page .journey::before {

            content:
                "";

            position:
                absolute;

            left:
                28px;

            top:
                0;

            bottom:
                0;

            width:
                1px;

            background:
                rgba(198,164,92,.45);
        }


        .curriculum-page .journey-item {

            position:
                relative;

            display:
                flex;

            gap:
                30px;

            margin-bottom:
                35px;
        }


        .curriculum-page .journey-item:last-child {

            margin-bottom:
                0;
        }


        .curriculum-page .journey-number {

            position:
                relative;

            z-index:
                2;

            flex:
                0 0 57px;

            width:
                57px;

            height:
                57px;

            border-radius:
                50%;

            background:
                var(--curr-navy);

            border:
                4px solid
                var(--curr-ivory);

            box-shadow:
                0 0 0 1px
                rgba(198,164,92,.5);

            color:
                var(--curr-gold-light);

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

            font-family:
                "Cormorant Garamond",
                serif;

            font-size:
                23px;
        }


        .curriculum-page .journey-content {

            background:
                white;

            padding:
                25px 30px;

            flex:
                1;

            border:
                1px solid
                var(--curr-border);

            transition:
                .3s ease;
        }


        .curriculum-page .journey-content:hover {

            transform:
                translateX(6px);

            box-shadow:
                var(--curr-shadow);
        }


        .curriculum-page .journey-content h3 {

            font-family:
                "Cormorant Garamond",
                serif;

            font-size:
                29px;

            color:
                var(--curr-navy);

            margin:
                0 0 7px;
        }


        .curriculum-page .journey-content p {

            color:
                var(--curr-muted);

            font-size:
                13px;

            line-height:
                1.8;

            margin:
                0;
        }


        /* ============================================================
           CTA
        ============================================================ */

        .curriculum-page .curriculum-cta {

            background:
                linear-gradient(
                    135deg,
                    #071426,
                    #122741
                );

            padding:
                90px 0;

            position:
                relative;

            overflow:
                hidden;

            color:
                white;
        }


        .curriculum-page .curriculum-cta::before {

            content:
                "";

            position:
                absolute;

            width:
                560px;

            height:
                560px;

            left:
                -330px;

            top:
                -250px;

            border:
                1px solid
                rgba(198,164,92,.11);

            border-radius:
                50%;
        }


        .curriculum-page .curriculum-cta::after {

            content:
                "";

            position:
                absolute;

            width:
                430px;

            height:
                430px;

            right:
                -200px;

            top:
                -150px;

            border:
                1px solid
                rgba(198,164,92,.14);

            border-radius:
                50%;
        }


        .curriculum-page .cta-inner {

            position:
                relative;

            z-index:
                2;

            max-width:
                820px;

            margin:
                auto;

            text-align:
                center;
        }


        .curriculum-page .cta-title {

            font-family:
                "Cormorant Garamond",
                serif;

            color:
                white;

            font-size:
                clamp(40px,5vw,61px);

            line-height:
                1.05;

            margin:
                0 0 18px;
        }


        .curriculum-page .cta-text {

            color:
                rgba(255,255,255,.66);

            font-size:
                14px;

            max-width:
                680px;

            margin:
                0 auto 28px;
        }


        /* ============================================================
           REVEAL
        ============================================================ */

        .curriculum-page .reveal {

            opacity:
                0;

            transform:
                translateY(30px);

            transition:
                opacity .8s ease,
                transform .8s ease;
        }


        .curriculum-page .reveal.visible {

            opacity:
                1;

            transform:
                translateY(0);
        }


        /* ============================================================
           BACK TO TOP
        ============================================================ */

        .curriculum-page .curriculum-back-top {

            position:
                fixed;

            right:
                24px;

            bottom:
                24px;

            width:
                44px;

            height:
                44px;

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

            background:
                var(--curr-gold);

            color:
                var(--curr-navy);

            z-index:
                9999;

            opacity:
                0;

            visibility:
                hidden;

            transform:
                translateY(15px);

            transition:
                .3s ease;

            cursor:
                pointer;

            box-shadow:
                0 8px 25px rgba(0,0,0,.18);
        }


        .curriculum-page .curriculum-back-top.show {

            opacity:
                1;

            visibility:
                visible;

            transform:
                translateY(0);
        }


        .curriculum-page .curriculum-back-top:hover {

            background:
                var(--curr-navy);

            color:
                white;
        }


        /* ============================================================
           RESPONSIVE
        ============================================================ */

        @media (max-width:991px) {

            .curriculum-page .curriculum-hero {

                min-height:
                    550px;
            }


            .curriculum-page .hero-content {

                padding:
                    100px 0 75px;
            }


            .curriculum-page .curr-section {

                padding:
                    80px 0;
            }


            .curriculum-page .intro-panel,
            .curriculum-page .development-panel {

                padding:
                    38px;
            }

        }


        @media (max-width:767px) {

            .curriculum-page .curriculum-container {

                width:
                    calc(100% - 40px);
            }


            .curriculum-page .curriculum-hero {

                min-height:
                    560px;

                background-position:
                    65% center;
            }


            .curriculum-page .hero-content {

                padding:
                    95px 0 70px;
            }


            .curriculum-page .hero-title {

                font-size:
                    55px;
            }


            .curriculum-page .hero-description {

                font-size:
                    14px;
            }


            .curriculum-page .curr-section {

                padding:
                    65px 0;
            }


            .curriculum-page .section-title {

                font-size:
                    43px;
            }


            .curriculum-page .intro-panel {

                padding:
                    28px;
            }


            .curriculum-page .intro-highlight {

                grid-template-columns:
                    1fr;
            }


            .curriculum-page .development-grid {

                margin-top:
                    20px;
            }


            .curriculum-page .learning-statement {

                padding:
                    30px;
            }


            .curriculum-page .journey {

                margin-top:
                    35px;
            }


            .curriculum-page .journey::before {

                left:
                    23px;
            }


            .curriculum-page .journey-item {

                gap:
                    18px;
            }


            .curriculum-page .journey-number {

                flex:
                    0 0 47px;

                width:
                    47px;

                height:
                    47px;
            }


            .curriculum-page .journey-content {

                padding:
                    20px;
            }

        }


        @media (max-width:480px) {

            .curriculum-page .hero-title {

                font-size:
                    47px;
            }


            .curriculum-page .hero-actions {

                flex-direction:
                    column;

                align-items:
                    stretch;
            }


            .curriculum-page .hero-btn {

                width:
                    100%;
            }


            .curriculum-page .development-grid {

                grid-template-columns:
                    1fr;
            }


            .curriculum-page .development-panel {

                padding:
                    30px;
            }


            .curriculum-page .learning-statement {

                padding:
                    27px;
            }


            .curriculum-page .learning-statement h3 {

                font-size:
                    31px;
            }


            .curriculum-page .stage-card {

                padding:
                    30px;
            }

        }


        /* ============================================================
           REDUCED MOTION
        ============================================================ */

        @media (prefers-reduced-motion: reduce) {

            .curriculum-page *,
            .curriculum-page *::before,
            .curriculum-page *::after {

                animation-duration:
                    .01ms !important;

                animation-iteration-count:
                    1 !important;

                scroll-behavior:
                    auto !important;

                transition-duration:
                    .01ms !important;
            }

        }

    </style>

</head>


<body>


<!-- ================================================================
     GLOBAL HEADER
================================================================ -->

<%- include('partials/header') %>


<!-- ================================================================
     CURRICULUM PAGE
================================================================ -->

<div class="curriculum-page">


    <!-- ============================================================
         HERO
    ============================================================= -->

    <section class="curriculum-hero">

        <div class="curriculum-light"></div>

        <div class="curriculum-container">

            <div class="hero-content reveal">

                <div class="hero-kicker">
                    Academic Programme
                </div>


                <h1 class="hero-title">

                    Learning with
                    <br>

                    <span>Purpose.</span>

                </h1>


                <p class="hero-description">

                    At St. Martin's High School, the curriculum is designed
                    to provide students with a strong academic foundation
                    while nurturing curiosity, creativity, discipline,
                    communication, confidence and a lifelong love of learning.

                </p>


                <div class="hero-actions">

                    <a
                        href="#academic-stages"
                        class="hero-btn hero-btn-primary"
                    >

                        <i class="fa-solid fa-book-open"></i>

                        Explore Curriculum

                    </a>


                    <a
                        href="#learning-approach"
                        class="hero-btn hero-btn-outline"
                    >

                        Our Learning Approach

                        <i class="fa-solid fa-arrow-down"></i>

                    </a>

                </div>

            </div>

        </div>

    </section>



    <!-- ============================================================
         INTRODUCTION
    ============================================================= -->

    <section class="curr-section curr-section-light">

        <div class="curriculum-container">

            <div class="row g-5 align-items-center">


                <div class="col-lg-5 reveal">

                    <div class="section-label">
                        Our Academic Philosophy
                    </div>


                    <h2 class="section-title">

                        Education that builds
                        <span>more than marks.</span>

                    </h2>


                    <p class="section-description">

                        A meaningful education should prepare young people
                        not only for examinations, but also for the choices,
                        responsibilities and opportunities that lie beyond
                        the classroom.

                    </p>

                </div>


                <div class="col-lg-7 reveal">

                    <div class="intro-panel">

                        <p>

                            The academic programme at St. Martin's High School
                            is structured to encourage students to understand
                            concepts deeply, communicate ideas confidently and
                            apply classroom learning to real situations.

                        </p>


                        <p>

                            Classroom instruction is complemented by practical
                            activities, discussions, projects, collaborative
                            learning, creative expression, sports and
                            co-curricular experiences.

                        </p>


                        <p>

                            Our approach seeks to develop disciplined,
                            independent and responsible learners who are
                            prepared to approach new challenges with confidence
                            and intellectual curiosity.

                        </p>


                        <div class="intro-highlight">


                            <div class="intro-highlight-item">

                                <i class="fa-solid fa-brain"></i>

                                <strong>
                                    Deep Understanding
                                </strong>

                                <span>
                                    Learning concepts rather than simply
                                    memorising information.
                                </span>

                            </div>


                            <div class="intro-highlight-item">

                                <i class="fa-solid fa-lightbulb"></i>

                                <strong>
                                    Curious Thinking
                                </strong>

                                <span>
                                    Encouraging questions, exploration
                                    and independent thought.
                                </span>

                            </div>


                            <div class="intro-highlight-item">

                                <i class="fa-solid fa-people-group"></i>

                                <strong>
                                    Collaboration
                                </strong>

                                <span>
                                    Learning through discussion,
                                    teamwork and shared experiences.
                                </span>

                            </div>


                            <div class="intro-highlight-item">

                                <i class="fa-solid fa-compass"></i>

                                <strong>
                                    Future Readiness
                                </strong>

                                <span>
                                    Building confidence and skills for
                                    future academic challenges.
                                </span>

                            </div>


                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>



    <!-- ============================================================
         CURRICULUM AT A GLANCE
    ============================================================= -->

    <section class="curr-section curr-section-white">

        <div class="curriculum-container">


            <div class="text-center mb-5 reveal">

                <div class="section-label justify-content-center">
                    Curriculum at a Glance
                </div>


                <h2 class="section-title">

                    Four dimensions of
                    <span>meaningful learning.</span>

                </h2>


                <p class="section-description mx-auto">

                    The curriculum brings together academic knowledge,
                    practical application, communication and personal
                    development to create a balanced learning experience.

                </p>

            </div>


            <div class="row g-4">


                <div class="col-md-6 col-lg-3 reveal">

                    <div class="glance-card">

                        <div class="glance-number">
                            01
                        </div>

                        <h3>
                            Strong Foundations
                        </h3>

                        <p>

                            Students build secure foundations in literacy,
                            numeracy, language, scientific thinking and
                            essential academic habits.

                        </p>

                    </div>

                </div>


                <div class="col-md-6 col-lg-3 reveal">

                    <div class="glance-card">

                        <div class="glance-number">
                            02
                        </div>

                        <h3>
                            Deeper Thinking
                        </h3>

                        <p>

                            Learning progressively develops reasoning,
                            analysis, questioning and the ability to
                            understand relationships between ideas.

                        </p>

                    </div>

                </div>


                <div class="col-md-6 col-lg-3 reveal">

                    <div class="glance-card">

                        <div class="glance-number">
                            03
                        </div>

                        <h3>
                            Practical Learning
                        </h3>

                        <p>

                            Projects, activities, demonstrations and
                            collaborative tasks help students connect
                            knowledge with practical situations.

                        </p>

                    </div>

                </div>


                <div class="col-md-6 col-lg-3 reveal">

                    <div class="glance-card">

                        <div class="glance-number">
                            04
                        </div>

                        <h3>
                            Future Readiness
                        </h3>

                        <p>

                            Students develop communication, confidence,
                            responsibility and independent learning habits
                            for the years ahead.

                        </p>

                    </div>

                </div>


            </div>

        </div>

    </section>



    <!-- ============================================================
         PRINCIPLES
    ============================================================= -->

    <section class="curr-section curr-section-white">

        <div class="curriculum-container">


            <div class="text-center mb-5 reveal">

                <div class="section-label justify-content-center">
                    The Foundation
                </div>


                <h2 class="section-title">

                    Four principles behind
                    <span>every classroom.</span>

                </h2>


                <p class="section-description mx-auto">

                    Our curriculum balances academic rigour with the
                    intellectual, emotional, social and physical development
                    of every learner.

                </p>

            </div>


            <div class="row g-4">


                <div class="col-md-6 col-lg-3 reveal">

                    <div class="principle-card">

                        <div class="principle-number">
                            01
                        </div>

                        <div class="principle-icon">
                            <i class="fa-solid fa-lightbulb"></i>
                        </div>

                        <h3>
                            Conceptual Understanding
                        </h3>

                        <p>

                            Students are encouraged to understand ideas,
                            principles and relationships rather than simply
                            memorising information.

                        </p>

                    </div>

                </div>


                <div class="col-md-6 col-lg-3 reveal">

                    <div class="principle-card">

                        <div class="principle-number">
                            02
                        </div>

                        <div class="principle-icon">
                            <i class="fa-solid fa-comments"></i>
                        </div>

                        <h3>
                            Communication
                        </h3>

                        <p>

                            Reading, writing, speaking, listening and
                            presentation skills are developed progressively
                            across the academic journey.

                        </p>

                    </div>

                </div>


                <div class="col-md-6 col-lg-3 reveal">

                    <div class="principle-card">

                        <div class="principle-number">
                            03
                        </div>

                        <div class="principle-icon">
                            <i class="fa-solid fa-puzzle-piece"></i>
                        </div>

                        <h3>
                            Application
                        </h3>

                        <p>

                            Students are encouraged to connect academic
                            concepts with practical situations, activities
                            and problem-solving exercises.

                        </p>

                    </div>

                </div>


                <div class="col-md-6 col-lg-3 reveal">

                    <div class="principle-card">

                        <div class="principle-number">
                            04
                        </div>

                        <div class="principle-icon">
                            <i class="fa-solid fa-seedling"></i>
                        </div>

                        <h3>
                            Character
                        </h3>

                        <p>

                            Discipline, responsibility, respect, integrity
                            and empathy remain important parts of the wider
                            educational experience.

                        </p>

                    </div>

                </div>


            </div>

        </div>

    </section>



    <!-- ============================================================
         ACADEMIC STAGES
    ============================================================= -->

    <section
        class="curr-section curr-section-light"
        id="academic-stages"
    >

        <div class="curriculum-container">


            <div class="row align-items-end mb-5">

                <div class="col-lg-7 reveal">

                    <div class="section-label">
                        Academic Stages
                    </div>

                    <h2 class="section-title">

                        A structured journey
                        <span>through school.</span>

                    </h2>

                </div>


                <div class="col-lg-5 reveal">

                    <p class="section-description mb-0">

                        Learning experiences become progressively more
                        challenging as students develop greater independence,
                        subject knowledge and responsibility.

                    </p>

                </div>

            </div>


            <div class="row g-4">


                <div class="col-lg-4 reveal">

                    <article class="stage-card">

                        <div class="stage-index">
                            Stage 01
                        </div>

                        <h3>
                            Primary Years
                        </h3>

                        <div class="stage-subtitle">
                            Building Strong Foundations
                        </div>

                        <p>

                            The primary years focus on curiosity, foundational
                            literacy and numeracy, communication and the
                            development of positive learning habits.

                        </p>

                        <ul class="stage-list">

                            <li>
                                Language and literacy development
                            </li>

                            <li>
                                Mathematical thinking
