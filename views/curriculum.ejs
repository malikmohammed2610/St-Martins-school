<!-- ================================================================
     JAVASCRIPT
================================================================ -->

<script>

document.addEventListener("DOMContentLoaded", function () {


    /* ============================================================
       SCROLL REVEAL
    ============================================================ */

    const revealItems =
        document.querySelectorAll(
            ".curriculum-page .reveal"
        );


    if ("IntersectionObserver" in window) {

        const observer =
            new IntersectionObserver(
                function (entries) {

                    entries.forEach(
                        function (entry) {

                            if (
                                entry.isIntersecting
                            ) {

                                entry.target.classList.add(
                                    "visible"
                                );

                                observer.unobserve(
                                    entry.target
                                );

                            }

                        }
                    );

                },
                {
                    threshold: 0.08,

                    rootMargin:
                        "0px 0px -40px 0px"
                }
            );


        revealItems.forEach(
            function (item) {

                observer.observe(item);

            }
        );

    } else {

        revealItems.forEach(
            function (item) {

                item.classList.add(
                    "visible"
                );

            }
        );

    }


    /* ============================================================
       BACK TO TOP
    ============================================================ */

    const backTop =
        document.getElementById(
            "curriculumBackTop"
        );


    function updateBackTop() {

        if (!backTop) return;


        if (
            window.scrollY > 500
        ) {

            backTop.classList.add(
                "show"
            );

        } else {

            backTop.classList.remove(
                "show"
            );

        }

    }


    window.addEventListener(
        "scroll",
        updateBackTop,
        {
            passive: true
        }
    );


    if (backTop) {

        backTop.addEventListener(
            "click",
            function () {

                window.scrollTo({

                    top: 0,

                    behavior: "smooth"

                });

            }
        );

    }


});

</script>


