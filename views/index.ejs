<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>St. Martin's High School | Balanagar, Hyderabad</title>

    <meta name="description"
          content="St. Martin's High School, Balanagar, Hyderabad — excellence in education, character and holistic development.">

    <link rel="icon" type="image/png" href="/images/logo.png">

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
    >

    <!-- Google Fonts -->
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <style>

        /* =========================================================
           GLOBAL
        ========================================================= */

        :root {
            --navy: #071A2B;
            --navy-light: #10283d;
            --navy-soft: #17344c;

            --gold: #C5A45A;
            --gold-light: #dfc982;

            --ivory: #F6F1E7;
            --white: #ffffff;

            --text: #263442;
            --muted: #71808f;

            --shadow: 0 25px 70px rgba(0,0,0,.14);
            --radius: 22px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: "Inter", sans-serif;
            background: var(--ivory);
            color: var(--text);
            overflow-x: hidden;
        }

        h1,
        h2,
        h3,
        h4,
        h5 {
            font-family: "Cormorant Garamond", serif;
        }

        a {
            text-decoration: none;
        }

        img {
            max-width: 100%;
        }


        /* =========================================================
           TOP BAR
        ========================================================= */

        .top-bar {
            background: var(--navy);
            color: rgba(255,255,255,.85);
            font-size: 13px;
            padding: 9px 0;
            position: relative;
            z-index: 1001;
        }

        .top-bar-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .top-info {
            display: flex;
            align-items: center;
            gap: 22px;
        }

        .top-info span {
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

        .top-info i {
            color: var(--gold-light);
        }


        /* =========================================================
           HEADER
        ========================================================= */

        .main-header {
            position: sticky;
            top: 0;
            z-index: 1000;

            background: rgba(246,241,231,.96);
            backdrop-filter: blur(16px);

            border-bottom: 1px solid rgba(197,164,90,.22);

            transition: .35s ease;
        }

        .main-header.scrolled {
            box-shadow: 0 10px 40px rgba(7,26,43,.12);
        }

        .header-inner {
            min-height: 92px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 25px;
        }


        /* =========================================================
           LOGO
        ========================================================= */

        .brand {
            display: flex;
            align-items: center;
            gap: 13px;

            color: var(--navy);
            flex-shrink: 0;
        }

        .brand:hover {
            color: var(--navy);
        }

        .brand-logo {
            width: 63px;
            height: 63px;

            object-fit: contain;

            filter: drop-shadow(
                0 8px 12px rgba(7,26,43,.12)
            );
        }

        .brand-text {
            line-height: 1;
        }

        .brand-name {
            font-family: "Cormorant Garamond", serif;
            font-size: 25px;
            font-weight: 700;
            letter-spacing: .4px;
        }

        .brand-location {
            margin-top: 6px;

            font-size: 9px;
            font-weight: 700;
            letter-spacing: 2px;

            color: var(--gold);

            text-transform: uppercase;
        }


        /* =========================================================
           NAVIGATION
        ========================================================= */

        .main-nav {
            display: flex;
            align-items: center;
            justify-content: center;

            gap: 3px;
        }

        .nav-item {
            position: relative;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 6px;

            color: var(--navy) !important;

            font-size: 13px;
            font-weight: 600;

            padding: 13px 12px;

            position: relative;

            transition: .25s ease;

            white-space: nowrap;
        }

        .nav-link::after {
            content: "";

            position: absolute;

            left: 12px;
            right: 12px;
            bottom: 5px;

            height: 2px;

            background: var(--gold);

            transform: scaleX(0);
            transform-origin: center;

            transition: transform .3s ease;
        }

        .nav-link:hover {
            color: #8d702d !important;
        }

        .nav-link:hover::after {
            transform: scaleX(1);
        }

        .nav-chevron {
            font-size: 9px;
            transition: transform .3s ease;
        }

        .nav-item:hover > .nav-link .nav-chevron {
            transform: rotate(180deg);
        }


        /* =========================================================
           PREMIUM DROPDOWNS
        ========================================================= */

        .dropdown-menu-custom {
            position: absolute;

            top: calc(100% + 14px);
            left: 50%;

            width: 255px;

            transform:
                translateX(-50%)
                translateY(12px)
                perspective(700px)
                rotateX(-8deg);

            transform-origin: top center;

            opacity: 0;
            visibility: hidden;

            background: rgba(7,26,43,.98);

            border: 1px solid rgba(197,164,90,.35);

            border-radius: 15px;

            padding: 9px;

            box-shadow:
                0 25px 55px rgba(0,0,0,.28),
                0 0 0 1px rgba(255,255,255,.03) inset;

            transition:
                opacity .25s ease,
                visibility .25s ease,
                transform .3s ease;

            z-index: 2000;
        }

        .dropdown-menu-custom::before {
            content: "";

            position: absolute;

            top: -7px;
            left: 50%;

            width: 14px;
            height: 14px;

            background: var(--navy);

            border-left: 1px solid rgba(197,164,90,.35);
            border-top: 1px solid rgba(197,164,90,.35);

            transform: translateX(-50%) rotate(45deg);
        }

        .nav-item:hover > .dropdown-menu-custom {
            opacity: 1;
            visibility: visible;

            transform:
                translateX(-50%)
                translateY(0)
                perspective(700px)
                rotateX(0);
        }

        .dropdown-item-custom {
            position: relative;

            display: flex;
            align-items: center;
            gap: 11px;

            color: rgba(255,255,255,.88);

            padding: 12px 13px;

            border-radius: 10px;

            font-size: 12px;
            font-weight: 500;

            transition: .25s ease;

            overflow: hidden;
        }

        .dropdown-item-custom::before {
            content: "";

            position: absolute;

            left: 0;
            top: 0;
            bottom: 0;

            width: 3px;

            background: var(--gold);

            transform: scaleY(0);

            transition: transform .25s ease;
        }

        .dropdown-item-custom i {
            width: 18px;

            color: var(--gold-light);

            font-size: 12px;

            transition: .25s ease;
        }

        .dropdown-item-custom:hover {
            color: white;

            background:
                linear-gradient(
                    90deg,
                    rgba(197,164,90,.16),
                    rgba(197,164,90,.05)
                );

            transform: translateX(4px);
        }

        .dropdown-item-custom:hover::before {
            transform: scaleY(1);
        }

        .dropdown-item-custom:hover i {
            transform: translateX(2px);
        }


        /* =========================================================
           HEADER CTA
        ========================================================= */

        .header-cta {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            gap: 8px;

            padding: 11px 18px;

            background: var(--navy);
            color: white;

            border: 1px solid var(--gold);

            border-radius: 50px;

            font-size: 12px;
            font-weight: 700;

            box-shadow: 0 8px 20px rgba(7,26,43,.16);

            transition: .3s ease;

            white-space: nowrap;
        }

        .header-cta:hover {
            color: var(--navy);

            background: var(--gold-light);

            transform: translateY(-2px);

            box-shadow:
                0 14px 28px rgba(7,26,43,.2);
        }


        /* =========================================================
           MOBILE BUTTON
        ========================================================= */

        .mobile-menu-btn {
            display: none;

            width: 45px;
            height: 45px;

            border: 1px solid rgba(197,164,90,.4);

            background: var(--navy);
            color: white;

            border-radius: 12px;

            font-size: 18px;
        }


        /* =========================================================
           HERO
        ========================================================= */

        .hero {
            position: relative;

            min-height: calc(100vh - 101px);

            overflow: hidden;

            background: var(--navy);
        }

        .hero-slider {
            position: absolute;
            inset: 0;
        }

        .hero-slide {
            position: absolute;
            inset: 0;

            width: 100%;
            height: 100%;

            opacity: 0;
            visibility: hidden;

            transform: scale(1.05);

            transition:
                opacity 1.2s ease,
                transform 7s ease,
                visibility 1.2s ease;

            background: var(--navy);
        }

        .hero-slide img {
            display: block;

            width: 100%;
            height: 100%;

            object-fit: cover;
            object-position: center 38%;

            user-select: none;
            -webkit-user-drag: none;
        }

        .hero-slide.active {
            opacity: 1;
            visibility: visible;
            transform: scale(1);
        }

        .hero-overlay {
            position: absolute;
            inset: 0;

            pointer-events: none;

            background:
                linear-gradient(
                    90deg,
                    rgba(7,26,43,.52) 0%,
                    rgba(7,26,43,.30) 34%,
                    rgba(7,26,43,.12) 67%,
                    rgba(7,26,43,.06) 100%
                ),
                linear-gradient(
                    180deg,
                    rgba(7,26,43,.08) 0%,
                    transparent 45%,
                    rgba(7,26,43,.38) 100%
                );
        }

        .hero-content {
            position: relative;
            z-index: 3;

            min-height: calc(100vh - 101px);

            display: flex;
            align-items: center;
        }

        .hero-copy {
            max-width: 750px;

            color: white;

            padding: 30px 34px;
            border-left: 2px solid var(--gold);

            background: linear-gradient(
                90deg,
                rgba(7,26,43,.48),
                rgba(7,26,43,.10)
            );

            border-radius: 0 20px 20px 0;
            backdrop-filter: blur(2px);

            box-shadow: 0 25px 70px rgba(0,0,0,.10);
        }

        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 9px;

            margin-bottom: 17px;

            color: var(--gold-light);

            font-size: 12px;
            font-weight: 700;

            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .hero-eyebrow::before {
            content: "";

            width: 36px;
            height: 1px;

            background: var(--gold);
        }

        .hero-title {
            font-size: clamp(48px, 7vw, 90px);

            line-height: .92;

            font-weight: 600;

            margin-bottom: 24px;
        }

        .hero-title span {
            color: var(--gold-light);
        }

        .hero-description {
            max-width: 620px;

            color: rgba(255,255,255,.8);

            line-height: 1.8;

            font-size: 15px;

            margin-bottom: 30px;
        }

        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 13px;
        }

        .btn-gold {
            display: inline-flex;
            align-items: center;
            gap: 9px;

            padding: 14px 22px;

            background: var(--gold);

            color: var(--navy);

            border-radius: 50px;

            font-size: 13px;
            font-weight: 700;

            transition: .3s ease;
        }

        .btn-gold:hover {
            background: var(--gold-light);
            color: var(--navy);

            transform: translateY(-3px);
        }

        .btn-outline-light-custom {
            display: inline-flex;
            align-items: center;
            gap: 9px;

            padding: 13px 22px;

            border: 1px solid rgba(255,255,255,.5);

            color: white;

            border-radius: 50px;

            font-size: 13px;
            font-weight: 600;

            transition: .3s ease;
        }

        .btn-outline-light-custom:hover {
            color: var(--navy);

            background: white;

            transform: translateY(-3px);
        }


        /* =========================================================
           SECTION
        ========================================================= */

        .section {
            padding: 100px 0;
        }

        .section-heading {
            max-width: 700px;
            margin-bottom: 55px;
        }

        .section-label {
            display: inline-flex;
            align-items: center;
            gap: 10px;

            color: var(--gold);

            font-size: 11px;
            font-weight: 800;

            letter-spacing: 3px;

            text-transform: uppercase;

            margin-bottom: 12px;
        }

        .section-label::before {
            content: "";

            width: 30px;
            height: 1px;

            background: var(--gold);
        }

        .section-title {
            font-size: clamp(40px, 5vw, 62px);

            line-height: 1;

            color: var(--navy);

            margin-bottom: 18px;
        }

        .section-description {
            color: var(--muted);

            line-height: 1.8;

            font-size: 14px;
        }


        /* =========================================================
           DISCOVER OUR STORY
        ========================================================= */

        .story-section {
            background: var(--ivory);
        }

        .story-card {
            position: relative;

            background: white;

            border-radius: 28px;

            overflow: hidden;

            box-shadow: var(--shadow);

            transform-style: preserve-3d;

            transition: transform .2s ease, box-shadow .3s ease;
        }

        .story-card:hover {
            box-shadow:
                0 35px 90px rgba(7,26,43,.2);
        }

        .story-image-wrap {
            position: relative;

            height: 100%;

            min-height: 530px;

            overflow: hidden;

            background: var(--navy);
        }

        .story-image {
            width: 100%;
            height: 100%;

            min-height: 530px;

            object-fit: contain;

            background: var(--navy);

            transition: transform .8s ease;
        }

        .story-card:hover .story-image {
            transform: scale(1.025);
        }

        .story-image-overlay {
            position: absolute;
            inset: 0;

            background:
                linear-gradient(
                    180deg,
                    transparent 55%,
                    rgba(7,26,43,.7)
                );
        }

        .story-number {
            position: absolute;

            top: 25px;
            right: 25px;

            width: 70px;
            height: 70px;

            display: grid;
            place-items: center;

            border-radius: 50%;

            background: rgba(255,255,255,.12);

            border: 1px solid rgba(255,255,255,.4);

            backdrop-filter: blur(10px);

            color: white;

            font-family: "Cormorant Garamond", serif;
            font-size: 25px;

            transform: translateZ(35px);
        }

        .story-content {
            padding: 60px;
        }

        .story-content h3 {
            font-size: 46px;
            line-height: 1;

            color: var(--navy);

            margin-bottom: 20px;
        }

        .story-content p {
            color: var(--muted);

            font-size: 14px;

            line-height: 1.9;

            margin-bottom: 22px;
        }

        .story-points {
            display: grid;
            grid-template-columns: 1fr 1fr;

            gap: 13px;

            margin: 25px 0 30px;
        }

        .story-point {
            display: flex;
            align-items: center;
            gap: 9px;

            font-size: 12px;
            font-weight: 600;

            color: var(--navy);
        }

        .story-point i {
            color: var(--gold);
        }


        /* =========================================================
           FEATURE CARDS
        ========================================================= */

        .features-section {
            background: white;
        }

        .feature-card {
            height: 100%;

            padding: 32px;

            background: var(--ivory);

            border: 1px solid rgba(197,164,90,.18);

            border-radius: 20px;

            transition: .35s ease;

            transform-style: preserve-3d;
        }

        .feature-card:hover {
            transform:
                perspective(900px)
                rotateX(4deg)
                rotateY(-4deg)
                translateY(-8px);

            box-shadow:
                0 25px 55px rgba(7,26,43,.12);
        }

        .feature-icon {
            width: 58px;
            height: 58px;

            display: grid;
            place-items: center;

            border-radius: 16px;

            background: var(--navy);
            color: var(--gold-light);

            font-size: 20px;

            margin-bottom: 22px;

            box-shadow:
                0 10px 25px rgba(7,26,43,.15);

            transform: translateZ(25px);
        }

        .feature-card h3 {
            color: var(--navy);

            font-size: 28px;

            margin-bottom: 10px;
        }

        .feature-card p {
            color: var(--muted);

            font-size: 13px;

            line-height: 1.8;
        }


        /* =========================================================
           CAMPUS GALLERY
        ========================================================= */

        .campus-section {
            background: var(--navy);
        }

        .campus-section .section-title {
            color: white;
        }

        .campus-section .section-description {
            color: rgba(255,255,255,.65);
        }

        .campus-grid {
            display: grid;

            grid-template-columns: 1.45fr 1fr 1fr;

            grid-template-rows: 250px 250px;

            gap: 14px;
        }

        .campus-image {
            position: relative;

            overflow: hidden;

            border-radius: 18px;

            background: #10283d;

            box-shadow:
                0 20px 45px rgba(0,0,0,.22);
        }

        .campus-image:first-child {
            grid-row: span 2;
        }

        .campus-image img {
            width: 100%;
            height: 100%;

            object-fit: contain;

            background: #10283d;

            transition: transform .7s ease;
        }

        .campus-image:hover img {
            transform: scale(1.06);
        }

        .campus-caption {
            position: absolute;

            left: 18px;
            right: 18px;
            bottom: 17px;

            padding: 12px 14px;

            border-radius: 12px;

            background: rgba(7,26,43,.72);

            backdrop-filter: blur(10px);

            color: white;

            font-size: 12px;
            font-weight: 600;
        }


        /* =========================================================
           VIDEO
        ========================================================= */

        .video-card {
            position: relative;

            overflow: hidden;

            border-radius: 26px;

            box-shadow: var(--shadow);

            transform-style: preserve-3d;

            transition: .4s ease;
        }

        .video-card:hover {
            transform:
                perspective(1000px)
                rotateX(2deg)
                rotateY(-2deg)
                translateY(-5px);
        }

        .video-card video {
            display: block;

            width: 100%;

            max-height: 650px;

            object-fit: cover;

            background: var(--navy);
        }


        /* =========================================================
           MAP
        ========================================================= */

        .map-section {
            background: var(--ivory);
        }

        .map-card {
            position: relative;

            overflow: hidden;

            border-radius: 28px;

            min-height: 500px;

            box-shadow: var(--shadow);

            border: 1px solid rgba(197,164,90,.2);
        }

        .map-card iframe {
            position: absolute;
            inset: 0;

            width: 100%;
            height: 100%;

            border: 0;
        }

        .map-info {
            position: absolute;

            left: 25px;
            bottom: 25px;

            width: min(360px, calc(100% - 50px));

            padding: 24px;

            background: rgba(7,26,43,.94);

            backdrop-filter: blur(14px);

            border: 1px solid rgba(197,164,90,.4);

            border-radius: 18px;

            color: white;

            box-shadow:
                0 20px 45px rgba(0,0,0,.2);
        }

        .map-info h3 {
            font-size: 27px;

            margin-bottom: 8px;
        }

        .map-info p {
            color: rgba(255,255,255,.68);

            font-size: 12px;

            line-height: 1.7;

            margin-bottom: 14px;
        }

        .map-link {
            display: inline-flex;
            align-items: center;
            gap: 7px;

            color: var(--gold-light);

            font-size: 12px;
            font-weight: 700;
        }


        /* =========================================================
           REVIEW SECTION
        ========================================================= */

        .review-section {
            background: white;
        }

        .review-form {
            background: var(--ivory);

            border-radius: 25px;

            padding: 40px;

            border: 1px solid rgba(197,164,90,.2);

            box-shadow:
                0 20px 50px rgba(7,26,43,.08);
        }

        .form-control-custom {
            width: 100%;

            padding: 14px 16px;

            border-radius: 11px;

            border: 1px solid rgba(7,26,43,.12);

            background: white;

            outline: none;

            font-family: inherit;

            font-size: 13px;

            transition: .25s ease;
        }

        .form-control-custom:focus {
            border-color: var(--gold);

            box-shadow:
                0 0 0 4px rgba(197,164,90,.1);
        }

        textarea.form-control-custom {
            min-height: 130px;

            resize: vertical;
        }


        /* =========================================================
           FOOTER
        ========================================================= */

        footer {
            background: var(--navy);

            color: rgba(255,255,255,.7);

            padding-top: 75px;
        }

        .footer-brand {
            color: white;

            font-family: "Cormorant Garamond", serif;

            font-size: 28px;
        }

        .footer-text {
            font-size: 13px;

            line-height: 1.9;

            color: rgba(255,255,255,.58);

            max-width: 420px;
        }

        .footer-title {
            color: white;

            font-family: "Inter", sans-serif;

            font-size: 13px;

            font-weight: 700;

            letter-spacing: .5px;

            margin-bottom: 20px;
        }

        .footer-links {
            list-style: none;

            padding: 0;
        }

        .footer-links li {
            margin-bottom: 10px;
        }

        .footer-links a {
            color: rgba(255,255,255,.58);

            font-size: 12px;

            transition: .2s ease;
        }

        .footer-links a:hover {
            color: var(--gold-light);

            padding-left: 4px;
        }

        .footer-bottom {
            margin-top: 55px;

            padding: 20px 0;

            border-top: 1px solid rgba(255,255,255,.1);

            font-size: 11px;

            color: rgba(255,255,255,.45);
        }


        /* =========================================================
           SCROLL REVEAL
        ========================================================= */

        .reveal {
            opacity: 0;

            transform: translateY(35px);

            transition:
                opacity .8s ease,
                transform .8s ease;
        }

        .reveal.visible {
            opacity: 1;

            transform: translateY(0);
        }


        /* =========================================================
           RESPONSIVE NAVIGATION
        ========================================================= */

        @media (max-width: 1200px) {

            .main-nav {
                gap: 0;
            }

            .nav-link {
                padding-left: 8px;
                padding-right: 8px;
            }

            .header-cta {
