                padding: 16px 22px;

                justify-content: space-between;
            }

            .nav-link::after {
                display: none;
            }

            .dropdown-menu-custom {
                position: static;

                width: 100%;

                transform: none !important;

                opacity: 1;
                visibility: visible;

                display: none;

                border: 0;

                border-radius: 0;

                background: rgba(7,26,43,.98);

                box-shadow: none;

                padding: 5px 10px;
            }

            .dropdown-menu-custom::before {
                display: none;
            }

            .nav-item.dropdown-open
            .dropdown-menu-custom {
                display: block;
            }

            .dropdown-item-custom {
                padding: 12px 15px;
            }

            .story-content {
