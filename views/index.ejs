<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>St. Martin's High School | Balanagar, Hyderabad</title>

    <link rel="icon" type="image/png" href="/images/logo.png">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap"
        rel="stylesheet">

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <style>

        :root {
            --navy: #071A2B;
            --navy-light: #10283d;
            --gold: #C5A45A;
            --gold-light: #dfc982;
            --cream: #F6F1E7;
            --white: #ffffff;
            --muted: #9eabb8;
            --text: #333b43;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
            color: var(--text);
            background: #f8f9fa;
            overflow-x: hidden;
        }

        a {
            transition: all 0.3s ease;
        }

        .font-serif {
            font-family: 'Cormorant Garamond', serif;
        }

        .text-navy {
            color: var(--navy) !important;
        }

        .text-gold {
            color: var(--gold) !important;
        }

        .tracking-widest {
            letter-spacing: 0.16em;
        }

        .section-spacing {
            padding: 100px 0;
        }

        /* =====================================================
           HEADER
        ===================================================== */

        .school-header {
            background: rgba(255,255,255,0.98);
            border-bottom: 1px solid rgba(7,26,43,0.10);
            position: sticky;
            top: 0;
            z-index: 1050;
        }

        .school-logo {
            width: 62px;
            height: 62px;
            object-fit: contain;
        }

        .school-name {
            color: var(--navy);
            font-size: 1.25rem;
            font-weight: 700;
            letter-spacing: 0.02em;
        }

        .school-location {
            color: #6c757d;
            font-size: 0.68rem;
            letter-spacing: 0.16em;
        }

        .header-phone {
            color: #6c757d;
            font-size: 0.84rem;
        }

        .header-phone i {
            color: var(--gold);
        }

        .teacher-btn {
            border: 1px solid var(--navy);
            color: var(--navy);
            background: transparent;
            padding: 9px 18px;
            font-size: 0.72rem;
            letter-spacing: 0.10em;
            text-transform: uppercase;
        }

        .teacher-btn:hover {
            background: var(--navy);
            color: white;
        }

        /* =====================================================
           NAVIGATION
        ===================================================== */

        .main-navigation {
            background: var(--navy);
            z-index: 1040;
        }

        .main-navigation .nav-link {
            color: white !important;
            font-size: 0.78rem;
            font-weight: 500;
            letter-spacing: 0.07em;
            padding: 15px 8px !important;
            position: relative;
        }

        .main-navigation .nav-link::after {
            transition: all 0.3s ease;
        }

        .main-navigation .nav-link:hover {
            color: var(--gold-light) !important;
        }

        .dropdown-menu {
            border: none;
            border-radius: 0;
            padding: 8px 0;
            box-shadow: 0 20px 50px rgba(7,26,43,0.18);
        }

        .dropdown-item {
            padding: 10px 22px;
            font-size: 0.83rem;
            color: var(--navy);
        }

        .dropdown-item:hover {
            background: var(--cream);
            color: var(--navy);
        }

        /* =====================================================
           HERO
        ===================================================== */

        .hero {
            min-height: 720px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: var(--navy);
        }

        .hero-video {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .hero-overlay {
            position: absolute;
            inset: 0;
            background:
                linear-gradient(
                    90deg,
                    rgba(7,26,43,0.92) 0%,
                    rgba(7,26,43,0.72) 45%,
                    rgba(7,26,43,0.45) 100%
                );
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 900px;
        }

        .hero-eyebrow {
            color: var(--gold-light);
            font-size: 0.76rem;
            font-weight: 600;
            letter-spacing: 0.24em;
            text-transform: uppercase;
        }

        .hero-title {
            color: white;
            font-size: clamp(3.4rem, 7vw, 6.5rem);
            line-height: 0.95;
            margin: 20px 0;
            font-weight: 600;
        }

        .hero-description {
            max-width: 680px;
            margin: auto;
            color: rgba(255,255,255,0.82);
            font-size: 1.05rem;
            line-height: 1.8;
            font-weight: 300;
        }

        .btn-premium {
            padding: 13px 27px;
            border: 1px solid var(--gold);
            background: var(--gold);
            color: var(--navy);
            font-size: 0.74rem;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .btn-premium:hover {
            background: transparent;
            color: white;
            border-color: white;
        }

        .btn-premium-outline {
            padding: 13px 27px;
            border: 1px solid rgba(255,255,255,0.65);
            background: transparent;
            color: white;
            font-size: 0.74rem;
            font-weight: 500;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .btn-premium-outline:hover {
            background: white;
            color: var(--navy);
        }

        /* =====================================================
           INTRO
        ===================================================== */

        .intro-section {
            background: white;
        }

        .gold-line {
            width: 60px;
            height: 2px;
            background: var(--gold);
            display: inline-block;
            margin-bottom: 22px;
        }

        .section-eyebrow {
            color: var(--gold);
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.18em;
            text-transform: uppercase;
        }

        .section-title {
            color: var(--navy);
            font-size: clamp(2.5rem, 4vw, 4rem);
            line-height: 1;
            margin: 12px 0 25px;
            font-weight: 600;
        }

        .body-text {
            color: #66717b;
            line-height: 1.9;
            font-size: 0.96rem;
        }

        .intro-image-wrapper {
            position: relative;
        }

        .intro-image {
            width: 100%;
            height: 470px;
            object-fit: cover;
            display: block;
        }

        .image-accent {
            position: absolute;
            width: 100px;
            height: 100px;
            right: -18px;
            bottom: -18px;
            border-right: 2px solid var(--gold);
            border-bottom: 2px solid var(--gold);
        }

        /* =====================================================
           STATS
        ===================================================== */

        .stats-section {
            background: var(--navy);
            padding: 65px 0;
        }

        .stat-item {
            text-align: center;
            padding: 15px;
        }

        .stat-number {
            color: var(--gold-light);
            font-family: 'Cormorant Garamond', serif;
            font-size: 3rem;
            font-weight: 600;
            line-height: 1;
        }

        .stat-label {
            color: rgba(255,255,255,0.65);
            margin-top: 8px;
            font-size: 0.72rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
        }

        /* =====================================================
           VIDEO SECTION
        ===================================================== */

        .video-section {
            background: var(--cream);
        }

        .video-frame {
            background: var(--navy);
            padding: 8px;
            box-shadow: 0 25px 60px rgba(7,26,43,0.18);
        }

        .video-frame iframe {
            display: block;
            width: 100%;
            height: 480px;
            border: 0;
        }

        .video-caption {
            color: #7b858e;
            font-size: 0.75rem;
            letter-spacing: 0.04em;
        }

        /* =====================================================
           WHY CHOOSE US
        ===================================================== */

        .features-section {
            background: white;
        }

        .feature-card {
            height: 100%;
            padding: 42px 32px;
            background: white;
            border: 1px solid #e7e7e7;
            position: relative;
            transition: all 0.35s ease;
        }

        .feature-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 45px rgba(7,26,43,0.10);
            border-color: rgba(197,164,90,0.45);
        }

        .feature-icon {
            width: 58px;
            height: 58px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(197,164,90,0.5);
            color: var(--gold);
            font-size: 1.25rem;
            margin-bottom: 25px;
        }

        .feature-card h3 {
            color: var(--navy);
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.7rem;
            margin-bottom: 14px;
        }

        .feature-card p {
            color: #75808a;
            line-height: 1.8;
            font-size: 0.9rem;
        }

        /* =====================================================
           CAMPUS LOCATION
        ===================================================== */

        .location-section {
            background: #f4f5f6;
        }

        .location-card {
            background: white;
            padding: 45px;
            border-left: 3px solid var(--gold);
            box-shadow: 0 15px 45px rgba(7,26,43,0.07);
        }

        .location-card h3 {
            color: var(--navy);
            font-size: 2rem;
        }

        .location-card p {
            color: #737e87;
            line-height: 1.9;
        }

        .map-frame {
            height: 430px;
            overflow: hidden;
            background: #ddd;
            box-shadow: 0 15px 45px rgba(7,26,43,0.10);
        }

        .map-frame iframe {
            width: 100%;
            height: 100%;
            border: 0;
        }

        /* =====================================================
           REVIEWS
        ===================================================== */

        .reviews-section {
            background: var(--cream);
        }

        .review-box {
            background: white;
            padding: 55px;
            border: 1px solid rgba(7,26,43,0.08);
            box-shadow: 0 20px 55px rgba(7,26,43,0.08);
        }

        .review-box label {
            color: var(--navy);
            font-size: 0.74rem;
            font-weight: 600;
            letter-spacing: 0.07em;
            text-transform: uppercase;
        }

        .form-control,
        .form-select {
            border-radius: 0;
            border: 1px solid #dfe3e6;
            padding: 12px 14px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--gold);
            box-shadow: 0 0 0 0.15rem rgba(197,164,90,0.12);
        }

        /* =====================================================
           CTA
        ===================================================== */

        .cta-section {
            background:
                linear-gradient(
                    rgba(7,26,43,0.94),
                    rgba(7,26,43,0.94)
                ),
                url('/images/hero-bg.jpg') center/cover;
            padding: 90px 0;
            text-align: center;
        }

        .cta-title {
            color: white;
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(2.5rem, 5vw, 4.5rem);
            line-height: 1;
            margin-bottom: 18px;
        }

        .cta-text {
            color: rgba(255,255,255,0.7);
            max-width: 650px;
            margin: auto;
            line-height: 1.8;
        }

        /* =====================================================
           FOOTER
        ===================================================== */

        .site-footer {
            background: #061522;
            color: white;
            border-top: 3px solid var(--gold);
            padding: 75px 0 25px;
        }

        .footer-school-logo {
            width: 58px;
            height: 58px;
            object-fit: contain;
            margin-right: 14px;
        }

        .footer-brand-title {
            color: var(--gold-light);
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.55rem;
            font-weight: 700;
            margin: 0;
        }

        .footer-heading {
            color: var(--gold);
            font-size: 0.72rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            font-weight: 600;
            margin-bottom: 24px;
        }

        .footer-text {
            color: #9ba8b4;
            font-size: 0.84rem;
            line-height: 1.8;
        }

        .footer-link {
            display: block;
            color: #9ba8b4;
            text-decoration: none;
            font-size: 0.84rem;
            margin-bottom: 13px;
        }

        .footer-link:hover {
            color: var(--gold-light);
            padding-left: 4px;
        }

        .footer-contact {
            color: #9ba8b4;
            font-size: 0.84rem;
            line-height: 1.8;
            margin-bottom: 15px;
        }

        .footer-contact i {
            width: 25px;
            color: var(--gold);
        }

        .footer-map {
            width: 100%;
            height: 220px;
            border: 1px solid rgba(197,164,90,0.3);
        }

        .footer-map iframe {
            width: 100%;
            height: 100%;
            border: 0;
        }

        .footer-divider {
            border-color: rgba(197,164,90,0.2);
            margin: 45px 0 22px;
        }

        .footer-bottom {
            color: #71808d;
            font-size: 0.72rem;
        }

        .teacher-footer-link {
            color: var(--gold-light);
            text-decoration: none;
        }

        .teacher-footer-link:hover {
            color: white;
        }

        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @media (max-width: 991px) {

            .hero {
                min-height: 620px;
            }

            .hero-title {
                font-size: 4rem;
            }

            .section-spacing {
                padding: 75px 0;
            }

            .intro-image {
                height: 380px;
            }

            .video-frame iframe {
                height: 400px;
            }

            .location-card {
                padding: 35px;
            }

        }

        @media (max-width: 767px) {

            .school-logo {
                width: 50px;
                height: 50px;
            }

            .school-name {
                font-size: 1rem;
            }

            .school-location {
                font-size: 0.58rem;
            }

            .hero {
                min-height: 600px;
            }

            .hero-title {
                font-size: 3.3rem;
            }

            .hero-description {
                font-size: 0.9rem;
            }

            .section-spacing {
                padding: 65px 0;
            }

            .section-title {
                font-size: 2.7rem;
            }

            .video-frame iframe {
                height: 280px;
            }

            .review-box {
                padding: 30px 22px;
            }

            .map-frame {
                height: 320px;
            }

        }

    </style>

</head>


<body>


