<!-- =========================================================
     HERO
========================================================= -->

<section class="hero">

    <video
        autoplay
        muted
        loop
        playsinline
        class="hero-video">

        <source
            src="/images/placeholders/campus-hero.mp4"
            type="video/mp4">

    </video>


    <div class="hero-overlay"></div>


    <div class="container hero-content text-center">

        <div class="hero-eyebrow">
            Welcome to Scholastic Excellence
        </div>


        <h1 class="hero-title font-serif">

            St. Martin's<br>
            High School

        </h1>


        <p class="hero-description mb-5">

            Empowering young minds through academic
            excellence, moral integrity and holistic
            development in Balanagar, Hyderabad.

        </p>


        <div class="d-flex justify-content-center gap-3 flex-wrap">

            <a
                href="/admissions"
                class="btn-premium text-decoration-none">

                Explore Admissions

            </a>


            <a
                href="/about"
                class="btn-premium-outline text-decoration-none">

                Discover Our School

            </a>

        </div>

    </div>

</section>


<!-- =========================================================
     INTRODUCTION
========================================================= -->

<section class="intro-section section-spacing">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <span class="gold-line"></span>

                <div class="section-eyebrow">
                    Who We Are
                </div>


                <h2 class="section-title font-serif">

                    A Tradition of Academic Distinction
                    & Moral Integrity

                </h2>


                <p class="body-text">

                    St. Martin's High School in Balanagar,
                    Hyderabad, is committed to creating an
                    environment where education goes beyond
                    textbooks and examinations.

                </p>


                <p class="body-text">

                    Our approach combines academic discipline,
                    character development, creativity and
                    responsible citizenship. Every student is
                    encouraged to think independently, discover
                    their strengths and develop the confidence
                    needed to succeed in an ever-changing world.

                </p>


                <a
                    href="/about"
                    class="btn btn-dark rounded-0 px-4 py-3 mt-2">

                    Discover Our Story →

                </a>

            </div>


            <div class="col-lg-6">

                <div class="intro-image-wrapper">

                    <img
                        src="/images/story-image.png"
                        alt="St. Martin's High School Campus"
                        class="intro-image">

                    <div class="image-accent"></div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     STATS
