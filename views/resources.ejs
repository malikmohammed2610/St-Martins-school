<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"><title>Resource Hub | St. Martin's High School</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body style="background: var(--ivory);">
    <header class="site-header" style="position: relative; background: var(--navy-midnight); border-bottom: 1px solid rgba(197,164,90,0.2);">
        <nav class="main-nav"><a href="/" class="logo-container">ST. MARTIN'S <span style="color:var(--gold)">HIGH SCHOOL</span></a><ul class="nav-links"><li><a href="/resources" style="color: var(--gold);">Resources</a></li><li><a href="/disclosure">Disclosure</a></li><li><a href="/contact">Contact</a></li></ul></nav>
    </header>
    <main style="padding: 6rem 5%; max-width: 1000px; margin: 0 auto;">
        <span class="eyebrow">Download Center</span>
        <h1 style="font-size: 3rem; margin-bottom: 1rem;">Student & Parent Resources</h1>
        <div class="gold-rule"></div>
        <div style="background: var(--white); padding: 2.5rem; margin-top: 3rem; border: 1px solid rgba(197,164,90,0.2);">
            <ul style="list-style: none; display: grid; gap: 1.5rem;">
                <li style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(0,0,0,0.05); padding-bottom: 1rem;">
                    <span style="font-weight: 500;">Academic Calendar & Syllabus Guide</span>
                    <a href="#" style="color: var(--gold); text-decoration: none; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em;">Download PDF</a>
                </li>
                <li style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(0,0,0,0.05); padding-bottom: 1rem;">
                    <span style="font-weight: 500;">Parent Handbook & Code of Conduct</span>
                    <a href="#" style="color: var(--gold); text-decoration: none; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em;">Download PDF</a>
                </li>
            </ul>
        </div>
    </main>
    <script src="/js/script.js"></script>
    <%- include('partials/footer') %>
</body>
</html>