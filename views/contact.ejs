
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Contact Us | St. Martin's High School, Balanagar</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/logo.png">

    <!-- Existing Website CSS -->
    <link rel="stylesheet" href="/css/style.css">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

        /* =========================================================
           ST. MARTIN'S HIGH SCHOOL
           PREMIUM CONTACT PAGE
        ========================================================= */

        :root {
            --smhs-navy: #071426;
            --smhs-navy-2: #0d2038;
            --smhs-gold: #c5a45a;
            --smhs-gold-light: #e1c982;
            --smhs-ivory: #f7f4ec;
            --smhs-white: #ffffff;
            --smhs-text: #263342;
            --smhs-muted: #697586;
            --smhs-border: rgba(197,164,90,0.25);
            --smhs-shadow: 0 25px 70px rgba(7,20,38,0.12);
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: var(--smhs-ivory);
            color: var(--smhs-text);
            font-family: "Inter", sans-serif;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* =========================================================
           HEADER
        ========================================================= */

        .contact-header {
            background:
                linear-gradient(
                    90deg,
                    rgba(7,20,38,0.98),
                    rgba(7,20,38,0.94)
                );

            border-bottom: 1px solid rgba(197,164,90,0.35);

            min-height: 82px;

            display: flex;
            align-items: center;

            position: relative;
            z-index: 50;
        }

        .contact-header-inner {
            width: min(1200px, 92%);
            margin: auto;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 30px;
        }

        .school-brand {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .school-brand img {
            width: 55px;
            height: 55px;
            object-fit: contain;
        }

        .school-brand-text {
            color: white;
        }

        .school-brand-text strong {
            display: block;
            font-family: "Cormorant Garamond", serif;
            font-size: 24px;
            line-height: 1;
            letter-spacing: 0.5px;
        }

        .school-brand-text span {
            display: block;
            margin-top: 4px;
            color: var(--smhs-gold-light);
            font-size: 10px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .contact-nav {
            display: flex;
            align-items: center;
            gap: 28px;
        }

        .contact-nav a {
            color: rgba(255,255,255,0.84);
            font-size: 13px;
            font-weight: 500;
            position: relative;
            padding: 30px 0;
            transition: 0.3s ease;
        }

        .contact-nav a::after {
            content: "";
            position: absolute;
            bottom: 20px;
            left: 0;
            width: 0;
            height: 1px;
            background: var(--smhs-gold);
            transition: 0.3s ease;
        }

        .contact-nav a:hover,
        .contact-nav a.active {
            color: white;
        }

        .contact-nav a:hover::after,
        .contact-nav a.active::after {
            width: 100%;
        }

        /* =========================================================
           HERO
        ========================================================= */

        .contact-hero {
            min-height: 480px;

            position: relative;

            display: flex;
            align-items: center;
            justify-content: center;

            overflow: hidden;

            background:
                linear-gradient(
                    135deg,
                    rgba(7,20,38,0.97),
                    rgba(13,32,56,0.94)
                );
        }

        .contact-hero::before {
            content: "";

            position: absolute;
            inset: 0;

            background:
                radial-gradient(
                    circle at 20% 20%,
                    rgba(197,164,90,0.16),
                    transparent 35%
                ),
                radial-gradient(
                    circle at 80% 80%,
                    rgba(197,164,90,0.09),
                    transparent 30%
                );
        }

        .hero-line {
            position: absolute;
            width: 1px;
            height: 180px;
            background: linear-gradient(
                to bottom,
                transparent,
                rgba(197,164,90,0.65),
                transparent
            );
            left: 9%;
            top: 50%;
            transform: translateY(-50%);
        }

        .hero-content {
            width: min(900px, 90%);
            text-align: center;
            position: relative;
            z-index: 2;
        }

        .hero-eyebrow {
            color: var(--smhs-gold-light);
            font-size: 12px;
            letter-spacing: 4px;
            text-transform: uppercase;
            font-weight: 600;
            margin-bottom: 18px;
        }

        .hero-content h1 {
            color: white;
            font-family: "Cormorant Garamond", serif;
            font-size: clamp(54px, 7vw, 90px);
            font-weight: 600;
            line-height: 0.95;
            margin: 0 0 24px;
        }

        .hero-content h1 span {
            color: var(--smhs-gold-light);
        }

        .hero-content p {
            max-width: 670px;
            margin: auto;
            color: rgba(255,255,255,0.73);
            font-size: 16px;
            line-height: 1.9;
        }

        .hero-scroll {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);

            color: rgba(255,255,255,0.5);
            font-size: 10px;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .hero-scroll i {
            margin-left: 8px;
            color: var(--smhs-gold);
        }

        /* =========================================================
           INTRO
        ========================================================= */

        .contact-intro {
            width: min(1100px, 90%);
            margin: 100px auto 55px;
            text-align: center;
        }

        .section-kicker {
            color: #9a7b35;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 14px;
        }

        .contact-intro h2 {
            margin: 0;
            color: var(--smhs-navy);
            font-family: "Cormorant Garamond", serif;
            font-size: clamp(38px, 5vw, 60px);
            line-height: 1;
        }

        .contact-intro p {
            max-width: 700px;
            margin: 22px auto 0;
            color: var(--smhs-muted);
            line-height: 1.9;
            font-size: 15px;
        }

        /* =========================================================
           CONTACT CARDS
        ========================================================= */

        .contact-cards {
            width: min(1200px, 92%);
            margin: 0 auto 100px;

            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
        }

        .contact-card {
            background: white;
            border: 1px solid rgba(7,20,38,0.07);

            padding: 38px 30px;

            text-align: center;

            box-shadow: 0 18px 50px rgba(7,20,38,0.06);

            transition:
                transform 0.35s ease,
                box-shadow 0.35s ease;

            position: relative;
            overflow: hidden;
        }

        .contact-card::before {
            content: "";

            position: absolute;
            top: 0;
            left: 0;

            width: 100%;
            height: 3px;

            background: linear-gradient(
                90deg,
                transparent,
                var(--smhs-gold),
                transparent
            );
        }

        .contact-card:hover {
            transform: translateY(-7px);
            box-shadow: var(--smhs-shadow);
        }

        .contact-icon {
            width: 60px;
            height: 60px;

            border-radius: 50%;

            margin: 0 auto 20px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: rgba(197,164,90,0.11);
            border: 1px solid rgba(197,164,90,0.3);

            color: #a88438;
            font-size: 21px;
        }

        .contact-card h3 {
            color: var(--smhs-navy);
            font-family: "Cormorant Garamond", serif;
            font-size: 28px;
            margin: 0 0 13px;
        }

        .contact-card p {
            color: var(--smhs-muted);
            font-size: 14px;
            line-height: 1.8;
            margin: 0;
        }

        .contact-card a {
            color: #92712c;
            font-weight: 600;
        }

        .contact-card a:hover {
            text-decoration: underline;
        }

        /* =========================================================
           MAIN CONTACT AREA
        ========================================================= */

        .contact-main {
            width: min(1200px, 92%);
            margin: 0 auto 110px;

            display: grid;
            grid-template-columns: 0.9fr 1.1fr;
            gap: 35px;
            align-items: stretch;
        }

        /* =========================================================
           INFORMATION PANEL
        ========================================================= */

        .contact-info {
            background: var(--smhs-navy);
            color: white;

            padding: 55px 45px;

            position: relative;
            overflow: hidden;
        }

        .contact-info::before {
            content: "";

            position: absolute;

            width: 300px;
            height: 300px;

            border-radius: 50%;

            border: 1px solid rgba(197,164,90,0.15);

            right: -150px;
            top: -150px;
        }

        .contact-info::after {
            content: "";

            position: absolute;

            width: 220px;
            height: 220px;

            border-radius: 50%;

            border: 1px solid rgba(197,164,90,0.1);

            left: -110px;
            bottom: -110px;
        }

        .contact-info-content {
            position: relative;
            z-index: 2;
        }

        .contact-info .section-kicker {
            color: var(--smhs-gold-light);
        }

        .contact-info h2 {
            margin: 0 0 22px;

            font-family: "Cormorant Garamond", serif;

            font-size: 48px;
            line-height: 1;
        }

        .contact-info > .contact-info-content > p {
            color: rgba(255,255,255,0.67);
            font-size: 14px;
            line-height: 1.9;
            margin-bottom: 38px;
        }

        .info-item {
            display: flex;
            gap: 18px;
            margin-bottom: 28px;
        }

        .info-item-icon {
            width: 42px;
            height: 42px;
            min-width: 42px;

            border: 1px solid rgba(197,164,90,0.4);

            display: flex;
            align-items: center;
            justify-content: center;

            color: var(--smhs-gold-light);
        }

        .info-item h4 {
            margin: 0 0 5px;

            color: white;
            font-size: 13px;
            letter-spacing: 0.4px;
        }

        .info-item p {
            margin: 0;

            color: rgba(255,255,255,0.65);

            font-size: 13px;
            line-height: 1.7;
        }

        .info-item a {
            color: rgba(255,255,255,0.72);
        }

        .info-item a:hover {
            color: var(--smhs-gold-light);
        }

        /* =========================================================
           ENQUIRY FORM
        ========================================================= */

        .contact-form-wrapper {
            background: white;

            padding: 55px 50px;

            border: 1px solid rgba(7,20,38,0.07);

            box-shadow: 0 20px 60px rgba(7,20,38,0.07);
        }

        .contact-form-wrapper h2 {
            margin: 0 0 10px;

            color: var(--smhs-navy);

            font-family: "Cormorant Garamond", serif;

            font-size: 46px;
        }

        .contact-form-wrapper > p {
            margin: 0 0 32px;

            color: var(--smhs-muted);

            font-size: 13px;
            line-height: 1.8;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .form-group {
            margin-bottom: 19px;
        }

        .form-group label {
            display: block;

            margin-bottom: 8px;

            color: var(--smhs-navy);

            font-size: 11px;
            font-weight: 700;

            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;

            border: 1px solid #dfe2e5;

            background: #fbfbfa;

            padding: 14px 15px;

            font-family: "Inter", sans-serif;
            font-size: 13px;

            color: var(--smhs-text);

            outline: none;

            transition: 0.3s ease;
        }

        .form-group textarea {
            min-height: 135px;
            resize: vertical;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            border-color: var(--smhs-gold);
            background: white;

            box-shadow: 0 0 0 3px rgba(197,164,90,0.09);
        }

        .submit-button {
            width: 100%;

            border: none;

            background: var(--smhs-navy);

            color: white;

            padding: 16px 25px;

            font-family: "Inter", sans-serif;

            font-size: 12px;
            font-weight: 700;

            text-transform: uppercase;
            letter-spacing: 2px;

            cursor: pointer;

            transition: 0.3s ease;
        }

        .submit-button:hover {
            background: #122b49;
            transform: translateY(-2px);
        }

        .submit-button i {
            margin-left: 8px;
            color: var(--smhs-gold-light);
        }

        /* =========================================================
           MAP SECTION
        ========================================================= */

        .map-section {
            background: #ece9e1;

            padding: 100px 0;
        }

        .map-heading {
            width: min(1100px, 90%);
            margin: 0 auto 40px;

            display: flex;
            align-items: end;
            justify-content: space-between;

            gap: 30px;
        }

        .map-heading h2 {
            margin: 0;

            color: var(--smhs-navy);

            font-family: "Cormorant Garamond", serif;

            font-size: clamp(42px, 5vw, 62px);
            line-height: 1;
        }

        .map-heading p {
            max-width: 420px;

            margin: 0;

            color: var(--smhs-muted);

            font-size: 13px;
            line-height: 1.8;
        }

        .map-wrapper {
            width: min(1200px, 92%);
            margin: auto;

            background: white;

            padding: 10px;

            box-shadow: var(--smhs-shadow);
        }

        .map-wrapper iframe {
            width: 100%;
            height: 470px;

            border: 0;

            display: block;
        }

        /* =========================================================
           WORKING HOURS
        ========================================================= */

        .hours-section {
            width: min(1000px, 90%);
            margin: 100px auto;

            text-align: center;
        }

        .hours-section h2 {
            margin: 0 0 15px;

            color: var(--smhs-navy);

            font-family: "Cormorant Garamond", serif;

            font-size: 50px;
        }

        .hours-section > p {
            color: var(--smhs-muted);
            font-size: 14px;
            margin-bottom: 35px;
        }

        .hours-box {
            display: grid;
            grid-template-columns: repeat(3, 1fr);

            border: 1px solid rgba(7,20,38,0.1);

            background: white;
        }

        .hours-item {
            padding: 28px 20px;

            border-right: 1px solid rgba(7,20,38,0.08);
        }

        .hours-item:last-child {
            border-right: none;
        }

        .hours-item i {
            color: #a88438;
            font-size: 20px;
            margin-bottom: 12px;
        }

        .hours-item h4 {
            margin: 0 0 7px;

            color: var(--smhs-navy);

            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .hours-item p {
            margin: 0;

            color: var(--smhs-muted);

            font-size: 13px;
            line-height: 1.6;
        }

        /* =========================================================
           CTA
        ========================================================= */

        .contact-cta {
            background: var(--smhs-navy);

            padding: 90px 20px;

            text-align: center;
        }

        .contact-cta .section-kicker {
            color: var(--smhs-gold-light);
        }

        .contact-cta h2 {
            margin: 0 auto 18px;

            max-width: 800px;

            color: white;

            font-family: "Cormorant Garamond", serif;

            font-size: clamp(42px, 5vw, 65px);
            line-height: 1;
        }

        .contact-cta p {
            max-width: 620px;

            margin: 0 auto 32px;

            color: rgba(255,255,255,0.65);

            font-size: 14px;
            line-height: 1.9;
        }

        .cta-button {
            display: inline-flex;

            align-items: center;
            gap: 10px;

            padding: 14px 27px;

            border: 1px solid var(--smhs-gold);

            color: white;

            font-size: 11px;
            font-weight: 700;

            letter-spacing: 1.5px;

            text-transform: uppercase;

            transition: 0.3s ease;
        }

        .cta-button:hover {
            background: var(--smhs-gold);
            color: var(--smhs-navy);
        }

        /* =========================================================
           FOOTER
        ========================================================= */

        .contact-footer {
            background: #040d19;

            color: rgba(255,255,255,0.6);

            padding: 60px 0 25px;
        }

        .footer-inner {
            width: min(1200px, 92%);
            margin: auto;

            display: grid;

            grid-template-columns: 1.3fr 1fr 1fr;

            gap: 50px;

            padding-bottom: 45px;

            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .footer-brand img {
            width: 65px;
            margin-bottom: 18px;
        }

        .footer-brand h3 {
            margin: 0 0 10px;

            color: white;

            font-family: "Cormorant Garamond", serif;

            font-size: 30px;
        }

        .footer-brand p {
            max-width: 360px;

            font-size: 12px;

            line-height: 1.8;
        }

        .footer-column h4 {
            margin: 0 0 18px;

            color: var(--smhs-gold-light);

            font-size: 11px;

            text-transform: uppercase;

            letter-spacing: 2px;
        }

        .footer-column a,
        .footer-column p {
            display: block;

            color: rgba(255,255,255,0.58);

            font-size: 12px;

            margin: 0 0 11px;

            line-height: 1.6;
        }

        .footer-column a:hover {
            color: var(--smhs-gold-light);
        }

        .footer-bottom {
            width: min(1200px, 92%);
            margin: 20px auto 0;

            display: flex;
            justify-content: space-between;

            gap: 20px;

            font-size: 10px;

            color: rgba(255,255,255,0.38);
        }

        /* =========================================================
           MOBILE
        ========================================================= */

        @media (max-width: 900px) {

            .contact-nav {
                display: none;
            }

            .contact-cards {
                grid-template-columns: 1fr;
            }

            .contact-main {
                grid-template-columns: 1fr;
            }

            .footer-inner {
                grid-template-columns: 1fr 1fr;
            }

            .map-heading {
                flex-direction: column;
                align-items: flex-start;
            }
        }

        @media (max-width: 650px) {

            .contact-header {
                min-height: 70px;
            }

            .school-brand-text strong {
                font-size: 20px;
            }

            .school-brand img {
                width: 47px;
                height: 47px;
            }

            .contact-hero {
                min-height: 430px;
            }

            .hero-content h1 {
                font-size: 58px;
            }

            .contact-intro {
                margin-top: 70px;
            }

            .contact-info,
            .contact-form-wrapper {
                padding: 38px 25px;
            }

            .contact-info h2,
            .contact-form-wrapper h2 {
                font-size: 40px;
            }

            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .map-section {
                padding: 70px 0;
            }

            .map-wrapper iframe {
                height: 350px;
            }

            .hours-section {
                margin: 70px auto;
            }

            .hours-box {
                grid-template-columns: 1fr;
            }

            .hours-item {
                border-right: none;
                border-bottom: 1px solid rgba(7,20,38,0.08);
            }

            .hours-item:last-child {
                border-bottom: none;
            }

            .footer-inner {
                grid-template-columns: 1fr;
                gap: 35px;
            }

            .footer-bottom {
                flex-direction: column;
            }
        }

    </style>
</head>

<body>

<!-- =========================================================
     HEADER
========================================================= -->

<header class="contact-header">

    <div class="contact-header-inner">

        <a href="/" class="school-brand">

            <img src="/images/logo.png"
                 alt="St. Martin's High School Logo">

            <div class="school-brand-text">

                <strong>St. Martin's High School</strong>

                <span> · Balanagar · Hyderabad</span>

            </div>

        </a>

        <nav class="contact-nav">

            <a href="/">Home</a>

            <a href="/about">About</a>

            <a href="/academics">Academics</a>

            <a href="/admissions">Admissions</a>

            <a href="/gallery">Gallery</a>

            <a href="/contact" class="active">Contact</a>

        </nav>

    </div>

</header>


<!-- =========================================================
     HERO
========================================================= -->

<section class="contact-hero">

    <div class="hero-line"></div>

    <div class="hero-content">

        <div class="hero-eyebrow">
            St. Martin's High School
        </div>

        <h1>
            Connect <span>With Us.</span>
        </h1>

        <p>
            Whether you are a parent seeking admission information,
            a prospective student, or simply wish to learn more about
            our school community, our team is here to assist you.
        </p>

    </div>

    <div class="hero-scroll">
        Explore <i class="fa-solid fa-arrow-down"></i>
    </div>

</section>


<!-- =========================================================
     INTRO
========================================================= -->

<section class="contact-intro">

    <div class="section-kicker">
        Contact Information
    </div>

    <h2>
        We Are Here To Help
    </h2>

    <p>
        Reach out to St. Martin's High School for admissions,
        academics, general enquiries, or any information about
        life on our campus.
    </p>

</section>


<!-- =========================================================
     QUICK CONTACT CARDS
========================================================= -->

<section class="contact-cards">

    <div class="contact-card">

        <div class="contact-icon">
            <i class="fa-solid fa-location-dot"></i>
        </div>

        <h3>Visit Us</h3>

        <p>
            Navjeevan Nagar,<br>
            Balanagar,<br>
            Hyderabad, Telangana – 500037
        </p>

    </div>


    <div class="contact-card">

        <div class="contact-icon">
            <i class="fa-solid fa-phone"></i>
        </div>

        <h3>Call Us</h3>

        <p>
            <a href="tel:04023082365">
                040-2308 2365
            </a>
            <br>

            <a href="tel:04023080515">
                040-2308 0515
            </a>
        </p>

    </div>


    <div class="contact-card">

