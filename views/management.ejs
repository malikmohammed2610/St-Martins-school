<!-- ==========================================================
     MAIN
     ========================================================== -->

<main>


    <!-- ======================================================
         HERO
         ====================================================== -->

    <section class="leadership-hero">

        <div class="leadership-hero-content">

            <div class="hero-eyebrow">
                LEADERSHIP • VISION • GUIDANCE
            </div>

            <h1>
                Principal &amp;<br>
                Management
            </h1>

            <div class="hero-rule"></div>

            <p>
                Strong educational leadership, purposeful management
                and a shared commitment to the growth and success of
                every student at St. Martin's High School.
            </p>

        </div>

    </section>



    <!-- ======================================================
         INTRODUCTION
         ====================================================== -->

    <section class="leadership-section">

        <div class="leadership-container">


            <div class="intro-content">

                <div class="section-kicker">
                    LEADERSHIP AT ST. MARTIN'S
                </div>

                <h2 class="section-title">
                    Guiding the School with
                    <span>Purpose.</span>
                </h2>

                <p>
                    The leadership of St. Martin's High School is
                    committed to creating an environment in which
                    academic excellence, character, discipline and
                    personal development work together.
                </p>

                <p>
                    Our administration and academic leadership work
                    closely with teachers, students and families to
                    maintain a culture of learning, responsibility,
