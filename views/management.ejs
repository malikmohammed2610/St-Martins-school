          content="width=device-width, initial-scale=1.0">

    <title>Principal &amp; Management | St. Martin's High School, Balanagar</title>

    <meta name="description"
          content="Meet the leadership and management of St. Martin's High School, Balanagar, Hyderabad.">

    <link rel="icon"
          type="image/png"
          href="/images/logo.png">

    <!-- ==========================================================
         GOOGLE FONTS
         ========================================================== -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">


    <!-- ==========================================================
         BOOTSTRAP
         ========================================================== -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">


    <!-- ==========================================================
         FONT AWESOME
         ========================================================== -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">


    <!-- ==========================================================
         GLOBAL CSS
         ========================================================== -->

    <link rel="stylesheet"
          href="/css/style.css">


    <!-- ==========================================================
         PAGE-SPECIFIC CSS
         ========================================================== -->

    <style>

        /* ==========================================================
           BASE
           ========================================================== */

        .principal-page {
            margin: 0;
            padding: 0;
            background: #f7f3eb;
            color: #20252a;
            font-family: "Inter", sans-serif;
            overflow-x: hidden;
        }

        .principal-page *,
        .principal-page *::before,
        .principal-page *::after {
            box-sizing: border-box;
        }


        /* ==========================================================
           HEADER
           ========================================================== */

        .principal-page .school-header {
            position: relative !important;
            width: 100%;
            z-index: 1000;
        }

        .principal-page .school-topbar {
            background: #ffffff;
            min-height: 88px;
            border-bottom: 1px solid rgba(197,164,90,.25);
            display: flex;
            align-items: center;
        }

        .principal-page .school-topbar-inner {
            width: min(1400px, 94%);
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
        }

        .principal-page .school-brand {
            display: flex;
            align-items: center;
            gap: 16px;
            text-decoration: none;
        }

        .principal-page .school-brand img {
            width: 62px;
            height: 62px;
            object-fit: contain;
        }

        .principal-page .school-brand-text {
            display: flex;
            flex-direction: column;
        }

        .principal-page .school-brand-title {
            color: #071a2b;
            font-family: "Cormorant Garamond", serif;
            font-size: 29px;
            line-height: 1;
            font-weight: 700;
            letter-spacing: .5px;
        }

        .principal-page .school-brand-location {
            margin-top: 6px;
            color: #92743a;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .principal-page .school-top-actions {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .principal-page .school-phone {
            color: #071a2b;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
        }

        .principal-page .school-phone i {
            color: #c5a45a;
            margin-right: 8px;
        }

        .principal-page .teacher-login {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 11px 18px;
            color: #071a2b;
            background: #ffffff;
            border: 1px solid #071a2b;
            text-decoration: none;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            transition: .3s ease;
        }

        .principal-page .teacher-login:hover {
            background: #071a2b;
            color: #ffffff;
        }


        /* ==========================================================
           NAVIGATION
           ========================================================== */

        .principal-page .school-nav {
            background: #071a2b !important;
            min-height: 62px;
            border-bottom: 1px solid rgba(197,164,90,.35);
        }

        .principal-page .school-nav-inner {
            width: min(1400px, 94%);
            min-height: 62px;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .principal-page .school-nav-list {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 3px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .principal-page .school-nav-list > li {
            position: relative;
            list-style: none;
        }

        .principal-page .school-nav-list > li > a {
            min-height: 62px;
            padding: 0 16px;
            display: flex;
            align-items: center;
            gap: 6px;
            color: #ffffff !important;
            text-decoration: none;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.1px;
            text-transform: uppercase;
            white-space: nowrap;
            transition: .25s ease;
        }

        .principal-page .school-nav-list > li > a:hover,
        .principal-page .school-nav-list > li.active > a {
            color: #d9b96e !important;
        }

        .principal-page .school-nav-list > li > a i {
            font-size: 8px;
        }


        /* ==========================================================
           DROPDOWNS
           ========================================================== */

        .principal-page .school-dropdown {
            position: absolute;
            top: 100%;
            left: 0;
            min-width: 245px;
            margin: 0;
            padding: 9px 0;
            list-style: none;
            background: #ffffff;
            border-top: 3px solid #c5a45a;
            box-shadow: 0 18px 40px rgba(0,0,0,.18);

            opacity: 0;
            visibility: hidden;
            transform: translateY(8px);

            transition:
                opacity .25s ease,
                visibility .25s ease,
                transform .25s ease;

            z-index: 5000;
        }

        .principal-page .school-nav-list > li:hover > .school-dropdown {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .principal-page .school-dropdown li {
            list-style: none;
        }

        .principal-page .school-dropdown a {
            display: block;
            padding: 12px 20px;
            color: #20252a !important;
            background: #ffffff;
            text-decoration: none;
            font-size: 12px;
            font-weight: 600;
            transition: .25s ease;
        }

        .principal-page .school-dropdown a:hover {
            background: #f5efe2;
            color: #071a2b !important;
            padding-left: 26px;
        }


        /* ==========================================================
           HERO
           ========================================================== */

        .principal-page .leadership-hero {
            position: relative;
            min-height: 500px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            background:
                linear-gradient(
                    135deg,
                    #071a2b 0%,
                    #0b263d 55%,
                    #102f47 100%
                );
            overflow: hidden;
        }

        .principal-page .leadership-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                radial-gradient(
                    circle at 15% 25%,
                    rgba(197,164,90,.17),
                    transparent 35%
                ),
                radial-gradient(
                    circle at 85% 75%,
                    rgba(197,164,90,.10),
                    transparent 35%
                );
        }

        .principal-page .leadership-hero::after {
            content: "";
            position: absolute;
            width: 500px;
            height: 500px;
            border: 1px solid rgba(197,164,90,.17);
            border-radius: 50%;
            bottom: -260px;
            left: 50%;
            transform: translateX(-50%);
        }

        .principal-page .leadership-hero-content {
            position: relative;
            z-index: 2;
            width: min(900px, 90%);
            padding: 80px 0;
        }

        .principal-page .hero-eyebrow {
            color: #d7bb77;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 4px;
            text-transform: uppercase;
            margin-bottom: 18px;
        }

        .principal-page .leadership-hero h1 {
            margin: 0;
            color: #ffffff;
            font-family: "Cormorant Garamond", serif;
            font-size: clamp(50px, 7vw, 82px);
            line-height: .95;
            font-weight: 600;
        }

        .principal-page .hero-rule {
            width: 75px;
            height: 2px;
            margin: 28px auto;
            background: #c5a45a;
        }

        .principal-page .leadership-hero p {
            max-width: 720px;
            margin: auto;
            color: rgba(255,255,255,.78);
            font-size: 16px;
            font-weight: 300;
            line-height: 1.9;
        }


        /* ==========================================================
           CONTENT
           ========================================================== */

        .principal-page .leadership-section {
            padding: 105px 0;
            background: #f7f3eb;
        }

        .principal-page .leadership-container {
            width: min(1180px, 90%);
            margin: auto;
        }


        /* ==========================================================
           INTRO
           ========================================================== */

        .principal-page .intro-content {
            max-width: 920px;
            margin: auto;
            text-align: center;
        }

        .principal-page .section-kicker {
            color: #9b7b3d;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 15px;
        }

        .principal-page .section-title {
            margin: 0 0 25px;
            color: #071a2b;
            font-family: "Cormorant Garamond", serif;
            font-size: clamp(42px, 5vw, 62px);
            line-height: 1;
            font-weight: 600;
        }

        .principal-page .section-title span {
            color: #a58242;
        }

        .principal-page .intro-content p {
            color: #606a73;
            font-size: 15px;
            line-height: 1.95;
        }


        /* ==========================================================
           LEADERSHIP CARDS
           ========================================================== */

        .principal-page .leaders-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 30px;
            margin-top: 65px;
        }

        .principal-page .leader-card {
            position: relative;
            background: #ffffff;
            padding: 45px;
            border: 1px solid rgba(7,26,43,.08);
            border-top: 3px solid #c5a45a;
            box-shadow: 0 20px 45px rgba(7,26,43,.07);
            transition: .35s ease;
        }

        .principal-page .leader-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 55px rgba(7,26,43,.12);
        }

        .principal-page .leader-icon {
            width: 62px;
            height: 62px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #9b7b3d;
            border: 1px solid #c5a45a;
            margin-bottom: 28px;
            font-size: 22px;
        }

        .principal-page .leader-card h2 {
            color: #071a2b;
            font-family: "Cormorant Garamond", serif;
            font-size: 36px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .principal-page .leader-role {
            color: #9b7b3d;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 25px;
        }

        .principal-page .leader-card p {
            color: #626b73;
            font-size: 14px;
            line-height: 1.9;
            margin-bottom: 15px;
        }


        /* ==========================================================
           PRINCIPAL MESSAGE
           ========================================================== */

        .principal-page .message-section {
            background: #ffffff;
        }

        .principal-page .message-grid {
            display: grid;
            grid-template-columns: .8fr 1.2fr;
            align-items: center;
            gap: 80px;
        }

        .principal-page .portrait-placeholder {
            min-height: 460px;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                linear-gradient(
                    145deg,
                    #071a2b,
                    #12344d
                );
            border: 1px solid rgba(197,164,90,.35);
            position: relative;
            overflow: hidden;
        }

        .principal-page .portrait-placeholder::before {
            content: "";
            position: absolute;
            inset: 20px;
            border: 1px solid rgba(197,164,90,.25);
        }

        .principal-page .portrait-placeholder i {
            position: relative;
            z-index: 2;
            color: #c5a45a;
            font-size: 90px;
            opacity: .7;
        }

        .principal-page .message-content .section-kicker {
            margin-bottom: 13px;
        }

        .principal-page .message-content h2 {
            color: #071a2b;
            font-family: "Cormorant Garamond", serif;
            font-size: clamp(40px, 5vw, 58px);
            line-height: 1;
            margin-bottom: 25px;
        }

        .principal-page .message-content h2 span {
            color: #a58242;
        }

        .principal-page .message-content blockquote {
            position: relative;
            margin: 0 0 25px;
            padding-left: 28px;
            border-left: 3px solid #c5a45a;
            color: #35404a;
            font-family: "Cormorant Garamond", serif;
            font-size: 28px;
            line-height: 1.45;
            font-weight: 500;
        }

        .principal-page .message-content p {
            color: #68717a;
            font-size: 14px;
            line-height: 1.9;
        }


        /* ==========================================================
           MANAGEMENT PHILOSOPHY
           ========================================================== */

        .principal-page .philosophy-section {
            background: #071a2b;
        }

        .principal-page .philosophy-heading {
            max-width: 750px;
            margin: auto;
            text-align: center;
        }

        .principal-page .philosophy-heading .section-kicker {
            color: #d7bb77;
        }

        .principal-page .philosophy-heading .section-title {
            color: #ffffff;
        }

        .principal-page .philosophy-heading p {
            color: rgba(255,255,255,.68);
            font-size: 14px;
            line-height: 1.9;
        }

        .principal-page .philosophy-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
            margin-top: 60px;
        }

        .principal-page .philosophy-card {
            padding: 38px 30px;
            border: 1px solid rgba(197,164,90,.25);
            background: rgba(255,255,255,.035);
            transition: .3s ease;
        }

        .principal-page .philosophy-card:hover {
            transform: translateY(-7px);
            border-color: rgba(197,164,90,.75);
        }

        .principal-page .philosophy-card i {
            color: #c5a45a;
            font-size: 24px;
            margin-bottom: 23px;
        }

        .principal-page .philosophy-card h3 {
            color: #ffffff;
            font-family: "Cormorant Garamond", serif;
            font-size: 29px;
            margin-bottom: 13px;
        }

        .principal-page .philosophy-card p {
            color: rgba(255,255,255,.62);
            font-size: 13px;
            line-height: 1.8;
            margin: 0;
        }


        /* ==========================================================
           CTA
           ========================================================== */

        .principal-page .leadership-cta {
            padding: 100px 0;
            background: #eee8db;
            text-align: center;
        }

        .principal-page .leadership-cta-content {
            max-width: 780px;
            margin: auto;
        }

        .principal-page .leadership-cta h2 {
            color: #071a2b;
            font-family: "Cormorant Garamond", serif;
            font-size: clamp(40px, 5vw, 58px);
            margin-bottom: 18px;
        }

        .principal-page .leadership-cta p {
            color: #626b73;
            font-size: 14px;
            line-height: 1.9;
            margin-bottom: 30px;
        }

        .principal-page .cta-button {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 15px 28px;
            color: #071a2b;
            background: #c5a45a;
            text-decoration: none;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            transition: .3s ease;
        }

        .principal-page .cta-button:hover {
            background: #071a2b;
            color: #ffffff;
        }


        /* ==========================================================
           RESPONSIVE
           ========================================================== */

        @media (max-width: 1050px) {

            .principal-page .school-nav-list > li > a {
                padding-left: 10px;
                padding-right: 10px;
                font-size: 10px;
            }

            .principal-page .message-grid {
                gap: 45px;
            }

        }


        @media (max-width: 850px) {

            .principal-page .school-topbar {
                padding: 15px 0;
            }

            .principal-page .school-topbar-inner {
                flex-direction: column;
                align-items: flex-start;
            }

            .principal-page .school-top-actions {
                width: 100%;
                justify-content: space-between;
            }

            .principal-page .school-nav {
                overflow-x: auto;
            }

            .principal-page .school-nav-inner {
                width: max-content;
                min-width: 100%;
            }

            .principal-page .school-nav-list {
                justify-content: flex-start;
            }

            .principal-page .leaders-grid,
            .principal-page .message-grid,
            .principal-page .philosophy-grid {
                grid-template-columns: 1fr;
            }

            .principal-page .message-grid {
                gap: 50px;
            }

        }


        @media (max-width: 600px) {

            .principal-page .school-brand-title {
                font-size: 23px;
            }

            .principal-page .school-brand-location {
                font-size: 9px;
                letter-spacing: 1.5px;
            }

            .principal-page .school-brand img {
                width: 52px;
                height: 52px;
            }

            .principal-page .school-top-actions {
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }

            .principal-page .leadership-hero {
                min-height: 430px;
            }

            .principal-page .leadership-section {
                padding: 75px 0;
            }

            .principal-page .leader-card {
                padding: 32px 25px;
            }

            .principal-page .portrait-placeholder {
                min-height: 350px;
            }

        }

    </style>

</head>


