                            <h4>Chemistry Laboratory</h4>

                            <p>
                                Practical science and experimentation.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="col-lg-4 col-md-6">

                    <div class="gallery-card">

                        <img
                            src="https://www.stmartinshighschool.in/images/vallyball.jpg"
                            alt="Volleyball Facility"
                            loading="lazy"
                        >

                        <div class="gallery-overlay">

                            <h4>Volleyball</h4>

                            <p>
                                Encouraging teamwork and active lifestyles.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="col-lg-4 col-md-6">

                    <div class="gallery-card">

