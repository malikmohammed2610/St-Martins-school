<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <meta name="description"
          content="Learn about St. Martin's High School, Balanagar, Hyderabad — our heritage, educational philosophy, campus, leadership and commitment to excellence.">

    <title><%= title || "About Us | St. Martin's High School" %></title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <!-- Global Website CSS -->
    <link rel="stylesheet" href="/css/style.css">

    <style>
        /* =========================================================
           ABOUT PAGE — PREMIUM STYLES
        ========================================================= */

        :root {
            --navy: #071A2B;
            --navy-2: #0C2235;
            --maroon: #581722;
            --gold: #C5A45A;
            --gold-light: #E0C67B;
            --ivory: #F6F1E7;
            --white: #ffffff;
            --text: #27313a;
            --muted: #6f7880;
            --border: rgba(197,164,90,.22);
        }

        body {
            background: #fff;
            color: var(--text);
            overflow-x: hidden;
        }

        /* =========================================================
           HERO
        ========================================================= */

        .about-hero {
            position: relative;
            min-height: 620px;
            display: flex;
            align-items: center;
            overflow: hidden;

            background:
                linear-gradient(
                    90deg,
                    rgba(7,26,43,.97) 0%,
                    rgba(7,26,43,.87) 45%,
                    rgba(7,26,43,.48) 100%
                ),
                url("https://www.stmartinshighschool.in/public/assets/images/gallery/1.png")
                center/cover no-repeat;
        }

        .about-hero::after {
            content: "";
            position: absolute;
            inset: 0;

            background:
                radial-gradient(
                    circle at 80% 40%,
                    rgba(197,164,90,.20),
                    transparent 35%
                );

            pointer-events: none;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 850px;
            padding: 90px 0;
        }

        .hero-kicker {
            display: inline-flex;
            align-items: center;
            gap: 12px;

            color: var(--gold-light);
            text-transform: uppercase;
            letter-spacing: 4px;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 22px;
        }

        .hero-kicker::before {
            content: "";
            width: 48px;
            height: 1px;
            background: var(--gold);
        }

        .hero-title {
            color: #fff;
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(48px, 7vw, 88px);
            line-height: .98;
            font-weight: 600;
            margin: 0 0 28px;
        }

        .hero-title span {
            color: var(--gold-light);
        }

        .hero-description {
            color: rgba(255,255,255,.82);
            font-size: 18px;
            line-height: 1.8;
            max-width: 720px;
            margin-bottom: 35px;
        }

        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
        }

        .premium-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 25px;
            border-radius: 4px;
            text-decoration: none;
            font-weight: 700;
            transition: .3s ease;
        }

        .premium-btn-gold {
            background: var(--gold);
            color: var(--navy);
        }

        .premium-btn-gold:hover {
            background: var(--gold-light);
            color: var(--navy);
            transform: translateY(-3px);
        }

        .premium-btn-outline {
            border: 1px solid rgba(255,255,255,.45);
            color: #fff;
        }

        .premium-btn-outline:hover {
            background: #fff;
            color: var(--navy);
            transform: translateY(-3px);
        }

        /* =========================================================
           SECTION COMMON
        ========================================================= */

        .about-section {
            padding: 100px 0;
        }

        .about-section.ivory {
            background: var(--ivory);
        }

        .section-label {
            color: var(--gold);
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 14px;
        }

        .section-title {
            font-family: Georgia, "Times New Roman", serif;
            color: var(--navy);
            font-size: clamp(36px, 5vw, 58px);
            line-height: 1.1;
            margin-bottom: 24px;
        }

        .section-title span {
            color: var(--maroon);
        }

        .section-text {
            color: #626c74;
            font-size: 16px;
            line-height: 1.9;
        }

        /* =========================================================
           STORY
        ========================================================= */

        .story-image {
            position: relative;
            overflow: hidden;
            border-radius: 4px;
            min-height: 500px;
            box-shadow: 0 25px 70px rgba(7,26,43,.16);
        }

        .story-image img {
            width: 100%;
            height: 100%;
            min-height: 500px;
            object-fit: cover;
            display: block;
            transition: transform .8s ease;
        }

        .story-image:hover img {
            transform: scale(1.04);
        }

        .story-image::after {
            content: "";
            position: absolute;
            inset: 18px;
            border: 1px solid rgba(255,255,255,.5);
            pointer-events: none;
        }

        .story-content {
            padding-left: 45px;
        }

        .story-content p {
            color: #5d6870;
            line-height: 1.9;
            font-size: 16px;
            margin-bottom: 20px;
        }

        .gold-line {
            width: 70px;
            height: 3px;
            background: var(--gold);
            margin: 25px 0;
        }

        /* =========================================================
           FACTS
        ========================================================= */

        .facts-section {
            background: var(--navy);
            padding: 75px 0;
        }

        .fact-card {
            text-align: center;
            color: #fff;
            padding: 25px 15px;
            position: relative;
        }

        .fact-card:not(:last-child)::after {
            content: "";
            position: absolute;
            right: 0;
            top: 15%;
            height: 70%;
            width: 1px;
            background: rgba(255,255,255,.13);
        }

        .fact-number {
            font-family: Georgia, "Times New Roman", serif;
            font-size: 48px;
            color: var(--gold-light);
            line-height: 1;
            margin-bottom: 10px;
        }

        .fact-label {
            color: rgba(255,255,255,.65);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        /* =========================================================
           PHILOSOPHY
        ========================================================= */

        .philosophy-card {
            height: 100%;
            padding: 38px 32px;
            background: #fff;
            border: 1px solid var(--border);
            transition: .35s ease;
            position: relative;
            overflow: hidden;
        }

        .philosophy-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 0;
            background: var(--gold);
            transition: .35s ease;
        }

        .philosophy-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 45px rgba(7,26,43,.12);
        }

        .philosophy-card:hover::before {
            height: 100%;
        }

        .philosophy-icon {
            width: 58px;
            height: 58px;
            border-radius: 50%;

            display: flex;
            align-items: center;
            justify-content: center;

            background: rgba(197,164,90,.12);
            color: var(--gold);
            font-size: 22px;
            margin-bottom: 22px;
        }

        .philosophy-card h3 {
            font-family: Georgia, "Times New Roman", serif;
            color: var(--navy);
            font-size: 25px;
            margin-bottom: 15px;
        }

        .philosophy-card p {
            color: #68727a;
            line-height: 1.8;
            margin: 0;
        }

        /* =========================================================
           CAMPUS FEATURE
        ========================================================= */

        .campus-feature {
            position: relative;
            min-height: 560px;
            overflow: hidden;
            background: var(--navy);
        }

        .campus-feature img {
            width: 100%;
            height: 560px;
            object-fit: cover;
            display: block;
            opacity: .82;
        }

        .campus-overlay {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;

            background:
                linear-gradient(
                    90deg,
                    rgba(7,26,43,.92),
                    rgba(7,26,43,.35)
                );
        }

        .campus-copy {
            max-width: 650px;
            color: #fff;
        }

        .campus-copy h2 {
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(38px, 5vw, 62px);
            margin-bottom: 20px;
        }

        .campus-copy h2 span {
            color: var(--gold-light);
        }

        .campus-copy p {
            color: rgba(255,255,255,.78);
            line-height: 1.9;
            font-size: 17px;
        }

        /* =========================================================
           GALLERY
        ========================================================= */

        .gallery-card {
            position: relative;
            height: 360px;
            overflow: hidden;
            background: #ddd;
            border-radius: 3px;
            margin-bottom: 25px;
        }

        .gallery-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform .7s ease;
        }

        .gallery-card:hover img {
            transform: scale(1.08);
        }

        .gallery-overlay {
            position: absolute;
            inset: auto 0 0;
            padding: 65px 25px 25px;

            background:
                linear-gradient(
                    transparent,
                    rgba(7,26,43,.92)
                );

            color: #fff;
        }

        .gallery-overlay h4 {
            font-family: Georgia, "Times New Roman", serif;
            margin: 0 0 5px;
            font-size: 25px;
        }

        .gallery-overlay p {
            margin: 0;
            color: rgba(255,255,255,.7);
            font-size: 13px;
        }

        /* =========================================================
           TIMELINE
        ========================================================= */

        .timeline {
            position: relative;
            max-width: 900px;
            margin: 50px auto 0;
        }

        .timeline::before {
            content: "";
            position: absolute;
            left: 50%;
            top: 0;
            bottom: 0;
            width: 1px;
            background: var(--gold);
            transform: translateX(-50%);
        }

        .timeline-item {
            width: 50%;
            padding: 0 45px 55px;
            position: relative;
        }

        .timeline-item:nth-child(odd) {
            text-align: right;
        }

        .timeline-item:nth-child(even) {
            margin-left: 50%;
        }

        .timeline-dot {
            position: absolute;
            top: 3px;
            width: 13px;
            height: 13px;
            background: var(--gold);
            border-radius: 50%;
            box-shadow: 0 0 0 6px rgba(197,164,90,.15);
        }

        .timeline-item:nth-child(odd) .timeline-dot {
            right: -6px;
        }

        .timeline-item:nth-child(even) .timeline-dot {
            left: -7px;
        }

        .timeline-year {
            color: var(--gold);
            font-weight: 800;
            font-size: 14px;
            letter-spacing: 2px;
        }

        .timeline-item h3 {
            color: var(--navy);
            font-family: Georgia, "Times New Roman", serif;
            margin: 8px 0 10px;
        }

        .timeline-item p {
            color: #6a737a;
            line-height: 1.8;
            margin: 0;
        }

        /* =========================================================
           CTA
        ========================================================= */

        .about-cta {
            background:
                linear-gradient(
                    135deg,
                    var(--maroon),
                    var(--navy)
                );

            padding: 90px 0;
            color: #fff;
        }

        .about-cta h2 {
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(38px, 5vw, 60px);
            margin-bottom: 20px;
        }

        .about-cta h2 span {
            color: var(--gold-light);
        }

        .about-cta p {
            color: rgba(255,255,255,.75);
            max-width: 700px;
            margin: 0 auto 30px;
            line-height: 1.8;
        }

        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @media (max-width: 991px) {

            .about-hero {
                min-height: 540px;
            }

            .story-content {
                padding-left: 0;
                padding-top: 40px;
            }

            .fact-card:not(:last-child)::after {
                display: none;
            }

            .timeline::before {
                left: 15px;
            }

            .timeline-item,
            .timeline-item:nth-child(even) {
                width: 100%;
                margin-left: 0;
                padding-left: 55px;
                padding-right: 10px;
                text-align: left;
            }

            .timeline-item:nth-child(odd) {
                text-align: left;
            }

            .timeline-item:nth-child(odd) .timeline-dot,
            .timeline-item:nth-child(even) .timeline-dot {
                left: 9px;
                right: auto;
            }
        }

        @media (max-width: 575px) {

            .about-section {
                padding: 70px 0;
            }

            .about-hero {
                min-height: 620px;
            }

            .hero-content {
                padding: 70px 15px;
            }

            .hero-description {
                font-size: 16px;
            }

            .story-image,
            .story-image img {
                min-height: 360px;
            }

            .campus-feature,
            .campus-feature img {
                min-height: 520px;
                height: 520px;
            }

            .gallery-card {
                height: 290px;
            }
        }
    </style>
</head>

<body>

    <!-- =========================================================
         SHARED HEADER
         Loaded from: views/partials/header.ejs
    ========================================================= -->

    <%- include('partials/header') %>


    <!-- =========================================================
         HERO
    ========================================================= -->

    <section class="about-hero about-hero-offset">

        <div class="container">

            <H1>

                
        </H1>
            <div class="hero-content-eyebrow">

                <div class="hero-kicker">
                    About St. Martin's
                </div>

                <h1 class="hero-title">
                    A Legacy of <span>Learning.</span>
                </h1>

                <p class="hero-description">
                    St. Martin's High School, Balanagar, Hyderabad,
                    represents a tradition of academic excellence,
                    character formation and holistic development.
                    For generations, the school has worked to create
                    confident, responsible and capable young citizens.
                </p>

                <div class="hero-buttons">

                    <a href="/contact"
                       class="premium-btn premium-btn-gold">
                        <i class="fa-solid fa-arrow-right"></i>
                        Contact School
                    </a>

                    <a href="/admissions"
                       class="premium-btn premium-btn-outline">
                        Explore Admissions
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         SCHOOL STORY
    ========================================================= -->

    <section class="about-section">

        <div class="container">

            <div class="row align-items-center g-5">

                <div class="col-lg-6">

                    <div class="story-image">

                        <img
                            src="https://www.stmartinshighschool.in/images/library.jpg"
                            alt="St. Martin's High School Library"
                            loading="lazy"
                            onerror="this.onerror=null;this.src='https://www.stmartinshighschool.in/images/scincelab.jpg';"
                        >

                    </div>

                </div>

                <div class="col-lg-6">

                    <div class="story-content">

                        <div class="section-label">
                            Our Story
                        </div>

                        <h2 class="section-title">
                            Built on <span>Values.</span>
                            Driven by Excellence.
                        </h2>

                        <div class="gold-line"></div>

                        <p>
                            Established in 1982, St. Martin's High School
                            has grown into a respected educational institution
                            serving students and families in Hyderabad.
                        </p>

                        <p>
                            The school combines academic discipline with
                            opportunities for students to develop creativity,
                            confidence, leadership and social responsibility.
                        </p>

                        <p>
                            With a strong emphasis on both scholastic and
                            co-scholastic development, the institution aims
                            to prepare students for the opportunities and
                            responsibilities of the future.
                        </p>

                        <a href="/contact"
                           class="premium-btn premium-btn-gold">

                            Learn More
                            <i class="fa-solid fa-arrow-right"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         FACTS
    ========================================================= -->

    <section class="facts-section">

        <div class="container">

            <div class="row">

                <div class="col-lg-3 col-6">

                    <div class="fact-card">

                        <div class="fact-number">
                            1982
                        </div>

                        <div class="fact-label">
                            Founded
                        </div>

                    </div>

                </div>

                <div class="col-lg-3 col-6">

                    <div class="fact-card">

                        <div class="fact-number">
                            70+
                        </div>

                        <div class="fact-label">
                            Teachers
                        </div>

                    </div>

                </div>

                <div class="col-lg-3 col-6">

                    <div class="fact-card">

                        <div class="fact-number">
                            1600+
                        </div>

                        <div class="fact-label">
                            Students
                        </div>

                    </div>

                </div>

                <div class="col-lg-3 col-6">

                    <div class="fact-card">

                        <div class="fact-number">
                            54+
                        </div>

                        <div class="fact-label">
                            Learning Spaces
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         PHILOSOPHY
    ========================================================= -->

    <section class="about-section ivory">

        <div class="container">

            <div class="text-center mb-5">

                <div class="section-label">
                    Our Philosophy
                </div>

                <h2 class="section-title">
                    Education Beyond the <span>Classroom</span>
                </h2>

                <p class="section-text mx-auto"
                   style="max-width:750px;">

                    We believe education is not limited to textbooks
                    and examinations. It is about developing capable,
                    ethical and confident individuals.

                </p>

            </div>

            <div class="row g-4">

                <div class="col-lg-4">

                    <div class="philosophy-card">

                        <div class="philosophy-icon">
                            <i class="fa-solid fa-graduation-cap"></i>
                        </div>

                        <h3>
                            Academic Excellence
                        </h3>

                        <p>
                            A structured learning environment that
                            encourages curiosity, critical thinking,
                            discipline and a strong academic foundation.
                        </p>

                    </div>

                </div>


                <div class="col-lg-4">

                    <div class="philosophy-card">

                        <div class="philosophy-icon">
                            <i class="fa-solid fa-person-rays"></i>
                        </div>

                        <h3>
                            Holistic Development
                        </h3>

                        <p>
                            Students are encouraged to participate
                            in sports, cultural activities, creative
                            pursuits and leadership opportunities.
                        </p>

                    </div>

                </div>


                <div class="col-lg-4">

                    <div class="philosophy-card">

                        <div class="philosophy-icon">
                            <i class="fa-solid fa-heart"></i>
                        </div>

                        <h3>
                            Character &amp; Values
                        </h3>

                        <p>
                            Integrity, respect, responsibility and
                            compassion remain important parts of the
                            school's approach to student development.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         CAMPUS FEATURE
    ========================================================= -->

    <section class="campus-feature">

        <img
            src="https://www.stmartinshighschool.in/images/computerlab.jpg"
            alt="St. Martin's High School Computer Laboratory"
            loading="lazy"
            onerror="this.onerror=null;this.src='https://www.stmartinshighschool.in/images/library.jpg';"
        >

        <div class="campus-overlay">

            <div class="container">

                <div class="campus-copy">

                    <div class="section-label">
                        The Campus
                    </div>

                    <h2>
                        Spaces Designed for
                        <span>Discovery.</span>
                    </h2>

                    <p>
                        From laboratories and libraries to sports
                        facilities and technology-enabled learning
                        spaces, the campus provides students with
                        opportunities to learn through experience.
                    </p>

                    <a href="/facilities"
                       class="premium-btn premium-btn-gold">

                        Explore Facilities
                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         CAMPUS GALLERY
    ========================================================= -->

    <section class="about-section">

        <div class="container">

            <div class="text-center mb-5">

                <div class="section-label">
                    Campus Life
