                            <p>
                                A dedicated space for reading and learning.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="col-lg-4 col-md-6">

                    <div class="gallery-card">

                        <img
                            src="https://www.stmartinshighschool.in/images/scincelab.jpg"
                            alt="Science Laboratory"
                            loading="lazy"
                        >

                        <div class="gallery-overlay">

                            <h4>Science Laboratory</h4>

                            <p>
