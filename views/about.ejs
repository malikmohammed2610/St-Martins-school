                height: 360px;
            }

            .about-page .philosophy-grid {
                grid-template-columns: 1fr;
            }

            .about-page .glance-grid {
                grid-template-columns: 1fr;
            }

            .about-page .vm-card {
                padding: 32px 25px;
            }
        }

    </style>

</head>


