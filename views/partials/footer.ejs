<!-- =========================================================
     PREMIUM FOOTER CSS
     ========================================================= -->

<style>

.sm-footer {
    font-family: 'Inter', sans-serif;
}


/* ================================
   ADMISSIONS CTA
================================ */

.sm-footer-cta {
    background:
        linear-gradient(
            135deg,
            #10283d,
            #071a2b
        );

    color: #ffffff;
    padding: 55px 0;

    border-top:
        1px solid rgba(197,164,90,.25);

    border-bottom:
        1px solid rgba(197,164,90,.25);
}


.sm-footer-cta-inner {

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 40px;
}


.sm-footer-eyebrow {

    color: #c5a45a;

    font-size: 12px;

    font-weight: 600;

    letter-spacing: 3px;

}


.sm-footer-cta h2 {

    font-family:
        'Cormorant Garamond',
        serif;

    font-size: 38px;

    margin:
        8px 0 10px;

    font-weight: 600;

}


.sm-footer-cta p {

    color: #b9c4d0;

    max-width: 650px;

    margin: 0;

    line-height: 1.7;

}


.sm-footer-button {

    display: inline-flex;

    align-items: center;

    gap: 25px;

    padding:
        15px 25px;

    color: #071a2b;

    background: #c5a45a;

    text-decoration: none;

    text-transform: uppercase;

    font-size: 12px;

    font-weight: 700;

    letter-spacing: 1.5px;

    transition:
        all .3s ease;
}


.sm-footer-button:hover {

    background: #e1c477;

    color: #071a2b;

    transform:
        translateY(-2px);
}


/* ================================
   MAIN FOOTER
================================ */

.sm-footer-main {

    background:
        #071a2b;

    color: #ffffff;

    padding:
        70px 0 25px;
}


.sm-footer-brand {

    display: flex;

    align-items: center;

    gap: 15px;

    margin-bottom: 20px;
}


.sm-footer-logo {

    width: 65px;

    height: 65px;

    object-fit: contain;

    filter:
        drop-shadow(
            0 4px 10px
            rgba(0,0,0,.4)
        );
}


.sm-footer-brand h3 {

    font-family:
        'Cormorant Garamond',
        serif;

    font-size: 24px;

    margin: 0;

    color: #ffffff;

}


.sm-footer-brand h3 span {

    display: block;

    color: #c5a45a;
}


.sm-footer-brand small {

    font-size: 9px;

    letter-spacing: 2px;

    color: #91a0ae;
}


.sm-footer-tagline {

    color: #c5a45a;

    font-family:
        'Cormorant Garamond',
        serif;

    font-size: 18px;

    font-style: italic;

    line-height: 1.5;

    margin-bottom: 15px;
}


.sm-footer-description {

    color: #9facba;

    font-size: 13px;

    line-height: 1.8;

    max-width: 430px;
}


/* ================================
   VALUES
================================ */

.sm-footer-values {

    display: flex;

    flex-direction: column;

    gap: 8px;

    margin-top: 20px;
}


.sm-footer-values span {

    font-size: 11px;

    color: #aab6c2;
}


.sm-footer-values i {

    width: 20px;

    color: #c5a45a;

    margin-right: 7px;
}


/* ================================
   HEADINGS
================================ */

.sm-footer-heading {

    color: #c5a45a;

    text-transform: uppercase;

    font-size: 12px;

    letter-spacing: 2px;

    font-weight: 600;

    margin-bottom: 25px;
}


/* ================================
   LINKS
================================ */

.sm-footer-links {

    list-style: none;

    padding: 0;

    margin: 0;
}


.sm-footer-links li {

    margin-bottom: 13px;
}


.sm-footer-links a {

    color: #aeb9c4;

    text-decoration: none;

    font-size: 13px;

    transition:
        all .25s ease;
}


.sm-footer-links a:hover {

    color: #c5a45a;

    padding-left: 5px;
}


/* ================================
   CONTACT
================================ */

.sm-contact-list {

    display: flex;

    flex-direction: column;

    gap: 18px;
}


.sm-contact-item {

    display: flex;

    gap: 13px;
}


.sm-contact-icon {

    color: #c5a45a;

    font-size: 15px;

    width: 20px;

    padding-top: 2px;
}


.sm-contact-item strong {

    color: #ffffff;

    font-size: 12px;

    display: block;

    margin-bottom: 4px;
}


.sm-contact-item p {

    color: #9facba;

    font-size: 12px;

    line-height: 1.6;

    margin: 0;
}


/* ================================
   MAP
================================ */

.sm-footer-map-section {

    margin-top: 65px;

    padding-top: 45px;

    border-top:
        1px solid
        rgba(197,164,90,.18);
}


.sm-map-heading {

    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 20px;

    gap: 20px;
}


.sm-map-heading span {

    font-size: 10px;

    letter-spacing: 3px;

    color: #c5a45a;

    font-weight: 600;
}


.sm-map-heading h3 {

    font-family:
        'Cormorant Garamond',
        serif;

    font-size: 28px;

    margin: 4px 0;

}


.sm-map-heading p {

    color: #8f9eac;

    font-size: 12px;

    margin: 0;
}


.sm-map-button {

    border:
        1px solid
        rgba(197,164,90,.6);

    color: #c5a45a;

    padding:
        11px 18px;

    text-decoration: none;

    font-size: 11px;

    text-transform: uppercase;

    letter-spacing: 1px;

    white-space: nowrap;

    transition: .3s;
}


.sm-map-button:hover {

    background: #c5a45a;

    color: #071a2b;
}


.sm-map-container {

    border:
        1px solid
        rgba(197,164,90,.3);

    overflow: hidden;

    box-shadow:
        0 15px 50px
        rgba(0,0,0,.3);
}


.sm-map-container iframe {

    display: block;

    filter:
        grayscale(20%);
}


/* ================================
   BOTTOM FOOTER
================================ */

.sm-footer-bottom {

    margin-top: 35px;

    padding-top: 22px;

    border-top:
        1px solid
        rgba(255,255,255,.08);

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 20px;
}


.sm-footer-copyright p {

    color: #8997a5;

    font-size: 11px;

    margin: 0 0 4px;
}


.sm-footer-copyright span {

    color: #596a79;

    font-size: 10px;
}


.sm-footer-bottom-links {

    display: flex;

    gap: 25px;
}


.sm-footer-bottom-links a {

    color: #8997a5;

    font-size: 11px;

    text-decoration: none;

    transition: .2s;
}


.sm-footer-bottom-links a:hover {

    color: #c5a45a;
}


/* ================================
   RESPONSIVE
================================ */

@media (max-width: 991px) {

    .sm-footer-cta-inner {

        flex-direction: column;

        align-items: flex-start;
    }

    .sm-footer-cta h2 {

        font-size: 32px;
    }

}


@media (max-width: 767px) {

    .sm-footer-main {

        padding-top: 50px;
    }

    .sm-footer-cta {

        padding: 45px 0;
    }

    .sm-footer-cta h2 {

        font-size: 29px;
    }

    .sm-footer-map-section {

        margin-top: 45px;
    }

    .sm-map-heading {

        flex-direction: column;

        align-items: flex-start;
    }

    .sm-footer-bottom {

        flex-direction: column;

        align-items: flex-start;
    }

    .sm-footer-bottom-links {

        flex-wrap: wrap;

        gap: 15px;
    }

}

</style>