            <!-- CONTACT -->
            <div class="smhs-footer-column smhs-footer-contact">
                <h3 class="smhs-footer-heading">Get in Touch</h3>
                <span class="smhs-footer-heading-line"></span>

                <div class="smhs-footer-contact-item">
                    <span class="smhs-footer-icon">
                        <i class="fa-solid fa-location-dot"></i>
                    </span>
                    <div>
