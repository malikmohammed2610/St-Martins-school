<style>
/* =========================================
   SMHS PREMIUM FOOTER
   Navy Blue | Cream | Heritage Gold
========================================= */

.smhs-footer {
    --smhs-navy: #071A2B;
    --smhs-navy-light: #0C2235;
    --smhs-cream: #F6F1E7;
    --smhs-gold: #C5A45A;
    --smhs-gold-light: #E0C67B;
    --smhs-muted: #B9C4CE;

    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
        radial-gradient(
            ellipse at 5% 0%,
            rgba(197, 164, 90, 0.09),
            transparent 36%
        ),
        linear-gradient(
            135deg,
            var(--smhs-navy),
            var(--smhs-navy-light) 65%,
            #081827
        );
    color: var(--smhs-cream);
    font-family: inherit;
    margin-top: 0;
}

.smhs-footer *,
.smhs-footer *::before,
.smhs-footer *::after {
    box-sizing: border-box;
}

.smhs-footer-accent {
    height: 3px;
    width: 100%;
    background: linear-gradient(
        90deg,
        transparent,
        var(--smhs-gold),
        var(--smhs-gold-light),
        var(--smhs-gold),
        transparent
    );
}

.smhs-footer-container {
    width: min(1240px, 100%);
    margin: 0 auto;
    padding: 70px 28px 24px;
}

.smhs-footer-grid {
    display: grid;
    grid-template-columns: 1.45fr 0.9fr 1.15fr 1.15fr;
    gap: 48px;
    align-items: start;
}

/* BRAND */

.smhs-footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 15px;
    text-decoration: none;
    color: var(--smhs-cream);
    margin-bottom: 23px;
}

.smhs-footer-logo img {
    width: 67px;
    height: 67px;
    object-fit: contain;
    flex-shrink: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.04);
}

.smhs-footer-brand-text {
    display: flex;
    flex-direction: column;
}

.smhs-footer-school-name {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 27px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 1.5px;
    color: var(--smhs-cream);
}

.smhs-footer-school-subtitle {
    margin-top: 5px;
    color: var(--smhs-gold-light);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 4px;
}

.smhs-footer-location {
    margin-top: 7px;
    color: var(--smhs-muted);
    font-size: 9px;
    letter-spacing: 1.5px;
}

.smhs-footer-description {
    max-width: 350px;
    margin: 0 0 21px;
    color: var(--smhs-muted);
    font-size: 13px;
    line-height: 1.95;
}

.smhs-footer-motto {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--smhs-gold-light);
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 17px;
    font-style: italic;
}

.smhs-footer-motto-line {
    width: 27px;
    height: 1px;
    flex-shrink: 0;
    background: var(--smhs-gold);
}

.smhs-footer-accreditation {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 23px;
    color: var(--smhs-muted);
    font-size: 11px;
}

.smhs-footer-accreditation i {
    color: var(--smhs-gold);
    font-size: 16px;
}

/* COLUMN HEADINGS */

.smhs-footer-heading {
    margin: 5px 0 14px;
    color: var(--smhs-cream);
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 23px;
    font-weight: 700;
    line-height: 1.3;
}

.smhs-footer-heading-line {
    display: block;
    width: 38px;
    height: 2px;
    margin-bottom: 23px;
    background: var(--smhs-gold);
}

/* NAVIGATION LINKS */

.smhs-footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
}

.smhs-footer-links li {
    margin: 0 0 15px;
}

.smhs-footer-links a {
    display: inline-flex;
    align-items: baseline;
    gap: 9px;
    color: var(--smhs-muted);
    font-size: 12px;
    line-height: 1.7;
    text-decoration: none;
    transition: color 0.25s ease, transform 0.25s ease;
}

.smhs-footer-links a i {
    color: var(--smhs-gold);
    font-size: 10px;
}

.smhs-footer-links a:hover,
.smhs-footer-bottom-links a:hover {
    color: var(--smhs-gold-light);
    transform: translateX(3px);
}

/* CALL TO ACTION */

.smhs-footer-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 8px;
    padding: 12px 15px;
    border: 1px solid rgba(197, 164, 90, 0.65);
    color: var(--smhs-gold-light);
    font-size: 11px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease;
}

.smhs-footer-cta:hover {
    background: var(--smhs-gold);
    color: var(--smhs-navy);
}

.smhs-footer-cta i {
    font-size: 10px;
}

/* CONTACT DETAILS */

.smhs-footer-contact-item {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    margin-bottom: 23px;
}

.smhs-footer-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(197, 164, 90, 0.3);
    border-radius: 50%;
    color: var(--smhs-gold-light);
    font-size: 13px;
    transition: background 0.25s ease;
}

.smhs-footer-contact-item:hover .smhs-footer-icon {
    background: rgba(197, 164, 90, 0.13);
}

.smhs-footer-contact-item strong {
    display: block;
    margin: 0 0 6px;
    color: var(--smhs-cream);
    font-size: 12px;
    font-weight: 600;
}

.smhs-footer-contact-item p,
.smhs-footer-contact-item div > a:not(.smhs-footer-map-link) {
    display: block;
    margin: 0;
    color: var(--smhs-muted);
    font-size: 12px;
    line-height: 1.8;
    text-decoration: none;
}

.smhs-footer-contact-item div > a:hover {
    color: var(--smhs-gold-light);
}

.smhs-footer-contact-item .smhs-footer-map-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 8px;
    color: var(--smhs-gold-light);
    font-size: 11px;
    text-decoration: none;
}

.smhs-footer-map-link i {
    font-size: 9px;
}

/* COPYRIGHT BAR */

.smhs-footer-divider {
    height: 1px;
    margin: 48px 0 23px;
    background: linear-gradient(
        90deg,
        transparent,
        rgba(197, 164, 90, 0.45),
        rgba(255, 255, 255, 0.1),
        transparent
    );
}

.smhs-footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.smhs-footer-copyright {
    margin: 0;
    color: var(--smhs-muted);
    font-size: 11px;
    line-height: 1.8;
}

.smhs-footer-copyright strong {
    color: var(--smhs-cream);
    font-weight: 600;
}

.smhs-footer-bottom-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
}

.smhs-footer-bottom-links a {
    color: var(--smhs-muted);
    font-size: 11px;
    text-decoration: none;
    transition: color 0.2s ease;
}

.smhs-footer-bottom-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--smhs-gold);
}

.smhs-footer-back-top {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 37px;
    height: 37px;
    border: 1px solid rgba(197, 164, 90, 0.6);
    border-radius: 50%;
    color: var(--smhs-gold-light);
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease;
}

.smhs-footer-back-top:hover {
    background: var(--smhs-gold);
    color: var(--smhs-navy);
}

/* TABLET */

@media (max-width: 1050px) {
    .smhs-footer-grid {
        grid-template-columns: 1.3fr 1fr;
        column-gap: 55px;
        row-gap: 45px;
    }

    .smhs-footer-description {
        max-width: 430px;
    }

    .smhs-footer-divider {
        margin-top: 40px;
    }
}

/* MOBILE */

@media (max-width: 600px) {
    .smhs-footer-container {
        padding: 48px 22px 20px;
    }

    .smhs-footer-grid {
        grid-template-columns: 1fr;
        gap: 37px;
    }

    .smhs-footer-brand {
        padding-bottom: 8px;
    }

    .smhs-footer-logo img {
        width: 59px;
        height: 59px;
    }

    .smhs-footer-school-name {
        font-size: 25px;
    }

    .smhs-footer-description {
        font-size: 13px;
    }

    .smhs-footer-heading {
        font-size: 22px;
    }

    .smhs-footer-heading-line {
        margin-bottom: 19px;
    }

    .smhs-footer-links li {
        margin-bottom: 13px;
    }

    .smhs-footer-divider {
        margin: 35px 0 22px;
    }

    .smhs-footer-bottom {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 16px 10px;
        align-items: center;
    }

    .smhs-footer-copyright {
        grid-column: 1 / -1;
        font-size: 11px;
    }

    .smhs-footer-bottom-links {
        justify-content: flex-start;
        gap: 9px;
    }

    .smhs-footer-bottom-links a {
        font-size: 10px;
    }

    .smhs-footer-back-top {
        width: 34px;
        height: 34px;
    }
}

/* REDUCED MOTION ACCESSIBILITY */

@media (prefers-reduced-motion: reduce) {
    .smhs-footer *,
    .smhs-footer *::before,
    .smhs-footer *::after {
        scroll-behavior: auto !important;
        transition: none !important;
    }
}
</style>
