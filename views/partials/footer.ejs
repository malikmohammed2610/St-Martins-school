                            rel="noopener noreferrer"
                            class="smhs-footer-map-link"
                        >
                            Get Directions
                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                        </a>
                    </div>
                </div>

                <div class="smhs-footer-contact-item">
                    <span class="smhs-footer-icon">
                        <i class="fa-solid fa-phone"></i>
                    </span>
                    <div>
                        <strong>Call the School</strong>
                        <a href="tel:040 2377 4208">040 - 2377 4208</a>
                    </div>
                </div>

                <div class="smhs-footer-contact-item">
                    <span class="smhs-footer-icon">
                        <i class="fa-regular fa-clock"></i>
                    </span>
                    <div>
                        <strong>School Enquiries</strong>
                        <p>Please contact the school<br>during office hours.</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- FOOTER DIVIDER -->
        <div class="smhs-footer-divider"></div>

        

<!-- BOTTOM BAR -->
<div class="smhs-footer-bottom">

    <p class="smhs-footer-copyright">
        <strong>
            &copy; <%= new Date().getFullYear() %>
            St. Martin's High School, Balanagar, Hyderabad.
            All Rights Reserved.
        </strong>
    </p>
  <a href="#top" class="smhs-footer-back-top" aria-label="Back to top">
                <i class="fa-solid fa-arrow-up"></i>
            </a>
        </div>
    <p class="smhs-footer-copyright smhs-footer-developer">
        <strong>Designed &amp; Developed by Abdul Malik</strong>
        <span class="smhs-footer-student">
            Student Developer | A Student of St. Martin's High School
        </span>
    </p>

</div>

