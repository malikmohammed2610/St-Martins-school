<!-- ============================================================
     ST. MARTIN'S HIGH SCHOOL
     GLOBAL HEADER PARTIAL
============================================================ -->

<style>
    /* =========================================================
       HEADER — ISOLATED STYLES
    ========================================================= */

    .site-header-wrapper,
    .site-header-wrapper * {
        box-sizing: border-box;
    }

    .site-header-wrapper {
        position: relative;
        z-index: 9999;
    }

    /* TOP BAR */

    .site-header-wrapper .top-bar {
        background: #071A2B;
        color: rgba(255,255,255,.85);
        font-size: 13px;
        padding: 9px 0;
        position: relative;
        z-index: 10001;
    }

    .site-header-wrapper .top-bar-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .site-header-wrapper .top-info {
        display: flex;
        align-items: center;
        gap: 22px;
    }

    .site-header-wrapper .top-info span {
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

    .site-header-wrapper .top-info i {
        color: #dfc982;
    }

    /* =========================================================
       MAIN HEADER
    ========================================================= */

    .site-header-wrapper .main-header {
        position: sticky;
        top: 0;
        z-index: 10000;
        width: 100%;
        background: rgba(246,241,231,.97);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(197,164,90,.22);
        transition: box-shadow .35s ease;
    }

    .site-header-wrapper .main-header.scrolled {
        box-shadow: 0 10px 40px rgba(7,26,43,.14);
    }

    /* HEADER INNER */

    .site-header-wrapper .header-inner {
        min-height: 92px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    /* =========================================================
       BRAND
    ========================================================= */

    .site-header-wrapper .brand {
        display: flex;
        align-items: center;
        gap: 13px;
        color: #071A2B;
        flex-shrink: 0;
        text-decoration: none;
        min-width: 0;
    }

    .site-header-wrapper .brand:hover {
        color: #071A2B;
    }

    .site-header-wrapper .brand-logo {
        display: block;
        width: 63px !important;
        height: 63px !important;
        min-width: 63px !important;
        min-height: 63px !important;
        max-width: 63px !important;
        max-height: 63px !important;
        object-fit: contain !important;
        flex: 0 0 63px;
        filter: drop-shadow(0 8px 12px rgba(7,26,43,.12));
    }

    /* BRAND TEXT */

    .site-header-wrapper .brand-text {
        line-height: 1;
        min-width: 0;
    }

    .site-header-wrapper .brand-name {
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: 25px;
        font-weight: 700;
        letter-spacing: .4px;
        white-space: nowrap;
    }

    .site-header-wrapper .brand-location {
        margin-top: 6px;
        font-family: "Inter", sans-serif;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 2px;
        color: #C5A45A;
        text-transform: uppercase;
        white-space: nowrap;
    }

    /* =========================================================
       NAVIGATION
    ========================================================= */

    .site-header-wrapper .main-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 3px;
    }

    .site-header-wrapper .nav-item {
        position: relative;
    }

    .site-header-wrapper .nav-link {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #071A2B !important;
        font-family: "Inter", sans-serif;
        font-size: 13px;
        font-weight: 600;
        padding: 13px 12px;
        position: relative;
        transition: .25s ease;
        white-space: nowrap;
        text-decoration: none;
    }

    .site-header-wrapper .nav-link::after {
        content: "";
        position: absolute;
        left: 12px;
        right: 12px;
        bottom: 5px;
        height: 2px;
        background: #C5A45A;
        transform: scaleX(0);
        transform-origin: center;
        transition: transform .3s ease;
    }

    .site-header-wrapper .nav-link:hover {
        color: #8d702d !important;
    }

    .site-header-wrapper .nav-link:hover::after {
        transform: scaleX(1);
    }

    .site-header-wrapper .nav-chevron {
        font-size: 9px;
        transition: transform .3s ease;
    }

    .site-header-wrapper .nav-item:hover > .nav-link .nav-chevron {
        transform: rotate(180deg);
    }

    /* =========================================================
       DROPDOWN
    ========================================================= */

    .site-header-wrapper .dropdown-menu-custom {
        position: absolute;
        top: calc(100% + 14px);
        left: 50%;
        width: 255px;
        transform: translateX(-50%) translateY(12px)
                   perspective(700px) rotateX(-8deg);
        transform-origin: top center;
        opacity: 0;
        visibility: hidden;
        background: rgba(7,26,43,.98);
        border: 1px solid rgba(197,164,90,.35);
        border-radius: 15px;
        padding: 9px;
        box-shadow:
            0 25px 55px rgba(0,0,0,.28),
            0 0 0 1px rgba(255,255,255,.03) inset;
        transition: opacity .25s ease,
                    visibility .25s ease,
                    transform .3s ease;
        z-index: 20000;
    }

    .site-header-wrapper .dropdown-menu-custom::before {
        content: "";
        position: absolute;
        top: -7px;
        left: 50%;
        width: 14px;
        height: 14px;
        background: #071A2B;
        border-left: 1px solid rgba(197,164,90,.35);
        border-top: 1px solid rgba(197,164,90,.35);
        transform: translateX(-50%) rotate(45deg);
    }

    .site-header-wrapper .nav-item:hover > .dropdown-menu-custom {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0)
                   perspective(700px) rotateX(0);
    }

    /* DROPDOWN ITEMS */

    .site-header-wrapper .dropdown-item-custom {
        position: relative;
        display: flex;
        align-items: center;
        gap: 11px;
        color: rgba(255,255,255,.88);
        padding: 12px 13px;
        border-radius: 10px;
        font-family: "Inter", sans-serif;
        font-size: 12px;
        font-weight: 500;
        transition: .25s ease;
        overflow: hidden;
        text-decoration: none;
    }

    .site-header-wrapper .dropdown-item-custom::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: #C5A45A;
        transform: scaleY(0);
        transition: transform .25s ease;
    }

    .site-header-wrapper .dropdown-item-custom i {
        width: 18px;
        color: #dfc982;
        font-size: 12px;
        transition: .25s ease;
    }

    .site-header-wrapper .dropdown-item-custom:hover {
        color: white;
        background: linear-gradient(
            90deg,
            rgba(197,164,90,.16),
            rgba(197,164,90,.05)
        );
        transform: translateX(4px);
    }

    .site-header-wrapper .dropdown-item-custom:hover::before {
        transform: scaleY(1);
    }

    .site-header-wrapper .dropdown-item-custom:hover i {
        transform: translateX(2px);
    }

    /* =========================================================
       HEADER ACTION BUTTONS
    ========================================================= */

    .site-header-wrapper .header-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        flex-shrink: 0;
    }

    .site-header-wrapper .header-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 15px;
        background: #071A2B;
        color: white;
        border: 1px solid #C5A45A;
        border-radius: 50px;
        font-family: "Inter", sans-serif;
        font-size: 12px;
        font-weight: 700;
        box-shadow: 0 8px 20px rgba(7,26,43,.16);
        transition: .3s ease;
        white-space: nowrap;
        text-decoration: none;
        flex-shrink: 0;
    }

    .site-header-wrapper .header-cta:hover {
        color: #071A2B;
        background: #dfc982;
        transform: translateY(-2px);
        box-shadow: 0 14px 28px rgba(7,26,43,.2);
    }

    /* TEACHER LOGIN BUTTON */

    .site-header-wrapper .teacher-login-cta {
        background: transparent;
        color: #071A2B;
        border: 1px solid #C5A45A;
        box-shadow: none;
    }

    .site-header-wrapper .teacher-login-cta:hover {
        color: #dfc982;
        background: #071A2B;
        border-color: #071A2B;
    }

    /* APPLY NOW BUTTON */

    .site-header-wrapper .apply-cta {
        background: #071A2B;
        color: #fff;
    }

    /* =========================================================
       MOBILE BUTTON
    ========================================================= */

    .site-header-wrapper .mobile-menu-btn {
        display: none;
        width: 45px !important;
        height: 45px !important;
        min-width: 45px !important;
        min-height: 45px !important;
        max-width: 45px !important;
        max-height: 45px !important;
        border: 1px solid rgba(197,164,90,.4);
        background: #071A2B;
        color: white;
        border-radius: 12px;
        font-size: 18px;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        cursor: pointer;
    }

    /* =========================================================
       TABLET
    ========================================================= */

    @media (max-width: 1200px) {
        .site-header-wrapper .main-nav {
            gap: 0;
        }

        .site-header-wrapper .nav-link {
            padding-left: 7px;
            padding-right: 7px;
            font-size: 12px;
        }

        .site-header-wrapper .header-actions {
            gap: 6px;
        }

        .site-header-wrapper .header-actions .header-cta {
            padding-left: 10px;
            padding-right: 10px;
            font-size: 11px;
        }

        .site-header-wrapper .brand {
            gap: 9px;
        }

        .site-header-wrapper .brand-name {
            font-size: 22px;
        }
    }

    /* =========================================================
       MOBILE NAVIGATION
    ========================================================= */

    @media (max-width: 991px) {
        .site-header-wrapper .top-bar {
            display: none;
        }

        .site-header-wrapper .header-inner {
            min-height: 80px;
        }

        .site-header-wrapper .brand-logo {
            width: 54px !important;
            height: 54px !important;
            min-width: 54px !important;
            min-height: 54px !important;
            max-width: 54px !important;
            max-height: 54px !important;
            flex-basis: 54px;
        }

        .site-header-wrapper .brand-name {
            font-size: 22px;
        }

        .site-header-wrapper .mobile-menu-btn {
            display: flex;
            margin-left: auto;
        }

        .site-header-wrapper .header-actions {
            display: none;
        }

        .site-header-wrapper .main-nav {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            display: block;
            max-height: 0;
            overflow: hidden;
            background: rgba(246,241,231,.99);
            border-bottom: 1px solid rgba(197,164,90,.2);
            box-shadow: 0 20px 40px rgba(7,26,43,.12);
            transition: max-height .45s ease;
        }

        .site-header-wrapper .main-nav.mobile-open {
            max-height: 85vh;
            overflow-y: auto;
        }

        .site-header-wrapper .nav-item {
            border-bottom: 1px solid rgba(7,26,43,.07);
        }

        .site-header-wrapper .nav-link {
            width: 100%;
            padding: 16px 22px;
            justify-content: space-between;
        }

        .site-header-wrapper .nav-link::after {
            display: none;
        }

        .site-header-wrapper .dropdown-menu-custom {
            position: static;
            width: 100%;
            transform: none !important;
            opacity: 1;
            visibility: visible;
            display: none;
            border: 0;
            border-radius: 0;
            background: rgba(7,26,43,.98);
            box-shadow: none;
            padding: 5px 10px;
        }

        .site-header-wrapper .dropdown-menu-custom::before {
            display: none;
        }

        .site-header-wrapper .nav-item.dropdown-open .dropdown-menu-custom {
            display: block;
        }

        .site-header-wrapper .dropdown-item-custom {
            padding: 12px 15px;
        }
    }

    /* SMALL MOBILE */

    @media (max-width: 767px) {
        .site-header-wrapper .header-inner {
            min-height: 76px;
        }

        .site-header-wrapper .brand-location {
            display: none;
        }

        .site-header-wrapper .brand-name {
            font-size: 20px;
        }

        .site-header-wrapper .brand-logo {
            width: 50px !important;
            height: 50px !important;
            min-width: 50px !important;
            min-height: 50px !important;
            max-width: 50px !important;
            max-height: 50px !important;
            flex-basis: 50px;
        }
    }
</style>

