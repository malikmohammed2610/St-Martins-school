```ejs
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Teacher Dashboard | St. Martin's High School</title>

    <link rel="icon" type="image/png" href="/images/Logo.png">

    <style>
        * {
            box-sizing: border-box;
        }

        :root {
            --navy: #071827;
            --navy-light: #102c44;
            --gold: #c5a45a;
            --gold-light: #e0c67b;
            --cream: #f4f1e9;
            --text: #172635;
            --muted: #7a8289;
            --border: #e8e8e5;
            --white: #ffffff;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: var(--cream);
            color: var(--text);
            line-height: 1.6;
        }

        input,
        select,
        textarea,
        button {
            font: inherit;
        }

        .topbar {
            background: var(--navy);
            color: white;
            padding: 18px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .brand img {
            width: 48px;
            height: 48px;
            object-fit: contain;
        }

        .brand strong {
            font-family: Georgia, serif;
            font-size: 18px;
            line-height: 1.3;
        }

        .logout {
            color: white;
            text-decoration: none;
            border: 1px solid rgba(255,255,255,.25);
            padding: 10px 16px;
            border-radius: 8px;
            transition: .25s ease;
            white-space: nowrap;
        }

        .logout:hover {
            background: var(--gold);
            color: var(--navy);
        }

        .container {
            max-width: 1200px;
            margin: auto;
            padding: 40px 25px 60px;
        }

        .hero {
            position: relative;
            overflow: hidden;
            background: linear-gradient(125deg, #071827, #163b57);
            color: white;
            border-radius: 24px;
            padding: 45px;
            margin-bottom: 30px;
            box-shadow: 0 15px 40px rgba(7, 24, 39, .12);
        }

        .hero::after {
            content: "";
            position: absolute;
            width: 250px;
            height: 250px;
            border: 1px solid rgba(197,164,90,.3);
            border-radius: 50%;
            right: -80px;
            top: -100px;
            box-shadow:
                0 0 0 30px rgba(197,164,90,.04),
                0 0 0 60px rgba(197,164,90,.03);
            pointer-events: none;
        }

        .eyebrow {
            color: var(--gold-light);
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 11px;
            font-weight: bold;
        }

        .hero h1 {
            font-family: Georgia, serif;
            font-size: 40px;
            line-height: 1.2;
            margin: 12px 0;
        }

        .hero p {
            color: #c1ced8;
            max-width: 650px;
            margin-bottom: 0;
        }

        .section-heading {
            margin: 40px 0 18px;
        }

        .section-heading h2 {
            font-family: Georgia, serif;
            font-size: 27px;
            margin: 0 0 5px;
        }

        .section-heading p {
            color: var(--muted);
            margin: 0;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 20px;
        }

        .card {
            background: white;
            padding: 26px;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(0,0,0,.045);
            border: 1px solid rgba(7,24,39,.04);
            transition: transform .25s ease, box-shadow .25s ease;
        }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 35px rgba(0,0,0,.075);
        }

        .card-icon {
            width: 48px;
            height: 48px;
            display: grid;
            place-items: center;
            border-radius: 14px;
            background: #f5f0e4;
            color: #85651f;
            font-size: 23px;
            margin-bottom: 17px;
        }

        .card h3 {
            margin: 0 0 9px;
            font-family: Georgia, serif;
            font-size: 21px;
        }

        .card p {
            color: var(--muted);
            font-size: 14px;
            margin: 0 0 20px;
        }

        .action-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-decoration: none;
            background: var(--navy-light);
            color: white;
            padding: 11px 16px;
            border-radius: 9px;
            font-weight: bold;
            font-size: 13px;
            transition: .25s ease;
        }

        .action-link:hover {
            background: var(--gold);
            color: var(--navy);
        }

        .form-panel,
        .profile {
            background: white;
            border-radius: 20px;
            padding: 30px;
            margin-top: 24px;
            box-shadow: 0 10px 30px rgba(0,0,0,.045);
            border: 1px solid rgba(7,24,39,.04);
            scroll-margin-top: 25px;
        }

        .panel-heading {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            margin-bottom: 25px;
        }

        .panel-heading .card-icon {
            flex-shrink: 0;
            margin-bottom: 0;
        }

        .panel-heading h2 {
            font-family: Georgia, serif;
            font-size: 25px;
            margin: 0 0 4px;
        }

        .panel-heading p {
            margin: 0;
            color: var(--muted);
            font-size: 14px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
            min-width: 0;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-size: 13px;
            font-weight: bold;
            color: #273746;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            min-width: 0;
            padding: 12px 14px;
            border: 1px solid #dce1e5;
            border-radius: 9px;
            background: #fcfcfb;
            color: var(--text);
            outline: none;
            transition: border-color .2s, box-shadow .2s;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            border-color: var(--gold);
            box-shadow: 0 0 0 3px rgba(197,164,90,.14);
        }

        .form-group textarea {
            min-height: 130px;
            resize: vertical;
        }

        .form-hint {
            font-size: 12px;
            color: var(--muted);
        }

        .form-actions {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 24px;
        }

        .submit-button,
        .reset-button {
            border: 0;
            padding: 13px 20px;
            border-radius: 9px;
            cursor: pointer;
            font-weight: bold;
            transition: .25s ease;
        }

        .submit-button {
            background: var(--navy-light);
            color: white;
        }

        .submit-button:hover {
            background: var(--gold);
            color: var(--navy);
        }

        .reset-button {
            background: #f0f1f1;
            color: #344451;
        }

        .reset-button:hover {
            background: #e2e5e7;
        }

        .profile h2 {
            font-family: Georgia, serif;
            margin: 0 0 15px;
        }

        .profile-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
            padding: 14px 0;
            border-bottom: 1px solid #eee;
        }

        .profile-row:last-child {
            border-bottom: 0;
        }

        .label {
            color: var(--muted);
        }

        .value {
            font-weight: bold;
            text-align: right;
            overflow-wrap: anywhere;
        }

        .footer-note {
            text-align: center;
            color: var(--muted);
            font-size: 12px;
            padding-top: 30px;
        }

        @media (max-width: 800px) {
            .grid {
                grid-template-columns: 1fr;
            }

            .hero {
                padding: 30px;
            }

            .hero h1 {
                font-size: 32px;
            }

            .topbar {
                padding: 15px;
            }
        }

        @media (max-width: 560px) {
            .container {
                padding: 25px 15px 40px;
            }

            .brand {
                gap: 9px;
            }

            .brand img {
                width: 40px;
                height: 40px;
            }

            .brand strong {
                font-size: 14px;
                max-width: 165px;
            }

            .logout {
                padding: 8px 10px;
                font-size: 13px;
            }

            .hero {
                padding: 25px 20px;
                border-radius: 18px;
            }

            .hero h1 {
                font-size: 29px;
                overflow-wrap: anywhere;
            }

            .section-heading h2 {
                font-size: 24px;
            }

            .form-panel,
            .profile {
                padding: 20px 16px;
                border-radius: 16px;
            }

            .form-grid {
                grid-template-columns: 1fr;
                gap: 16px;
            }

            .panel-heading h2 {
                font-size: 21px;
            }

            .profile-row {
                gap: 12px;
                font-size: 13px;
            }

            .form-actions > button {
                width: 100%;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            *,
            *::before,
            *::after {
                transition-duration: .01ms !important;
            }
        }
    </style>
</head>

<body>

<header class="topbar">
    <div class="brand">
        <img src="/images/Logo.png" alt="St. Martin's High School logo">
        <strong>St. Martin's High School</strong>
    </div>

    <a href="/teacher-logout" class="logout">Logout</a>
</header>

<main class="container">

    <!-- DASHBOARD WELCOME -->

    <section class="hero">
        <div class="eyebrow">Faculty Dashboard</div>

        <h1>
            Welcome, <%= teacher.full_name %>
        </h1>

        <p>
            Welcome to the secure St. Martin's High School teacher portal.
            Manage school announcements, submit academic calendar events,
            and access your faculty information from one place.
        </p>
    </section>


    <!-- QUICK ACCESS -->

    <div class="section-heading">
        <h2>Faculty Workspace</h2>
        <p>Choose an action to manage school information.</p>
    </div>

    <section class="grid">

        <article class="card">
            <div class="card-icon">📢</div>
            <h3>Post a New Update</h3>
            <p>
                Prepare announcements about school activities, examinations,
                competitions, holidays, or other important information.
            </p>
            <a href="#new-update" class="action-link">
                + Create Update
            </a>
        </article>

        <article class="card">
            <div class="card-icon">🗓️</div>
            <h3>Add Calendar Event</h3>
            <p>
                Submit academic events, examinations, parent meetings,
                school functions, and other important dates.
            </p>
            <a href="#new-calendar-event" class="action-link">
                + Add Event
            </a>
        </article>

        <article class="card">
            <div class="card-icon">📚</div>
            <h3>Academic Resources</h3>
            <p>
                Access teaching resources, academic information,
                and school materials.
            </p>
            <a href="/resources" class="action-link">
                View Resources
            </a>
        </article>

    </section>


    <!-- NEW SCHOOL UPDATE FORM -->

    <section class="form-panel" id="new-update">

        <div class="panel-heading">
            <div class="card-icon">📢</div>

            <div>
                <h2>Post a New School Update</h2>
                <p>
                    Submit an announcement for the school's News &amp; Updates page.
                </p>
            </div>
        </div>

        <form
            action="/teacher/updates"
            method="POST"
            accept-charset="UTF-8"
        >

            <div class="form-grid">

                <div class="form-group full-width">
                    <label for="updateTitle">Announcement Title *</label>
                    <input
                        type="text"
                        id="updateTitle"
                        name="title"
                        placeholder="e.g. Annual Sports Day Announcement"
                        maxlength="150"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="updateCategory">Category *</label>

                    <select id="updateCategory" name="category" required>
                        <option value="">Select a category</option>
                        <option value="General Announcement">General Announcement</option>
                        <option value="Academic">Academic</option>
                        <option value="Examination">Examination</option>
                        <option value="Sports">Sports</option>
                        <option value="Cultural Event">Cultural Event</option>
                        <option value="Holiday">Holiday</option>
                        <option value="Achievement">Achievement</option>
                        <option value="Important Notice">Important Notice</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="updateDate">Announcement Date *</label>
                    <input
                        type="date"
                        id="updateDate"
                        name="date"
                        required
                    >
                </div>

                <div class="form-group full-width">
                    <label for="updateImage">Image URL (optional)</label>
                    <input
                        type="url"
                        id="updateImage"
                        name="image_url"
                        placeholder="https://example.com/announcement-image.jpg"
                    >
                    <span class="form-hint">
                        Enter a publicly accessible image URL if required.
                    </span>
                </div>

                <div class="form-group full-width">
                    <label for="updateDescription">Announcement Details *</label>
                    <textarea
                        id="updateDescription"
                        name="description"
                        placeholder="Write the announcement clearly, including any instructions for students and parents..."
                        maxlength="5000"
                        required
                    ></textarea>
                </div>

            </div>

            <div class="form-actions">
                <button type="submit" class="submit-button">
                    Submit Announcement →
                </button>

                <button type="reset" class="reset-button">
                    Clear Form
                </button>
            </div>

        </form>

    </section>


    <!-- NEW ACADEMIC CALENDAR EVENT FORM -->

    <section class="form-panel" id="new-calendar-event">

        <div class="panel-heading">
            <div class="card-icon">🗓️</div>

            <div>
                <h2>Add to Academic Calendar</h2>
                <p>
                    Submit a new event for the school's Academic Calendar page.
                </p>
            </div>
        </div>

        <form
            action="/teacher/calendar-events"
            method="POST"
            accept-charset="UTF-8"
        >

            <div class="form-grid">

                <div class="form-group full-width">
                    <label for="eventTitle">Event Title *</label>
                    <input
                        type="text"
                        id="eventTitle"
                        name="title"
                        placeholder="e.g. First Term Examination"
                        maxlength="150"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="eventCategory">Event Category *</label>

                    <select id="eventCategory" name="category" required>
                        <option value="">Select a category</option>
                        <option value="Examination">Examination</option>
                        <option value="Holiday">Holiday</option>
                        <option value="School Event">School Event</option>
                        <option value="Sports">Sports</option>
                        <option value="Cultural">Cultural Programme</option>
                        <option value="Parent Meeting">Parent Meeting</option>
                        <option value="Academic Activity">Academic Activity</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="eventDate">Event Date *</label>
                    <input
                        type="date"
                        id="eventDate"
                        name="event_date"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="eventStartTime">Start Time</label>
                    <input
                        type="time"
                        id="eventStartTime"
                        name="start_time"
                    >
                </div>

                <div class="form-group">
                    <label for="eventEndTime">End Time</label>
                    <input
                        type="time"
                        id="eventEndTime"
                        name="end_time"
                    >
                </div>

                <div class="form-group full-width">
                    <label for="eventLocation">Venue (optional)</label>
                    <input
                        type="text"
                        id="eventLocation"
                        name="location"
                        placeholder="e.g. School Auditorium"
                        maxlength="200"
                    >
                </div>

                <div class="form-group full-width">
                    <label for="eventDescription">Event Details *</label>
                    <textarea
                        id="eventDescription"
                        name="description"
                        placeholder="Describe the event, relevant classes, instructions, and other details..."
                        maxlength="5000"
                        required
                    ></textarea>
                </div>

            </div>

            <div class="form-actions">
                <button type="submit" class="submit-button">
                    Submit Calendar Event →
                </button>

                <button type="reset" class="reset-button">
                    Clear Form
                </button>
            </div>

        </form>

    </section>


<!-- PRINCIPAL'S INSTRUCTIONS -->

<section id="principal-instructions" style="
    background:#fff;
    padding:26px;
    margin:30px 0;
    border-radius:18px;
    border:1px solid #e8e8e5;
    box-shadow:0 10px 30px rgba(0,0,0,.045);
">
    <h2 style="margin-top:0;font-family:Georgia,serif;">
        📢 Principal's Instructions
    </h2>

    <p style="color:#7a8289;">
        Important messages sent directly by the principal.
    </p>

    <div id="teacherNotifications" aria-live="polite">
        Loading instructions...
    </div>
</section>



    <!-- TEACHER ACCOUNT -->

    <section class="profile" id="teacher-profile">

        <h2>Teacher Account</h2>

        <div class="profile-row">
            <span class="label">Full Name</span>
            <span class="value"><%= teacher.full_name %></span>
        </div>

        <div class="profile-row">
            <span class="label">Employee ID</span>
            <span class="value"><%= teacher.employee_id %></span>
        </div>

        <div class="profile-row">
            <span class="label">Username</span>
            <span class="value"><%= teacher.username %></span>
        </div>

        <div class="profile-row">
            <span class="label">Email</span>
            <span class="value"><%= teacher.email %></span>
        </div>

        <div class="profile-row">
            <span class="label">Role</span>
            <span class="value">Teacher</span>
        </div>

    </section>

    <div class="footer-note">
        St. Martin's High School · Faculty Portal
    </div>

</main>


<script>
(async function loadPrincipalInstructions() {
    const container = document.getElementById(
        "teacherNotifications"
    );

    function addTextElement(parent, tag, text, styles) {
        const element = document.createElement(tag);
        element.textContent = text;

        if (styles) {
            Object.assign(element.style, styles);
        }

        parent.appendChild(element);
        return element;
    }

    try {
        const response = await fetch(
            "/api/teacher/notifications",
            {
                credentials: "same-origin"
            }
        );

        if (response.status === 401) {
            container.textContent =
                "Your session has expired. Please log in again.";
            return;
        }

        const data = await response.json();

        if (!response.ok || !data.success) {
            throw new Error(
                data.error || "Unable to load instructions."
            );
        }

        container.replaceChildren();

        const notifications = data.notifications || [];

        if (notifications.length === 0) {
            container.textContent =
                "No instructions from the principal yet.";
            return;
        }

        notifications.forEach(function (item) {
            const card = document.createElement("article");

            Object.assign(card.style, {
                padding: "18px",
                marginTop: "14px",
                border: "1px solid #e8e8e5",
                borderLeft: "4px solid #c5a45a",
                borderRadius: "10px",
                background: "#fcfbf8"
            });

            addTextElement(card, "h3", item.title, {
                margin: "0 0 8px",
                color: "#071827",
                fontSize: "18px"
            });

            addTextElement(card, "p", item.message, {
                margin: "0 0 10px",
                whiteSpace: "pre-wrap",
                overflowWrap: "anywhere",
                color: "#344454"
            });

            if (item.created_at) {
                addTextElement(
                    card,
                    "small",
                    "Sent: " + item.created_at,
                    { color: "#7a8289" }
                );
            }

            container.appendChild(card);
        });
    } catch (error) {
        console.error(
            "Unable to load principal instructions:",
            error
        );

        container.textContent =
            "Unable to load instructions. Please refresh the page.";
    }
})();
</script>


<script src="/js/premium-effects.js"></script>


</body>
</html>
```
