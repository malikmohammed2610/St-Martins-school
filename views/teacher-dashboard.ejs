<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>
        Teacher Dashboard | St. Martin's High School
    </title>

    <link rel="icon"
          type="image/png"
          href="/images/logo.png">

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f1e9;
            color: #172635;
        }

        .topbar {
            background: #071827;
            color: white;
            padding: 18px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .brand img {
            width: 48px;
            height: 48px;
            object-fit: contain;
        }

        .brand strong {
            font-family: Georgia, serif;
            font-size: 18px;
        }

        .logout {
            color: white;
            text-decoration: none;
            border: 1px solid rgba(255,255,255,.2);
            padding: 10px 16px;
            border-radius: 8px;
        }

        .logout:hover {
            background: #c5a45a;
            color: #071827;
        }

        .container {
            max-width: 1200px;
            margin: auto;
            padding: 45px 25px;
        }

        .hero {
            background: #102c44;
            color: white;
            border-radius: 24px;
            padding: 45px;
            margin-bottom: 30px;
        }

        .eyebrow {
            color: #c5a45a;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 11px;
            font-weight: bold;
        }

        .hero h1 {
            font-family: Georgia, serif;
            font-size: 40px;
            margin: 12px 0;
        }

        .hero p {
            color: #c1ced8;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 20px;
        }

        .card {
            background: white;
            padding: 28px;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(0,0,0,.06);
        }

        .card h3 {
            margin-top: 0;
            font-family: Georgia, serif;
        }

        .profile {
            margin-top: 30px;
            background: white;
            border-radius: 20px;
            padding: 30px;
        }

        .profile-row {
            display: flex;
            justify-content: space-between;
            padding: 14px 0;
            border-bottom: 1px solid #eee;
        }

        .profile-row:last-child {
            border-bottom: 0;
        }

        .label {
            color: #7a8289;
        }

        .value {
            font-weight: bold;
        }

        @media(max-width:800px) {

            .grid {
                grid-template-columns: 1fr;
            }

            .hero {
                padding: 30px;
            }

            .hero h1 {
                font-size: 32px;
            }

            .topbar {
                padding: 15px;
            }

        }

    </style>

</head>

<body>

<header class="topbar">

    <div class="brand">

        <img
            src="/images/logo.png"
            alt="School Logo"
        >

        <strong>
            St. Martin's High School
        </strong>

    </div>

    <a
        href="/teacher-logout"
        class="logout"
    >
        Logout
    </a>

</header>


<main class="container">

    <section class="hero">

        <div class="eyebrow">
            Faculty Dashboard
        </div>

        <h1>
            Welcome,
            <%= teacher.full_name %>
        </h1>

        <p>
            Welcome to the secure St. Martin's
            High School teacher portal.
        </p>

    </section>


    <section class="grid">

        <div class="card">

            <h3>
                📚 Academic Resources
            </h3>

            <p>
                Access teaching resources,
                academic information and
                school materials.
            </p>

        </div>


        <div class="card">

            <h3>
                🗓 School Calendar
            </h3>

            <p>
                Review school events,
                academic schedules and
                important dates.
            </p>

        </div>


        <div class="card">

            <h3>
                👤 Faculty Profile
            </h3>

            <p>
                View your registered teacher
                account information.
            </p>

        </div>

    </section>


    <section class="profile">

        <h2>
            Teacher Account
        </h2>

        <div class="profile-row">

            <span class="label">
                Full Name
            </span>

            <span class="value">
                <%= teacher.full_name %>
            </span>

        </div>

        <div class="profile-row">

            <span class="label">
                Employee ID
            </span>

            <span class="value">
                <%= teacher.employee_id %>
            </span>

        </div>

        <div class="profile-row">

            <span class="label">
                Username
            </span>

            <span class="value">
                <%= teacher.username %>
            </span>

        </div>

        <div class="profile-row">

            <span class="label">
                Email
            </span>

            <span class="value">
                <%= teacher.email %>
            </span>

        </div>

        <div class="profile-row">

            <span class="label">
                Role
            </span>

            <span class="value">
                Teacher
            </span>

        </div>

    </section>

</main>

</body>
</html>