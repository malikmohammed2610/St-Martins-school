<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta
        name="description"
        content="View the academic calendar, school events and important dates at St. Martin's High School, Balanagar, Hyderabad."
    >

    <meta name="theme-color" content="#071a2b">

    <title>Academic Calendar | St. Martin's High School</title>

    <link rel="icon" type="image/png" href="/images/logo.png">
    <link rel="stylesheet" href="/css/style.css">

    <style>
        .calendar-page {
            background: #f8f7f3;
            color: #263448;
            min-height: 70vh;
        }

        .calendar-page * {
            box-sizing: border-box;
        }

        .calendar-hero {
            background: linear-gradient(120deg, #071a2b, #123d55);
            color: #fff;
            text-align: center;
            padding: 82px 22px;
        }

        .calendar-hero span {
            color: #e0c67b;
            font-size: 12px;
            letter-spacing: 4px;
            text-transform: uppercase;
            font-weight: 700;
        }

        .calendar-hero h1 {
            font-size: clamp(36px, 5vw, 60px);
            margin: 16px 0;
            line-height: 1.15;
        }

        .calendar-hero p {
            max-width: 720px;
            margin: auto;
            color: #e0e7ed;
            line-height: 1.8;
        }

        .calendar-container {
            width: min(1150px, 94%);
            margin: auto;
            padding: 50px 0;
        }

        .calendar-heading {
            font-size: clamp(25px, 3vw, 36px);
            color: #102b42;
            margin: 0 0 12px;
        }

        .calendar-intro {
            color: #657181;
            line-height: 1.8;
            margin-bottom: 28px;
        }

        .calendar-panel {
            background: #fff;
            border: 1px solid #e7e3da;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 45px;
            box-shadow: 0 8px 28px rgba(7, 26, 43, 0.04);
        }

        .calendar-controls {
            display: grid;
            grid-template-columns: auto 1fr auto;
            align-items: center;
            gap: 12px;
            margin-bottom: 22px;
        }

        .calendar-controls h2 {
            margin: 0;
            color: #102b42;
            font-size: 23px;
            text-align: center;
        }

        .calendar-controls button {
            border: 0;
            background: #102b42;
            color: #fff;
            border-radius: 5px;
            padding: 11px 15px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: background 0.2s ease;
        }

        .calendar-controls button:hover {
            background: #244a63;
        }

        .calendar-controls button:focus-visible,
        .calendar-link:focus-visible {
            outline: 3px solid #c5a45a;
            outline-offset: 3px;
        }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
            gap: 7px;
        }

        .calendar-weekday {
            text-align: center;
            padding: 10px 2px;
            color: #735c24;
            font-weight: 700;
            font-size: 13px;
        }

        .calendar-day {
            min-width: 0;
            min-height: 86px;
            border: 1px solid #eee9df;
            border-radius: 7px;
            padding: 9px;
            background: #fcfbf8;
            color: #263448;
            overflow-wrap: anywhere;
        }

        .calendar-day.is-empty {
            background: transparent;
            border-color: transparent;
        }

        .calendar-day.today {
            border: 2px solid #c5a45a;
        }

        .calendar-day.has-event {
            background: #f5edd9;
        }

        .calendar-day-number {
            font-weight: 700;
        }

        .calendar-event-dot {
            display: block;
            margin-top: 8px;
            font-size: 11px;
            line-height: 1.35;
            color: #735c24;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .calendar-events {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 20px;
        }

        .calendar-event-card {
            background: #fff;
            border: 1px solid #e8e3d8;
            border-radius: 10px;
            padding: 23px;
            box-shadow: 0 6px 22px rgba(7, 26, 43, 0.035);
        }

        .calendar-event-card h3 {
            color: #102b42;
            margin: 12px 0;
            font-size: 21px;
            overflow-wrap: anywhere;
        }

        .calendar-event-card p {
            color: #66717e;
            line-height: 1.7;
            white-space: pre-line;
            overflow-wrap: anywhere;
        }

        .calendar-tag {
            display: inline-block;
            padding: 6px 10px;
            background: #f3ead4;
            color: #735c24;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 700;
        }

        .calendar-date {
            color: #8a7440;
            font-weight: 700;
            font-size: 14px;
        }

        .calendar-empty {
            padding: 25px;
            border: 1px dashed #d7d2c7;
            border-radius: 10px;
            background: #fff;
            color: #66717e;
            line-height: 1.8;
        }

        .calendar-links {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 45px;
        }

        .calendar-link {
            display: inline-block;
            padding: 12px 20px;
            background: #c5a45a;
            color: #071a2b;
            text-decoration: none;
            border-radius: 5px;
            font-weight: 700;
            transition: background 0.2s ease;
        }

        .calendar-link:hover {
            background: #e0c67b;
        }

        @media (max-width: 650px) {
            .calendar-hero {
                padding: 60px 18px;
            }

            .calendar-container {
                padding: 35px 0;
            }

            .calendar-panel {
                padding: 12px;
            }

            .calendar-grid {
                gap: 3px;
            }

            .calendar-day {
                min-height: 59px;
                padding: 5px 3px;
                font-size: 12px;
            }

            .calendar-weekday {
                font-size: 10px;
                padding: 8px 0;
            }

            .calendar-event-dot {
                font-size: 9px;
                margin-top: 5px;
            }

            .calendar-controls {
                grid-template-columns: auto 1fr auto;
                gap: 5px;
            }

            .calendar-controls h2 {
                font-size: 15px;
            }

            .calendar-controls button {
                padding: 9px 7px;
                font-size: 11px;
            }

            .calendar-events {
                grid-template-columns: 1fr;
            }

            .calendar-event-card {
                padding: 18px;
            }

            .calendar-links {
                flex-direction: column;
            }

            .calendar-link {
                text-align: center;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .calendar-controls button,
            .calendar-link {
                transition: none;
            }
        }
    </style>
</head>

<body>

    <!-- Shared website header -->
    <%- include('partials/header') %>

    <%
        const pageEvents =
            typeof events !== 'undefined' && Array.isArray(events)
                ? events
                : [];
    %>

    <main class="calendar-page">

        <section class="calendar-hero">
            <span>Plan Ahead</span>
            <h1>Academic Calendar</h1>
            <p>
                Keep track of published school events, important dates and
                activities at St. Martin's High School, Balanagar, Hyderabad.
            </p>
        </section>

        <div class="calendar-container">

            <!-- Monthly calendar -->
            <section aria-labelledby="monthlyHeading">
                <h2 class="calendar-heading" id="monthlyHeading">
                    Monthly View
                </h2>

                <p class="calendar-intro">
                    Use the arrows to browse months. Dates with published
                    school events are highlighted in the calendar.
                </p>

                <div class="calendar-panel">

                    <div class="calendar-controls">
                        <button
                            type="button"
                            id="previousMonth"
                            aria-label="Previous month"
                        >
                            &#8592; Previous
                        </button>

                        <h2 id="monthHeading" aria-live="polite">
                            Academic Calendar
                        </h2>

                        <button
                            type="button"
                            id="nextMonth"
                            aria-label="Next month"
                        >
                            Next &#8594;
                        </button>
                    </div>

                    <div
                        class="calendar-grid"
                        id="calendarGrid"
                        role="grid"
                        aria-label="Monthly academic calendar"
                    >
                        <div
                            class="calendar-empty"
                            style="grid-column: 1 / -1"
                        >
                            Loading calendar...
                        </div>
                    </div>

                </div>
            </section>

            <!-- Published events -->
            <section aria-labelledby="publishedEventsHeading">

                <h2
                    class="calendar-heading"
                    id="publishedEventsHeading"
                >
                    Published School Events
                </h2>

                <p class="calendar-intro">
                    Event information is displayed here after it has been
                    approved for publication.
                </p>

                <% if (pageEvents.length > 0) { %>

                    <div class="calendar-events">

                        <% pageEvents.forEach(function(event) { %>

                            <article class="calendar-event-card">

                                <span class="calendar-tag">
                                    <%= event.category || 'School Event' %>
                                </span>

                                <h3>
                                    <%= event.title || 'School Event' %>
                                </h3>

                                <div class="calendar-date">
                                    <%= event.event_date || event.date || 'Date to be announced' %>
                                </div>

                                <% if (event.description) { %>
                                    <p><%= event.description %></p>
                                <% } %>

                                <% if (event.start_time) { %>
                                    <p>
                                        <strong>Time:</strong>
                                        <%= event.start_time %><%= event.end_time ? ' – ' + event.end_time : '' %>
                                    </p>
                                <% } %>

                                <% if (event.location) { %>
                                    <p>
                                        <strong>Venue:</strong>
                                        <%= event.location %>
                                    </p>
                                <% } %>

                            </article>

                        <% }); %>

                    </div>

                <% } else { %>

                    <div class="calendar-empty">
                        <strong>No published events yet.</strong>
                        <br>
                        Upcoming school events will appear here after
                        approval. Please revisit this page for updates.
                    </div>

                <% } %>

            </section>

            <!-- Related pages -->
            <section class="calendar-links" aria-label="Related pages">

                <a href="/news" class="calendar-link">
                    Read School News
                </a>

                <a href="/student-life" class="calendar-link">
                    Explore Student Life
                </a>

            </section>

        </div>
    </main>

    <script>
        (function () {
            "use strict";

            // Safely pass the EJS event data to browser JavaScript.
            const events =  JSON.stringify(pageEvents)
                .replace(/</g, '\\u003c')
                .replace(/>/g, '\\u003e')
                .replace(/&/g, '\\u0026') 

            const grid = document.getElementById("calendarGrid");
            const heading = document.getElementById("monthHeading");
            const previous = document.getElementById("previousMonth");
            const next = document.getElementById("nextMonth");

            if (!grid || !heading || !previous || !next) {
                return;
            }

            const now = new Date();

            let displayedYear = now.getFullYear();
            let displayedMonth = now.getMonth();

            const weekdays = [
                "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"
            ];

            /*
             * Supports database dates such as:
             * 2026-10-14
             * 2026-10-14T00:00:00.000Z
             */
            function getEventDate(event) {
                const rawValue = event.event_date || event.date || "";

                if (typeof rawValue !== "string" &&
                    typeof rawValue !== "number") {
                    return null;
                }

                const value = String(rawValue).trim();
                const datePart = value.slice(0, 10);

                if (!/^\d{4}-\d{2}-\d{2}$/.test(datePart)) {
                    return null;
                }

                const parts = datePart.split("-").map(Number);

                const date = new Date(
                    parts[0],
                    parts[1] - 1,
                    parts[2]
                );

                // Reject invalid dates, such as February 31.
                if (
                    date.getFullYear() !== parts[0] ||
                    date.getMonth() !== parts[1] - 1 ||
                    date.getDate() !== parts[2]
                ) {
                    return null;
                }

                return date;
            }

            function renderCalendar() {
                grid.replaceChildren();

                const currentMonthDate = new Date(
                    displayedYear,
                    displayedMonth,
                    1
                );

                heading.textContent =
                    currentMonthDate.toLocaleDateString("en-IN", {
                        month: "long",
                        year: "numeric"
                    });

                // Weekday headings.
                weekdays.forEach(function (day) {
                    const label = document.createElement("div");

                    label.className = "calendar-weekday";
                    label.textContent = day;
                    label.setAttribute("role", "columnheader");

                    grid.appendChild(label);
                });

                const firstDay = new Date(
                    displayedYear,
                    displayedMonth,
                    1
                ).getDay();

                const daysInMonth = new Date(
                    displayedYear,
                    displayedMonth + 1,
                    0
                ).getDate();

                // Empty cells before the first day of the month.
                for (let i = 0; i < firstDay; i++) {
                    const empty = document.createElement("div");

                    empty.className = "calendar-day is-empty";
                    empty.setAttribute("aria-hidden", "true");

                    grid.appendChild(empty);
                }

                // Calendar date cells.
                for (let day = 1; day <= daysInMonth; day++) {
                    const cell = document.createElement("div");

                    cell.className = "calendar-day";
                    cell.setAttribute("role", "gridcell");

                    const isToday =
                        day === now.getDate() &&
                        displayedMonth === now.getMonth() &&
                        displayedYear === now.getFullYear();

                    if (isToday) {
                        cell.classList.add("today");
                        cell.setAttribute("aria-current", "date");
                    }

                    const number = document.createElement("div");

                    number.className = "calendar-day-number";
                    number.textContent = day;

                    cell.appendChild(number);

                    const matchingEvents = events.filter(
                        function (event) {
                            const date = getEventDate(event);

                            return date !== null &&
                                date.getFullYear() === displayedYear &&
                                date.getMonth() === displayedMonth &&
                                date.getDate() === day;
                        }
                    );

                    if (matchingEvents.length > 0) {
                        cell.classList.add("has-event");

                        // Display up to two event titles in each date cell.
                        matchingEvents.slice(0, 2).forEach(
                            function (event) {
                                const label =
                                    document.createElement("span");

                                label.className = "calendar-event-dot";
                                label.textContent =
                                    event.title || "School Event";

                                cell.appendChild(label);
                            }
                        );

                        // Indicate any additional events.
                        if (matchingEvents.length > 2) {
                            const more =
                                document.createElement("span");

                            more.className = "calendar-event-dot";
                            more.textContent =
                                "+" + (matchingEvents.length - 2) + " more";

                            cell.appendChild(more);
                        }

                        cell.title = matchingEvents
                            .map(function (event) {
                                return event.title || "School Event";
                            })
                            .join(", ");

                        cell.setAttribute(
                            "aria-label",
                            day + ": " +
                            matchingEvents.map(function (event) {
                                return event.title || "School Event";
                            }).join(", ")
                        );
                    } else {
                        cell.setAttribute(
                            "aria-label",
                            String(day)
                        );
                    }

                    grid.appendChild(cell);
                }
            }

            previous.addEventListener("click", function () {
                displayedMonth--;

                if (displayedMonth < 0) {
                    displayedMonth = 11;
                    displayedYear--;
                }

                renderCalendar();
            });

            next.addEventListener("click", function () {
                displayedMonth++;

                if (displayedMonth > 11) {
                    displayedMonth = 0;
                    displayedYear++;
                }

                renderCalendar();
            });

            renderCalendar();
        })();
    </script>

    <!-- Shared website footer -->
    <%- include('partials/footer') %>

</body>
</html>
