        <!-- Facilities Grid -->

        <div class="row g-4 mt-4">
            <!-- Facility 1: Smart Classrooms -->
            <div class="col-md-6">
                <div class="luxury-card h-100 bg-white p-4 border-top border-warning" style="border-top: 3px solid #C5A45A !important;">
                    <div class="mb-3 overflow-hidden" style="height: 220px; background-color: #e9ecef;">
                        <img src="/images/facility-classrooms.jpg" alt="Smart Classrooms" class="w-100 h-100 object-fit-cover">
                    </div>
                    <h3 style="font-size: 1.5rem; font-family: 'Cormorant Garamond', serif; color: #071A2B;">Smart Classrooms</h3>
                    <p style="font-weight: 300; color: #20252A; font-size: 0.95rem; line-height: 1.7;">Our classrooms are designed to create a focused and engaging learning environment. Spacious layouts, digital learning support, comfortable seating, clear visibility, and thoughtfully planned teaching spaces help students participate actively and learn with confidence.</p>
                    <div class="mt-3 pt-3 border-top">
                        <small class="text-uppercase" style="letter-spacing: 0.12em; color: #C5A45A; font-weight: 600;">Learning Environment</small>
                        <p class="mb-0 mt-1" style="font-size: 0.88rem; color: #6c757d;">Interactive teaching • Comfortable spaces • Technology-enabled learning</p>
                    </div>
                </div>
            </div>

            <!-- Facility 2: Science Laboratories -->
            <div class="col-md-6">
                <div class="luxury-card h-100 bg-white p-4 border-top border-warning" style="border-top: 3px solid #C5A45A !important;">
                    <div class="mb-3 overflow-hidden" style="height: 220px; background-color: #e9ecef;">
                        <img src="/images/facility-science.jpg" alt="Science Laboratories" class="w-100 h-100 object-fit-cover">
                    </div>
                    <h3 style="font-size: 1.5rem; font-family: 'Cormorant Garamond', serif; color: #071A2B;">Advanced Science Labs</h3>
                    <p style="font-weight: 300; color: #20252A; font-size: 0.95rem; line-height: 1.7;">The science laboratories encourage students to move beyond textbooks and explore concepts through observation and practical work. Dedicated learning spaces support experiments, demonstrations, scientific inquiry, and a deeper understanding of Physics, Chemistry, and Biology.</p>
                    <div class="mt-3 pt-3 border-top">
                        <small class="text-uppercase" style="letter-spacing: 0.12em; color: #C5A45A; font-weight: 600;">Practical Learning</small>
                        <p class="mb-0 mt-1" style="font-size: 0.88rem; color: #6c757d;">Experimentation • Scientific thinking • Practical exploration</p>
                    </div>
                </div>
            </div>

            <!-- Facility 3: Computer & IT Lab -->
            <div class="col-md-6">
                <div class="luxury-card h-100 bg-white p-4 border-top border-warning" style="border-top: 3px solid #C5A45A !important;">
                    <div class="mb-3 overflow-hidden" style="height: 220px; background-color: #e9ecef;">
                        <img src="/images/facility-computer.jpg" alt="Computer Lab" class="w-100 h-100 object-fit-cover">
                    </div>
                    <h3 style="font-size: 1.5rem; font-family: 'Cormorant Garamond', serif; color: #071A2B;">Computer & IT Center</h3>
                    <p style="font-weight: 300; color: #20252A; font-size: 0.95rem; line-height: 1.7;">Our computer and IT learning spaces help students develop essential digital skills in a structured environment. Students are introduced to responsible technology use, digital literacy, problem-solving, and computer-based learning activities appropriate to their academic level.</p>
                    <div class="mt-3 pt-3 border-top">
                        <small class="text-uppercase" style="letter-spacing: 0.12em; color: #C5A45A; font-weight: 600;">Digital Learning</small>
                        <p class="mb-0 mt-1" style="font-size: 0.88rem; color: #6c757d;">Digital literacy • Computer skills • Technology awareness</p>
                    </div>
                </div>
            </div>

            <!-- Facility 4: Library & Reading Room -->
            <div class="col-md-6">
                <div class="luxury-card h-100 bg-white p-4 border-top border-warning" style="border-top: 3px solid #C5A45A !important;">
                    <div class="mb-3 overflow-hidden" style="height: 220px; background-color: #e9ecef;">
                        <img src="/images/facility-library.jpg" alt="Library" class="w-100 h-100 object-fit-cover">
                    </div>
                    <h3 style="font-size: 1.5rem; font-family: 'Cormorant Garamond', serif; color: #071A2B;">Library & Reading Hall</h3>
                    <p style="font-weight: 300; color: #20252A; font-size: 0.95rem; line-height: 1.7;">The library provides students with a calm space for reading, reference work, independent study, and exploration beyond the classroom. A well-organised collection can support academic preparation while encouraging curiosity, concentration, and a lasting appreciation for books.</p>
                    <div class="mt-3 pt-3 border-top">
                        <small class="text-uppercase" style="letter-spacing: 0.12em; color: #C5A45A; font-weight: 600;">Reading & Research</small>
                        <p class="mb-0 mt-1" style="font-size: 0.88rem; color: #6c757d;">Independent study • Reading culture • Academic reference</p>
                    </div>
                </div>
            </div>
