<%- include('partials/header') %>

<main class="facilities-page">

    <!-- HERO -->
    <section class="facilities-hero">
        <img
            class="facilities-hero-image"
            src="https://stmartinshighschool.in/images/chemicallab.jpg"
            alt="School laboratory"
            onerror="this.onerror=null;this.src='https://stmartinshighschool.in/images/library.jpg';"
        >

        <div class="facilities-hero-overlay"></div>

        <div class="facilities-container facilities-hero-content">
            <span class="section-kicker">THE ST. MARTIN'S EXPERIENCE</span>

            <h1>Facilities That Inspire<br><span>Excellence</span></h1>

            <p>
                An environment where curiosity is encouraged,
                potential is nurtured, and every student is
                empowered to learn, discover, and grow.
            </p>

            <a href="#explore-facilities" class="facilities-button">
                Explore Our Facilities
                <i class="fas fa-arrow-down"></i>
            </a>
        </div>
    </section>


    <!-- INTRODUCTION -->
    <section class="facilities-intro">
        <div class="facilities-container intro-grid">

            <div class="intro-image-wrap reveal">
                <img
                    src="https://stmartinshighschool.in/images/library.jpg"
                    alt="School library"
                    loading="lazy"
                    onerror="this.onerror=null;this.src='https://stmartinshighschool.in/public/assets/images/library.png';"
                >
                <div class="intro-image-label">
                    <i class="fas fa-book-open"></i>
                    <div>
                        <strong>A Space to Grow</strong>
                        <span>Knowledge. Confidence. Character.</span>
                    </div>
                </div>
            </div>

            <div class="intro-content reveal">
                <span class="section-kicker">BEYOND THE CLASSROOM</span>
                <h2>A Campus Designed<br>for <span>Possibility.</span></h2>
                <div class="gold-divider"></div>

                <p>
                    At St. Martin's High School, learning extends
                    beyond textbooks. Our learning spaces and
                    student facilities support academic development,
                    creativity, physical wellbeing, and personal growth.
                </p>

                <p>
                    From practical learning environments to sports
                    and creative activities, we encourage students
                    to explore their interests, develop valuable skills,
                    and discover their strengths.
                </p>

                <a href="/contact" class="text-link">
                    Discover St. Martin's
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>

        </div>
    </section>


    <!-- FACILITIES -->
    <section id="explore-facilities" class="facilities-showcase">
        <div class="facilities-container">

            <div class="section-heading reveal">
                <span class="section-kicker">OUR LEARNING ENVIRONMENT</span>
                <h2>Everything Students Need<br>to <span>Thrive</span></h2>
                <p>
                    Explore the spaces and experiences that support
                    learning, discovery, teamwork, and all-round development.
                </p>
            </div>

            <div class="facilities-grid">

                <!-- COMPUTER LAB -->
                <article class="facility-card reveal">
                    <div class="facility-image">
                        <img
                            src="https://stmartinshighschool.in/images/computerlab.jpg"
                            alt="Computer laboratory"
                            loading="lazy"
                            onerror="this.onerror=null;this.src='https://stmartinshighschool.in/images/chemicallab.jpg';"
                        >
                        <span class="facility-number">01</span>
                    </div>
                    <div class="facility-card-content">
                        <span class="facility-category">DIGITAL LEARNING</span>
                        <h3>Computer Education</h3>
                        <p>
                            Students develop digital awareness,
                            computing skills, and familiarity with
                            technology through computer-based learning.
                        </p>
                        <div class="facility-card-bottom">
                            <span><i class="fas fa-desktop"></i> Technology</span>
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </div>
                </article>

                <!-- SCIENCE LAB -->
                <article class="facility-card reveal">
                    <div class="facility-image">
                        <img
                            src="https://stmartinshighschool.in/images/chemicallab.jpg"
                            alt="Chemistry laboratory"
                            loading="lazy"
                            onerror="this.onerror=null;this.src='https://stmartinshighschool.in/images/library.jpg';"
                        >
                        <span class="facility-number">02</span>
                    </div>
                    <div class="facility-card-content">
                        <span class="facility-category">PRACTICAL LEARNING</span>
                        <h3>Science Laboratories</h3>
                        <p>
                            Practical learning helps students explore
                            scientific concepts, ask questions, and
                            develop analytical thinking.
                        </p>
                        <div class="facility-card-bottom">
                            <span><i class="fas fa-flask"></i> Discovery</span>
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </div>
                </article>

                <!-- LIBRARY -->
                <article class="facility-card reveal">
                    <div class="facility-image">
                        <img
                            src="https://stmartinshighschool.in/images/library.jpg"
                            alt="School library"
                            loading="lazy"
                            onerror="this.onerror=null;this.src='https://stmartinshighschool.in/public/assets/images/library.png';"
                        >
                        <span class="facility-number">03</span>
                    </div>
                    <div class="facility-card-content">
                        <span class="facility-category">KNOWLEDGE & READING</span>
                        <h3>Library</h3>
                        <p>
                            A reading environment that encourages
                            curiosity, independent study, language
                            development, and lifelong learning.
                        </p>
                        <div class="facility-card-bottom">
                            <span><i class="fas fa-book-open"></i> Knowledge</span>
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </div>
                </article>

                <!-- VOLLEYBALL -->
                <article class="facility-card reveal">
                    <div class="facility-image">
                        <img
                            src="https://stmartinshighschool.in/images/vallyball.jpg"
                            alt="Volleyball activities"
                            loading="lazy"
                            onerror="this.onerror=null;this.src='https://stmartinshighschool.in/images/basketball.jpg';"
                        >
                        <span class="facility-number">04</span>
                    </div>
                    <div class="facility-card-content">
                        <span class="facility-category">SPORTS & FITNESS</span>
                        <h3>Sports & Teamwork</h3>
                        <p>
                            Sporting activities help students build
                            discipline, teamwork, perseverance,
                            coordination, and sportsmanship.
                        </p>
                        <div class="facility-card-bottom">
                            <span><i class="fas fa-volleyball-ball"></i> Team Spirit</span>
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </div>
                </article>

                <!-- BASKETBALL -->
                <article class="facility-card reveal">
                    <div class="facility-image">
                        <img
                            src="https://stmartinshighschool.in/images/basketball.jpg"
                            alt="Basketball activities"
                            loading="lazy"
                            onerror="this.onerror=null;this.src='https://stmartinshighschool.in/images/vallyball.jpg';"
                        >
                        <span class="facility-number">05</span>
                    </div>
                    <div class="facility-card-content">
                        <span class="facility-category">ACTIVE LIFESTYLE</span>
                        <h3>Physical Development</h3>
                        <p>
                            Physical activities give students
                            opportunities to practise coordination,
                            resilience, cooperation, and fitness.
                        </p>
                        <div class="facility-card-bottom">
                            <span><i class="fas fa-running"></i> Wellbeing</span>
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </div>
                </article>

                <!-- TRANSPORT -->
                <article class="facility-card reveal">
                    <div class="facility-image">
                        <img
                            src="https://stmartinshighschool.in/public/assets/images/transport.png"
                            alt="School transport facilities"
                            loading="lazy"
                            onerror="this.onerror=null;this.src='https://stmartinshighschool.in/images/library.jpg';"
                        >
                        <span class="facility-number">06</span>
                    </div>
                    <div class="facility-card-content">
                        <span class="facility-category">STUDENT CONVENIENCE</span>
                        <h3>Transport Facilities</h3>
                        <p>
                            School transport arrangements help
                            families plan students' daily journeys
                            between home and school.
                        </p>
                        <div class="facility-card-bottom">
                            <span><i class="fas fa-bus"></i> Connectivity</span>
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </div>
                </article>

                <!-- CLASSICAL DANCE -->
                <article class="facility-card reveal">
                    <div class="facility-image">
                        <img
                            src="https://stmartinshighschool.in/images/classicaldance.jpg"
                            alt="Classical dance activities"
                            loading="lazy"
                            onerror="this.onerror=null;this.src='https://stmartinshighschool.in/images/dance.jpg';"
                        >
                        <span class="facility-number">07</span>
                    </div>
                    <div class="facility-card-content">
                        <span class="facility-category">ARTS & CULTURE</span>
                        <h3>Creative Expression</h3>
                        <p>
                            Cultural and creative activities encourage
                            self-expression, confidence, and appreciation
                            of the arts.
                        </p>
                        <div class="facility-card-bottom">
                            <span><i class="fas fa-music"></i> Creativity</span>
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </div>
                </article>

                <!-- SKATING -->
                <article class="facility-card reveal">
                    <div class="facility-image">
                        <img
                            src="https://stmartinshighschool.in/images/skating.png"
                            alt="Skating activities"
                            loading="lazy"
                            onerror="this.onerror=null;this.src='https://stmartinshighschool.in/images/basketball.jpg';"
                        >
                        <span class="facility-number">08</span>
                    </div>
                    <div class="facility-card-content">
                        <span class="facility-category">SKILL DEVELOPMENT</span>
                        <h3>Recreation & Activities</h3>
                        <p>
                            Recreational activities help students
                            practise balance, coordination, persistence,
                            and confidence while staying active.
                        </p>
                        <div class="facility-card-bottom">
                            <span><i class="fas fa-star"></i> Growth</span>
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </div>
                </article>

            </div>
        </div>
    </section>


    <!-- OUR PHILOSOPHY -->
    <section class="facilities-philosophy">
        <div class="facilities-container philosophy-grid">

            <div class="philosophy-content reveal">
                <span class="section-kicker">OUR PHILOSOPHY</span>
                <h2>Education Is More<br>Than <span>Academics.</span></h2>
                <div class="gold-divider"></div>

                <p>
                    A meaningful school experience combines knowledge
                    with character, physical development, creativity,
                    and the confidence to face new challenges.
                </p>

                <p>
                    We believe students deserve opportunities to explore,
                    participate, collaborate, and grow into responsible
                    and capable individuals.
                </p>

                <a href="/academics" class="facilities-button">
                    Explore Our Curriculum
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>

            <div class="philosophy-features reveal">

                <div class="philosophy-feature">
                    <span class="philosophy-icon">
                        <i class="fas fa-lightbulb"></i>
                    </span>
                    <div>
                        <h3>Curiosity</h3>
                        <p>Encouraging questions, exploration, and discovery.</p>
                    </div>
                </div>

                <div class="philosophy-feature">
                    <span class="philosophy-icon">
                        <i class="fas fa-award"></i>
                    </span>
                    <div>
                        <h3>Character</h3>
                        <p>Developing responsibility, respect, and integrity.</p>
                    </div>
                </div>

                <div class="philosophy-feature">
                    <span class="philosophy-icon">
                        <i class="fas fa-users"></i>
                    </span>
                    <div>
                        <h3>Collaboration</h3>
                        <p>Building communication and teamwork skills.</p>
                    </div>
                </div>

                <div class="philosophy-feature">
                    <span class="philosophy-icon">
                        <i class="fas fa-seedling"></i>
                    </span>
                    <div>
                        <h3>Growth</h3>
                        <p>Supporting students as they discover their potential.</p>
                    </div>
                </div>

            </div>
        </div>
    </section>


    <!-- CALL TO ACTION -->
    <section class="facilities-cta">
        <div class="facilities-container">
            <div class="cta-panel reveal">

                <span class="section-kicker">YOUR JOURNEY STARTS HERE</span>
                <h2>Discover the St. Martin's<br><span>Difference.</span></h2>

                <p>
                    Learn more about our school, explore the learning
                    environment, and connect with our team.
                </p>

                <div class="cta-buttons">
                    <a href="/admissions" class="facilities-button">
                        Explore Admissions
                        <i class="fas fa-arrow-right"></i>
                    </a>

                    <a href="/contact" class="facilities-outline-button">
                        Contact the School
                    </a>
                </div>

                <div class="cta-watermark">
                    <i class="fas fa-graduation-cap"></i>
                </div>
            </div>
        </div>
    </section>

</main>


<style>
/* =========================================
   FACILITIES PAGE — SCOPED STYLES
========================================= */

.facilities-page {
    --fac-navy: #071a2b;
    --fac-navy-light: #102d45;
    --fac-gold: #c5a45a;
    --fac-gold-light: #e0c67b;
    --fac-ivory: #f6f1e7;
    --fac-text: #52606c;

    width: 100%;
    max-width: 100%;
    overflow: clip;
    color: var(--fac-navy);
    background: #fff;
    font-family: "Inter", sans-serif;
}

.facilities-page *,
.facilities-page *::before,
.facilities-page *::after {
    box-sizing: border-box;
}

.facilities-page img {
    max-width: 100%;
}

.facilities-container {
    width: min(1160px, calc(100% - 48px));
    margin-right: auto;
    margin-left: auto;
}

.facilities-page h1,
.facilities-page h2,
.facilities-page h3 {
    font-family: "Cormorant Garamond", Georgia, serif;
}

.facilities-page h2 {
    margin: 15px 0 20px;
    font-size: clamp(36px, 4vw, 54px);
    font-weight: 700;
    line-height: 1.08;
}

.facilities-page h2 span {
    color: var(--fac-gold);
}

.facilities-page p {
    color: var(--fac-text);
    font-size: 14px;
    line-height: 1.85;
}

.section-kicker {
    display: inline-block;
    color: var(--fac-gold);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2.5px;
    line-height: 1.8;
}

.gold-divider {
    width: 58px;
    height: 3px;
    margin: 24px 0;
    background: var(--fac-gold);
}

/* HERO */

.facilities-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: 570px;
    overflow: hidden;
    background: var(--fac-navy);
}

.facilities-hero-image,
.facilities-hero-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
}

.facilities-hero-image {
    z-index: -2;
    object-fit: cover;
    object-position: center 45%;
    animation: facHeroZoom 15s ease-in-out infinite alternate;
}

.facilities-hero-overlay {
    z-index: -1;
    background: linear-gradient(
        90deg,
        rgba(4, 17, 29, .94) 0%,
        rgba(4, 17, 29, .78) 52%,
        rgba(4, 17, 29, .30) 100%
    );
}

.facilities-hero-content {
    padding-top: 90px;
    padding-bottom: 90px;
    color: #fff;
}

.facilities-hero-content h1 {
    margin: 20px 0;
    font-size: clamp(45px, 6.5vw, 78px);
    font-weight: 700;
    line-height: .99;
    letter-spacing: -1px;
}

.facilities-hero-content h1 span {
    color: var(--fac-gold-light);
}

.facilities-hero-content p {
    max-width: 550px;
    margin-bottom: 28px;
    color: rgba(255, 255, 255, .82);
}

.facilities-button,
.facilities-outline-button {
    min-height: 48px;
    padding: 0 21px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    font-family: "Inter", sans-serif;
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
    transition: background .25s ease, color .25s ease, transform .25s ease;
}

.facilities-button {
    color: var(--fac-navy);
    background: var(--fac-gold-light);
    border: 1px solid var(--fac-gold-light);
}

.facilities-button:hover {
    color: var(--fac-navy);
    background: #fff;
    border-color: #fff;
    transform: translateY(-2px);
}

.facilities-outline-button {
    color: #fff;
    border: 1px solid rgba(255, 255, 255, .5);
}

.facilities-outline-button:hover {
    color: var(--fac-navy);
    background: #fff;
}

/* INTRODUCTION */

.facilities-intro {
    padding: 85px 0;
    background: #fff;
}

.intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(35px, 6vw, 75px);
}

.intro-image-wrap {
    position: relative;
    min-width: 0;
    padding: 15px 0 24px 15px;
}

.intro-image-wrap::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 58%;
    height: 60%;
    content: "";
    border-top: 2px solid var(--fac-gold);
    border-left: 2px solid var(--fac-gold);
}

.intro-image-wrap > img {
    position: relative;
    display: block;
    width: 100%;
    height: clamp(280px, 36vw, 410px);
    object-fit: cover;
    object-position: center;
    background: var(--fac-ivory);
    box-shadow: 0 16px 40px rgba(7, 26, 43, .12);
}

.intro-image-label {
    position: absolute;
    right: -8px;
    bottom: 0;
    max-width: calc(100% - 25px);
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 16px 19px;
    color: #fff;
    background: var(--fac-navy);
    box-shadow: 0 10px 28px rgba(7, 26, 43, .16);
}

.intro-image-label > i {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 39px;
    height: 39px;
    color: var(--fac-navy);
    background: var(--fac-gold-light);
}

.intro-image-label strong,
.intro-image-label span {
    display: block;
}

.intro-image-label strong {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 19px;
}

.intro-image-label span {
    margin-top: 3px;
    color: rgba(255, 255, 255, .72);
    font-size: 10px;
    line-height: 1.5;
}

.intro-content {
    min-width: 0;
}

.text-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
    color: var(--fac-navy);
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
}

.text-link i {
    color: var(--fac-gold);
    transition: transform .25s ease;
}

.text-link:hover i {
    transform: translateX(5px);
}

/* FACILITY GRID */

.facilities-showcase {
    padding: 85px 0;
    background: var(--fac-ivory);
}

.section-heading {
    max-width: 700px;
    margin: 0 auto 45px;
    text-align: center;
}

.section-heading p {
    max-width: 590px;
    margin: 0 auto;
}

.facilities-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
}

.facility-card {
    min-width: 0;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(7, 26, 43, .06);
    box-shadow: 0 7px 22px rgba(7, 26, 43, .045);
    transition: transform .3s ease, box-shadow .3s ease;
}

.facility-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 17px 38px rgba(7, 26, 43, .12);
}

/* FIXED IMAGE SIZE:
   All cards have identical image height.
   object-fit: cover keeps images proportional. */

.facility-image {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    background: #dfe4e7;
}

.facility-image img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    transition: transform .55s ease;
}

.facility-card:hover .facility-image img {
    transform: scale(1.045);
}

.facility-number {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 1;
    min-width: 35px;
    height: 35px;
    padding: 0 7px;
    display: grid;
    place-items: center;
    color: var(--fac-navy);
    background: var(--fac-gold-light);
    font-size: 10px;
    font-weight: 900;
}

.facility-card-content {
    padding: 22px 22px 18px;
}

.facility-category {
    display: block;
    margin-bottom: 8px;
    color: #987a38;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.4px;
    line-height: 1.6;
}

.facility-card-content h3 {
    margin: 0 0 11px;
    font-size: 26px;
    font-weight: 700;
    line-height: 1.12;
}

.facility-card-content p {
    min-height: 84px;
    margin: 0 0 17px;
    font-size: 12px;
    line-height: 1.8;
}

.facility-card-bottom {
    min-height: 35px;
    padding-top: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border-top: 1px solid rgba(7, 26, 43, .1);
    color: #68737d;
    font-size: 10px;
}

.facility-card-bottom span {
    display: flex;
    align-items: center;
    gap: 8px;
}

.facility-card-bottom span i,
.facility-card-bottom > i {
    color: #a48745;
}

/* PHILOSOPHY */

.facilities-philosophy {
    padding: 85px 0;
    color: #fff;
    background:
        radial-gradient(circle at 90% 10%, rgba(197, 164, 90, .09), transparent 32%),
        var(--fac-navy);
}

.philosophy-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, .9fr);
    align-items: center;
    gap: clamp(40px, 7vw, 85px);
}

.philosophy-content h2 {
    color: #fff;
}

.philosophy-content p {
    color: rgba(255, 255, 255, .74);
}

.philosophy-content .facilities-button {
    margin-top: 13px;
}

.philosophy-features {
    min-width: 0;
}

.philosophy-feature {
    display: flex;
    align-items: flex-start;
    gap: 17px;
    padding: 19px 0;
    border-bottom: 1px solid rgba(255, 255, 255, .13);
}

.philosophy-feature:first-child {
    border-top: 1px solid rgba(255, 255, 255, .13);
}

.philosophy-icon {
    width: 45px;
    height: 45px;
    flex: 0 0 45px;
    display: grid;
    place-items: center;
    color: var(--fac-gold-light);
    background: rgba(197, 164, 90, .1);
    border: 1px solid rgba(197, 164, 90, .28);
}

.philosophy-feature h3 {
    margin: 0 0 5px;
    color: #fff;
    font-size: 23px;
}

.philosophy-feature p {
    margin: 0;
    color: rgba(255, 255, 255, .67);
    font-size: 12px;
    line-height: 1.75;
}

/* CALL TO ACTION */

.facilities-cta {
    padding: 80px 0;
    background: #fff;
}

.cta-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(30px, 5vw, 60px);
    color: #fff;
    background: var(--fac-navy);
}

.cta-panel > *:not(.cta-watermark) {
    position: relative;
    z-index: 1;
}

.cta-panel h2 {
    color: #fff;
}

.cta-panel p {
    max-width: 540px;
    color: rgba(255, 255, 255, .72);
}

.cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 25px;
}

.cta-watermark {
    position: absolute;
    right: 45px;
    bottom: 15px;
    z-index: 0;
    color: rgba(255, 255, 255, .055);
    font-size: clamp(80px, 14vw, 160px);
    pointer-events: none;
}

/* REVEAL */

.facilities-page .reveal,
.facilities-philosophy .reveal,
.facilities-cta .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity .65s ease, transform .65s ease;
}

.facilities-page .reveal.is-visible,
.facilities-philosophy .reveal.is-visible,
.facilities-cta .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
}

@keyframes facHeroZoom {
    from { transform: scale(1); }
    to { transform: scale(1.055); }
}

/* TABLET */

@media (max-width: 992px) {
    .facilities-container {
        width: calc(100% - 40px);
    }

    .facilities-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .facility-image {
        height: 230px;
    }

    .intro-grid,
    .philosophy-grid {
        gap: 35px;
    }

    .facility-card-content p {
        min-height: 75px;
    }
}

/* MOBILE */

@media (max-width: 600px) {
    .facilities-container {
        width: calc(100% - 32px);
    }

    .facilities-hero {
        min-height: 510px;
    }

    .facilities-hero-content {
        padding-top: 75px;
        padding-bottom: 75px;
    }

    .facilities-hero-content h1 {
        font-size: clamp(41px, 11vw, 58px);
    }

    .facilities-hero-content p {
        font-size: 13px;
    }

    .facilities-intro,
    .facilities-showcase,
    .facilities-philosophy {
        padding: 60px 0;
    }

    .intro-grid,
    .philosophy-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 35px;
    }

    .intro-image-wrap > img {
        height: 280px;
    }

    .intro-image-label {
        right: -2px;
    }

    .facilities-page h2 {
        font-size: clamp(34px, 9vw, 43px);
    }

    .section-heading {
        margin-bottom: 32px;
    }

    .facilities-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 22px;
    }

    .facility-image {
        height: clamp(210px, 62vw, 290px);
    }

    .facility-card-content {
        padding: 21px;
    }

    .facility-card-content h3 {
        font-size: 26px;
    }

    .facility-card-content p {
        min-height: 0;
    }

    .facilities-cta {
        padding: 55px 0;
    }

    .cta-panel {
        padding: 30px 22px;
    }

    .cta-buttons {
        flex-direction: column;
    }

    .cta-buttons .facilities-button,
    .cta-buttons .facilities-outline-button {
        width: 100%;
    }

    .cta-watermark {
        right: 10px;
        bottom: 5px;
        font-size: 75px;
    }
}

/* REDUCED MOTION */

@media (prefers-reduced-motion: reduce) {
    .facilities-page *,
    .facilities-page *::before,
    .facilities-page *::after,
    .facilities-philosophy *,
    .facilities-cta * {
        animation: none !important;
        transition: none !important;
        scroll-behavior: auto !important;
    }

    .facilities-page .reveal,
    .facilities-philosophy .reveal,
    .facilities-cta .reveal {
        opacity: 1;
        transform: none;
    }
}
</style>


<script>
(function () {
    "use strict";

    function initFacilitiesReveal() {
        const elements = document.querySelectorAll(
            ".facilities-page .reveal, " +
            ".facilities-philosophy .reveal, " +
            ".facilities-cta .reveal"
        );

        if (!("IntersectionObserver" in window)) {
            elements.forEach(function (element) {
                element.classList.add("is-visible");
            });
            return;
        }

        const observer = new IntersectionObserver(
            function (entries, currentObserver) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("is-visible");
                        currentObserver.unobserve(entry.target);
                    }
                });
            },
            {
                threshold: 0.1,
                rootMargin: "0px 0px -25px 0px"
            }
        );

        elements.forEach(function (element) {
            observer.observe(element);
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener(
            "DOMContentLoaded",
            initFacilitiesReveal
        );
    } else {
        initFacilitiesReveal();
    }
})();
</script>

